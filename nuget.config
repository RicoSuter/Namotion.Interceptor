<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Nightly builds of dotnet/iot, until a release contains the fixes of dotnet/iot#2602, #2614 and #2489. -->
    <add key="dotnet-iot-nightly" value="https://pkgs.dev.azure.com/dotnet/IoT/_packaging/nightly_iot_builds/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-iot-nightly">
      <package pattern="System.Device.Gpio" />
      <package pattern="Iot.Device.Bindings" />
    </packageSource>
  </packageSourceMapping>
</configuration>
