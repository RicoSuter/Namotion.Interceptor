<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Authors>Rico Suter</Authors>
    <Description>Interceptor library for .NET</Description>

    <RepositoryUrl>https://github.com/RicoSuter/Namotion.Interceptor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/RicoSuter/Namotion.Interceptor</PackageProjectUrl>
    <PackageTags>Interceptor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <Version>0.1.0</Version>
    <!-- Lets an application build report the released library version in deps.json, which plugin loaders compare
         against the versions plugins were built with. pack sets PackageVersion directly instead. -->
    <PackageVersion Condition="'$(LibraryPackageVersion)' != ''">$(LibraryPackageVersion)</PackageVersion>
  </PropertyGroup>
</Project>
