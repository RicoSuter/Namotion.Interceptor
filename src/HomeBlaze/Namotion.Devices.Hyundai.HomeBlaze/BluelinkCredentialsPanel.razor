@implements IDisposable

@inject TimeProvider TimeProvider

<MudStack Spacing="2">
    @if (_isConnected)
    {
        <MudCard Outlined="true">
            <MudCardContent>
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        <MudText Typo="Typo.h6">Connected</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">@_connectedEmail</MudText>
                    @if (_vehicles.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">This account has no vehicles.</MudAlert>
                    }
                    else
                    {
                        <MudList T="string" ReadOnly="true" Dense="true" Padding="false">
                            @foreach (var vehicle in _vehicles)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.DirectionsCar">
                                    @(vehicle.Nickname ?? vehicle.Model ?? "Hyundai")
                                    <MudText Typo="Typo.caption" Inline="true">(@vehicle.VinSuffix, @(vehicle.Model ?? "unknown model"), @vehicle.Protocol)</MudText>
                                    @if (!vehicle.IsSupported)
                                    {
                                        <MudChip T="string" Size="Size.Small">Not supported (@(vehicle.Type ?? "unknown type"))</MudChip>
                                    }
                                    else if (vehicle.Protocol == BluelinkProtocol.Ccs2 && _isPinMissing)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Commands need the PIN</MudChip>
                                    }
                                </MudListItem>
                            }
                        </MudList>
                    }
                    <MudText Typo="Typo.body2">Create or save to store the credentials and the token set of this connection.</MudText>
                </MudStack>
            </MudCardContent>
            <MudCardActions>
                <MudButton OnClick="UseDifferentCredentialsAsync" Variant="Variant.Text" Color="Color.Primary">Use different credentials</MudButton>
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <MudTextField @bind-Value="_email" @bind-Value:after="ClearError" Label="Email" InputType="InputType.Email"
                      Immediate="true" Disabled="_isConnecting" />
        <MudTextField @bind-Value="_password" @bind-Value:after="ClearError" Label="Password" InputType="InputType.Password"
                      Immediate="true" Disabled="_isConnecting"
                      HelperText="Stored as a secret, so that the account signs in again by itself when Hyundai rejects its token" />
        <MudTextField @bind-Value="_pin" @bind-Value:after="ClearError" Label="PIN (optional)" InputType="InputType.Password"
                      Immediate="true" Disabled="_isConnecting"
                      HelperText="The PIN of the Bluelink app. Only charging and climate commands of newer vehicles (CCS2) need it." />

        <MudButton OnClick="ConnectAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isConnecting || !CanConnect)">
            @if (_isConnecting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Connect
        </MudButton>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        }
    }
</MudStack>

@code {
    private readonly CancellationTokenSource _disposeCancellation = new();

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _pin = string.Empty;
    private bool _isConnecting;
    private string? _error;

    // Only what is shown is kept: the password, the PIN and the tokens go to OnConnected and are not held here.
    private bool _isConnected;
    private string? _connectedEmail;
    private bool _isPinMissing;
    private IReadOnlyList<BluelinkVehicleSummary> _vehicles = [];

    /// <summary>The email to start with, for example the stored one when replacing the credentials.</summary>
    [Parameter]
    public string? InitialEmail { get; set; }

    /// <summary>Raised with the connection after a successful connect; store its credentials and tokens.</summary>
    [Parameter]
    public EventCallback<BluelinkConnection> OnConnected { get; set; }

    /// <summary>Raised when the user discards the connection to enter different credentials; drop the stored connection.</summary>
    [Parameter]
    public EventCallback OnReset { get; set; }

    private bool CanConnect => _email.Contains('@') && _password.Length > 0;

    protected override void OnInitialized() => _email = InitialEmail ?? string.Empty;

    private async Task ConnectAsync()
    {
        _error = null;
        _isConnecting = true;
        try
        {
            var connection = await BluelinkAccountConnector.ConnectAsync(_email, _password, _pin, TimeProvider, _disposeCancellation.Token);
            await OnConnected.InvokeAsync(connection);
            _isConnected = true;
            _connectedEmail = connection.Email;
            _isPinMissing = connection.Pin.Length == 0;
            _vehicles = connection.Vehicles;
            _password = string.Empty;
            _pin = string.Empty;
        }
        catch (OperationCanceledException) when (_disposeCancellation.IsCancellationRequested)
        {
            // The dialog was closed.
        }
        catch (BluelinkPinRejectedException)
        {
            _error = "Connecting failed: Hyundai rejected the PIN. Five wrong PINs lock PIN entry for a while.";
        }
        catch (Exception exception)
        {
            _error = $"Connecting failed: {exception.Message}";
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private void ClearError() => _error = null;

    private Task UseDifferentCredentialsAsync()
    {
        _isConnected = false;
        _email = _connectedEmail ?? _email;
        _connectedEmail = null;
        _isPinMissing = false;
        _vehicles = [];
        return OnReset.InvokeAsync();
    }

    public void Dispose()
    {
        _disposeCancellation.Cancel();
        _disposeCancellation.Dispose();
    }
}
