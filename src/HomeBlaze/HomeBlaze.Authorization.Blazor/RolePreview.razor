@* Shows what a role allows a kind of principal on one subject: whether the subject is readable, each member against each
   action with the rule that decided it, and how many members each deny rule of the role matches. Never writes anything.
   Shows nothing to a viewer who may not administer the roles of the authorization, as it lists the members of any
   subject whatever the viewer may read. *@
@using HomeBlaze.Authorization.Abstractions
@using HomeBlaze.Abstractions
@using HomeBlaze.Abstractions.Metadata
@using Namotion.Interceptor.Registry.Abstractions
@using Namotion.Interceptor.Registry.Paths

@inject AuthorizationService AuthorizationService
@inject SubjectPathResolver PathResolver
@inject IUserPermissions Permissions

<div class="role-preview">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="8">
            <div data-testid="role-preview-path">
                <SubjectPathField Value="@_path" ValueChanged="@OnPathChanged" Label="Subject" Placeholder="/Devices/Kitchen"
                                  IsPropertyVisible="@IsSubjectProperty" CanSelectProperty="@IsSubjectReference" HasBrowseButton="true" />
            </div>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="PrincipalKind" Label="Preview as" Value="@Kind" ValueChanged="@OnKindChangedAsync" data-testid="role-preview-kind">
                @foreach (var (kind, name) in KindNames)
                {
                    <MudSelectItem T="PrincipalKind" Value="@kind">@name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
        What the role allows on the chosen subject, its unsaved changes included, with the other roles it includes and the
        system rules of the chosen kind of principal.
    </MudText>

    @if (_isRefused)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4" data-testid="role-preview-refusal">@NotAllowedMessage</MudAlert>
    }
    else if (_subject is null)
    {
        @if (Result.Error is null && !string.IsNullOrWhiteSpace(_path))
        {
            <MudText Typo="Typo.body2" Class="mt-4" data-testid="role-preview-not-found">No subject has this path.</MudText>
        }
    }
    else
    {
        <MudAlert Severity="@(_subjectDecision.IsVisible ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-4"
                  data-testid="role-preview-readable" data-readable="@(_subjectDecision.IsVisible ? "true" : "false")">@_subjectText</MudAlert>

        <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Class="role-preview-matrix mt-4" data-testid="role-preview-matrix">
            <thead>
                <tr>
                    <th>Member</th>
                    @foreach (var action in AuthorizationActions.All)
                    {
                        <th class="text-center">@action.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr data-member="@row.Name">
                        <td>
                            @row.Name
                            @* Selected as a whole with one click, to be copied into a rule. *@
                            @if (row.Path is { } path)
                            {
                                <div class="mud-text-secondary role-preview-member-path" title="The path a rule matches this member by"
                                     data-testid="@($"role-preview-path-{row.Name}")">@path</div>
                            }
                        </td>
                        @for (var index = 0; index < row.Cells.Length; index++)
                        {
                            var action = AuthorizationActions.All[index];
                            <td class="text-center" data-testid="@($"role-preview-cell-{row.Name}-{action.Name}")"
                                data-decision="@row.Cells[index]?.Decision" data-note="@(row.Cells[index]?.IsUnusable == true ? "execute-without-read" : null)">
                                @if (row.Cells[index] is { } cell)
                                {
                                    <MudTooltip Text="@cell.Explanation">
                                        <MudIconButton Size="Size.Small" Icon="@(cell.IsAllowed ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                                       Color="@cell.Color"
                                                       aria-label="@($"{row.Name}, {action.Name}: {cell.AccessibleDecision}")"
                                                       OnClick="@(() => Select(row.Name, action))" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <span class="role-preview-not-applicable" role="img" aria-label="Does not apply" title="Does not apply to this member">–</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        @if (GetSelectedCell() is { } selected)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" data-testid="role-preview-explanation">
                <b>@_selectedMember, @_selectedAction?.Name:</b> @selected.Explanation
            </MudAlert>
        }

        @if (_denyMatches.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">Deny rules</MudText>
            <MudStack Spacing="1" Class="mt-1">
                @foreach (var match in _denyMatches)
                {
                    <MudAlert Severity="@(match.MatchesNothing ? Severity.Warning : Severity.Normal)" Dense="true"
                              data-testid="@($"role-preview-deny-{match.Index}")" data-count="@match.Count"
                              data-matches-nothing="@(match.MatchesNothing ? "true" : "false")">@match.Text</MudAlert>
                }
            </MudStack>
        }
    }
</div>

<style>
    /* The field, the readability line and the explanation keep their height; only the matrix scrolls, below its header,
       unless the window is short, see below. */
    .role-preview {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .role-preview > * {
        flex: 0 0 auto;
    }

    .role-preview > .role-preview-matrix {
        flex: 0 1 auto;
        min-height: 120px;
        display: flex;
        flex-direction: column;
    }

    .role-preview-matrix > .mud-table-container {
        min-height: 0;
        overflow-y: auto;
    }

    /* In a short window, the whole tab scrolls instead, so that the matrix can take the height of the tab; its header row
       stays at the top of the tab. The container must outrank the overflow MudBlazor gives a sticky header's container,
       as a header sticks to the nearest ancestor that scrolls, even one that never does. */
    @@media (max-height: 800px) {
        .role-preview {
            display: block;
            height: auto;
        }

        .role-preview .role-preview-matrix.mud-table-sticky-header > .mud-table-container {
            overflow: visible;
        }

        /* Sticks over the top padding of the tab panels, see RoleEditComponent, rather than show rows above it. */
        .role-preview .role-preview-matrix.mud-table-sticky-header thead th {
            top: -16px;
        }
    }

    .role-preview-member-path {
        font-family: monospace;
        font-size: 0.7rem;
        user-select: all;
        word-break: break-all;
    }

    .role-preview-not-applicable {
        color: var(--mud-palette-text-secondary);
    }
</style>

@code {
    private static readonly (PrincipalKind Kind, string Name)[] KindNames =
    [
        (PrincipalKind.Person, "Person"),
        (PrincipalKind.NonHuman, "Agent or MCP client"),
        (PrincipalKind.Anonymous, "Anonymous")
    ];

    private const string NotAllowedMessage = "Only a full administrator can preview roles.";

    private string? _path;
    private AuthorizationResult _previewedResult;
    private AuthorizationRole? _previewedRole;
    private bool _isRefused;
    private IInterceptorSubject? _subject;
    private VisibilityDecision _subjectDecision;
    private string? _subjectText;
    private IReadOnlyList<MemberRow> _rows = [];
    private IReadOnlyList<DenyMatch> _denyMatches = [];
    private string? _selectedMember;
    private PermissionAction? _selectedAction;

    /// <summary>
    /// The preview of the role, see <see cref="AuthorizationService.PreviewPolicy(AuthorizationRole, PrincipalKind)"/>. While
    /// it has an error, which the editor shows, no subject is shown.
    /// </summary>
    [Parameter, EditorRequired]
    public AuthorizationResult Result { get; set; }

    /// <summary>The role the preview was compiled from, whose deny rules are matched against the members of the subject.</summary>
    [Parameter, EditorRequired]
    public AuthorizationRole Role { get; set; } = null!;

    /// <summary>The kind of principal whose system rules <see cref="Result"/> was compiled with.</summary>
    [Parameter]
    public PrincipalKind Kind { get; set; } = PrincipalKind.Person;

    /// <summary>The authorization that holds the roles; the preview shows nothing unless the viewer may administer its roles.</summary>
    [Parameter]
    public Authorization? Authorization { get; set; }

    /// <summary>Raised with the kind chosen in the preview, for which the parent passes the preview compiled with it.</summary>
    [Parameter]
    public EventCallback<PrincipalKind> KindChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (Result != _previewedResult || !ReferenceEquals(Role, _previewedRole))
        {
            Update();
        }
    }

    private static bool IsSubjectProperty(RegisteredSubjectProperty property) => property.CanContainSubjects;

    // A reference's path is the path of the subject it holds.
    private static bool IsSubjectReference(RegisteredSubjectProperty property) => property.IsSubjectReference;

    private void OnPathChanged(string? path)
    {
        _path = path;
        Update();
    }

    // Kept here as chosen, as the parameter is set again only once the parent rendered.
    private async Task OnKindChangedAsync(PrincipalKind kind)
    {
        Kind = kind;
        await KindChanged.InvokeAsync(kind);
    }

    private void Select(string member, PermissionAction action)
    {
        _selectedMember = member;
        _selectedAction = action;
    }

    private Cell? GetSelectedCell()
    {
        var index = _selectedAction is { } action ? AuthorizationActions.All.IndexOf(action) : -1;
        return index >= 0 ? _rows.FirstOrDefault(row => row.Name == _selectedMember)?.Cells[index] : null;
    }

    private void Update()
    {
        _previewedResult = Result;
        _previewedRole = Role;
        _rows = [];
        _denyMatches = [];

        // Checked on every update, as a path can still arrive from a page whose viewer lost the permission.
        _isRefused = !Permissions.CanAdministerRoles(Authorization);
        _subject = _isRefused || Result.Error is not null || string.IsNullOrWhiteSpace(_path)
            ? null
            : PathResolver.ResolveSubject(_path.Trim(), PathStyle.Canonical);

        if (_subject?.TryGetRegisteredSubject() is not { } subject)
        {
            return;
        }

        var policy = Result.Policy;
        var members = GetMembers(subject);
        _subjectDecision = policy.ExplainVisibility(subject);
        _subjectText = DescribeSubject(_subjectDecision);
        _rows = members.Select(member => CreateRow(member, policy, AuthorizationService.PathProvider)).ToList();
        _denyMatches = MatchDenyRules(Role, members);
    }

    // The members a deny rule of the role matches among those of the subject; when none, whether it matches any member
    // at all, which the service answers from its cache, as a deny rule that matches nothing denies nothing.
    private List<DenyMatch> MatchDenyRules(AuthorizationRole role, List<MemberEntry> members)
    {
        var matches = new List<DenyMatch>();
        for (var index = 0; index < role.Deny.Length; index++)
        {
            var rule = role.Deny[index];
            if (DenyRuleMatcher.Create(rule, AuthorizationService.PathProvider) is not { } matcher)
            {
                continue;
            }

            var count = members.Count(member => matcher.Matches(member.Member));
            var matchesNothing = count == 0 && AuthorizationService.DenyRuleMatchesAnyMember(rule) == false;
            matches.Add(new DenyMatch(index, count, matchesNothing, DescribeDenyMatch(index, rule, count, matchesNothing)));
        }

        return matches;
    }

    private static string DescribeDenyMatch(int index, PermissionRule rule, int count, bool matchesNothing)
    {
        var name = $"Deny rule {index + 1} (deny {rule})";
        if (matchesNothing)
        {
            return $"{name} matches nothing: no member of any subject, so it denies nothing.";
        }

        return count switch
        {
            0 => $"{name} matches no member of this subject.",
            1 => $"{name} matches 1 member of this subject.",
            _ => $"{name} matches {count} members of this subject."
        };
    }

    private string DescribeSubject(VisibilityDecision decision)
    {
        if (decision.IsVisible)
        {
            return "Readable: the subject has a readable member and a chain of readable links from the root.";
        }

        if (!decision.HasReadableMember)
        {
            return "Hidden: no member is readable.";
        }

        if (decision.DeniedProperty is { } property)
        {
            var path = PathResolver.GetPath(property.Parent.Subject, PathStyle.Canonical);
            return $"Hidden: the property {property.Name} of {path ?? "a subject without a path"} is not readable.";
        }

        return "Hidden: no chain of parents leads to the root.";
    }

    // The properties, then the methods, then the attributes of each, as the policy names them.
    private static List<MemberEntry> GetMembers(RegisteredSubject subject)
    {
        var properties = new List<RegisteredSubjectProperty>();
        var methods = new List<RegisteredSubjectProperty>();
        foreach (var property in subject.Properties)
        {
            if (!property.IsAttribute)
            {
                // By type, as reading the value to classify the member would call its getter.
                (property.Type == typeof(MethodMetadata) ? methods : properties).Add(property);
            }
        }

        var members = new List<MemberEntry>();
        members.AddRange(properties.Select(property => new MemberEntry(property, property.Name, IsMethod: false)));
        members.AddRange(methods.Select(method => new MemberEntry(method, method.Name, IsMethod: true)));
        foreach (var property in properties.Concat(methods))
        {
            AddAttributes(property, property.Name, members);
        }

        return members;
    }

    private static void AddAttributes(RegisteredSubjectProperty property, string name, List<MemberEntry> members)
    {
        foreach (var attribute in property.Attributes)
        {
            if (RulePaths.IsMarker(attribute))
            {
                continue;
            }

            var attributeName = $"{name}@{attribute.BrowseName}";
            members.Add(new MemberEntry(attribute, attributeName, IsMethod: false));
            AddAttributes(attribute, attributeName, members);
        }
    }

    // Only the actions that apply to the member get a cell, see AuthorizationActions.AppliesTo.
    private static MemberRow CreateRow(MemberEntry entry, AuthorizationPolicy policy, PathProviderBase pathProvider)
    {
        var (member, name, isMethod) = entry;
        var cells = new Cell?[AuthorizationActions.All.Length];
        for (var index = 0; index < cells.Length; index++)
        {
            var action = AuthorizationActions.All[index];
            if (AuthorizationActions.AppliesTo(action, isMethod))
            {
                var decision = policy.Explain(member, action);
                cells[index] = new Cell(decision.IsAllowed, Explain(decision));
            }
        }

        if (isMethod)
        {
            MarkExecuteWithoutRead(cells);
        }

        return new MemberRow(name, RulePaths.GetMemberPath(member, pathProvider), cells);
    }

    // A method that can be executed but not read cannot be used, so its allowed execute cell says why.
    private static void MarkExecuteWithoutRead(Cell?[] cells)
    {
        var executeIndex = AuthorizationActions.All.IndexOf(AuthorizationActions.Execute);
        var readIndex = AuthorizationActions.All.IndexOf(PermissionAction.Read);
        if (cells[executeIndex] is { IsAllowed: true } execute && cells[readIndex] is { IsAllowed: false })
        {
            cells[executeIndex] = execute with
            {
                IsUnusable = true,
                Explanation = $"{execute.Explanation} It cannot be used, as read is denied: A method is listed and run only when it is readable."
            };
        }
    }

    /// <summary>
    /// Gets a decision as text, for example
    /// <c>Denied by Kitchen: deny write · paths: /Devices. It overrides Reader: allow read, write.</c>
    /// </summary>
    internal static string Explain(PermissionDecision decision)
    {
        if (decision.DeniedByRule is { } deniedByRule)
        {
            var denier = decision.IsDeniedBySystem ? "a system rule" : decision.DeniedBy?.Name;
            var text = $"Denied by {denier}: deny {deniedByRule}.";
            return decision.AllowedBy is { } allowedBy && decision.AllowedByRule is { } allowedByRule
                ? $"{text} It overrides {allowedBy.Name}: allow {allowedByRule}."
                : text;
        }

        if (decision.AllowedBy is { } allower && decision.AllowedByRule is { } allowingRule)
        {
            return $"Allowed by {allower.Name}: allow {allowingRule}.";
        }

        return "No role allows it.";
    }

    // A member as listed, by the name the matrix shows it with.
    private sealed record MemberEntry(RegisteredSubjectProperty Member, string Name, bool IsMethod);

    // The members of the subject a deny rule of the role matches, at its index in the deny rules of the role, and
    // whether it matches no member of any subject.
    private sealed record DenyMatch(int Index, int Count, bool MatchesNothing, string Text);

    // The path is the member's path as path patterns spell it, or null when its subject has none.
    private sealed record MemberRow(string Name, string? Path, Cell?[] Cells);

    // Unusable: allowed, but of no use because another action is denied, see MarkExecuteWithoutRead.
    private sealed record Cell(bool IsAllowed, string Explanation, bool IsUnusable = false)
    {
        public string Decision => IsAllowed ? "allowed" : "denied";

        // The decision as screen readers announce it, which the color of an unusable cell says otherwise.
        public string AccessibleDecision => IsUnusable ? $"{Decision}, cannot be used" : Decision;

        public Color Color
        {
            get
            {
                if (IsUnusable)
                {
                    return Color.Warning;
                }

                return IsAllowed ? Color.Success : Color.Error;
            }
        }
    }
}
