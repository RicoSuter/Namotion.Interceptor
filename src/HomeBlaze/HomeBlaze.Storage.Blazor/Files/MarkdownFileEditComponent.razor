@using BlazorMonaco.Editor
@using HomeBlaze.Abstractions
@using HomeBlaze.Components
@using HomeBlaze.Components.Abstractions
@using HomeBlaze.Components.Abstractions.Attributes
@using HomeBlaze.Components.Dialogs
@using HomeBlaze.Services
@using HomeBlaze.Services.Components
@using HomeBlaze.Storage.Blazor.Models
@using HomeBlaze.Storage.Files
@using HomeBlaze.Storage.Internal
@using HomeBlaze.Storage.Pages
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.JSInterop
@using MudBlazor
@using Namotion.Interceptor

@inject IJSRuntime JsRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ConfigurableSubjectSerializer Serializer
@inject SubjectFactory SubjectFactory
@inject SubjectComponentRegistry ComponentRegistry
@inject TypeProvider TypeProvider

@attribute [SubjectComponent(SubjectComponentType.Edit, typeof(MarkdownFile))]
@implements ISubjectEditComponent

@if (string.IsNullOrEmpty(_originalContent))
{
    <MudProgressCircular Indeterminate="true"/>
}
else
{
    <SectionContent SectionName="EditActions">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OnCreateClick"
                   data-testid="create-subject-button">
            Create
        </MudButton>
        @if (_activeRegion != null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="OnEditButtonClick"
                       data-testid="@(_activeRegion.Type == DecorationRegionType.SubjectBlock ? "edit-subject-button" : "edit-expression-button")">
                @(_activeRegion.Type == DecorationRegionType.SubjectBlock ? $"Edit {_activeRegion.Name}" : "Edit Expression")
            </MudButton>
        }
    </SectionContent>

    <StandaloneCodeEditor @ref="_editor"
                          Id="markdown-editor"
                          CssClass="monaco-editor-container"
                          ConstructionOptions="GetEditorOptions"
                          OnDidInit="OnEditorInit"
                          OnDidChangeModelContent="OnContentChanged"
                          OnDidChangeCursorPosition="OnCursorPositionChanged"/>
}

<style>
    .monaco-editor-container {
        height: calc(100vh - 200px);
        width: 100%;
    }

    /* Decoration styles for subject blocks and expressions */
    .subject-block-decoration {
        background-color: rgba(65, 105, 225, 0.25); /* Royal blue, works in light/dark modes */
        border-radius: 3px;
    }

    .expression-decoration {
        background-color: rgba(65, 105, 225, 0.25); /* Royal blue, works in light/dark modes */
        border-radius: 3px;
    }
</style>

@code {
    [Parameter] public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public bool IsCreating { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    public bool IsDarkMode { get; set; } = true;

    private MarkdownFile? File => Subject as MarkdownFile;
    private StandaloneCodeEditor? _editor;
    private string _originalContent = string.Empty;
    private string _currentContent = string.Empty;
    private bool _previousDarkMode = true;
    private List<DecorationRegion> _decorationRegions = new();
    private string[] _currentDecorationIds = Array.Empty<string>();
    private DecorationRegion? _activeRegion;
    private Task? _decorationRefresh;
    private bool _isDecorationRefreshRequested;

    private string MonacoTheme => IsDarkMode ? "vs-dark" : "vs";

    public bool IsValid => true;
    public bool IsDirty => _currentContent != _originalContent;

    public event Action<bool>? IsValidChanged
    {
        add { }
        remove { }
    }

    public event Action<bool>? IsDirtyChanged;

    private StandaloneEditorConstructionOptions GetEditorOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "markdown",
            Value = _originalContent,
            WordWrap = "on",
            Theme = MonacoTheme
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        // Update Monaco theme when dark mode changes
        if (_editor != null && _previousDarkMode != IsDarkMode)
        {
            _previousDarkMode = IsDarkMode;
            await Global.SetTheme(JsRuntime, MonacoTheme);
        }
    }

    private async Task OnEditorInit()
    {
        // Apply initial decorations
        await RefreshDecorationsAsync();
    }

    private void OnCursorPositionChanged(CursorPositionChangedEvent e)
    {
        // Find if cursor is inside any decoration region
        var cursorLine = e.Position.LineNumber;
        var cursorColumn = e.Position.Column;

        var previousRegion = _activeRegion;
        _activeRegion = _decorationRegions.FirstOrDefault(r => r.ContainsPosition(cursorLine, cursorColumn));

        // Only update UI if active region changed
        if (_activeRegion != previousRegion)
        {
            StateHasChanged();
        }
    }

    private async Task OnEditButtonClick()
    {
        if (_activeRegion == null)
            return;

        if (_activeRegion.Type == DecorationRegionType.SubjectBlock)
        {
            await OnEditSubjectClick(_activeRegion);
        }
        else
        {
            await OnEditExpressionClick(_activeRegion);
        }
    }

    private async Task OnEditSubjectClick(DecorationRegion region)
    {
        if (File == null || _editor == null || region.BlockIndex is not { } blockIndex)
            return;

        // _currentContent follows the editor with a delay, and the comparison below must see what was typed last.
        _currentContent = await _editor.GetValue();

        // The subject belongs to the block of the saved page. Opening the dialog on editor text that
        // differs would show the saved values and then replace what was typed, or write into another block.
        if (MarkdownBlockMatcher.FindSavedBlock(_currentContent, File.Content, blockIndex) is null)
        {
            Snackbar.Add($"Save the page before editing {region.Name}. The text up to the end of this block has changes that are not saved.", Severity.Warning);
            return;
        }

        // The region is from the last content change and the page can have been parsed again since,
        // so the subject is looked up now.
        if (File.GetBlockSubject(blockIndex) is not { } subject)
        {
            Snackbar.Add($"{region.Name} cannot be edited because the block did not create a subject.", Severity.Warning);
            return;
        }

        var dialog = await SubjectEditDialog.ShowAsync(DialogService, ComponentRegistry, subject, $"Edit {region.Name}");
        var result = await dialog.Result;

        if (result?.Canceled != false)
            return;

        // Saving in the dialog wrote the configuration into the saved page, so its head line and json
        // fence no longer equal the editor text and only the text before the block is compared.
        if (MarkdownBlockMatcher.FindSavedBlockAfterWriteBack(_currentContent, File.Content, blockIndex) is not { } block)
        {
            Snackbar.Add($"The page changed while {region.Name} was edited, so the editor text was not updated. Reload the page before saving it.", Severity.Warning);
            return;
        }

        // Writes the head line and the json block only. When the graph has drifted from the text, the write-back
        // can also have inserted or removed blocks, and writing the editor text below overwrites that.
        _currentContent = MarkdownBlockWriter.WriteConfiguration(
            _currentContent, block, MarkdownBlockConfiguration.Serialize(Serializer, subject));

        // TODO: Code below is repeated 3x (extract to method)
        // Update the Monaco editor
        await _editor.SetValue(_currentContent);

        // Save the file, which also reloads it on the worker of its storage. The reload keeps the edited
        // subject and applies its configuration.
        using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(_currentContent));
        await File.WriteAsync(stream, CancellationToken.None);

        // After the reload, so that the regions carry the subjects of the reloaded page.
        await RefreshDecorationsAsync();

        // Update dirty state
        _originalContent = _currentContent;
        IsDirtyChanged?.Invoke(false);
    }

    private async Task OnEditExpressionClick(DecorationRegion region)
    {
        if (File == null || _editor == null)
            return;

        // Filter to only include actual subject blocks (not HtmlSegment, RenderExpression, etc.)
        var subjectBlocks = File.Children
            .Where(kvp => kvp.Value is not HtmlSegment && kvp.Value is not RenderExpression)
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

        // Open the ExpressionEditDialog
        var parameters = new DialogParameters<object>
        {
            { "SelectedPath", region.Name },
            { "LocalSubjects", subjectBlocks }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        // Use dynamic type lookup for ExpressionEditDialog since it's in HomeBlaze.Host
        var dialogType = Type.GetType("HomeBlaze.Host.Components.Dialogs.ExpressionEditDialog, HomeBlaze.Host");
        if (dialogType == null)
            return;

        var dialog = await DialogService.ShowAsync(dialogType, "Edit Expression", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not string newPath)
            return;

        // Replace the expression in the content
        // Find the exact expression using the decoration region position
        var lines = _currentContent.Split('\n');
        var startLineIndex = region.StartLine - 1;
        var endLineIndex = region.EndLine - 1;

        if (startLineIndex == endLineIndex)
        {
            // Single line expression
            var line = lines[startLineIndex];
            var before = line[..(region.StartColumn - 1)];
            var after = line[(region.EndColumn - 1)..];
            lines[startLineIndex] = $"{before}{{{{ {newPath} }}}}{after}";
        }
        else
        {
            // Multi-line expression (unlikely but handle it)
            var firstLine = lines[startLineIndex][..(region.StartColumn - 1)];
            var lastLine = lines[endLineIndex][(region.EndColumn - 1)..];
            lines[startLineIndex] = $"{firstLine}{{{{ {newPath} }}}}{lastLine}";
            // Remove intermediate lines
            for (int i = endLineIndex; i > startLineIndex; i--)
            {
                lines = lines.Take(i).Concat(lines.Skip(i + 1)).ToArray();
            }
        }

        _currentContent = string.Join('\n', lines);

        // Update the Monaco editor
        await _editor.SetValue(_currentContent);

        // Save the file, which also reloads it on the worker of its storage
        using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(_currentContent));
        await File.WriteAsync(stream, CancellationToken.None);

        // After the reload, so that the regions carry the subjects of the reloaded page.
        await RefreshDecorationsAsync();

        // Update dirty state
        _originalContent = _currentContent;
        IsDirtyChanged?.Invoke(false);
    }

    private async Task OnCreateClick()
    {
        if (File == null || _editor == null)
            return;

        // _currentContent follows the editor with a delay, and the names must be those of what was typed last.
        _currentContent = await _editor.GetValue();

        // The name becomes the #id of the block. It is checked while the dialog is open, because the
        // subject that was configured in it is gone once the dialog has closed.
        var result = await SubjectSetupDialog.ShowAsync(DialogService, new SubjectSetupOptions
        {
            NameField = MarkdownBlockNames.CreateNameOptions(_currentContent)
        });

        if (result?.Name is null)
            return;

        string json;
        try
        {
            json = MarkdownBlockConfiguration.Serialize(Serializer, result.Subject);
        }
        finally
        {
            // Only the text of the subject goes into the page, and the reload below creates the instance that lives on.
            SubjectFactory.DiscardSubject(result.Subject);
        }

        // The editor gives the text with one line ending for all lines.
        var lineEnding = MarkdownBlockWriter.GetLineEnding(_currentContent);
        var typeName = result.Subject.GetType().FullName!;

        // Insert at cursor line (or end if no cursor)
        var position = await _editor.GetPosition();
        var lines = _currentContent.Split(lineEnding);
        var newLines = new List<string>(lines);

        // Inside a block, the new block goes after the json block of that block and gets one colon more
        // than the block that it is then inside of. It always gets a closing line, so that the lines
        // after it are not inside it.
        var editorPage = MarkdownPageParser.Parse(_currentContent);
        var insertLine = Math.Min(editorPage.GetLineForNewBlock(position?.LineNumber ?? lines.Length), lines.Length + 1);
        var fenceLength = editorPage.GetFenceLengthForNewBlock(
            insertLine, name => TypeProvider.Types.FirstOrDefault(type => type.FullName == name));
        var blockLines = MarkdownBlockWriter.CreateBlock(typeName, result.Name, json, fenceLength, lineEnding).Split(lineEnding);

        // The parser accepts a block without blank lines around it. They keep the page text readable.
        if (insertLine > 1 && !string.IsNullOrWhiteSpace(lines[insertLine - 2]))
        {
            newLines.Insert(insertLine - 1, "");
            insertLine++;
        }

        newLines.InsertRange(insertLine - 1, blockLines);

        var lineAfterBlock = insertLine - 1 + blockLines.Length;
        if (lineAfterBlock < newLines.Count && !string.IsNullOrWhiteSpace(newLines[lineAfterBlock]))
        {
            newLines.Insert(lineAfterBlock, "");
        }

        _currentContent = string.Join(lineEnding, newLines);

        // Update the Monaco editor
        await _editor.SetValue(_currentContent);

        // Save the file, which also reloads it on the worker of its storage
        using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(_currentContent));
        await File.WriteAsync(stream, CancellationToken.None);

        // After the reload, so that the regions carry the subjects of the reloaded page.
        await RefreshDecorationsAsync();

        // Update dirty state
        _originalContent = _currentContent;
        IsDirtyChanged?.Invoke(false);
    }

    // Called only on the synchronization context of the circuit: the editor keeps its decoration ids in a list that is
    // not thread-safe, and calls from two threads break it for every later call. A refresh that is requested while one
    // runs is one more run after it, never a second one at the same time, because both would remove the same old
    // decorations and the one whose ids are overwritten in _currentDecorationIds would stay in the editor for good.
    // The returned task completes after a run that started after the call, unless a run fails before.
    private Task RefreshDecorationsAsync()
    {
        if (_decorationRefresh is { IsCompleted: false } runningRefresh)
        {
            _isDecorationRefreshRequested = true;
            return runningRefresh;
        }

        _decorationRefresh = RunDecorationRefreshesAsync();
        return _decorationRefresh;
    }

    private async Task RunDecorationRefreshesAsync()
    {
        do
        {
            _isDecorationRefreshRequested = false;
            await ApplyDecorationsAsync();
        }
        while (_isDecorationRefreshRequested);
    }

    private async Task ApplyDecorationsAsync()
    {
        if (_editor == null)
            return;

        // Parse decoration regions from current content
        Func<int, IInterceptorSubject?>? getBlockSubject = File is null ? null : File.GetBlockSubject;
        _decorationRegions = MarkdownDecorationParser.Parse(_currentContent, getBlockSubject);

        // Convert to Monaco decorations
        var decorations = _decorationRegions.Select(region => new ModelDeltaDecoration
        {
            Range = new BlazorMonaco.Range(
                region.StartLine,
                region.StartColumn,
                region.EndLine,
                region.EndColumn),
            Options = new ModelDecorationOptions
            {
                ClassName = region.Type == DecorationRegionType.SubjectBlock
                    ? "subject-block-decoration"
                    : "expression-decoration",
                IsWholeLine = false
            }
        }).ToArray();

        // Apply decorations (delta update - removes old, adds new)
        _currentDecorationIds = await _editor.DeltaDecorations(_currentDecorationIds, decorations);
    }

    protected override async Task OnInitializedAsync()
    {
        if (File != null)
        {
            await using var stream = await File.ReadAsync(CancellationToken.None);
            using var reader = new StreamReader(stream);
            _originalContent = await reader.ReadToEndAsync();
            _currentContent = _originalContent;
        }
    }

    private async Task OnContentChanged(ModelContentChangedEvent e)
    {
        // TODO: Add try-catch for ObjectDisposedException/JSDisconnectedException - component may be disposed during async operation
        // Awaited here and not run on the thread pool, because the decorations are refreshed on the synchronization
        // context of the circuit only, see RefreshDecorationsAsync.
        if (_editor != null)
        {
            _currentContent = await _editor.GetValue();
            await RefreshDecorationsAsync();

            IsDirtyChanged?.Invoke(IsDirty);
        }
    }

    public async Task SaveAsync(CancellationToken cancellationToken)
    {
        if (File == null || _editor == null) return;

        var content = await _editor.GetValue();

        using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(content));
        await File.WriteAsync(stream, cancellationToken);

        _originalContent = content;
        _currentContent = content;

        // The storage reloads the file as part of the write, so the regions get the subjects of the saved page.
        await RefreshDecorationsAsync();

        IsDirtyChanged?.Invoke(false);
    }

}
