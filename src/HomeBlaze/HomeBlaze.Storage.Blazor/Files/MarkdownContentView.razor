@using System.Text
@using System.Web
@using HomeBlaze.Components
@using HomeBlaze.Components.Abstractions.Attributes
@using HomeBlaze.Components.Abstractions.TimeZones
@using HomeBlaze.Components.Components
@using HomeBlaze.Services.Components
@using HomeBlaze.Storage.Internal
@using Namotion.Interceptor
@inject ITimeZoneDisplay TimeZone
@inject SubjectComponentRegistry ComponentRegistry
@implements IDisposable

@{
    var isEditingInline = IsEditing && Selection is not null;
    var showsInsertLines = ShowsInsertLines();
}
@if (isEditingInline && Children is not null && HasInvisibleWidget())
{
    @* Keyed, so that a chip keeps its state when a block is inserted or removed. *@
    <div class="invisible-widget-stack">
        @foreach (var child in Children!.Values)
        {
            if (IsInvisibleWidget(child))
            {
                <SubjectComponent @key="child" Subject="@child" Type="SubjectComponentType.Widget" />
            }
        }
    </div>
}
@foreach (var segment in GetRenderSegments())
{
    @if (segment.Html != null)
    {
        @((MarkupString)segment.Html)
    }
    else if (segment.Widget != null && !(isEditingInline && IsInvisibleWidget(segment.Widget)))
    {
        @if (showsInsertLines)
        {
            <BlockInsertLine OnInsert="@(() => StructureEditor!.InsertWidgetAsync(Content!, segment.Widget))" />
        }

        @* Keyed, so that the state of a component stays with its subject when a reload inserts or removes a block. *@
        <SubjectComponent @key="segment.Widget" Subject="@segment.Widget" Type="SubjectComponentType.Widget" />
    }
}
@if (showsInsertLines)
{
    <BlockInsertLine OnInsert="@(() => StructureEditor!.InsertWidgetAsync(Content!, null))" />
}

@code {
    /// <summary>The page or the fragment whose segments these are, into which new blocks are inserted.</summary>
    [Parameter]
    public IInterceptorSubject? Content { get; set; }

    /// <summary>
    /// The segments of a page or of a fragment, in order.
    /// </summary>
    [Parameter]
    public IDictionary<string, IInterceptorSubject>? Children { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    [CascadingParameter]
    public WidgetSelection? Selection { get; set; }

    [CascadingParameter]
    public IPageStructureEditor? StructureEditor { get; set; }

    [CascadingParameter(Name = "ParentSubjectComponent")]
    public SubjectComponent? Owner { get; set; }

    private WidgetSelection? _subscribedSelection;
    private bool _isAtSelection;

    private record RenderSegment(string? Html, IInterceptorSubject? Widget);

    // Runs on every render and keeps nothing: the values of expressions are read here so that the render
    // records them, and a reload replaces the dictionary and its subjects.
    private List<RenderSegment> GetRenderSegments()
    {
        var result = new List<RenderSegment>();
        if (Children is null)
            return result;

        StringBuilder? builder = null;

        foreach (var child in Children.Values)
        {
            if (child is HtmlSegment html)
            {
                builder ??= new StringBuilder();
                builder.Append(html.Html);
            }
            else if (child is RenderExpression expression)
            {
                builder ??= new StringBuilder();
                if (expression.Error is not null)
                {
                    builder.Append("<span class=\"mud-error-text\" data-testid=\"expression-error\">");
                    builder.Append(HttpUtility.HtmlEncode(expression.Error));
                    builder.Append("</span>");
                }
                else
                {
                    builder.Append(HttpUtility.HtmlEncode(expression.GetText(TimeZone)));
                }
            }
            else
            {
                // HTML and expressions are joined into one markup string so that an
                // expression can sit inside an HTML attribute.
                if (builder is { Length: > 0 })
                {
                    result.Add(new RenderSegment(builder.ToString(), null));
                    builder.Clear();
                }

                result.Add(new RenderSegment(null, child));
            }
        }

        if (builder is { Length: > 0 })
        {
            result.Add(new RenderSegment(builder.ToString(), null));
        }

        return result;
    }

    protected override void OnParametersSet()
    {
        // The lines follow the selection, which changes without new parameters.
        var selection = StructureEditor is not null ? Selection : null;
        if (!ReferenceEquals(selection, _subscribedSelection))
        {
            Unsubscribe();
            _subscribedSelection = selection;
            if (selection is not null)
            {
                selection.Changed += OnSelectionChanged;
            }
        }
    }

    private void OnSelectionChanged() => _ = UpdateAfterSelectionChangedAsync();

    private async Task UpdateAfterSelectionChangedAsync()
    {
        // The change also changes which widgets can be selected, such as the rows of a selected list, and they learn it
        // only with the render that follows it. The yield posts the rest after that render.
        await Task.Yield();
        if (_subscribedSelection is null)
        {
            return;
        }

        // Every content of the page is notified, and only one whose lines show or hide renders again.
        var isAtSelection = IsAtSelection();
        if (isAtSelection != _isAtSelection)
        {
            _isAtSelection = isAtSelection;
            StateHasChanged();
        }
    }

    // The content is at the selection when it is the page and nothing is selected, or when it is the content of
    // the selected widget or the content that holds the selected widget directly.
    private bool IsAtSelection()
    {
        if (StructureEditor is null || Content is null)
        {
            return false;
        }

        var contentOwner = Owner?.GetSelectableSelfOrAncestor();
        var selected = Selection?.Selected;
        return selected is null
            ? contentOwner is null
            : ReferenceEquals(selected, contentOwner) || ReferenceEquals(selected.SelectableAncestor, contentOwner);
    }

    // Runs once per render and remembers where the selection was for OnSelectionChanged. The editor is asked last, because
    // whether the content belongs to the page is a scan of its blocks.
    private bool ShowsInsertLines()
    {
        _isAtSelection = IsAtSelection();
        return _isAtSelection && StructureEditor!.CanInsertInto(Content!);
    }

    private void Unsubscribe()
    {
        if (_subscribedSelection is not null)
        {
            _subscribedSelection.Changed -= OnSelectionChanged;
            _subscribedSelection = null;
        }
    }

    public void Dispose() => Unsubscribe();

    private bool HasInvisibleWidget()
    {
        foreach (var child in Children!.Values)
        {
            if (IsInvisibleWidget(child))
            {
                return true;
            }
        }

        return false;
    }

    private bool IsInvisibleWidget(IInterceptorSubject subject) =>
        subject is not (HtmlSegment or RenderExpression) &&
        ComponentRegistry.GetComponent(subject.GetType(), SubjectComponentType.Widget)?.ComponentType is { } componentType &&
        typeof(IInvisibleWidget).IsAssignableFrom(componentType);
}
