@using BlazorMonaco
@using BlazorMonaco.Editor
@using HomeBlaze.Storage.Blazor.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor

@inject IJSRuntime JsRuntime
@inject IDialogService DialogService

@implements IAsyncDisposable

@* The Markdown of a block of text in an editor that fills the dialog. A refusal, such as text that changed meanwhile, shows
   above it and keeps what was typed, and so does a close: Escape and Cancel ask before they discard a change. *@
<MudDialog Class="markdown-text-dialog" ContentClass="markdown-text-dialog-content" DefaultFocus="DefaultFocus.None">
    <DialogContent>
        @* The dialog reports no Escape to its OnKeyDown, so the module of the editor watches the dialog for it, see
           watchEscape. The editor stops a key that it uses, such as an Escape that closes its suggestions. *@
        <div class="markdown-text-dialog-body" @ref="_body">
            @if (_refusal is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" data-testid="markdown-text-refusal">@_refusal</MudAlert>
            }

            <div class="markdown-text-editor" data-testid="markdown-text-input">
                <StandaloneCodeEditor @ref="_editor"
                                      Id="@EditorId"
                                      CssClass="markdown-text-editor-host"
                                      ConstructionOptions="GetEditorOptions"
                                      OnDidInit="OnEditorInitAsync"
                                      OnDidChangeModelContent="_contentChangedCallback"/>
            </div>
        </div>
        <MarkdownEditorStyles/>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_isSaving" OnClick="CancelAsync" data-testid="markdown-text-cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_isSaving" OnClick="SaveAsync" data-testid="markdown-text-save">Save</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* As high as MudBlazor lets a dialog be, so that the editor gets what the title, a refusal and the actions leave. */
    .mud-dialog.markdown-text-dialog {
        height: calc(100vh - var(--mud-appbar-height));
        height: calc(100dvh - var(--mud-appbar-height));
    }

    .markdown-text-dialog .markdown-text-dialog-content {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .markdown-text-dialog-body {
        display: contents;
    }

    .markdown-text-editor {
        position: relative;
        flex: 1 1 auto;
        min-height: 120px;
    }

    .markdown-text-editor-host {
        position: absolute;
        inset: 0;
    }
</style>

@code {
    private const string EditorId = "markdown-text-editor";

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The Markdown that the editor starts with.</summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>Whether the editor shows in the colors of the dark mode.</summary>
    [Parameter]
    public bool IsDarkMode { get; set; } = true;

    /// <summary>Saves the text and returns why it was not saved, or null when it was.</summary>
    [Parameter]
    public Func<string, Task<string?>> Save { get; set; } = default!;

    private StandaloneCodeEditor? _editor;
    private ElementReference _body;
    private Task<IJSObjectReference>? _moduleImport;
    private DotNetObjectReference<MarkdownTextDialog>? _reference;
    private IJSObjectReference? _escapeWatch;
    private string? _refusal;
    private bool _isSaving;

    // Raised for every typed character. The decorations go to the editor, and the dialog has nothing to render for them.
    private EventCallback<ModelContentChangedEvent> _contentChangedCallback;
    private bool _isCanceling;
    private bool _isDisposed;

    protected override void OnInitialized()
    {
        _contentChangedCallback = EventCallback.Factory.Create<ModelContentChangedEvent>(new NonRenderingReceiver(), OnContentChangedAsync);
    }

    private StandaloneEditorConstructionOptions GetEditorOptions(StandaloneCodeEditor editor)
    {
        var options = MarkdownEditor.CreateOptions(Text, IsDarkMode);
        options.Minimap = new EditorMinimapOptions { Enabled = false };
        return options;
    }

    private async Task OnEditorInitAsync()
    {
        if (_editor is null)
            return;

        // The keys work before the editor takes the focus, so that a key typed right away is not lost. CtrlCmd is Command on a
        // Mac and Control elsewhere.
        await _editor.AddCommand((int)KeyMod.CtrlCmd | (int)KeyCode.KeyS, arguments => _ = SaveByKeyAsync());
        if (await GetModuleAsync() is { } module)
        {
            await WatchEscapeAsync(module);
            await module.InvokeVoidAsync("focusEnd", EditorId);
            await DecorateAsync(module);
        }
    }

    private async Task OnContentChangedAsync(ModelContentChangedEvent change)
    {
        if (await GetModuleAsync() is { } module)
        {
            await DecorateAsync(module);
        }
    }

    // The module drops records of a version that is no longer current, and the change that made it newer decorates again.
    private async Task DecorateAsync(IJSObjectReference module)
    {
        if (await module.InvokeAsync<MarkdownEditorContent?>("getContent", EditorId) is not { } content || _isDisposed)
            return;

        var parsed = MarkdownDecorationParser.ParseDecorations(content.Text);
        var decorations = BlockOutlineDecorations.Create(parsed.Regions, parsed.Outlines);
        await module.InvokeVoidAsync("update", EditorId, content.Version, decorations.Values, decorations.Labels);
    }

    // Null once the dialog is disposed: the next text dialog gets the same editor id, and a late call would decorate its model.
    private async ValueTask<IJSObjectReference?> GetModuleAsync()
    {
        if (_isDisposed)
            return null;

        var moduleImport = _moduleImport ??= JsRuntime.InvokeAsync<IJSObjectReference>("import", MarkdownEditor.ModulePath).AsTask();
        try
        {
            var module = await moduleImport;
            return _isDisposed ? null : module;
        }
        catch (Exception exception) when (exception is JSException or OperationCanceledException)
        {
            // The next call imports again. Until then the editor has no decorations.
            if (_moduleImport == moduleImport)
            {
                _moduleImport = null;
            }

            return null;
        }
    }

    // A dispose while the watch starts would miss the watch and the reference, so they are let go here then.
    private async Task WatchEscapeAsync(IJSObjectReference module)
    {
        if (_escapeWatch is not null)
            return;

        var reference = DotNetObjectReference.Create(this);
        IJSObjectReference escapeWatch;
        try
        {
            escapeWatch = await module.InvokeAsync<IJSObjectReference>("watchEscape", _body, reference);
        }
        catch
        {
            reference.Dispose();
            throw;
        }

        if (_isDisposed)
        {
            await escapeWatch.InvokeVoidAsync("dispose");
            await escapeWatch.DisposeAsync();
            reference.Dispose();
            return;
        }

        _reference = reference;
        _escapeWatch = escapeWatch;
    }

    /// <summary>Called by the module of the editor for an Escape in the dialog that the editor did not take.</summary>
    [JSInvokable]
    public async Task CancelByEscapeAsync()
    {
        try
        {
            await CancelAsync();
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    // Ignored while a save runs, so that the write is never dropped without the dialog showing its outcome.
    private async Task CancelAsync()
    {
        if (_isSaving || _isCanceling || _editor is null || _isDisposed)
            return;

        _isCanceling = true;
        try
        {
            string text;
            try
            {
                text = await _editor.GetValue();
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException)
            {
                // The editor is gone, and with it what was typed.
                Dialog.Cancel();
                return;
            }

            if (_isDisposed)
                return;

            if (IsUnchanged(text) ||
                await DialogService.ShowMessageBoxAsync("Discard changes", "Discard your changes?", yesText: "Discard", cancelText: "Keep editing") == true)
            {
                Dialog.Cancel();
            }
        }
        finally
        {
            _isCanceling = false;
        }
    }

    private bool IsUnchanged(string text) =>
        string.Equals(text.ReplaceLineEndings("\n"), Text.ReplaceLineEndings("\n"), StringComparison.Ordinal);

    private async Task SaveAsync()
    {
        if (_isSaving || _isCanceling || _editor is null || _isDisposed)
            return;

        _isSaving = true;
        try
        {
            string text;
            try
            {
                text = await _editor.GetValue();
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException)
            {
                // Escape or Cancel closed the dialog and disposed the editor while it was read, so nothing is saved.
                return;
            }

            if (_isDisposed)
                return;

            _refusal = await Save(text);
            if (_refusal is null)
            {
                Dialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Monaco runs the command outside of an event handler of the dialog, so the save renders the dialog itself and hands a
    // failure to the renderer the way an event handler would.
    private async Task SaveByKeyAsync()
    {
        try
        {
            var save = SaveAsync();
            StateHasChanged();
            await save;
            StateHasChanged();
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        try
        {
            if (_escapeWatch is not null)
            {
                await _escapeWatch.InvokeVoidAsync("dispose");
                await _escapeWatch.DisposeAsync();
            }

            if (_moduleImport is not null)
            {
                await (await _moduleImport).DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSException or OperationCanceledException or JSDisconnectedException)
        {
            // The import failed or the circuit is gone, and there is nothing to dispose.
        }
        finally
        {
            _reference?.Dispose();
        }
    }

    // Runs a callback without rendering the component that created it.
    private sealed class NonRenderingReceiver : IHandleEvent
    {
        public Task HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);
    }

    /// <summary>Shows the dialog until the text is saved or the dialog is canceled.</summary>
    public static async Task ShowAsync(IDialogService dialogService, string title, string text, bool isDarkMode, Func<string, Task<string?>> save)
    {
        var parameters = new DialogParameters<MarkdownTextDialog>
        {
            { dialog => dialog.Text, text },
            { dialog => dialog.IsDarkMode, isDarkMode },
            { dialog => dialog.Save, save }
        };
        // Escape is handled by the dialog, which asks before it discards a change, and a click beside the dialog does nothing.
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false };
        var reference = await dialogService.ShowAsync<MarkdownTextDialog>(title, parameters, options);
        await reference.Result;
    }
}
