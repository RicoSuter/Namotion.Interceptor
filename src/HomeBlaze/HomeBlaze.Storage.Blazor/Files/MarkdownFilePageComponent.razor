@using HomeBlaze.Components.Abstractions
@using HomeBlaze.Components.Abstractions.Attributes
@using HomeBlaze.Storage.Files
@using MudBlazor
@using Namotion.Interceptor
@using HomeBlaze.Services
@using HomeBlaze.Components.Abstractions.TimeZones
@using Microsoft.JSInterop

@attribute [SubjectComponent(SubjectComponentType.Page, typeof(MarkdownFile))]

@implements ISubjectComponent
@implements IDisposable
@inject ITimeZoneDisplay TimeZone
@inject IJSRuntime JsRuntime

<CascadingValue Value="@IsEditing" Name="IsEditing">
    <div class="markdown-content" style="position: relative;">
        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <div class="markdown-page-toolbar" style="position: absolute; top: 0.5rem; right: 1rem; display: flex; gap: 0.5rem; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--mud-palette-text-secondary);">
                    @(File is { } file ? TimeZone.ToZoned(new DateTimeOffset(file.LastModified, TimeSpan.Zero)).ToString("yyyy-MM-dd HH:mm:ss") : "")
                </span>
            </div>
            <MarkdownContentView Children="@File?.Children" />
        }
    </div>
</CascadingValue>

<style>
    .markdown-content h1 { font-size: 2rem; font-weight: 500; margin: 1.5rem 0 1rem; }
    .markdown-content h2 { font-size: 1.5rem; font-weight: 500; margin: 1.25rem 0 0.75rem; }
    .markdown-content h3 { font-size: 1.25rem; font-weight: 500; margin: 1rem 0 0.5rem; }
    .markdown-content p { margin: 0.75rem 0; line-height: 1.6; }
    .markdown-content ul, .markdown-content ol { margin: 0.75rem 0; padding-left: 1.5rem; }
    .markdown-content li { margin: 0.25rem 0; }
    .markdown-content code { background: rgba(0,0,0,0.1); padding: 0.2em 0.4em; border-radius: 4px; font-family: monospace; }
    .markdown-content pre { background: rgba(0,0,0,0.1); padding: 1rem; border-radius: 8px; overflow-x: auto; margin: 1rem 0; }
    .markdown-content pre code { background: transparent; padding: 0; }
    .markdown-content table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    .markdown-content th, .markdown-content td { border: 1px solid rgba(128,128,128,0.3); padding: 0.5rem; text-align: left; }
    .markdown-content th { background: rgba(0,0,0,0.05); font-weight: 500; }
    .markdown-content blockquote { border-left: 4px solid rgba(128,128,128,0.3); margin: 1rem 0; padding-left: 1rem; color: var(--mud-palette-text-secondary); }
    .markdown-content img { max-width: 100%; height: auto; }
    .markdown-content img:not([width]) { max-height: 80vh; }
    .markdown-content a { color: var(--mud-palette-primary); text-decoration: none; }
    /* The dark primary is too dark for text on the page and on cards. */
    .homeblaze-dark-mode .markdown-content a { color: var(--mud-palette-primary-lighten); }
    .markdown-content a:hover { text-decoration: underline; }
    .markdown-content .markdown-block-error { border: 1px solid var(--mud-palette-error); color: var(--mud-palette-error); border-radius: 4px; padding: 0.5rem 0.75rem; margin: 0.75rem 0; font-family: monospace; font-size: 0.85rem; }
    /* The title makes room for the time of the last change in its corner, which stands above it. */
    .markdown-content > h1:first-of-type { padding-right: 9rem; }

    /* Only containers and the page create space; a widget has no outer margin of its own. The blocks of a page are
       1rem apart, from each other and from the text around them. */
    .markdown-content > .subject-component-wrapper { margin: 1rem 0; }

    /* The content of a container: a card body, a tab, an expansion panel, a layout cell, an alert or a Responsive. Its blocks
       and paragraphs are 1rem apart, and the padding of the container alone is the space at its edges. The two empty boxes
       cancel the outer margin of the first and of the last block in the collapsed margins, also when that block is hidden,
       like a Responsive for other screens, which a first-child rule would take for the first block. Content that is part
       of a widget, such as the value of a list row, keeps the margins of the page. */
    .markdown-content :is(.mud-card-content, .layout-cell, .grid-cell-content, .canvas-node-content, .mud-alert-message, [data-testid=responsive]) > .subject-component-wrapper > .markdown-fragment { display: flow-root; }
    .markdown-content :is(.mud-card-content, .layout-cell, .grid-cell-content, .canvas-node-content, .mud-alert-message, [data-testid=responsive]) > .subject-component-wrapper > .markdown-fragment > * { margin-top: 1rem; margin-bottom: 1rem; }
    .markdown-content :is(.mud-card-content, .layout-cell, .grid-cell-content, .canvas-node-content, .mud-alert-message, [data-testid=responsive]) > .subject-component-wrapper > .markdown-fragment::before,
    .markdown-content :is(.mud-card-content, .layout-cell, .grid-cell-content, .canvas-node-content, .mud-alert-message, [data-testid=responsive]) > .subject-component-wrapper > .markdown-fragment::after { content: ""; display: block; }
    .markdown-content :is(.mud-card-content, .layout-cell, .grid-cell-content, .canvas-node-content, .mud-alert-message, [data-testid=responsive]) > .subject-component-wrapper > .markdown-fragment::before { margin-bottom: -1rem; }
    .markdown-content :is(.mud-card-content, .layout-cell, .grid-cell-content, .canvas-node-content, .mud-alert-message, [data-testid=responsive]) > .subject-component-wrapper > .markdown-fragment::after { margin-top: -1rem; }

    /* A flow item whose content is one card: the card is as high as the row, as card-widget.css does for a card that is the
       content itself. A card that shares its item with other blocks keeps its own height. */
    .markdown-content .flow-layout-item > .subject-component-wrapper:has(> .markdown-fragment > .subject-component-wrapper:only-child > .card-widget:not(.card-widget-sized)),
    .markdown-content .flow-layout-item > .subject-component-wrapper > .markdown-fragment:has(> .subject-component-wrapper:only-child > .card-widget:not(.card-widget-sized)),
    .markdown-content .flow-layout-item > .subject-component-wrapper > .markdown-fragment > .subject-component-wrapper:only-child:has(> .card-widget:not(.card-widget-sized)),
    .markdown-content .flow-layout-item > .subject-component-wrapper > .markdown-fragment > .subject-component-wrapper:only-child > .card-widget:not(.card-widget-sized) { height: 100%; }

    /* The blocks of a card footer, such as buttons, stand in a row, and the footer padding is the space at its edges. */
    .markdown-content .card-widget > .mud-card-actions > .subject-component-wrapper > .markdown-fragment { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .markdown-content .card-widget > .mud-card-actions > .subject-component-wrapper > .markdown-fragment > * { margin: 0; }
</style>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    private const string ModulePath = "./_content/HomeBlaze.Storage.Blazor/Files/MarkdownFilePageComponent.razor.js";

    private MarkdownFile? File => Subject as MarkdownFile;

    private bool IsLoading => File?.Content is null;

    protected override void OnInitialized()
    {
        // The last-modified stamp is formatted through the display time zone, so re-render when it changes.
        TimeZone.Changed += OnTimeZoneChanged;
    }

    private void OnTimeZoneChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // The script keeps watching the pictures of every page of the tab, so its module is not kept here.
            await using var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await module.InvokeVoidAsync("watchPictures");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no page with pictures to watch.
        }
    }

    public void Dispose()
    {
        TimeZone.Changed -= OnTimeZoneChanged;
    }
}
