@using HomeBlaze.Components.Abstractions
@using HomeBlaze.Components.Abstractions.Attributes
@using HomeBlaze.Components.Abstractions.TimeZones
@using HomeBlaze.Authorization.Abstractions
@using HomeBlaze.Storage.Internal
@using Namotion.Interceptor

@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(RenderExpression))]
@implements ISubjectComponent
@inherits PermissionsComponentBase
@inject ITimeZoneDisplay TimeZone

@if (Expression?.Error is { } error)
{
    @error
}
else
{
    @Expression?.GetText(TimeZone, Permissions)
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    private RenderExpression? Expression => Subject as RenderExpression;
}
