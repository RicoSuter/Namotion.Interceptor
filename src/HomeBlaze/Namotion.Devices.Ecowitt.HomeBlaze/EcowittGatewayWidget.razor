@using Namotion.Interceptor

@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(EcowittGateway))]
@inherits PermissionsComponentBase
@implements ISubjectComponent

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Cloud" Class="mr-2" />
            <MudText Typo="Typo.h6">@(GatewaySubject?.Title ?? "Ecowitt Gateway")</MudText>
            <MudSpacer />
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(GatewaySubject?.IsConnected == true ? Color.Success : Color.Error)"
                     Variant="Variant.Filled">
                @(GatewaySubject?.IsConnected == true ? "Connected" : "Disconnected")
            </MudChip>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Spacing="4">
            @if (Shown(GatewaySubject?.OutdoorSensor) is { } outdoorSensor)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Temperature</MudText>
                    <MudText Typo="Typo.h5">@(outdoorSensor.Temperature?.ToString("F1") ?? "\u2014") °C</MudText>
                </MudStack>

                <MudStack>
                    <MudText Typo="Typo.caption">Humidity</MudText>
                    <MudText Typo="Typo.h5">@((outdoorSensor.Humidity * 100)?.ToString("F0") ?? "\u2014") %</MudText>
                </MudStack>

                @if (outdoorSensor.WindSpeed != null)
                {
                    <MudStack>
                        <MudText Typo="Typo.caption">Wind</MudText>
                        <MudText Typo="Typo.h5">@(outdoorSensor.WindSpeed?.ToString("F1") ?? "\u2014") m/s</MudText>
                    </MudStack>
                }
            }

            @if (Shown(GatewaySubject?.RainGauge) is { RainRate: > 0 } rainGauge)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Rain</MudText>
                    <MudText Typo="Typo.h5">@rainGauge.RainRate?.ToString("F1") mm/h</MudText>
                </MudStack>
            }
        </MudStack>

        <MudStack Row="true" Spacing="4">
            @if (GatewaySubject?.ChannelSensors.Count(sensor => Permissions.CanShow(sensor)) is > 0 and var channelCount)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Channels</MudText>
                    <MudText Typo="Typo.h5">@channelCount</MudText>
                </MudStack>
            }

            @if (Shown(GatewaySubject?.IndoorSensor) is { } indoorSensor)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Indoor</MudText>
                    <MudText Typo="Typo.h5">@(indoorSensor.Temperature?.ToString("F1") ?? "\u2014") °C</MudText>
                </MudStack>
            }
        </MudStack>

        @if (GatewaySubject?.HostAddress != null)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       Href="@($"http://{GatewaySubject.HostAddress}")"
                       Target="_blank"
                       Size="Size.Small">
                Open Web UI
            </MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    private EcowittGateway? GatewaySubject => Subject as EcowittGateway;

    // A sensor the roles hide renders as absent.
    private TSensor? Shown<TSensor>(TSensor? sensor)
        where TSensor : class, IInterceptorSubject =>
        sensor is not null && Permissions.CanShow(sensor) ? sensor : null;
}
