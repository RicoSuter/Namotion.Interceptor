@using Namotion.Interceptor

@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(ShellyDevice))]
@inherits PermissionsComponentBase
@implements ISubjectComponent

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" />
            <MudText Typo="Typo.h6">@(DeviceSubject?.Title ?? "Shelly Device")</MudText>
            <MudSpacer />
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(DeviceSubject?.IsConnected == true ? Color.Success : Color.Error)"
                     Variant="Variant.Filled">
                @(DeviceSubject?.IsConnected == true ? "Connected" : "Disconnected")
            </MudChip>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Spacing="4">
            @if (CountShown(DeviceSubject?.Switches) is > 0 and var switchCount)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Switches</MudText>
                    <MudText Typo="Typo.h5">@switchCount</MudText>
                </MudStack>
            }

            @if (CountShown(DeviceSubject?.Covers) is > 0 and var coverCount)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Covers</MudText>
                    <MudText Typo="Typo.h5">@coverCount</MudText>
                </MudStack>
            }

            @if (DeviceSubject?.EnergyMeter is { } energyMeter && Permissions.CanShow(energyMeter))
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Power</MudText>
                    <MudText Typo="Typo.h5">@(energyMeter.MeasuredPower?.ToString("F0") ?? "\u2014") W</MudText>
                </MudStack>
            }

            @if (CountShown(DeviceSubject?.Inputs) is > 0 and var inputCount)
            {
                <MudStack>
                    <MudText Typo="Typo.caption">Inputs</MudText>
                    <MudText Typo="Typo.h5">@inputCount</MudText>
                </MudStack>
            }
        </MudStack>

        @if (DeviceSubject?.HostAddress != null)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       Href="@($"http://{DeviceSubject.HostAddress}")"
                       Target="_blank"
                       Size="Size.Small">
                Open Web UI
            </MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    private ShellyDevice? DeviceSubject => Subject as ShellyDevice;

    // A component the roles hide is not counted.
    private int CountShown(IInterceptorSubject[]? components) =>
        components?.Count(component => Permissions.CanShow(component)) ?? 0;
}
