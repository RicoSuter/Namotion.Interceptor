@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(SonosPlayer))]
@inherits SonosWidgetBase

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Speaker" Class="mr-2" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Player?.RoomName</MudText>
                <MudText Typo="Typo.caption">@Player?.Model</MudText>
            </MudStack>
            <MudSpacer />
            @if (Player?.Source is { } source && source != SonosSource.None)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@source</MudChip>
            }
            @if (Player?.BatteryLevel is { } battery)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Icon="@(Player.IsCharging == true ? Icons.Material.Filled.BatteryChargingFull : Icons.Material.Filled.BatteryStd)">
                    @battery.ToString("P0")
                </MudChip>
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            @if (Player?.CurrentTrackImageUri is { } image && image != _failedImageUri)
            {
                @* The size is a style, because a page sets the height of its pictures and that overrides a height attribute. *@
                <img src="@image" alt="" class="rounded flex-shrink-0" style="width: 64px; height: 64px; object-fit: cover"
                     @onerror="@(() => _failedImageUri = image)" />
            }
            else
            {
                <div class="d-flex align-center justify-center rounded flex-shrink-0"
                     style="width: 64px; height: 64px; background-color: var(--mud-palette-action-default-hover)">
                    <MudIcon Icon="@(Player?.Source == SonosSource.Radio ? Icons.Material.Filled.Radio : Icons.Material.Filled.MusicNote)"
                             Class="mud-text-secondary" />
                </div>
            }
            <MudStack Spacing="0">
                <MudText Typo="Typo.body1">@SonosTrackText.GetTitleOrState(Player?.CurrentTrackTitle, Player?.SourceTitle, Player?.IsPlaying)</MudText>
                <MudText Typo="Typo.caption">@SonosTrackText.GetCaption(Player?.CurrentTrackArtist, Player?.CurrentTrackTitle, Player?.SourceTitle)</MudText>
            </MudStack>
        </MudStack>

        @if (Player is { } player)
        {
            var muteMethod = player.IsMuted == true ? nameof(SonosPlayer.UnmuteAsync) : nameof(SonosPlayer.MuteAsync);
            var canPrevious = CanRun(player, nameof(SonosPlayer.PreviousAsync));
            var canTogglePlayback = CanRun(player, nameof(SonosPlayer.TogglePlaybackAsync));
            var canNext = CanRun(player, nameof(SonosPlayer.NextAsync));
            var canMute = CanRun(player, muteMethod);
            var canSetVolume = CanRun(player, nameof(SonosPlayer.SetVolumeAsync));
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious" Disabled="@(!player.Previous_IsEnabled || !canPrevious)"
                               title="@(canPrevious ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-previous"
                               OnClick="@(() => RunAsync(player, nameof(SonosPlayer.PreviousAsync)))" />
                <MudIconButton Icon="@(player.IsPlaying == true ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                               Disabled="@(!player.TogglePlayback_IsEnabled || !canTogglePlayback)"
                               title="@(canTogglePlayback ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-toggle-playback"
                               OnClick="@(() => RunAsync(player, nameof(SonosPlayer.TogglePlaybackAsync)))" />
                <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Disabled="@(!player.Next_IsEnabled || !canNext)"
                               title="@(canNext ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-next"
                               OnClick="@(() => RunAsync(player, nameof(SonosPlayer.NextAsync)))" />
                <MudIconButton Icon="@(player.IsMuted == true ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                               Disabled="@(!(player.IsMuted == true ? player.Unmute_IsEnabled : player.Mute_IsEnabled) || !canMute)"
                               title="@(canMute ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-mute"
                               OnClick="@(() => RunAsync(player, muteMethod))" />
                <MudSlider T="int" Min="0" Max="100" Immediate="false" Class="flex-grow-1"
                           Disabled="@(!player.SetVolume_IsEnabled || !canSetVolume)"
                           title="@(canSetVolume ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-volume"
                           Value="@((int)((player.Volume ?? 0m) * 100m))"
                           ValueChanged="@(value => RunAsync(player, nameof(SonosPlayer.SetVolumeAsync), value / 100m))" />
            </MudStack>

            @if (player.HomeTheater is { } homeTheater)
            {
                var canSetNightMode = CanRun(homeTheater, nameof(SonosHomeTheater.SetNightModeAsync));
                var canSetSpeechEnhancement = CanRun(homeTheater, nameof(SonosHomeTheater.SetSpeechEnhancementAsync));
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudSwitch T="bool" Label="Night mode" Color="Color.Primary" Size="Size.Small"
                               Disabled="@(!homeTheater.SetNightMode_IsEnabled || !canSetNightMode)"
                               title="@(canSetNightMode ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-night-mode"
                               Value="@(homeTheater.NightMode == true)"
                               ValueChanged="@(value => RunAsync(homeTheater, nameof(SonosHomeTheater.SetNightModeAsync), value))" />
                    <MudSwitch T="bool" Label="Speech enhancement" Color="Color.Primary" Size="Size.Small"
                               Disabled="@(!homeTheater.SetSpeechEnhancement_IsEnabled || !canSetSpeechEnhancement)"
                               title="@(canSetSpeechEnhancement ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-speech-enhancement"
                               Value="@(homeTheater.SpeechEnhancement == true)"
                               ValueChanged="@(value => RunAsync(homeTheater, nameof(SonosHomeTheater.SetSpeechEnhancementAsync), value))" />
                </MudStack>
            }
        }
    </MudStack>
</MudPaper>

@code {
    private SonosPlayer? Player => Subject as SonosPlayer;

    // Some browsers block the speaker's plain HTTP art on an HTTPS page, and a browser outside the speakers' network
    // cannot reach it. The placeholder then stays until the art URI changes, so a failing image is not reloaded.
    private string? _failedImageUri;
}
