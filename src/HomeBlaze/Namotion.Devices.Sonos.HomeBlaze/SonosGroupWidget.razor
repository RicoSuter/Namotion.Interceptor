@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(SonosGroup))]
@inherits SonosWidgetBase

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.SpeakerGroup" Class="mr-2" />
            <MudText Typo="Typo.h6">@Group?.Title</MudText>
        </MudStack>

        <MudStack Row="true" Spacing="1">
            @foreach (var member in Group?.Members ?? [])
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@member.RoomName</MudChip>
            }
        </MudStack>

        <MudStack Spacing="0">
            <MudText Typo="Typo.body1">@SonosTrackText.GetTitleOrState(Group?.CurrentTrackTitle, Group?.SourceTitle, Group?.IsPlaying)</MudText>
            <MudText Typo="Typo.caption">@SonosTrackText.GetCaption(Group?.CurrentTrackArtist, Group?.CurrentTrackTitle, Group?.SourceTitle)</MudText>
        </MudStack>

        @if (Group is { } group)
        {
            var canTogglePlayback = CanRun(group, nameof(SonosGroup.TogglePlaybackAsync));
            var canSetVolume = CanRun(group, nameof(SonosGroup.SetVolumeAsync));
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIconButton Icon="@(group.IsPlaying == true ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                               Disabled="@(!group.TogglePlayback_IsEnabled || !canTogglePlayback)"
                               title="@(canTogglePlayback ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-toggle-playback"
                               OnClick="@(() => RunAsync(group, nameof(SonosGroup.TogglePlaybackAsync)))" />
                <MudSlider T="int" Min="0" Max="100" Immediate="false" Class="flex-grow-1"
                           Disabled="@(!group.SetVolume_IsEnabled || !canSetVolume)"
                           title="@(canSetVolume ? null : AccessDeniedTexts.Tooltip)" data-testid="sonos-volume"
                           Value="@((int)((group.Volume ?? 0m) * 100m))"
                           ValueChanged="@(value => RunAsync(group, nameof(SonosGroup.SetVolumeAsync), value / 100m))" />
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    private SonosGroup? Group => Subject as SonosGroup;
}
