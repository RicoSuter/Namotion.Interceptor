@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(HistoryChart))]
@implements ISubjectComponent
@implements IDisposable
@using HomeBlaze.Components.Abstractions
@using HomeBlaze.Components.Abstractions.Attributes
@using HomeBlaze.Components.Abstractions.TimeZones
@using HomeBlaze.History.Abstractions
@using HomeBlaze.Services
@using HomeBlaze.Services.Display
@using Namotion.Interceptor
@using Namotion.Interceptor.Registry.Abstractions
@using Microsoft.AspNetCore.Components.Rendering
@inject SubjectPathResolver PathResolver
@inject ITimeZoneDisplay TimeZone
@inject TimeProvider TimeProvider
@inject IInterceptorSubjectContext RootContext
@inject IDialogService DialogService

@if (Subject is HistoryChart chart)
{
    // The configuration and the current values are read on every render and the values are never kept: these
    // reads are what the page tracking scope records, so a change of a charted value renders the legend again,
    // and that render arms the refresh of the chart. The legends in the chart view are read in the same render batch.
    Resolve(chart);
    var height = chart.Height;

    <div data-testid="history-chart">
        @if (_error is not null)
        {
            @* The markup of WidgetArgumentError, which this project cannot reference. *@
            <MudAlert Severity="Severity.Error" Dense="true" data-testid="widget-argument-error">@_error</MudAlert>
        }
        else
        {
            @if (_queryError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" data-testid="history-chart-query-error">@_queryError</MudAlert>
            }
            else if (_hasStores is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_hasStores == true && _data is not null)
            {
                @* The view shows the legend of the lines below them and each band series in the header of its band. *@
                var linesTarget = CanShowHistory(_firstLine) ? _firstLine : -1;
                <HistoryChartView Data="_data" MaxHeight="height" ShowAxes="!chart.Compact" LineLegend="_lineLegend" BandHeader="_bandHeader"
                                  LinesClicked="@(linesTarget >= 0 ? _showHistory[linesTarget] : default)"
                                  LinesTitle="@(linesTarget >= 0 ? _historyTitles[linesTarget] : null)" />
            }

            @if (_queryError is not null || _hasStores != true || _data is null)
            {
                <div data-testid="history-chart-legend" style="@OwnLegendStyle">
                    @for (var index = 0; index < _series.Count; index++)
                    {
                        RenderLegendEntry(__builder, index, isBand: false);
                    }
                </div>
            }
        }
    </div>
}

@code {
    private const string MissingText = "–";
    private const string NoStoreNote = "no history store";
    private const string EntryStyle = "display:flex; align-items:center; gap:6px;";

    // The legend of the lines ends where the plot does, see HistoryChartView.LineLegend.
    private const string LegendStyle =
        "align-self:stretch; display:flex; gap:16px; flex-wrap:wrap; justify-content:flex-end; margin-right:var(--history-chart-plot-end, 0px);";

    // The legend of every series below the widget, while there is no chart view to hold it.
    private const string OwnLegendStyle = "align-self:stretch; display:flex; gap:16px; flex-wrap:wrap; margin-top:8px;";

    private HistoryRefreshThrottle? _throttle;
    private CancellationTokenSource? _queryCancellation;
    private HistoryChartData? _data;
    private bool? _hasStores;
    private string? _queryError;
    private TimeSpan? _bucket;
    private bool _skipNextArm;

    // The resolution of the series, kept until the configuration or the paths of the graph change, because the
    // legend renders on every change of a charted value.
    private HistoryChartSeries[]? _resolvedEntries;
    private (string? Path, string? Label, string? Color)[] _resolvedConfiguration = [];
    private string? _resolvedRange;
    private string? _resolvedBucket;
    private int _resolvedPathsVersion = -1;
    private IReadOnlyList<HistoryChartSeriesInfo> _series = [];
    private string?[] _colors = [];
    private string?[] _swatchStyles = [];
    private string? _error;

    // Built with the series, so a render allocates none: the first recorded line, which a click on the lines shows,
    // and for every series what opens its history and the tooltip that says so.
    private int _firstLine = -1;
    private EventCallback[] _showHistory = [];
    private string[] _historyTitles = [];

    // The series the shown data was queried for, and the index in them of the series of each band of the data.
    private IReadOnlyList<HistoryChartSeriesInfo>? _dataSeries;
    private int[] _bandSeries = [];
    private bool[] _hasBand = [];

    // One fragment per band of the shown data, built with it, so a render allocates none.
    private RenderFragment[] _bandHeaders = [];

    private readonly RenderFragment _lineLegend;
    private readonly RenderFragment<int> _bandHeader;

    // Set when a render resolved other series, range or bucket than the last query used.
    private bool _isQueryOutdated;

    // Incremented on the thread that changes the graph.
    private int _pathsVersion;

    // Read on a timer thread by OnRefreshDue.
    private volatile bool _isDisposed;

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    // In edit mode a click selects the widget, so nothing opens the history.
    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    public HistoryChartWidget()
    {
        _lineLegend = RenderLineLegend;
        _bandHeader = GetBandHeader;
    }

    // Every series without a band in the shown data: the lines, and a band series that has no band, such as one
    // without history, so its note stays in view.
    private void RenderLineLegend(RenderTreeBuilder __builder)
    {
        var bandsMatch = ReferenceEquals(_dataSeries, _series);
        var hasEntries = false;
        for (var index = 0; index < _series.Count && !hasEntries; index++)
        {
            hasEntries = !bandsMatch || !_hasBand[index];
        }

        if (hasEntries)
        {
            <div data-testid="history-chart-legend" style="@LegendStyle">
                @for (var index = 0; index < _series.Count; index++)
                {
                    if (!bandsMatch || !_hasBand[index])
                    {
                        RenderLegendEntry(__builder, index, isBand: false);
                    }
                }
            </div>
        }
    }

    private RenderFragment GetBandHeader(int band) => _bandHeaders[band];

    // Until the series of a changed configuration are queried, a band cannot be matched to its series and shows its label.
    private void RenderBandHeader(RenderTreeBuilder __builder, int band)
    {
        if (ReferenceEquals(_dataSeries, _series))
        {
            RenderLegendEntry(__builder, _bandSeries[band], isBand: true);
        }
        else if (_data is { } data)
        {
            <MudText Typo="Typo.caption">@data.Bands[band].Label</MudText>
        }
    }

    private void RenderLegendEntry(RenderTreeBuilder __builder, int index, bool isBand)
    {
        if (CanShowHistory(index))
        {
            <button type="button" class="history-chart-legend-button" data-testid="history-chart-legend-entry" style="@EntryStyle"
                    title="@_historyTitles[index]" @onclick="_showHistory[index]">
                @{ RenderLegendEntryContent(__builder, index, isBand); }
            </button>
        }
        else
        {
            <div data-testid="history-chart-legend-entry" style="@EntryStyle">
                @{ RenderLegendEntryContent(__builder, index, isBand); }
            </div>
        }
    }

    private void RenderLegendEntryContent(RenderTreeBuilder __builder, int index, bool isBand)
    {
        var entry = _series[index];
        var property = entry.Property;
        var value = property?.GetValue();
        var text = property is null || value is null ? MissingText : property.GetPropertyDisplayValue(value, TimeZone);
        var note = entry.Note ?? (_hasStores == false ? NoStoreNote : null);

        if (isBand)
        {
            @* The colon sits outside the label, which is found by its exact text. *@
            <span style="display:inline-flex;">
                <MudText Typo="Typo.caption">@entry.Label</MudText><MudText Typo="Typo.caption">:</MudText>
            </span>
        }
        else
        {
            if (_swatchStyles[index] is { } swatchStyle)
            {
                <span aria-hidden="true" style="@swatchStyle"></span>
            }
            <MudText Typo="Typo.caption">@entry.Label</MudText>
        }
        <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="history-chart-legend-value">@text</MudText>
        if (note is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="history-chart-legend-note">(@note)</MudText>
        }
    }

    private bool CanShowHistory(int index) =>
        !IsEditing && _hasStores == true && index >= 0 && _series[index] is { HasHistory: true, Property: not null };

    private async Task ShowHistoryAsync(HistoryChartSeriesInfo entry)
    {
        if (IsEditing || entry.Property is not { } property || RootContext.TryGetService<ISubjectRegistry>() is not { } registry)
        {
            return;
        }

        await PropertyHistoryDialog.ShowAsync(DialogService, registry, PathResolver, property, entry.Label);
    }

    protected override void OnInitialized()
    {
        _throttle = new HistoryRefreshThrottle(TimeProvider, OnRefreshDue);
        PathResolver.PathsChanged += OnPathsChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // The first query runs after the first interactive render, never while prerendering. A changed
        // configuration queries at once rather than at the end of the next window.
        if (firstRender || _isQueryOutdated)
        {
            _isQueryOutdated = false;
            QueueRefresh();
            return;
        }

        // The render that shows a new result is no change of a value.
        if (_skipNextArm)
        {
            _skipNextArm = false;
            return;
        }

        if (_error is null && Subject is HistoryChart chart)
        {
            _throttle?.Arm(HistoryRefreshThrottle.GetWindow(chart.RefreshInterval, _bucket));
        }
    }

    private void Resolve(HistoryChart chart)
    {
        var entries = chart.Series;
        var range = chart.Range;
        var bucket = chart.Bucket;
        var pathsVersion = Volatile.Read(ref _pathsVersion);

        // Every entry is read even when an earlier one differs, so the tracking scope records all of them.
        var isCurrent = ReferenceEquals(entries, _resolvedEntries) &&
            pathsVersion == _resolvedPathsVersion &&
            range == _resolvedRange &&
            bucket == _resolvedBucket &&
            entries.Length == _resolvedConfiguration.Length;
        for (var index = 0; index < entries.Length; index++)
        {
            var entry = entries[index];
            var configuration = (entry.Path, entry.Label, entry.Color);
            isCurrent &= index < _resolvedConfiguration.Length && _resolvedConfiguration[index] == configuration;
        }

        if (isCurrent)
        {
            return;
        }

        var configurations = new (string? Path, string? Label, string? Color)[entries.Length];
        for (var index = 0; index < entries.Length; index++)
        {
            var entry = entries[index];
            configurations[index] = (entry.Path, entry.Label, entry.Color);
        }

        var series = HistoryChartSeriesResolver.Resolve(PathResolver, chart);
        var error = HistoryChartSeriesResolver.FindArgumentError(range, bucket, series);

        // A change of the graph that leaves the series as they were, which is the common case, does not query again.
        var seriesChanged = !series.SequenceEqual(_series);
        _isQueryOutdated |= error != _error ||
            range != _resolvedRange ||
            bucket != _resolvedBucket ||
            seriesChanged;

        _resolvedEntries = entries;
        _resolvedConfiguration = configurations;
        _resolvedRange = range;
        _resolvedBucket = bucket;
        _resolvedPathsVersion = pathsVersion;
        _error = error;
        if (!seriesChanged)
        {
            // The same instance, so the bands of the shown data still match their series, see _dataSeries.
            return;
        }

        _series = series;
        _firstLine = HistoryChartSeriesResolver.FindFirstRecordedLine(series);
        _showHistory = new EventCallback[series.Count];
        _historyTitles = new string[series.Count];
        for (var index = 0; index < series.Count; index++)
        {
            var entry = series[index];
            _showHistory[index] = EventCallback.Factory.Create(this, () => ShowHistoryAsync(entry));
            _historyTitles[index] = $"Show history of {entry.Label}";
        }

        _colors = HistoryChartSeriesResolver.AssignLineColors(series);
        _swatchStyles = new string?[_colors.Length];
        for (var index = 0; index < _colors.Length; index++)
        {
            if (_colors[index] is { } color)
            {
                _swatchStyles[index] = $"width:12px; height:3px; border-radius:1px; background:{color};";
            }
        }
    }

    // Runs on the thread that changes the graph, inside the lock of the lifecycle interceptor: it only notes the change,
    // and the page renders after a change of the paths.
    private void OnPathsChanged() => Interlocked.Increment(ref _pathsVersion);

    // Runs on a timer thread under the lock of the throttle (see the remarks of HistoryRefreshThrottle).
    private void OnRefreshDue() => QueueRefresh();

    // Every query starts on the thread pool without an execution context, never inline: after a render and in the
    // throttle callback the execution context is the one of a render, which can hold the read recorder of the page
    // tracking scope, and InvokeAsync runs inline on an idle dispatcher, so the query would also run under the lock
    // of the throttle.
    private void QueueRefresh()
    {
        if (_isDisposed)
        {
            return;
        }

        ThreadPool.UnsafeQueueUserWorkItem(static widget => widget.PostRefresh(), this, preferLocal: false);
    }

    private void PostRefresh()
    {
        if (_isDisposed)
        {
            return;
        }

        _ = InvokeAsync(RefreshAsync);
    }

    private async Task RefreshAsync()
    {
        _isQueryOutdated = false;
        if (_isDisposed || Subject is not HistoryChart || _error is not null)
        {
            return;
        }

        // A newer query supersedes this one, and disposing the widget cancels it.
        _queryCancellation?.Cancel();
        _queryCancellation?.Dispose();
        _queryCancellation = new CancellationTokenSource();
        var cancellationToken = _queryCancellation.Token;

        // Everything that can throw is inside the try: this runs from a discarded task, so an exception that
        // escapes is never observed and the widget would show nothing.
        try
        {
            PropertyHistoryChartModel.TryGetRange(_resolvedRange, out var range);
            PropertyHistoryChartModel.TryGetPeriod(_resolvedBucket, out var period);

            var stores = RootContext.TryGetService<ISubjectRegistry>()?.KnownSubjects.Keys.OfType<IHistoryStore>().ToArray() ?? [];
            _hasStores = stores.Length > 0;
            if (stores.Length == 0)
            {
                _skipNextArm = true;
                StateHasChanged();
                return;
            }

            var storeAggregations = new HashSet<string>(StringComparer.Ordinal);
            foreach (var store in stores)
            {
                storeAggregations.UnionWith(store.SupportedAggregations);
            }

            var series = _series;
            var requests = new List<HistoryChartSeriesRequest>(series.Count);
            var bandSeries = new List<int>();
            var hasBand = new bool[series.Count];
            for (var index = 0; index < series.Count; index++)
            {
                var entry = series[index];
                if (entry.Property is not { } property || !entry.HasHistory || property.GetHistoryPath(PathResolver) is not { } path)
                {
                    continue;
                }

                var isBand = entry.Kind == HistoryChartSeriesKind.Band;
                if (isBand)
                {
                    // The query returns one band per band request, in request order.
                    bandSeries.Add(index);
                    hasBand[index] = true;
                }

                var aggregation = HistoryChartSeriesResolver.ChooseAggregation(
                    property.Type, isBand, entry.IsCumulative, period.IsRaw, storeAggregations);
                requests.Add(new HistoryChartSeriesRequest(path, entry.Label, property.Type, isBand, aggregation, _colors[index], entry.Unit));
            }

            var to = TimeProvider.GetUtcNow();
            var from = to - range;
            var bucket = PropertyHistoryChartModel.ResolveBucket(period, range, HistoryChartQuery.GetAvailableCoverage(stores, to));
            var result = await HistoryChartQuery.QueryAsync(stores, requests, from, to, bucket, cancellationToken);
            if (cancellationToken.IsCancellationRequested || _isDisposed)
            {
                return;
            }

            _data = result.Data;
            _dataSeries = series;
            _bandSeries = bandSeries.ToArray();
            _hasBand = hasBand;
            _bandHeaders = new RenderFragment[_bandSeries.Length];
            for (var band = 0; band < _bandHeaders.Length; band++)
            {
                var captured = band;
                _bandHeaders[band] = builder => RenderBandHeader(builder, captured);
            }

            _bucket = bucket;
            _queryError = null;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            if (cancellationToken.IsCancellationRequested || _isDisposed)
            {
                return;
            }

            _queryError = "Could not load history: " + exception.Message;
        }

        _skipNextArm = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        _isDisposed = true;
        PathResolver.PathsChanged -= OnPathsChanged;
        _throttle?.Dispose();

        // Cancel before disposing: disposing does not cancel the token of a running query.
        _queryCancellation?.Cancel();
        _queryCancellation?.Dispose();
    }
}
