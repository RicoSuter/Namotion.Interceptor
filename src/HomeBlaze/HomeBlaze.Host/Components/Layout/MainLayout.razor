@using HomeBlaze.Components.Abstractions.Pages
@using HomeBlaze.Host.Components.Browser
@using HomeBlaze.Host.Components.TimeZones

@inherits LayoutComponentBase

@inject DeveloperModeService DeveloperMode
@inject RootManager RootManager
@inject NavigationItemResolver NavigationResolver
@inject NavigationManager NavigationManager

@implements IDisposable

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode"/>

@* MudBlazor marks no element with the mode, so styles that differ by mode beyond the palette scope to this class. It wraps
   the providers too, because dialogs, popovers and snackbars render there and not inside the layout. *@
<div class="@(_isDarkMode ? DarkModeClass : null)" style="display: contents">
    <MudPopoverProvider/>
    <MudDialogProvider/>
    <MudSnackbarProvider/>

    <CascadingValue Value="@_isDarkMode" Name="IsDarkMode">
        <MudLayout>
            <TimeZoneInitializer />
            <PropertyRowLayoutInitializer />
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@(_ => DrawerToggle())"/>
                @foreach (var item in GetAppBarItems(AppBarAlignment.Left))
                {
                    <MudIconButton Icon="@SubjectIconExtensions.ResolveMudBlazorIcon(item.Icon)"
                                   Href="@item.PageUrl"
                                   Color="@(IsActive(item) ? Color.Primary : Color.Inherit)"
                                   title="@item.Title"/>
                }
                <MudSpacer/>
                @foreach (var item in GetAppBarItems(AppBarAlignment.Right))
                {
                    <MudIconButton Icon="@SubjectIconExtensions.ResolveMudBlazorIcon(item.Icon)"
                                   Href="@item.PageUrl"
                                   Color="@(IsActive(item) ? Color.Primary : Color.Inherit)"
                                   title="@item.Title"/>
                }
                <MudIconButton Icon="@(DeveloperModeIcon)"
                               Color="@(DeveloperMode.IsEnabled ? Color.Success : Color.Inherit)"
                               OnClick="@DeveloperMode.Toggle"
                               title="Toggle Developer Mode"/>
                <TimeZoneSelector />
                <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle"
                               title="Toggle Dark Mode"/>
                <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End"/>
            </MudAppBar>
            <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                <NavMenu Root="@RootManager.Root"/>
            </MudDrawer>
            <MudMainContent Class="pt-16 px-4 pt-4">
                @if (_isRootLoaded || IsErrorPage)
                {
                    @Body
                }
                else if (_rootLoadFailed)
                {
                    <MudAlert Severity="Severity.Error">
                        The configuration could not be loaded. See the server log for details.
                    </MudAlert>
                }
                else
                {
                    <div class="d-flex flex-column justify-center align-center" style="height: calc(100vh - 128px);">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                        <MudText Class="mt-4">Loading configuration...</MudText>
                    </div>
                }
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string DarkModeClass = "homeblaze-dark-mode";

    private readonly CancellationTokenSource _disposalTokenSource = new();

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme;
    private bool _isRootLoaded;
    private bool _rootLoadFailed;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        DeveloperMode.OnChange += OnStateHasChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        _isRootLoaded = RootManager.RootLoaded.IsCompletedSuccessfully;

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isRootLoaded)
        {
            return;
        }

        // Not in OnInitializedAsync: prerendering withholds the response until every initialization task completes.
        try
        {
            await RootManager.RootLoaded.WaitAsync(_disposalTokenSource.Token);
            _isRootLoaded = true;
        }
        catch (OperationCanceledException) when (_disposalTokenSource.IsCancellationRequested || RootManager.RootLoaded.IsCanceled)
        {
            // Either this component or the host is going away, so there is nothing to report. A
            // cancellation from anywhere else is a failed load and falls through to the alert.
            return;
        }
        catch (Exception)
        {
            _rootLoadFailed = true;
        }

        StateHasChanged();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    // Three levels with equal steps in lightness: the drawer, the page background and the surfaces of cards,
    // tiles and tab bars. The secondary text and the primary colour of the light palette are darker than the
    // defaults, which are below 4.5:1 on the page background and on the active drawer link. The status colours
    // are darker for the same reason: as text on the page and on alerts, and behind the white text of filled
    // buttons and chips. The outline of inputs reaches 3:1 on cards.
    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#3f2ddd",
        AppbarBackground = "#3f2ddd",
        Background = "#e9eaee",
        BackgroundGray = "#d5d5dc",
        DrawerBackground = "#d5d5dc",
        TextSecondary = "rgba(0,0,0,0.6)",
        Info = "#0a6ab6",
        InfoDarken = "#085592",
        Success = "#007932",
        SuccessDarken = "#005322",
        Warning = "#965a00",
        WarningDarken = "#704300",
        Error = "#cd180b",
        ErrorDarken = "#a91409",
        LinesInputs = "rgba(0,0,0,0.45)",
        Divider = "rgba(0,0,0,0.12)"
    };

    // Links on pages use the lightened primary colour, which is lighter than the computed default so that it
    // reaches 4.5:1 on the surface of cards, as does the secondary text. The outline of inputs reaches 3:1 on
    // cards. The darker status tones keep their defaults for the hover of filled buttons, so text in a status
    // colour, such as that of alerts, gets the lightened tone in app.css, which reaches 4.5:1 on cards.
    private readonly PaletteDark _darkPalette = new()
    {
        PrimaryLighten = "#a29aef",
        InfoLighten = "#90caf9",
        SuccessLighten = "#0dde9c",
        WarningLighten = "#ffb624",
        ErrorLighten = "#ffaba4",
        Background = "#2a2b32",
        BackgroundGray = "#1f1f25",
        AppbarBackground = "#1f1f25",
        DrawerBackground = "#1f1f25",
        TextSecondary = "rgba(255,255,255,0.55)",
        LinesInputs = "rgba(255,255,255,0.4)"
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };

    public string DeveloperModeIcon => DeveloperMode.IsEnabled
        ? Icons.Material.Filled.DeveloperMode
        : Icons.Material.Outlined.DeveloperMode;

    public void Dispose()
    {
        DeveloperMode.OnChange -= OnStateHasChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;

        _disposalTokenSource.Cancel();
        _disposalTokenSource.Dispose();
    }

    private void OnStateHasChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<NavigationItem> GetAppBarItems(AppBarAlignment alignment)
    {
        if (RootManager.Root == null)
            return Enumerable.Empty<NavigationItem>();

        return NavigationResolver.GetChildItems(RootManager.Root)
            .Where(item => item.Location == NavigationLocation.AppBar && item.IsPage && item.Alignment == alignment);
    }

    // The error page is shown exactly when the system is unhealthy, so it must render even if the
    // root never loads.
    private bool IsErrorPage => NavigationManager
        .ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("Error", StringComparison.OrdinalIgnoreCase);

    private bool IsActive(NavigationItem item)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return currentPath.Equals(item.PageUrl, StringComparison.OrdinalIgnoreCase);
    }
}
