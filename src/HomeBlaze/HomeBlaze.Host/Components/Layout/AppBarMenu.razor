@using HomeBlaze.Components.Abstractions.TimeZones
@using HomeBlaze.Host.Components.TimeZones

@inject DeveloperModeService DeveloperMode
@inject NavigationManager NavigationManager
@inject ITimeZoneDisplay TimeZone

@implements IDisposable

@* The circuit sets data-time-zone once it has resolved the zone of the browser, so it also tells that the page is interactive. *@
<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AriaLabel="Open menu" title="Menu"
         Class="app-bar-menu" ListClass="app-bar-menu-list"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
         data-testid="app-bar-menu" data-time-zone="@TimeZoneSelector.GetCurrentLabel(TimeZone)">
    @if (Pages.Count > 0)
    {
        @foreach (var item in Pages)
        {
            <MudMenuItem Icon="@SubjectIconExtensions.ResolveMudBlazorIcon(item.Icon)" Href="@item.PageUrl"
                         Class="@(IsActive(item) ? "app-bar-menu-page active" : "app-bar-menu-page")"
                         aria-current="@(IsActive(item) ? "page" : null)">
                @item.Title
            </MudMenuItem>
        }
        <MudDivider/>
    }
    <MudMenuItem Icon="@DeveloperModeIcon" IconColor="@(DeveloperMode.IsEnabled ? Color.Success : Color.Default)"
                 OnClick="@DeveloperMode.Toggle" AutoClose="false"
                 role="menuitemcheckbox" aria-checked="@(DeveloperMode.IsEnabled ? "true" : "false")"
                 data-testid="app-bar-menu-developer-mode">
        <span class="d-flex align-center justify-space-between gap-4">
            <span>Developer mode</span>
            <MudIcon Icon="@ToggleIcon(DeveloperMode.IsEnabled)" Color="@(DeveloperMode.IsEnabled ? Color.Success : Color.Default)"/>
        </span>
    </MudMenuItem>
    <TimeZoneSelector/>
    <MudMenuItem Icon="@(IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Outlined.DarkMode)"
                 OnClick="@OnToggleDarkMode" AutoClose="false"
                 role="menuitemcheckbox" aria-checked="@(IsDarkMode ? "true" : "false")"
                 data-testid="app-bar-menu-dark-mode">
        <span class="d-flex align-center justify-space-between gap-4">
            <span>Dark mode</span>
            <MudIcon Icon="@ToggleIcon(IsDarkMode)" Color="@(IsDarkMode ? Color.Success : Color.Default)"/>
        </span>
    </MudMenuItem>
    @* An app started from the home screen has no address bar, so these two stand in for its reload button and address. *@
    <MudDivider/>
    <MudMenuItem Icon="@Icons.Material.Filled.Home" Href="/" data-testid="app-bar-menu-home">Home</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="@Reload" data-testid="app-bar-menu-reload">Reload</MudMenuItem>
</MudMenu>

@code {
    /// <summary>The pages with <c>alignment: Menu</c>, in the order the menu lists them.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<NavigationItem> Pages { get; set; } = [];

    /// <summary>Whether the dark mode is on.</summary>
    [Parameter]
    public bool IsDarkMode { get; set; }

    /// <summary>Raised when the dark mode entry is clicked.</summary>
    [Parameter]
    public EventCallback OnToggleDarkMode { get; set; }

    private string DeveloperModeIcon => DeveloperMode.IsEnabled
        ? Icons.Material.Filled.DeveloperMode
        : Icons.Material.Outlined.DeveloperMode;

    private static string ToggleIcon(bool isOn) => isOn
        ? Icons.Material.Filled.ToggleOn
        : Icons.Material.Filled.ToggleOff;

    protected override void OnInitialized()
    {
        DeveloperMode.OnChange += OnDeveloperModeChanged;
    }

    private bool IsActive(NavigationItem item) => MainLayout.IsActive(NavigationManager, item);

    private void Reload() => NavigationManager.Refresh(forceReload: true);

    private void OnDeveloperModeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DeveloperMode.OnChange -= OnDeveloperModeChanged;
    }
}
