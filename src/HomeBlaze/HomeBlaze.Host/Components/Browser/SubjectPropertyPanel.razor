@using HomeBlaze.Abstractions.Attributes
@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.History.Abstractions
@using HomeBlaze.History
@using HomeBlaze.History.Blazor
@using HomeBlaze.Components.Operations
@using HomeBlaze.Storage.Abstractions
@using HomeBlaze.Components.Abstractions.TimeZones

@implements IAsyncDisposable

@inject IDialogService DialogService
@inject SubjectComponentRegistry ComponentRegistry
@inject SubjectPathResolver PathResolver
@inject IServiceProvider ServiceProvider
@inject ITimeZoneDisplay TimeZone
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

@if (Subject != null)
{
    @* The header stays in place and the content below it scrolls. *@
    <div @ref="_rootElement" style="display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); height: 100%;">
        <div style="display: flex; flex-direction: column; height: 100%;">
            <MudListSubheader Class="d-flex align-center gap-1" Style="flex-shrink: 0;">
                @{
                    var canEdit = CanEdit();
                    var canDelete = Subject is IStorageFile or IConfigurable;
                }

                @* Stays an h1: the page focuses the first h1 after navigation. *@
                <MudText Typo="Typo.h6" HtmlTag="h1" Class="flex-grow-1 mud-typography-nowrap">
                    <MudIcon Size="Size.Small" Icon="@GetSubjectIcon(Subject)" Color="@GetSubjectIconColor(Subject)" Class="mr-2" Style="vertical-align: middle;" />
                    @GetSubjectTitle()
                </MudText>

                @if (canEdit)
                {
                    <MudTooltip Text="Edit">
                        <MudIconButton OnClick="@OpenEditDialog"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Text"
                                       Size="Size.Small"
                                       aria-label="Edit"
                                       data-testid="edit-subject-button" />
                    </MudTooltip>
                }
                @if (canDelete)
                {
                    <MudTooltip Text="Delete">
                        <MudIconButton OnClick="@(() => OnDelete.InvokeAsync())"
                                       Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Text"
                                       Size="Size.Small"
                                       aria-label="Delete" />
                    </MudTooltip>
                }
                @if (CanClose)
                {
                    @if (canEdit || canDelete)
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-1" />
                    }

                    @* The color comes from the root of the tooltip: its class on the button loses to that of an icon button. *@
                    <MudTooltip Text="Close" RootClass="mud-text-primary">
                        <MudIconButton OnClick="@(() => OnClose.InvokeAsync())"
                                       Icon="@Icons.Material.Filled.Close"
                                       Variant="Variant.Text"
                                       Color="Color.Inherit"
                                       Size="Size.Medium"
                                       Class="pa-1"
                                       aria-label="Close"
                                       data-testid="close-pane-button" />
                    </MudTooltip>
                }
            </MudListSubheader>

            @* Each block gets the gap above it from GetGapClass, by the block before it. *@
            <div data-testid="subject-pane-content" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden;">
                @{
                    var members = GetMemberGroups();
                    var previousBlock = PaneBlock.None;
                }
                @* Child Collections *@
                @foreach (var section in GetChildSections())
                {
                    var sectionGapClass = GetGapClass(previousBlock, PaneBlock.Section);
                    previousBlock = PaneBlock.Section;

                    @if (section.CollectionProperty is null)
                    {
                        @* Consecutive single child references share one list *@
                        <MudList T="object" SelectedValue="SelectedChild" Color="Color.Primary" Dense="true" Class="@sectionGapClass">
                            @foreach (var (property, child) in section.SingleChildren)
                            {
                                var isSelected = child.Subject == SelectedChild;
                                var childCount = GetChildCount(child);

                                <MudListItem Value="@child.Subject"
                                             OnClick="@(() => OnPropertyClick.InvokeAsync(new PropertyClickEventArgs(property.Name, child.Index, child.Subject)))"
                                             Icon="@GetSubjectIcon(child.Subject)"
                                             IconColor="@(isSelected ? Color.Primary : GetSubjectIconColor(child.Subject))"
                                             Class="@(isSelected ? "mud-primary-text" : "")">
                                    @if (isSelected)
                                    {
                                        <div style="float: right; line-height: 0">
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                        </div>
                                    }
                                    <span class="subject-pane-child-name" style="word-break: break-word;">@property.GetChildDisplayName(child)</span>
                                    @if (childCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="ml-4 my-0">@childCount</MudChip>
                                    }
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    }
                    else
                    {
                        var property = section.CollectionProperty;
                        var children = section.CollectionChildren;
                        @* mb-0, as MudBlazor gives an expanded panel a margin of 16px above and below. *@
                        <MudExpansionPanel Gutters="false" Dense="true" Expanded="true" Class="@($"{sectionGapClass} mb-0")" HeaderClass="px-4 subject-pane-section-header">
                            <TitleContent>
                                @GetPropertyDisplayName(property)
                                <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="my-0">@children.Length</MudChip>
                            </TitleContent>
                            <ChildContent>
                                <MudList T="object" SelectedValue="SelectedChild" Color="Color.Primary" Dense="true">
                                    @foreach (var child in children)
                                    {
                                        var isSelected = child.Subject == SelectedChild;
                                        var childCount = GetChildCount(child);

                                        <MudListItem Value="@child.Subject"
                                                     OnClick="@(() => OnPropertyClick.InvokeAsync(new PropertyClickEventArgs(property.Name, child.Index, child.Subject)))"
                                                     Icon="@GetSubjectIcon(child.Subject)"
                                                     IconColor="@(isSelected ? Color.Primary : GetSubjectIconColor(child.Subject))"
                                                     Class="@(isSelected ? "mud-primary-text" : "")">
                                            @if (isSelected)
                                            {
                                                <div style="float: right; line-height: 0">
                                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                                </div>
                                            }
                                            <span class="subject-pane-child-name" style="word-break: break-word;">@property.GetChildDisplayName(child)</span>
                                            @if (childCount > 0)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="ml-4 my-0">@childCount</MudChip>
                                            }
                                        </MudListItem>
                                        <MudDivider />
                                    }
                                </MudList>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                }

                @* Primitive properties and methods (operations and queries) without a category *@
                @if (members.UncategorizedValues.Count > 0)
                {
                    @RenderValues(members.UncategorizedValues, GetGapClass(previousBlock, PaneBlock.Values))
                    previousBlock = PaneBlock.Values;
                }
                @if (members.UncategorizedMethods.Count > 0)
                {
                    @RenderMethods(members.UncategorizedMethods, GetGapClass(previousBlock, PaneBlock.Methods))
                    previousBlock = PaneBlock.Methods;
                }

                @* Categories: the values of a category and its methods below them *@
                @foreach (var category in members.Categories)
                {
                    <div class="@GetGapClass(previousBlock, PaneBlock.Category)" data-testid="subject-pane-category">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" HtmlTag="h2" Class="px-4"
                                 data-testid="subject-pane-category-title">@category.Name</MudText>
                        @if (category.Values.Count > 0)
                        {
                            @RenderValues(category.Values, GetGapClass(PaneBlock.CategoryTitle, PaneBlock.Values))
                        }
                        @if (category.Methods.Count > 0)
                        {
                            @RenderMethods(category.Methods, GetGapClass(
                                category.Values.Count > 0 ? PaneBlock.Values : PaneBlock.CategoryTitle, PaneBlock.Methods))
                        }
                    </div>
                    previousBlock = PaneBlock.Category;
                }

                @* Details Accordion *@
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Gutters="false" Dense="true" Class="@GetGapClass(previousBlock, PaneBlock.Section)" Style="overflow: hidden;">
                    <MudExpansionPanel Expanded="false" Gutters="false" Class="px-4" HeaderClass="subject-pane-section-header">
                        <TitleContent>
                            Details
                        </TitleContent>
                        <ChildContent>
                            <div class="mb-4">
                                <small style="word-break: break-all;">
                                    <p class="my-1"><strong>ID:</strong> @GetPath()</p>
                                    <p class="my-1"><strong>Type:</strong> @Subject.GetType().FullName</p>
                                </small>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>
        </div>
    </div>
}

<style>
    /* MudBlazor has no parameter or class for the rules below. */

    /* The copy button of a value shows while its row is hovered or focused, and always on a device without hover.
       Transparent rather than hidden, so that it stays in the tab order. */
    .subject-pane-copy {
        opacity: 0;
    }

    .subject-pane-row:hover .subject-pane-copy,
    .subject-pane-row:focus-within .subject-pane-copy {
        opacity: 1;
    }

    @@media (hover: none) {
        .subject-pane-copy {
            opacity: 1;
        }
    }

    /* The height of the count chip and of the chevron of the selected child, so that all rows are equally high. */
    .subject-pane-child-name {
        line-height: 24px;
    }

    /* Three classes, as MudBlazor sets the height of a panel header with two. */
    .mud-expand-panel .mud-expand-panel-header.subject-pane-section-header {
        min-height: 36px;
        padding-top: 6px;
        padding-bottom: 6px;
    }

    /* A title too long for the pane wraps inside its button. */
    .subject-pane-method {
        max-width: 100%;
        overflow-wrap: anywhere;
    }

    /* The values of a pane start at the same place. A longer name pushes its value to the right. */
    .subject-pane-value-name {
        min-width: 10rem;
    }

    /* The arrow and its margin take 24px. */
    .subject-pane-value-name-after-arrow {
        min-width: calc(10rem - 24px);
    }

    .subject-pane-value-text {
        font-weight: 500;
    }

    /* Stacked: a name as wide as the line puts its value below it. A Typo cannot follow a media query, so the caption is set here. */
    .subject-pane-rows-stacked .subject-pane-value-name {
        flex-basis: 100%;
        font-size: var(--mud-typography-caption-size);
        line-height: var(--mud-typography-caption-lineheight);
        letter-spacing: var(--mud-typography-caption-letterspacing);
    }

    /* The same rule below the sm breakpoint of MudBlazor: a selector cannot join a class and a media query. */
    @@media (max-width: 599.98px) {
        .subject-pane-rows-automatic .subject-pane-value-name {
            flex-basis: 100%;
            font-size: var(--mud-typography-caption-size);
            line-height: var(--mud-typography-caption-lineheight);
            letter-spacing: var(--mud-typography-caption-letterspacing);
        }
    }
</style>

@code {
    // Strings, as markup drops the space at the end. The no-break space keeps a line from starting with the dot.
    private const string EmptyValuesLabel = "No value: ";
    private const string EmptyValuesSeparator = "\xA0· ";

    private readonly HashSet<string> _expandedProperties = [];

    private ElementReference _rootElement;
    private string? _copyButtonsElementId;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SubjectPropertyPanel>? _dotNetReference;
    private bool _isDisposed;

    // The subject type of each path property of the shown subject, null for one that does not lead to a subject.
    private readonly Dictionary<RegisteredSubjectProperty, Type?> _linkedSubjectTypes = [];

    private RegisteredSubject? _registeredSubject;
    // The method whose prompt, run or result is under way, so that a second click starts nothing.
    private MethodMetadata? _invokingMethod;

    // The method that runs, which shows the spinner. Not set while its prompt or result dialog is open.
    private MethodMetadata? _executingMethod;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public ISubjectRegistry? SubjectRegistry { get; set; }

    [Parameter]
    public IInterceptorSubject? SelectedChild { get; set; }

    [Parameter]
    public bool CanClose { get; set; }

    [Parameter]
    public string? Path { get; set; }

    [Parameter]
    public EventCallback<PropertyClickEventArgs> OnPropertyClick { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _dotNetReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and with it the module.
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        // The listener sits on the root, which is new only when the pane showed no subject in between.
        if (Subject is null || _rootElement.Id is null || _rootElement.Id == _copyButtonsElementId)
        {
            return;
        }

        // Claimed before the awaits, so that a render during them does not register the element again.
        _copyButtonsElementId = _rootElement.Id;
        try
        {
            _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/HomeBlaze.Host/Components/Browser/SubjectPropertyPanel.razor.js");
            if (_isDisposed)
            {
                await _module.DisposeAsync();
                return;
            }

            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerCopyButtons", _rootElement, _dotNetReference);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException or JSException)
        {
            // Without the script the copy buttons do nothing; the values are still shown.
        }
    }

    [JSInvokable]
    public void OnValueCopied(bool isCopied)
    {
        if (isCopied)
        {
            Snackbar.Add("Copied", Severity.Normal, options => options.VisibleStateDuration = 1500);
        }
        else
        {
            Snackbar.Add("The value could not be copied.", Severity.Warning);
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        var registeredSubject = Subject != null && SubjectRegistry != null
            ? SubjectRegistry.TryGetRegisteredSubject(Subject)
            : null;
        if (registeredSubject != _registeredSubject)
        {
            _linkedSubjectTypes.Clear();
        }

        _registeredSubject = registeredSubject;
    }

    private string GetSubjectTitle()
    {
        return Subject switch
        {
            null => "No Selection",
            ITitleProvider titleProvider when !string.IsNullOrEmpty(titleProvider.Title) => titleProvider.Title,
            _ => Subject.GetType().Name
        };
    }

    private string GetSubjectIcon(IInterceptorSubject? subject)
    {
        if (subject == null)
            return Icons.Material.Filled.QuestionMark;

        return SubjectIconExtensions.ResolveMudBlazorIcon(subject.GetIcon());
    }

    private Color GetSubjectIconColor(IInterceptorSubject? subject)
    {
        if (subject == null)
            return Color.Default;

        return SubjectIconExtensions.ResolveMudBlazorColor(subject.GetIconColor());
    }

    private string GetPath()
    {
        if (Subject != null)
        {
            return PathResolver.GetPath(Subject, PathStyle.Canonical) ?? Path ?? "/";
        }

        return Path ?? "/";
    }

    private IEnumerable<RegisteredSubjectProperty> GetPrimitiveProperties()
    {
        if (_registeredSubject == null)
            return [];

        // Read in the render, so that a property added at run time, which increments the version, renders the panel again.
        _ = PathResolver.PathsVersion;
        return _registeredSubject.Properties
            .Where(p =>
                p.GetStateMetadata() != null
                && p is { IsAttribute: false, CanContainSubjects: false }
                && p.GetConfigurationMetadata()?.IsSecret != true)
            .OrderBy(p => p.GetDisplayPosition());
    }

    private IEnumerable<RegisteredSubjectProperty> GetChildProperties()
    {
        if (_registeredSubject == null)
            return [];

        // Read in the render, so that a property added at run time, which increments the version, renders the panel again.
        _ = PathResolver.PathsVersion;
        return _registeredSubject.Properties
            .Where(p => p is { IsAttribute: false, CanContainSubjects: true })
            .OrderBy(p => p.GetDisplayPosition());
    }

    private List<ChildSection> GetChildSections()
    {
        var sections = new List<ChildSection>();
        List<(RegisteredSubjectProperty, SubjectPropertyChild)>? singleChildren = null;
        foreach (var property in GetChildProperties())
        {
            var children = GetVisibleChildren(property);
            if (children.Length == 1 && property.IsSubjectReference)
            {
                if (singleChildren is null)
                {
                    singleChildren = [];
                    sections.Add(new ChildSection(singleChildren, null, []));
                }

                singleChildren.Add((property, children[0]));
            }
            else if (children.Length >= 1)
            {
                singleChildren = null;
                sections.Add(new ChildSection([], property, children));
            }
        }

        return sections;
    }

    private sealed record ChildSection(
        List<(RegisteredSubjectProperty Property, SubjectPropertyChild Child)> SingleChildren,
        RegisteredSubjectProperty? CollectionProperty,
        SubjectPropertyChild[] CollectionChildren);

    private static SubjectPropertyChild[] GetVisibleChildren(RegisteredSubjectProperty property)
    {
        // The children come from the registry, which is not a tracked read. Reading the property is, so the pane renders
        // again when a child is added, replaced or removed.
        _ = property.GetValue();
        return property.Children
            .Where(child => !Attribute.IsDefined(child.Subject.GetType(), typeof(ExcludeFromBrowsingAttribute), true))
            .ToArray();
    }

    private void TogglePropertyExpanded(string propertyName)
    {
        if (!_expandedProperties.Remove(propertyName))
            _expandedProperties.Add(propertyName);
    }

    // No flex-shrink-0 on the name: a name longer than the line would be cut off at the edge of the pane.
    private const string NameAndValueClass = "d-flex flex-wrap align-baseline gap-x-4 flex-grow-1";

    private RenderFragment RenderProperty(RegisteredSubjectProperty prop, object? value, int depth) => __builder =>
    {
        var attributes = prop.Attributes.Where(IsDetail).ToArray();
        var hasAttributes = attributes.Length > 0;
        var isExpanded = _expandedProperties.Contains(prop.Name);
        var displayName = prop.IsAttribute ? prop.AttributeMetadata.AttributeName : GetPropertyDisplayName(prop);
        var displayValue = prop.GetPropertyDisplayValue(value, TimeZone);
        var linkedSubject = ResolveLinkedSubject(prop, value);
        if (linkedSubject is not null)
        {
            displayValue = (linkedSubject as ITitleProvider)?.Title is { Length: > 0 } title ? title : displayValue;
        }

        // A row without a value is dimmed by the colour of disabled text, as MudBlazor has no class for an opacity.
        var nameClass = value is null
            ? (hasAttributes ? "subject-pane-value-name subject-pane-value-name-after-arrow mud-text-disabled" : "subject-pane-value-name mud-text-disabled")
            : (hasAttributes ? "subject-pane-value-name subject-pane-value-name-after-arrow mud-text-secondary" : "subject-pane-value-name mud-text-secondary");
        var valueClass = value is null ? "subject-pane-value-text mud-text-disabled" : "subject-pane-value-text mud-text-primary";

        // A detail without an arrow starts where the name of one with an arrow starts.
        var rowClass = depth > 0 && !hasAttributes ? "subject-pane-row d-flex align-start py-1 pl-6" : "subject-pane-row d-flex align-start py-1";

        RenderFragment nameAndValue =
            @<text>
                <MudText Typo="Typo.body1" HtmlTag="span" Class="@nameClass" data-testid="subject-pane-value-name">@displayName</MudText>
                <MudText Typo="Typo.body1" HtmlTag="span" Class="@valueClass" data-testid="subject-pane-value-text">
                    @if (displayValue.Contains('\n'))
                    {
                        @foreach (var line in displayValue.Split('\n'))
                        {
                            <span>@line</span>

                            <br/>
                        }
                    }
                    else
                    {
                        @displayValue
                    }
                </MudText>
            </text>;

        <div class="@rowClass" data-testid="subject-pane-value">
            @* Outside the link, so that a click on the arrow does not open the history. *@
            @if (hasAttributes)
            {
                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                               Size="Size.Small"
                               Class="pa-0 mr-1"
                               OnClick="@(() => TogglePropertyExpanded(prop.Name))" />
            }
            @if (CanShowHistory(prop))
            {
                <MudLink Color="Color.Inherit" Underline="Underline.Hover" Class="@NameAndValueClass"
                         title="Show history" OnClick="@(() => OpenPropertyHistoryDialogAsync(prop))">@nameAndValue</MudLink>
            }
            else
            {
                <div class="@NameAndValueClass">@nameAndValue</div>
            }
            @if (linkedSubject is not null && PathResolver.GetPath(linkedSubject, PathStyle.Route) is { } routePath)
            {
                <MudTooltip Text="Open">
                    <MudIconButton Href="@BrowserUrls.FromRoutePath(routePath)"
                                   Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small"
                                   Class="pa-0 ml-2"
                                   aria-label="@($"Open {displayValue}")"
                                   data-testid="subject-pane-value-link" />
                </MudTooltip>
            }
            else if (value is Uri { IsAbsoluteUri: true } uri && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
            {
                <MudTooltip Text="Open in new tab">
                    <MudIconButton Href="@uri.AbsoluteUri"
                                   Target="_blank"
                                   Rel="noopener noreferrer"
                                   Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small"
                                   Class="pa-0 ml-2"
                                   aria-label="@($"Open {displayName} in new tab")"
                                   data-testid="subject-pane-value-link" />
                </MudTooltip>
            }
            else if (value is not null)
            {
                @* Copied by the script of the pane in the click itself, see SubjectPropertyPanel.razor.js. *@
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                               Size="Size.Small"
                               Class="pa-0 ml-2 subject-pane-copy"
                               title="Copy"
                               aria-label="@($"Copy {displayName}")"
                               data-copy-value="@displayValue"
                               data-testid="subject-pane-value-copy" />
            }
        </div>

        @if (isExpanded && hasAttributes)
        {
            @* Indented by the width of the arrow and its margin. *@
            <div class="ml-6">
                @foreach (var attribute in attributes)
                {
                    <MudDivider />
                    @RenderProperty(attribute, attribute.GetValue(), depth + 1)
                }
            </div>
        }
    };

    // A [State] path property with a subject type shows the subject at the path. The path is resolved here only, so
    // that the subject is not attached a second time under the property's subject.
    private IInterceptorSubject? ResolveLinkedSubject(RegisteredSubjectProperty property, object? value)
    {
        if (value is not string { Length: > 0 } path || property.IsAttribute)
        {
            return null;
        }

        if (!_linkedSubjectTypes.TryGetValue(property, out var subjectType))
        {
            subjectType = GetLinkedSubjectType(property);
            _linkedSubjectTypes[property] = subjectType;
        }

        return subjectType is not null && PathResolver.ResolveSubject(path, PathStyle.Canonical) is { } subject &&
            subjectType.IsInstanceOfType(subject)
            ? subject
            : null;
    }

    private static Type? GetLinkedSubjectType(RegisteredSubjectProperty property)
    {
        foreach (var attribute in property.ReflectionAttributes)
        {
            if (attribute is SubjectPathAttribute { SubjectType: { } subjectType })
            {
                return subjectType;
            }
        }

        return null;
    }

    // An attribute that the row of its property shows when expanded, which gives the row its arrow.
    private static bool IsDetail(RegisteredSubjectProperty attribute) =>
        attribute.AttributeMetadata.AttributeName is not (KnownAttributes.State or KnownAttributes.Configuration);

    private static bool HasDetails(RegisteredSubjectProperty property) =>
        Array.Exists(property.Attributes, IsDetail);

    private string GetPropertyDisplayName(RegisteredSubjectProperty property)
    {
        return property.GetDisplayName();
    }

    private int GetChildCount(SubjectPropertyChild child)
    {
        var subject = child.Subject;
        var registered = SubjectRegistry?.TryGetRegisteredSubject(subject);
        if (registered == null) return 0;

        return registered.Properties
            .Where(p => p is { IsAttribute: false, CanContainSubjects: true })
            .Sum(p =>
            {
                // Read for the same reason as in GetVisibleChildren.
                _ = p.GetValue();
                return p.Children.Length;
            });
    }

    public record PropertyClickEventArgs(string PropertyName, object? Index, IInterceptorSubject Subject);

    private bool CanEdit()
    {
        if (Subject == null) return false;

        // Can edit if there's a custom edit component or configuration properties
        var hasEditComponent = ComponentRegistry.HasComponent(
            Subject.GetType(),
            SubjectComponentType.Edit);

        return hasEditComponent || Subject.HasConfigurationProperties();
    }

    private async Task OpenEditDialog()
    {
        if (Subject == null) return;

        var title = GetSubjectTitle();
        await SubjectEditDialog.ShowAsync(DialogService, ComponentRegistry, Subject, $"Edit {title}");
    }

    private bool CanShowHistory(RegisteredSubjectProperty property)
    {
        if (SubjectRegistry is null || !property.HasHistory())
        {
            return false;
        }

        return SubjectRegistry.KnownSubjects.Keys.OfType<IHistoryStore>().Any();
    }

    private async Task OpenPropertyHistoryDialogAsync(RegisteredSubjectProperty property)
    {
        if (Subject is null || SubjectRegistry is null)
        {
            return;
        }

        await PropertyHistoryDialog.ShowAsync(DialogService, SubjectRegistry, PathResolver, property, property.Name);
    }

    private SubjectMemberGroups<RegisteredSubjectProperty, MethodMetadata> GetMemberGroups() =>
        SubjectMemberGrouping.Group(
            GetPrimitiveProperties().ToList(),
            static property => property.GetStateMetadata()?.Category,
            static property => property.GetDisplayPosition(),
            _registeredSubject?.GetAllMethods() ?? [],
            static method => method.Category,
            static method => method.Position);

    // A section is a list of children, a collection or the details.
    private enum PaneBlock
    {
        None,
        Values,
        Methods,
        Category,
        CategoryTitle,
        Section
    }

    // 16px around a category and between the children and the values below them, 12px around a row of method
    // buttons, 8px otherwise. The category arm comes first: a category after a row of buttons is 16px away.
    private static string GetGapClass(PaneBlock previousBlock, PaneBlock block) => (previousBlock, block) switch
    {
        (PaneBlock.None, _) => "mt-2",
        (PaneBlock.CategoryTitle, PaneBlock.Values) => "mt-1",
        (PaneBlock.CategoryTitle, _) => "mt-2",
        (PaneBlock.Category, _) or (_, PaneBlock.Category) or (PaneBlock.Section, PaneBlock.Values) => "mt-4",
        (PaneBlock.Methods, _) or (_, PaneBlock.Methods) => "mt-3",
        _ => "mt-2"
    };

    private RenderFragment RenderValues(IReadOnlyList<RegisteredSubjectProperty> values, string gapClass) => __builder =>
    {
        // The word break lets a name or a value without a space wrap, for which MudBlazor has no class.
        <MudListSubheader Class="@($"{gapClass} py-0")" Style="word-break: break-word;">
            @{
                List<RegisteredSubjectProperty>? emptyValues = null;
                var hasRows = false;
            }
            @foreach (var property in values)
            {
                // Read here also for a value that gets no row: the render records the read, so the pane is
                // rendered again once the value is set.
                var value = property.GetValue();
                if (value is null && !HasDetails(property))
                {
                    emptyValues ??= [];
                    emptyValues.Add(property);
                }
                else
                {
                    if (hasRows)
                    {
                        <MudDivider />
                    }

                    hasRows = true;
                    @RenderProperty(property, value, 0)
                }
            }
            @if (emptyValues is not null)
            {
                @RenderEmptyValues(emptyValues, hasRows)
            }
        </MudListSubheader>
    };

    private RenderFragment RenderEmptyValues(List<RegisteredSubjectProperty> emptyValues, bool hasRows) => __builder =>
    {
        // A div, as the span of a caption takes no margin above it.
        <MudText Typo="Typo.caption" HtmlTag="div" Class="@(hasRows ? "mud-text-secondary mt-1" : "mud-text-secondary")"
                 data-testid="subject-pane-empty-values">
            @EmptyValuesLabel
            @{ var isFirst = true; }
            @foreach (var property in emptyValues)
            {
                if (!isFirst)
                {
                    @EmptyValuesSeparator
                }

                isFirst = false;
                var displayName = GetPropertyDisplayName(property);
                if (CanShowHistory(property))
                {
                    <MudLink Color="Color.Inherit" Underline="Underline.Hover" title="Show history"
                             OnClick="@(() => OpenPropertyHistoryDialogAsync(property))">@displayName</MudLink>
                }
                else
                {
                    @displayName
                }
            }
        </MudText>
    };

    private RenderFragment RenderMethods(IReadOnlyList<MethodMetadata> methods, string gapClass) => __builder =>
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="@($"{gapClass} px-4")">
            @foreach (var method in methods)
            {
                var isQuery = method.Kind == MethodKind.Query;
                var isEnabled = _registeredSubject?.TryGetProperty(method.PropertyName)?.IsMethodEnabled() ?? true;
                var isExecuting = _executingMethod == method;
                <MudButton Variant="Variant.Filled"
                           Color="@(isQuery ? Color.Info : Color.Primary)"
                           Size="Size.Small"
                           Class="subject-pane-method"
                           StartIcon="@(isExecuting ? null : SubjectIconExtensions.ResolveMudBlazorIcon(OperationInvoker.GetIconName(method)))"
                           Disabled="@(isExecuting || !isEnabled)"
                           OnClick="@(() => ExecuteMethodAsync(method))">
                    @* The spinner takes the start icon's place instead of adding one, so the button keeps its width while busy. *@
                    @if (isExecuting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width: 20px; height: 20px;" />
                    }
                    @method.Title
                </MudButton>
            }
        </MudStack>
    };

    private async Task ExecuteMethodAsync(MethodMetadata method)
    {
        if (Subject == null || _invokingMethod != null)
        {
            return;
        }

        _invokingMethod = method;
        try
        {
            await OperationInvoker.InvokeAsync(DialogService, ServiceProvider, method, _lifetime.Token, isRunning =>
            {
                _executingMethod = isRunning ? method : null;
                StateHasChanged();
            });
        }
        finally
        {
            _invokingMethod = null;
            _executingMethod = null;
        }
    }
}
