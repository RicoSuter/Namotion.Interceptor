@using HomeBlaze.Abstractions.Attributes
@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.History.Abstractions
@using HomeBlaze.History
@using HomeBlaze.History.Blazor
@using HomeBlaze.Host.Components.Dialogs
@using HomeBlaze.Storage.Abstractions
@using HomeBlaze.Components.Abstractions.TimeZones

@implements IDisposable

@inject IDialogService DialogService
@inject SubjectComponentRegistry ComponentRegistry
@inject DeveloperModeService DeveloperMode
@inject SubjectPathResolver PathResolver
@inject IServiceProvider ServiceProvider
@inject ITimeZoneDisplay TimeZone

@if (Subject != null)
{
    @* The header stays in place and the content below it scrolls. The grid cell gives the column its height through
       the element the tracking scope adds around it in developer mode. *@
    <div style="display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); height: 100%;">
        <TrackingScope Context="Subject.Context" ShowDebugInfo="DeveloperMode.IsEnabled">
            <div style="display: flex; flex-direction: column; height: 100%;">
                <MudListSubheader Class="d-flex align-center gap-1" Style="flex-shrink: 0;">
                    @{
                        var canEdit = CanEdit();
                        var canDelete = Subject is IStorageFile or IConfigurable;
                    }

                    @* Stays an h1: the page focuses the first h1 after navigation. *@
                    <MudText Typo="Typo.h6" HtmlTag="h1" Class="flex-grow-1"
                             Style="min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <MudIcon Size="Size.Small" Icon="@GetSubjectIcon(Subject)" Color="@GetSubjectIconColor(Subject)" Class="mr-2" Style="vertical-align: middle;" />
                        @GetSubjectTitle()
                    </MudText>

                    @if (canEdit)
                    {
                        <MudTooltip Text="Edit">
                            <MudIconButton OnClick="@OpenEditDialog"
                                           Icon="@Icons.Material.Filled.Edit"
                                           Variant="Variant.Text"
                                           Size="Size.Small"
                                           aria-label="Edit"
                                           data-testid="edit-subject-button" />
                        </MudTooltip>
                    }
                    @if (canDelete)
                    {
                        <MudTooltip Text="Delete">
                            <MudIconButton OnClick="@(() => OnDelete.InvokeAsync())"
                                           Icon="@Icons.Material.Filled.Delete"
                                           Variant="Variant.Text"
                                           Size="Size.Small"
                                           aria-label="Delete" />
                        </MudTooltip>
                    }
                    @if (CanClose)
                    {
                        @if (canEdit || canDelete)
                        {
                            <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-1" />
                        }

                        @* The padding keeps the larger icon within the height of the title line. *@
                        <MudTooltip Text="Close">
                            <MudIconButton OnClick="@(() => OnClose.InvokeAsync())"
                                           Icon="@Icons.Material.Filled.Close"
                                           Variant="Variant.Text"
                                           Size="Size.Medium"
                                           Style="padding: 4px; color: var(--mud-palette-text-primary);"
                                           aria-label="Close"
                                           data-testid="close-pane-button" />
                        </MudTooltip>
                    }
                </MudListSubheader>

                <div data-testid="subject-pane-content" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden;">
                    @* Primitive Properties *@
                    @{
                        var primitiveProperties = GetPrimitiveProperties().ToList();
                        if (primitiveProperties.Count > 0)
                        {
                            <MudListSubheader Style="word-break: break-word;">
                                @foreach (var prop in primitiveProperties)
                                {
                                    @RenderProperty(prop, 0)
                                }
                            </MudListSubheader>
                        }
                    }

                    @* Child Collections *@
                    @foreach (var section in GetChildSections())
                    {
                        @if (section.CollectionProperty is null)
                        {
                            @* Consecutive single child references share one list *@
                            <MudList T="object" SelectedValue="SelectedChild" Color="Color.Primary" Dense="true" Class="pt-2" Style="padding-bottom: 0">
                                @foreach (var (property, child) in section.SingleChildren)
                                {
                                    var isSelected = child.Subject == SelectedChild;
                                    var childCount = GetChildCount(child);

                                    <MudListItem Value="@child.Subject"
                                                 OnClick="@(() => OnPropertyClick.InvokeAsync(new PropertyClickEventArgs(property.Name, child.Index, child.Subject)))"
                                                 Icon="@GetSubjectIcon(child.Subject)"
                                                 IconColor="@(isSelected ? Color.Primary : GetSubjectIconColor(child.Subject))"
                                                 Class="@(isSelected ? "mud-primary-text" : "")">
                                        @if (isSelected)
                                        {
                                            <div style="float: right; line-height: 0">
                                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                            </div>
                                        }
                                        <span class="subject-pane-child-name" style="word-break: break-word;">@property.GetChildDisplayName(child)</span>
                                        @if (childCount > 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="ml-4 my-0">@childCount</MudChip>
                                        }
                                    </MudListItem>
                                    <MudDivider />
                                }
                            </MudList>
                        }
                        else
                        {
                            var property = section.CollectionProperty;
                            var children = section.CollectionChildren;
                            @* MudBlazor gives an expanded panel a margin of 16px, but not as the first or the last child. The
                               fixed margin keeps the distance to the block above the same in every case. *@
                            <MudExpansionPanel Gutters="false" Dense="true" Expanded="true" Class="mt-2 mb-0" HeaderClass="px-4 subject-pane-section-header">
                                <TitleContent>
                                    @GetPropertyDisplayName(property)
                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="my-0">@children.Length</MudChip>
                                </TitleContent>
                                <ChildContent>
                                    <MudList T="object" SelectedValue="SelectedChild" Color="Color.Primary" Dense="true">
                                        @foreach (var child in children)
                                        {
                                            var isSelected = child.Subject == SelectedChild;
                                            var childCount = GetChildCount(child);

                                            <MudListItem Value="@child.Subject"
                                                         OnClick="@(() => OnPropertyClick.InvokeAsync(new PropertyClickEventArgs(property.Name, child.Index, child.Subject)))"
                                                         Icon="@GetSubjectIcon(child.Subject)"
                                                         IconColor="@(isSelected ? Color.Primary : GetSubjectIconColor(child.Subject))"
                                                         Class="@(isSelected ? "mud-primary-text" : "")">
                                                @if (isSelected)
                                                {
                                                    <div style="float: right; line-height: 0">
                                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                                    </div>
                                                }
                                                <span class="subject-pane-child-name" style="word-break: break-word;">@property.GetChildDisplayName(child)</span>
                                                @if (childCount > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="ml-4 my-0">@childCount</MudChip>
                                                }
                                            </MudListItem>
                                            <MudDivider />
                                        }
                                    </MudList>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    }

                    @* Methods Section (Operations & Queries) *@
                    @{
                        var methods = GetMethods();
                        if (methods.Count > 0)
                        {
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="px-4 pt-2">
                                @foreach (var method in methods)
                                {
                                    var isQuery = method.Kind == MethodKind.Query;
                                    var defaultIcon = isQuery ? "Search" : "PlayArrow";
                                    var methodProperty = _registeredSubject?.TryGetProperty(method.PropertyName);
                                    var isEnabledAttribute = methodProperty?.TryGetAttribute(KnownAttributes.IsEnabled);
                                    var isEnabled = isEnabledAttribute?.GetValue() as bool? ?? true;
                                    <MudButton Variant="Variant.Filled"
                                               Color="@(isQuery ? Color.Info : Color.Primary)"
                                               Size="Size.Small"
                                               Class="subject-pane-method"
                                               StartIcon="@SubjectIconExtensions.ResolveMudBlazorIcon(method.Icon ?? defaultIcon)"
                                               Disabled="@(_executingMethod == method || !isEnabled)"
                                               OnClick="@(() => ExecuteMethodAsync(method))">
                                        @if (_executingMethod == method)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        }
                                        @method.Title
                                    </MudButton>
                                }
                            </MudStack>
                        }
                    }

                    @* Details Accordion *@
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Gutters="false" Dense="true" Class="mt-2" Style="overflow: hidden;">
                        <MudExpansionPanel Expanded="false" Gutters="false" Class="px-4" HeaderClass="subject-pane-section-header">
                            <TitleContent>
                                Details
                            </TitleContent>
                            <ChildContent>
                                <div class="mb-4">
                                    <small style="word-break: break-all;">
                                        <p class="my-1"><strong>ID:</strong> @GetPath()</p>
                                        <p class="my-1"><strong>Type:</strong> @Subject.GetType().FullName</p>
                                    </small>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            </div>
        </TrackingScope>
    </div>
}

<style>
    /* The line of a dense row is 20px, but the count chip and the chevron of the selected child are 24px high. Without
       this, rows with a chip are higher than rows without one and the chevron hangs below the name. */
    .subject-pane-child-name {
        line-height: 24px;
    }

    /* MudBlazor has no parameter for the height of a panel header and sets it with two classes, so this takes three. */
    .mud-expand-panel .mud-expand-panel-header.subject-pane-section-header {
        min-height: 36px;
        padding-top: 6px;
        padding-bottom: 6px;
    }

    /* A title too long for the pane wraps inside its button, which would otherwise be wider than the pane. */
    .subject-pane-method {
        max-width: 100%;
        overflow-wrap: anywhere;
    }
</style>

@code {
    private readonly HashSet<string> _expandedProperties = [];

    private RegisteredSubject? _registeredSubject;
    private MethodMetadata? _executingMethod;

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public ISubjectRegistry? SubjectRegistry { get; set; }

    [Parameter]
    public IInterceptorSubject? SelectedChild { get; set; }

    [Parameter]
    public bool CanClose { get; set; }

    [Parameter]
    public string? Path { get; set; }

    [Parameter]
    public EventCallback<PropertyClickEventArgs> OnPropertyClick { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        TimeZone.Changed += OnTimeZoneChanged;
    }

    private void OnTimeZoneChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        TimeZone.Changed -= OnTimeZoneChanged;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _registeredSubject = Subject != null && SubjectRegistry != null
            ? SubjectRegistry.TryGetRegisteredSubject(Subject)
            : null;
    }

    private string GetSubjectTitle()
    {
        return Subject switch
        {
            null => "No Selection",
            ITitleProvider titleProvider when !string.IsNullOrEmpty(titleProvider.Title) => titleProvider.Title,
            _ => Subject.GetType().Name
        };
    }

    private string GetSubjectIcon(IInterceptorSubject? subject)
    {
        if (subject == null)
            return Icons.Material.Filled.QuestionMark;

        return SubjectIconExtensions.ResolveMudBlazorIcon(subject.GetIcon());
    }

    private Color GetSubjectIconColor(IInterceptorSubject? subject)
    {
        if (subject == null)
            return Color.Default;

        return SubjectIconExtensions.ResolveMudBlazorColor(subject.GetIconColor());
    }

    private string GetPath()
    {
        if (Subject != null)
        {
            return PathResolver.GetPath(Subject, PathStyle.Canonical) ?? Path ?? "/";
        }

        return Path ?? "/";
    }

    private IEnumerable<RegisteredSubjectProperty> GetPrimitiveProperties()
    {
        if (_registeredSubject == null)
            return [];

        return _registeredSubject.Properties
            .Where(p => 
                p.GetStateMetadata() != null 
                && p is { IsAttribute: false, CanContainSubjects: false }
                && p.GetConfigurationMetadata()?.IsSecret != true)
            .OrderBy(p => p.GetDisplayPosition());
    }

    private IEnumerable<RegisteredSubjectProperty> GetChildProperties()
    {
        if (_registeredSubject == null)
            return [];

        return _registeredSubject.Properties
            .Where(p => p is { IsAttribute: false, CanContainSubjects: true })
            .OrderBy(p => p.GetDisplayPosition());
    }

    private List<ChildSection> GetChildSections()
    {
        var sections = new List<ChildSection>();
        List<(RegisteredSubjectProperty, SubjectPropertyChild)>? singleChildren = null;
        foreach (var property in GetChildProperties())
        {
            var children = GetVisibleChildren(property);
            if (children.Length == 1 && property.IsSubjectReference)
            {
                if (singleChildren is null)
                {
                    singleChildren = [];
                    sections.Add(new ChildSection(singleChildren, null, []));
                }

                singleChildren.Add((property, children[0]));
            }
            else if (children.Length >= 1)
            {
                singleChildren = null;
                sections.Add(new ChildSection([], property, children));
            }
        }

        return sections;
    }

    private sealed record ChildSection(
        List<(RegisteredSubjectProperty Property, SubjectPropertyChild Child)> SingleChildren,
        RegisteredSubjectProperty? CollectionProperty,
        SubjectPropertyChild[] CollectionChildren);

    private static SubjectPropertyChild[] GetVisibleChildren(RegisteredSubjectProperty property)
    {
        return property.Children
            .Where(child => !Attribute.IsDefined(child.Subject.GetType(), typeof(ExcludeFromBrowsingAttribute), true))
            .ToArray();
    }

    private void TogglePropertyExpanded(string propertyName)
    {
        if (!_expandedProperties.Remove(propertyName))
            _expandedProperties.Add(propertyName);
    }

    private RenderFragment RenderProperty(RegisteredSubjectProperty prop, int depth) => __builder =>
    {
        // Property reads are automatically recorded via the context-based ReadPropertyRecorder
        var value = prop.GetValue();
        var attributes = prop.Attributes
            .Where(a => a.AttributeMetadata.AttributeName != KnownAttributes.State &&
                        a.AttributeMetadata.AttributeName != KnownAttributes.Configuration)
            .ToArray();
        var hasAttributes = attributes.Length > 0;
        var isExpanded = _expandedProperties.Contains(prop.Name);
        var marginLeft = depth * 24;
        var displayName = prop.IsAttribute ? prop.AttributeMetadata.AttributeName : GetPropertyDisplayName(prop);

        <MudText Style="@($"margin-left: {marginLeft}px; {(value is null ? "opacity: 0.5" : "")}")">
            @if (hasAttributes)
            {
                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                               Size="Size.Small"
                               Class="mr-1"
                               Style="padding: 0; width: 20px; height: 20px;"
                               OnClick="@(() => TogglePropertyExpanded(prop.Name))" />
            }
            else if (depth > 0)
            {
                <span style="display: inline-block; width: 24px;"></span>
            }
            @{ var displayValue = prop.GetPropertyDisplayValue(value, TimeZone); }
            @{
                RenderFragment nameAndValue =
                    @<text><strong>@displayName: </strong>@if (displayValue.Contains('\n'))
                    {
                        @foreach (var line in displayValue.Split('\n'))
                        {
                            <span>@line</span>

                            <br/>
                        }
                    }
                    else
                    {
                        @displayValue
                    }</text>;
            }
            @if (CanShowHistory(prop))
            {
                <MudLink Color="Color.Inherit" Underline="Underline.Hover" Style="cursor: pointer;"
                         title="Show history" OnClick="@(() => OpenPropertyHistoryDialogAsync(prop))">@nameAndValue</MudLink>
            }
            else
            {
                @nameAndValue
            }
        </MudText>

        @if (isExpanded)
        {
            foreach (var attr in attributes)
            {
                @RenderProperty(attr, depth + 1)
            }
        }
    };

    private string GetPropertyDisplayName(RegisteredSubjectProperty property)
    {
        return property.GetDisplayName();
    }

    private int GetChildCount(SubjectPropertyChild child)
    {
        var subject = child.Subject;
        var registered = SubjectRegistry?.TryGetRegisteredSubject(subject);
        if (registered == null) return 0;

        return registered.Properties
            .Where(p => p is { IsAttribute: false, CanContainSubjects: true })
            .Sum(p => p.Children.Length);
    }

    public record PropertyClickEventArgs(string PropertyName, object? Index, IInterceptorSubject Subject);

    private bool CanEdit()
    {
        if (Subject == null) return false;

        // Can edit if there's a custom edit component or configuration properties
        var hasEditComponent = ComponentRegistry.HasComponent(
            Subject.GetType(),
            SubjectComponentType.Edit);

        return hasEditComponent || Subject.HasConfigurationProperties();
    }

    private async Task OpenEditDialog()
    {
        if (Subject == null) return;

        var title = GetSubjectTitle();
        await SubjectEditDialog.ShowAsync(DialogService, ComponentRegistry, Subject, $"Edit {title}");
    }

    private bool CanShowHistory(RegisteredSubjectProperty property)
    {
        if (SubjectRegistry is null || !property.HasHistory())
        {
            return false;
        }

        return SubjectRegistry.KnownSubjects.Keys.OfType<IHistoryStore>().Any();
    }

    private async Task OpenPropertyHistoryDialogAsync(RegisteredSubjectProperty property)
    {
        if (Subject is null || SubjectRegistry is null)
        {
            return;
        }

        var basePath = PathResolver.GetPath(Subject, PathStyle.Canonical);
        if (basePath is null)
        {
            return;
        }

        var path = basePath == "/" ? $"/{property.Name}" : $"{basePath}/{property.Name}";

        var metadata = property.GetStateMetadata();
        var unit = metadata is null || metadata.Unit == StateUnit.Default
            ? null
            : StateUnitExtensions.GetUnitSuffix(metadata.Unit);
        await PropertyHistoryDialog.ShowAsync(
            DialogService, SubjectRegistry, path, property.Name, property.Type, metadata?.IsCumulative ?? false, unit,
            metadata?.IsDiscrete ?? false);
    }

    private IReadOnlyList<MethodMetadata> GetMethods() =>
        _registeredSubject?.GetAllMethods() ?? [];

    private async Task ExecuteMethodAsync(MethodMetadata method)
    {
        if (Subject == null || _executingMethod != null)
        {
            return;
        }

        try
        {
            object?[]? parameters = null;

            // Check if there are any parameters that need user input
            if (method.Parameters.Any(p => p.RequiresInput))
            {
                var parameterDialog = await MethodParameterDialog.ShowAsync(DialogService, method);
                var parameterResult = await parameterDialog.Result;
                if (parameterResult == null || parameterResult.Canceled)
                    return;

                parameters = parameterResult.Data as object?[];
            }
            else if (method.RequiresConfirmation)
            {
                var confirmDialog = await MethodConfirmationDialog.ShowAsync(DialogService, method);
                var confirmResult = await confirmDialog.Result;
                if (confirmResult == null || confirmResult.Canceled)
                    return;
            }

            // Execute the method
            _executingMethod = method;
            StateHasChanged();

            var result = await method.InvokeAsync(parameters, ServiceProvider, CancellationToken.None);

            _executingMethod = null;
            StateHasChanged();

            if (result != null)
            {
                await MethodResultDialog.ShowAsync(DialogService, method.Title, result);
            }
        }
        catch (OperationCanceledException)
        {
            _executingMethod = null;
        }
        catch (Exception ex)
        {
            _executingMethod = null;
            await MethodErrorDialog.ShowAsync(DialogService, method.Title, ex);
        }
    }
}
