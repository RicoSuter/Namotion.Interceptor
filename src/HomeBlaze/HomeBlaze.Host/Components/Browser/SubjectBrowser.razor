@using HomeBlaze.Storage.Abstractions
@using Namotion.Interceptor.Registry.Attributes

@inherits HomeBlazorComponentBase

@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService
@inject SubjectPathResolver PathResolver

@implements IDisposable
@implements IAsyncDisposable

<MudStack Row="true" Class="browser-toolbar mb-2">
    <MudBreadcrumbs Items="_breadcrumbs" />
    <MudSpacer />
</MudStack>

<div id="scrollContainer" style="height: calc(100vh - 130px); width: 100%; overflow-x: auto; overflow-y: hidden; display: flex;">
    @for (var i = 0; i < _panes.Count; i++)
    {
        var pane = _panes[i];
        var isFirst = i == 0;
        var selectedChild = i < _panes.Count - 1 ? _panes[i + 1].Subject : null;

        <div style="display: flex; flex-direction: column;" class="pb-4">
            <MudPaper @key="pane.Subject" Width="@((PaneWidth - 16) + "px")"
                      Class="mr-4"
                      Style="@($"min-width: {PaneWidth - 16}px; flex-shrink: 0; height: 100%;")">
                <SubjectPropertyPanel @key="pane.Subject"
                                      Subject="@pane.Subject"
                                      SubjectRegistry="@_subjectRegistry"
                                      Path="@pane.Path"
                                      SelectedChild="@selectedChild"
                                      CanClose="@(!isFirst)"
                                      OnPropertyClick="@((args) => OnPropertyClick(pane, args.PropertyName, args.Index, args.Subject))"
                                      OnClose="@(() => OnPaneClose(pane))"
                                      OnDelete="@(() => OnPaneDelete(pane))" />
            </MudPaper>
        </div>
    }
</div>

@code {
    private const decimal PaneWidth = 400;

    private readonly List<SubjectPane> _panes = [];
    private readonly List<BreadcrumbItem> _breadcrumbs = [];

    // The requested path below /browser with its segments escaped as in the URL, so that a key containing
    // '/' or '%' stays one segment and is unescaped exactly once, by the path resolver. The panes follow it
    // as far as it resolves and extend when the rest of it appears.
    private string _targetPath = "";
    private string? _lastNavigatedPath;
    private bool _scrollToLastPane;

    private IJSObjectReference? _jsModule;
    private ISubjectRegistry? _subjectRegistry;
    private PropertyChangeWatcher? _childrenWatcher;
    private PropertyReference? _nextProperty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        // Only the initial load builds here; later URL changes arrive through OnLocationChanged.
        if (_panes.Count == 0)
        {
            _targetPath = NavigationManager.GetEscapedPathBelow(NavigationManager.Uri, "browser") ?? "";
            RebuildFromPath();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/HomeBlaze.Host/Components/Browser/SubjectBrowser.razor.js");
        }

        if (_scrollToLastPane && _jsModule != null)
        {
            _scrollToLastPane = false;
            var scrollLeft = PaneWidth * (_panes.Count - 1);
            await _jsModule.InvokeVoidAsync("scrollIntoView", "scrollContainer", scrollLeft);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = NavigationManager.GetEscapedPathBelow(e.Location, "browser");
        if (path is null)
        {
            return;
        }

        // Skip if this is our own programmatic navigation
        if (_lastNavigatedPath != null && path == _lastNavigatedPath)
        {
            _lastNavigatedPath = null;
            return;
        }

        _targetPath = path;
        RebuildFromPath();

        InvokeAsync(StateHasChanged);
    }

    private void RebuildFromPath()
    {
        if (Root != null)
        {
            _subjectRegistry = Root.Context.GetService<ISubjectRegistry>();
            _childrenWatcher ??= new PropertyChangeWatcher(
                Root.Context, InvokeAsync, OnPaneChildrenChanged, exception => _ = DispatchExceptionAsync(exception));
        }

        _nextProperty = BuildPanes(_targetPath, _panes);
        BuildBreadcrumbs(_panes, _breadcrumbs);
        WatchPaneChildren();
    }

    /// <summary>
    /// Builds the panes for the part of the escaped path that resolves.
    /// </summary>
    /// <returns>The property that would hold the next pane when the path does not fully resolve, otherwise null.</returns>
    private PropertyReference? BuildPanes(string path, List<SubjectPane> panes)
    {
        panes.Clear();

        if (Root == null) return null;

        // Always show root as first pane
        panes.Add(new SubjectPane
        {
            Subject = Root,
            DisplayName = "Root",
            Path = "/",
            PropertyName = null,
            Index = null
        });

        if (string.IsNullOrEmpty(path))
            return null;

        var resolution = PathResolver.ResolvePartially(path, PathStyle.Route, Root);

        var parentPath = "";
        foreach (var step in resolution.Steps)
        {
            var propertyName = step.Property.Name;
            var panePath = step.Index is null
                ? $"{parentPath}/{propertyName}"
                : InlinePathsAttribute.IsInlinePathsProperty(step.Property.Subject.GetType(), propertyName)
                    ? $"{parentPath}/{step.Index}"
                    : $"{parentPath}/{propertyName}/{step.Index}";

            var displayName = GetChildDisplayName(step.Property, step.Subject, step.Index);
            panes.Add(new SubjectPane { Subject = step.Subject, DisplayName = displayName, Path = panePath, PropertyName = propertyName, Index = step.Index });
            parentPath = panePath;
        }

        return resolution.NextProperty;
    }

    private static void BuildBreadcrumbs(List<SubjectPane> panes, List<BreadcrumbItem> breadcrumbs)
    {
        breadcrumbs.Clear();
        if (panes.Count == 0)
        {
            return;
        }

        breadcrumbs.Add(new BreadcrumbItem("Root", "/browser"));

        var pathParts = new List<string>();
        for (var i = 1; i < panes.Count; i++)
        {
            AddPathSegments(panes, pathParts, i);
            breadcrumbs.Add(new BreadcrumbItem(panes[i].DisplayName, "/browser/" + string.Join("/", pathParts)));
        }
    }

    private void OnPropertyClick(SubjectPane clickedPane, string propertyName, object? index, IInterceptorSubject subject)
    {
        // Find the index of the clicked pane
        var paneIndex = _panes.IndexOf(clickedPane);
        if (paneIndex < 0) return;

        // Remove all panes after the clicked one
        while (_panes.Count > paneIndex + 1)
        {
            _panes.RemoveAt(_panes.Count - 1);
        }

        // Build display name and path using slash notation
        var isInlinePathsProperty = InlinePathsAttribute.IsInlinePathsProperty(
            clickedPane.Subject.GetType(), propertyName);
        var property = clickedPane.Subject.TryGetRegisteredSubject()?.TryGetProperty(propertyName);
        var displayName = property is not null
            ? GetChildDisplayName(property, subject, index)
            : index?.ToString() ?? propertyName;
        var parentPath = clickedPane.Path.TrimEnd('/');
        var path = index != null
            ? (isInlinePathsProperty
                ? $"{parentPath}/{index}"
                : $"{parentPath}/{propertyName}/{index}")
            : $"{parentPath}/{propertyName}";

        // Add the new subject pane
        _panes.Add(new SubjectPane
        {
            Subject = subject,
            DisplayName = displayName,
            Path = path,
            PropertyName = propertyName,
            Index = index
        });

        _scrollToLastPane = true;
        UpdateUrl();
        StateHasChanged();
    }

    private void OnPaneClose(SubjectPane pane)
    {
        var paneIndex = _panes.IndexOf(pane);
        if (paneIndex <= 0) return; // Can't close the root pane

        // Remove this pane and all panes after it
        while (_panes.Count > paneIndex)
        {
            _panes.RemoveAt(_panes.Count - 1);
        }

        UpdateUrl();
        StateHasChanged();
    }

    private async Task OnPaneDelete(SubjectPane pane)
    {
        // Get subject name for confirmation dialog
        string subjectName;
        IStorageContainer? storage = null;

        if (pane.Subject is IStorageFile storageFile)
        {
            subjectName = storageFile.Name;
            storage = storageFile.Storage;
        }
        else if (pane.Subject is IConfigurable configurableSubject)
        {
            subjectName = SubjectDisplayExtensions.GetIdentifyingDisplayName(pane.DisplayName, pane.Index);

            // Find the parent IStorageContainer by traversing up the pane hierarchy
            for (int i = _panes.IndexOf(pane) - 1; i >= 0; i--)
            {
                if (_panes[i].Subject is IStorageContainer container)
                {
                    storage = container;
                    break;
                }
            }

            if (storage == null)
                return;
        }
        else
        {
            return;
        }

        // Show confirmation dialog
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Subject",
            $"Are you sure you want to delete '{subjectName}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            // Delete the subject from storage
            await storage.DeleteSubjectAsync(pane.Subject, CancellationToken.None);

            // Close this pane and any after it
            var paneIndex = _panes.IndexOf(pane);
            if (paneIndex > 0)
            {
                while (_panes.Count > paneIndex)
                {
                    _panes.RemoveAt(_panes.Count - 1);
                }

                UpdateUrl();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBoxAsync(
                "Delete Failed",
                $"Failed to delete: {ex.Message}",
                yesText: "OK");
        }
    }

    private void UpdateUrl()
    {
        BuildBreadcrumbs(_panes, _breadcrumbs);

        var pathParts = new List<string>();
        for (var i = 1; i < _panes.Count; i++)
        {
            AddPathSegments(_panes, pathParts, i);
        }

        // The open panes are now the requested path, so a missing tail of the previous one is no longer awaited.
        _targetPath = string.Join("/", pathParts);
        _nextProperty = null;

        // Stored so OnLocationChanged knows to ignore this navigation
        _lastNavigatedPath = _targetPath;
        NavigationManager.NavigateTo("/browser" + (pathParts.Count > 0 ? "/" + _targetPath : ""), replace: true);

        WatchPaneChildren();
    }

    private static void AddPathSegments(List<SubjectPane> panes, List<string> pathParts, int paneIndex)
    {
        var pane = panes[paneIndex];

        // For [InlinePaths] properties, only add the index (key), not the property name
        var isInlinePathsProperty = pane.PropertyName != null &&
            InlinePathsAttribute.IsInlinePathsProperty(panes[paneIndex - 1].Subject.GetType(), pane.PropertyName);

        if (isInlinePathsProperty && pane.Index != null)
        {
            pathParts.Add(Uri.EscapeDataString(pane.Index.ToString()!));
            return;
        }

        if (pane.PropertyName != null)
        {
            pathParts.Add(Uri.EscapeDataString(pane.PropertyName));
        }

        // Add index/key if present (for collections/dictionaries)
        if (pane.Index != null)
        {
            pathParts.Add(Uri.EscapeDataString(pane.Index.ToString()!));
        }
    }

    private void WatchPaneChildren()
    {
        if (_childrenWatcher is null)
        {
            return;
        }

        // Each pane after the first is held by a property of the pane before it. Storage replaces a subject
        // at the same path by assigning that property, which leaves the pane on the detached instance. While
        // the path does not fully resolve, the property that would hold the next pane tells when it appears.
        var nextProperty = _nextProperty;
        var properties = new PropertyReference[Math.Max(_panes.Count - 1, 0) + (nextProperty.HasValue ? 1 : 0)];
        for (var i = 1; i < _panes.Count; i++)
        {
            properties[i - 1] = new PropertyReference(_panes[i - 1].Subject, _panes[i].PropertyName!);
        }

        if (nextProperty.HasValue)
        {
            properties[^1] = nextProperty.Value;
        }

        _childrenWatcher.Watch(properties);

        // A write after the panes were resolved but before the watch was published is not reported.
        var currentPanes = new List<SubjectPane>(_panes.Count);
        var currentNextProperty = BuildPanes(_targetPath, currentPanes);
        if (!HaveSameSubjects(currentPanes, _panes) || currentNextProperty != nextProperty)
        {
            _childrenWatcher.Invalidate();
        }
    }

    private void OnPaneChildrenChanged()
    {
        var panes = new List<SubjectPane>(_panes.Count);
        var nextProperty = BuildPanes(_targetPath, panes);
        if (HaveSameSubjects(panes, _panes) && nextProperty == _nextProperty)
        {
            return;
        }

        var isPaneRemoved = panes.Count < _panes.Count;
        if (panes.Count > _panes.Count)
        {
            _scrollToLastPane = true;
        }

        _panes.Clear();
        _panes.AddRange(panes);
        BuildBreadcrumbs(_panes, _breadcrumbs);
        _nextProperty = nextProperty;

        if (isPaneRemoved)
        {
            // A subject on the path is gone, so the URL follows the panes that are left.
            UpdateUrl();
        }
        else
        {
            WatchPaneChildren();
        }

        StateHasChanged();
    }

    private static bool HaveSameSubjects(List<SubjectPane> panes, List<SubjectPane> otherPanes)
    {
        if (panes.Count != otherPanes.Count)
        {
            return false;
        }

        for (var i = 0; i < panes.Count; i++)
        {
            if (!ReferenceEquals(panes[i].Subject, otherPanes[i].Subject))
            {
                return false;
            }
        }

        return true;
    }

    // Breadcrumbs and pane titles use the same label as the child list of the parent pane.
    private static string GetChildDisplayName(RegisteredSubjectProperty property, IInterceptorSubject child, object? index)
        => property.GetChildDisplayName(new SubjectPropertyChild { Subject = child, Index = index });

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _childrenWatcher?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        // First, so a failing module disposal cannot leave the watcher observing every write in the graph.
        Dispose();

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already disconnected, nothing to clean up
            }
        }
    }

    private class SubjectPane
    {
        public required IInterceptorSubject Subject { get; init; }

        public string DisplayName { get; init; } = "";
        
        public string Path { get; init; } = "";
        
        public string? PropertyName { get; init; }
        
        public object? Index { get; init; }
    }
}
