@using Microsoft.AspNetCore.WebUtilities
@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.Services.Metadata
@using Namotion.Interceptor.Registry.Attributes
@using Namotion.Interceptor.Registry.Paths

@inherits HomeBlazorComponentBase

@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService
@inject PropertyRowLayoutService RowLayout
@inject BrowserPreferences Preferences

@implements IDisposable
@implements IAsyncDisposable

@* The panes take the height the breadcrumbs leave, which wrap on a narrow view. 66px is the top padding of the main
   content below the app bar plus 2px of slack. *@
<div style="display: flex; flex-direction: column; height: calc(100vh - 66px);">
    <PathsChangeListener OnPathsChanged="OnPathsChanged" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="browser-toolbar mb-2" Style="flex-shrink: 0;">
        <MudBreadcrumbs Items="_breadcrumbs" />
        <MudSpacer />
        @* To the left, as a tooltip below the button would cover the open menu. *@
        <MudTooltip Text="Row layout" Placement="Placement.Left">
            <MudMenu Icon="@Icons.Material.Filled.ViewAgenda" Size="Size.Small" Dense="true" AriaLabel="Row layout"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-testid="row-layout-menu">
                @* MudBlazor gives a menu and its items no roles, without which an item cannot state that it is chosen. *@
                <div role="menu" aria-label="Row layout">
                    @foreach (var (layout, label, testId) in RowLayouts)
                    {
                        var isCurrent = RowLayout.Layout == layout;
                        <MudMenuItem Icon="@(isCurrent ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                                     OnClick="@(() => SetRowLayoutAsync(layout))"
                                     role="menuitemradio"
                                     aria-checked="@(isCurrent ? "true" : "false")"
                                     data-testid="@testId">@label</MudMenuItem>
                    }
                </div>
            </MudMenu>
        </MudTooltip>
    </MudStack>

    @* The row always has its scrollbar: one that appears with the pane that makes the row scroll takes its height
       from the panes, which then all jump shorter. *@
    <div id="scrollContainer" @ref="_paneContainer" class="@RowLayoutClass"
         style="@($"flex: 1 1 auto; min-height: 0; width: 100%; overflow-x: scroll; overflow-y: hidden; display: flex; gap: {PaneGap}px; scroll-snap-type: var(--pane-snap, x mandatory);")">
        @for (var i = 0; i < _panes.Count; i++)
        {
            var pane = _panes[i];
            var isFirst = i == 0;
            var selectedChild = i < _panes.Count - 1 ? _panes[i + 1].Subject : null;

            // A local and not i: the panel reads its parameters when MudPaper renders its content, after the loop. A
            // pending path has not reached the subject of the highlighted property yet.
            var highlightedProperty = i == _panes.Count - 1 && !_isPathPending ? _highlightedProperty : null;

            @* Keyed by path: a subject that is reachable from itself can be in the row twice. *@
            <div @key="pane.Path" data-testid="subject-pane" class="pb-4"
                 style="@PaneStyle">
                <MudPaper Style="height: 100%; overflow: hidden;">
                    <SubjectPropertyPanel @key="pane.Subject"
                                          Subject="@pane.Subject"
                                          SubjectRegistry="@_subjectRegistry"
                                          Path="@pane.Path"
                                          SelectedChild="@selectedChild"
                                          CanClose="@(!isFirst)"
                                          OnPropertyClick="@((args) => OnPropertyClick(pane, args.PropertyName, args.Index, args.Subject))"
                                          OnClose="@(() => OnPaneClose(pane))"
                                          OnDelete="@((MethodMetadata deleteOperation) => OnPaneDelete(pane, deleteOperation))"
                                          HighlightedProperty="@highlightedProperty" />
                </MudPaper>
            </div>
        }

        @* Closed panes keep their place until the row has scrolled back, see RemovePanesFrom. A placeholder snaps like
           a pane: otherwise the row jumps off it at once when it replaces the pane the view rests on. *@
        @for (var i = 0; i < _placeholderCount; i++)
        {
            <div @key="@($"placeholder-{i}")" data-testid="subject-pane-placeholder" style="@PaneStyle"></div>
        }
    </div>
</div>

@code {
    // A pane is at least this wide, and wider when that lets a whole number of panes fill the view.
    private const int MinimumPaneWidth = 360;
    private const int PaneGap = 16;

    // The script sets --pane-width; until it has run, a pane is at most as wide as the view.
    private static readonly string PaneStyle =
        $"flex: 0 0 var(--pane-width, min({MinimumPaneWidth}px, 100%)); min-width: 0; scroll-snap-align: start;";

    private static readonly (PropertyRowLayout Layout, string Label, string TestId)[] RowLayouts =
    [
        (PropertyRowLayout.Automatic, "Automatic", "row-layout-automatic"),
        (PropertyRowLayout.SideBySide, "Side by side", "row-layout-side-by-side"),
        (PropertyRowLayout.Stacked, "Stacked", "row-layout-stacked")
    ];

    // The rules of these classes are in the style block of SubjectPropertyPanel. Side by side needs none.
    private string RowLayoutClass => RowLayout.Layout switch
    {
        PropertyRowLayout.SideBySide => "subject-pane-rows-side-by-side",
        PropertyRowLayout.Stacked => "subject-pane-rows-stacked",
        _ => "subject-pane-rows-automatic"
    };

    [Parameter]
    public string? Path { get; set; }

    // The property of the subject of the last pane whose row is highlighted, from the query of a link to a property.
    private string? _highlightedProperty;

    private readonly List<SubjectPane> _panes = [];
    private readonly List<BreadcrumbItem> _breadcrumbs = [];

    private string? _lastNavigatedUrl;

    // Whether Path reaches subjects that do not exist yet, such as while the storage loads after a restart. Until the
    // user changes the panes, Path alone decides them on each change of the paths, like a reload of the page would.
    private bool _isPathPending;
    private bool _scrollToLastPane;
    private int _placeholderCount;
    private int _scrollVersion;
    private bool _disposed;

    private ElementReference _paneContainer;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _paneFitting;
    private ISubjectRegistry? _subjectRegistry;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RowLayout.Load(Preferences.Get(BrowserPreferenceKeys.RowLayout));
        NavigationManager.LocationChanged += OnLocationChanged;
        RowLayout.OnChange += OnRowLayoutChanged;
    }

    private void OnRowLayoutChanged() => InvokeAsync(StateHasChanged);

    private async Task SetRowLayoutAsync(PropertyRowLayout layout)
    {
        RowLayout.SetLayout(layout);
        await Preferences.SetAsync(BrowserPreferenceKeys.RowLayout, RowLayout.StoredValue);
    }

    protected override void OnParametersSet()
    {
        // Only rebuild if this is the initial load (no panes yet)
        // or if Path changed externally (not from our own navigation)
        if (_panes.Count == 0)
        {
            _highlightedProperty = GetHighlightedProperty(new Uri(NavigationManager.Uri));
            RebuildFromPath();
        }
    }

    private static string? GetHighlightedProperty(Uri uri)
        => QueryHelpers.ParseQuery(uri.Query).TryGetValue(MetadataLinkResolver.PropertyQueryParameter, out var values) ? values.ToString() : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HomeBlaze.Host/Components/Browser/SubjectBrowser.razor.js");
                var paneFitting = await module.InvokeAsync<IJSObjectReference>("fitPanes", _paneContainer, MinimumPaneWidth, PaneGap);

                // The page can be left while the script loads, which is after DisposeAsync has run.
                if (_disposed)
                {
                    await DisposeScriptAsync(module, paneFitting);
                    return;
                }

                _paneFitting = paneFitting;
                _jsModule = module;
            }

            // The panes are fitted before the first scroll, which a render during the import above leaves to this one.
            if (_scrollToLastPane && _jsModule != null && !_disposed)
            {
                _scrollToLastPane = false;
                var scrollVersion = _scrollVersion;
                try
                {
                    await _jsModule.InvokeVoidAsync("scrollToPane", _paneContainer, _panes.Count - 1, !firstRender);
                }
                finally
                {
                    // The row has scrolled back to the remaining panes, unless the panes changed again in the meantime.
                    if (scrollVersion == _scrollVersion && _placeholderCount > 0 && !_disposed)
                    {
                        _placeholderCount = 0;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected, nothing to scroll
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // Asks for a scroll to the last pane once the changed panes are rendered. The version changes with the panes
    // rather than with the scroll, so a scroll that ends after a later change leaves the placeholders to that change.
    private void ScrollToLastPaneAfterRender()
    {
        _scrollToLastPane = true;
        _scrollVersion++;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location);
        var highlightedProperty = GetHighlightedProperty(uri);
        var isHighlightChanged = highlightedProperty != _highlightedProperty;
        _highlightedProperty = highlightedProperty;

        // Skip if this is our own programmatic navigation
        if (_lastNavigatedUrl != null && uri.AbsolutePath == _lastNavigatedUrl)
        {
            _lastNavigatedUrl = null;
            if (isHighlightChanged)
            {
                InvokeAsync(StateHasChanged);
            }

            return;
        }

        var segments = uri.AbsolutePath.TrimStart('/').Split('/');
        if (segments.Length > 0 && segments[0] == "browser")
        {
            var decodedSegments = segments.Skip(1).Select(Uri.UnescapeDataString);
            Path = string.Join("/", decodedSegments);

            // A link to the subject of the last pane, such as to one of its properties, still scrolls to it.
            RebuildFromPath();
            ScrollToLastPaneAfterRender();

            InvokeAsync(StateHasChanged);
        }
    }

    // Shows the panes that Path reaches. Returns whether a pane changed.
    private bool RebuildFromPath()
    {
        var panes = new List<SubjectPane>();
        _isPathPending = !BuildPanesFromPath(panes);

        // The panes that show the same subject at the same path stay, so that a pane an awaited handler holds is still
        // found. Their title can change without a change of the paths.
        var keptCount = 0;
        var hasRenamedPane = false;
        while (keptCount < panes.Count && keptCount < _panes.Count &&
               ReferenceEquals(panes[keptCount].Subject, _panes[keptCount].Subject) &&
               panes[keptCount].Path == _panes[keptCount].Path)
        {
            if (_panes[keptCount].DisplayName != panes[keptCount].DisplayName)
            {
                _panes[keptCount].DisplayName = panes[keptCount].DisplayName;
                hasRenamedPane = true;
            }

            keptCount++;
        }

        if (keptCount < panes.Count || keptCount < _panes.Count)
        {
            // A shorter path leaves placeholders behind like closed panes do, see RemovePanesFrom, and new panes take
            // them.
            var previousPaneCount = _panes.Count + _placeholderCount;
            _panes.RemoveRange(keptCount, _panes.Count - keptCount);
            _panes.AddRange(panes.GetRange(keptCount, panes.Count - keptCount));
            _placeholderCount = Math.Max(0, previousPaneCount - _panes.Count);
            ScrollToLastPaneAfterRender();
        }
        else if (!hasRenamedPane)
        {
            return false;
        }

        RebuildBreadcrumbs();
        return true;
    }

    // Adds the panes that Path reaches to the empty list. Returns whether it reaches all of Path.
    private bool BuildPanesFromPath(List<SubjectPane> panes)
    {
        if (Root == null) return false;

        // Get registry from root's context
        _subjectRegistry = RootContext?.GetService<ISubjectRegistry>();

        // Always show root as first pane
        panes.Add(new SubjectPane
        {
            Subject = Root,
            DisplayName = "Root",
            Path = "/",
            PropertyName = null,
            Index = null
        });

        if (string.IsNullOrEmpty(Path))
            return true;

        // Use RoutePathResolver to navigate the path and build panes
        var pathSegments = Path.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Select(Uri.UnescapeDataString)
            .ToArray();

        IInterceptorSubject currentSubject = Root;
        var currentPath = "/";
        var i = 0;

        while (i < pathSegments.Length)
        {
            var propertyName = pathSegments[i++];
            var registered = currentSubject.TryGetRegisteredSubject();
            var property = registered?.TryGetProperty(propertyName);

            if (property is not { CanContainSubjects: true })
            {
                // Try [InlinePaths] fallback
                var inlinePathsPropertyName = InlinePathsAttribute.GetInlinePathsPropertyName(currentSubject.GetType());
                if (inlinePathsPropertyName != null)
                {
                    property = registered?.TryGetProperty(inlinePathsPropertyName);
                    if (property is { CanContainSubjects: true })
                    {
                        // This segment is actually a child key, not a property name
                        var childKey = propertyName;
                        var child = SubjectPathResolverExtensions.FindChildByIndex(property, childKey);
                        if (child != null)
                        {
                            currentPath = $"{currentPath}{childKey}/";
                            var childDisplayName = GetChildDisplayName(property, child, childKey);
                            panes.Add(new SubjectPane { Subject = child, DisplayName = childDisplayName, Path = currentPath.TrimEnd('/'), PropertyName = inlinePathsPropertyName, Index = childKey });
                            currentSubject = child;
                            continue;
                        }
                    }
                }
                return false;
            }

            // Check for collections/dictionaries BEFORE subject references
            // because IDictionary<string, IInterceptorSubject> is an interface (IsSubjectReference would be true)
            // but it's actually a dictionary of subjects, not a single subject reference
            if (property.IsSubjectDictionary || property.IsSubjectCollection)
            {
                // Collection/Dictionary - next segment is the index/key
                if (i >= pathSegments.Length)
                    return false;

                var indexStr = pathSegments[i++];
                var child = SubjectPathResolverExtensions.FindChildByIndex(property, indexStr);
                if (child == null)
                    return false;

                currentPath = $"{currentPath}{propertyName}/{indexStr}/";
                var displayName = GetChildDisplayName(property, child, indexStr);
                panes.Add(new SubjectPane { Subject = child, DisplayName = displayName, Path = currentPath.TrimEnd('/'), PropertyName = propertyName, Index = indexStr });
                currentSubject = child;
            }
            else if (property.IsSubjectReference)
            {
                // Direct subject property
                if (property.GetValue() is not IInterceptorSubject child)
                    return false;

                currentPath = $"{currentPath}{propertyName}/";
                var displayName = GetChildDisplayName(property, child, index: null);
                panes.Add(new SubjectPane { Subject = child, DisplayName = displayName, Path = currentPath.TrimEnd('/'), PropertyName = propertyName, Index = null });
                currentSubject = child;
            }
            else
            {
                // Unknown property type with children - shouldn't happen
                return false;
            }
        }

        return true;
    }

    private void OnPropertyClick(SubjectPane clickedPane, string propertyName, object? index, IInterceptorSubject subject)
    {
        // Find the index of the clicked pane
        var paneIndex = _panes.IndexOf(clickedPane);
        if (paneIndex < 0) return;

        RemovePanesFrom(paneIndex + 1);

        // Build display name and path using slash notation
        var isInlinePathsProperty = InlinePathsAttribute.IsInlinePathsProperty(
            clickedPane.Subject.GetType(), propertyName);
        var property = clickedPane.Subject.TryGetRegisteredSubject()?.TryGetProperty(propertyName);
        var displayName = property is not null
            ? GetChildDisplayName(property, subject, index)
            : index?.ToString() ?? propertyName;
        var parentPath = clickedPane.Path.TrimEnd('/');
        var path = index != null
            ? (isInlinePathsProperty
                ? $"{parentPath}/{PathExtensions.FormatPathIndex(index)}"
                : $"{parentPath}/{propertyName}/{PathExtensions.FormatPathIndex(index)}")
            : $"{parentPath}/{propertyName}";

        // Add the new subject pane
        _panes.Add(new SubjectPane
        {
            Subject = subject,
            DisplayName = displayName,
            Path = path,
            PropertyName = propertyName,
            Index = index
        });

        // The new pane takes the place of the first pane it replaced.
        _placeholderCount = Math.Max(0, _placeholderCount - 1);
        ScrollToLastPaneAfterRender();

        // The clicked list can be older than a replacement of the subject that OnPathsChanged has already handled.
        FollowReplacedSubjects();
        UpdateUrl();
        StateHasChanged();
    }

    private void OnPaneClose(SubjectPane pane)
    {
        var paneIndex = _panes.IndexOf(pane);
        if (paneIndex <= 0) return; // Can't close the root pane

        RemovePanesFrom(paneIndex);
        UpdateUrl();
        StateHasChanged();
    }

    // Removes the pane at the index and all panes after it. Invisible placeholders keep their place until the row has
    // scrolled back to the remaining panes, see OnAfterRenderAsync: a row that gets shorter at once makes them jump.
    private void RemovePanesFrom(int index)
    {
        if (index >= _panes.Count)
        {
            return;
        }

        _placeholderCount += _panes.Count - index;
        _panes.RemoveRange(index, _panes.Count - index);
        ScrollToLastPaneAfterRender();
    }

    private async Task OnPaneDelete(SubjectPane pane, MethodMetadata deleteOperation)
    {
        if (pane.Subject.TryGetRegisteredSubject()?.TryGetProperty(deleteOperation.PropertyName)?.IsMethodEnabled() == false)
            return;

        var subjectName = SubjectDisplayExtensions.GetIdentifyingDisplayName(pane.DisplayName, pane.Index);

        // The one confirmation of the delete, also for an operation that requires confirmation.
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete",
            $"Delete '{subjectName}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await deleteOperation.InvokeAsync(null, ServiceProvider, CancellationToken.None);

            // Close this pane and any after it. A pending path can have dropped the pane on the change of the paths
            // that the delete caused, and a delete is a change of the panes by the user that ends it.
            var paneIndex = _panes.IndexOf(pane);
            if (paneIndex > 0)
            {
                RemovePanesFrom(paneIndex);
            }
            else if (!_isPathPending)
            {
                return;
            }

            UpdateUrl();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBoxAsync(
                "Delete Failed",
                $"Failed to delete: {ex.Message}",
                yesText: "OK");
        }
    }

    private void UpdateUrl()
    {
        RebuildBreadcrumbs();

        // The last breadcrumb links to the last pane.
        var url = _breadcrumbs[^1].Href!;

        // Store the URL so OnLocationChanged knows to ignore this navigation
        _lastNavigatedUrl = url;
        _isPathPending = false;

        // The URL has no property to highlight, and the last pane changed before OnLocationChanged learns of it.
        _highlightedProperty = null;
        NavigationManager.NavigateTo(url, replace: true);
    }

    private void RebuildBreadcrumbs()
    {
        _breadcrumbs.Clear();
        if (_panes.Count == 0)
        {
            return;
        }

        _breadcrumbs.Add(new BreadcrumbItem("Root", BrowserUrls.Root));

        var breadcrumbParts = new List<string>();
        for (var i = 1; i < _panes.Count; i++)
        {
            var pane = _panes[i];

            // For [InlinePaths] properties, only add the index (key), not the property name
            var isInlinePathsProp = pane.PropertyName != null &&
                InlinePathsAttribute.IsInlinePathsProperty(_panes[i - 1].Subject.GetType(), pane.PropertyName);

            if (isInlinePathsProp && pane.Index != null)
            {
                // Only add the key for [InlinePaths] properties
                breadcrumbParts.Add(PathExtensions.FormatPathIndex(pane.Index));
            }
            else
            {
                if (pane.PropertyName != null)
                {
                    breadcrumbParts.Add(pane.PropertyName);
                }
                if (pane.Index != null)
                {
                    breadcrumbParts.Add(PathExtensions.FormatPathIndex(pane.Index));
                }
            }

            _breadcrumbs.Add(new BreadcrumbItem(pane.DisplayName, BrowserUrls.Create(breadcrumbParts)));
        }
    }

    // Renders the browser only when one of its panes changed, not on every change of the paths in the graph.
    private void OnPathsChanged()
    {
        if (_disposed)
        {
            return;
        }

        // A pending path shows what it reaches now, not the subjects that its panes showed before, such as an item that
        // moved to another index.
        if (_isPathPending)
        {
            if (RebuildFromPath())
            {
                StateHasChanged();
            }

            return;
        }

        var paneCount = _panes.Count;
        if (!FollowReplacedSubjects())
        {
            return;
        }

        // Closed like a deleted subject's pane, so that the URL and a reload show what is left.
        if (_panes.Count < paneCount)
        {
            UpdateUrl();
        }
        else
        {
            RebuildBreadcrumbs();
        }

        StateHasChanged();
    }

    // Replaces the subject of each pane that its property and index no longer reach, and closes the panes from the first
    // that no longer resolves. Returns whether a pane changed.
    private bool FollowReplacedSubjects()
    {
        var hasChanged = false;
        for (var i = 1; i < _panes.Count; i++)
        {
            var pane = _panes[i];
            var property = _panes[i - 1].Subject.TryGetRegisteredSubject()?.TryGetProperty(pane.PropertyName!);
            if (property is not { CanContainSubjects: true })
            {
                ClosePanesFrom(i);
                return true;
            }

            var subject = FindChild(property, pane.Index);
            if (ReferenceEquals(subject, pane.Subject) || pane.Index is not null && ContainsChild(property, pane.Subject))
            {
                // A subject that moved to another index of a collection, after an item before it was removed, is the
                // one the pane shows, not the subject that now has its index.
                continue;
            }

            if (subject is null)
            {
                ClosePanesFrom(i);
                return true;
            }

            // The same pane and so the same element: the row keeps its scroll position.
            pane.Subject = subject;
            pane.DisplayName = GetChildDisplayName(property, subject, pane.Index);
            hasChanged = true;
        }

        return hasChanged;
    }

    private void ClosePanesFrom(int index)
    {
        RemovePanesFrom(index);

        // The highlighted property is one of the last pane, which is closed now.
        _highlightedProperty = null;
    }

    private static bool ContainsChild(RegisteredSubjectProperty property, IInterceptorSubject subject)
    {
        foreach (var child in property.Children)
        {
            if (ReferenceEquals(child.Subject, subject))
            {
                return true;
            }
        }

        return false;
    }

    private static IInterceptorSubject? FindChild(RegisteredSubjectProperty property, object? index)
        => index is not null
            ? SubjectPathResolverExtensions.FindChildByIndex(property, PathExtensions.FormatPathIndex(index))
            : property.GetValue() as IInterceptorSubject;

    // Breadcrumbs and pane titles use the same label as the child list of the parent pane.
    private static string GetChildDisplayName(RegisteredSubjectProperty property, IInterceptorSubject child, object? index)
        => property.GetChildDisplayName(new SubjectPropertyChild { Subject = child, Index = index });

    public void Dispose()
    {
        _disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        RowLayout.OnChange -= OnRowLayoutChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await DisposeScriptAsync(_jsModule, _paneFitting);
    }

    private static async ValueTask DisposeScriptAsync(IJSObjectReference? module, IJSObjectReference? paneFitting)
    {
        try
        {
            if (paneFitting != null)
            {
                await paneFitting.InvokeVoidAsync("dispose");
                await paneFitting.DisposeAsync();
            }

            if (module != null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected, nothing to clean up
        }
    }

    private class SubjectPane
    {
        public required IInterceptorSubject Subject { get; set; }

        public string DisplayName { get; set; } = "";
        
        public string Path { get; init; } = "";
        
        public string? PropertyName { get; init; }
        
        public object? Index { get; init; }
    }
}
