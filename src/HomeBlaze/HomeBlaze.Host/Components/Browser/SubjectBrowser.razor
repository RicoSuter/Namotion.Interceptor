@using HomeBlaze.Storage.Abstractions
@using Namotion.Interceptor.Registry.Attributes

@inherits HomeBlazorComponentBase

@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService

@implements IDisposable
@implements IAsyncDisposable

@* The panes take the height the breadcrumbs leave, which wrap on a narrow view. 66px is the top padding of the main
   content below the app bar plus 2px of slack. *@
<div style="display: flex; flex-direction: column; height: calc(100vh - 66px);">
    <MudStack Row="true" Class="browser-toolbar mb-2" Style="flex-shrink: 0;">
        <MudBreadcrumbs Items="_breadcrumbs" />
        <MudSpacer />
    </MudStack>

    @* The row always has its scrollbar: one that appears with the pane that makes the row scroll takes its height
       from the panes, which then all jump shorter. *@
    <div id="scrollContainer" @ref="_paneContainer"
         style="@($"flex: 1 1 auto; min-height: 0; width: 100%; overflow-x: scroll; overflow-y: hidden; display: flex; gap: {PaneGap}px; scroll-snap-type: var(--pane-snap, x mandatory);")">
        @for (var i = 0; i < _panes.Count; i++)
        {
            var pane = _panes[i];
            var isFirst = i == 0;
            var selectedChild = i < _panes.Count - 1 ? _panes[i + 1].Subject : null;

            @* Keyed by path: a subject that is reachable from itself can be in the row twice. *@
            <div @key="pane.Path" data-testid="subject-pane" class="pb-4"
                 style="@PaneStyle">
                <MudPaper Style="height: 100%; overflow: hidden;">
                    <SubjectPropertyPanel @key="pane.Subject"
                                          Subject="@pane.Subject"
                                          SubjectRegistry="@_subjectRegistry"
                                          Path="@pane.Path"
                                          SelectedChild="@selectedChild"
                                          CanClose="@(!isFirst)"
                                          OnPropertyClick="@((args) => OnPropertyClick(pane, args.PropertyName, args.Index, args.Subject))"
                                          OnClose="@(() => OnPaneClose(pane))"
                                          OnDelete="@(() => OnPaneDelete(pane))" />
                </MudPaper>
            </div>
        }

        @* Closed panes keep their place until the row has scrolled back, see RemovePanesFrom. A placeholder snaps like
           a pane: otherwise the row jumps off it at once when it replaces the pane the view rests on. *@
        @for (var i = 0; i < _placeholderCount; i++)
        {
            <div @key="@($"placeholder-{i}")" data-testid="subject-pane-placeholder" style="@PaneStyle"></div>
        }
    </div>
</div>

@code {
    // A pane is at least this wide, and wider when that lets a whole number of panes fill the view.
    private const int MinimumPaneWidth = 360;
    private const int PaneGap = 16;

    // The script sets --pane-width; until it has run, a pane is at most as wide as the view.
    private static readonly string PaneStyle =
        $"flex: 0 0 var(--pane-width, min({MinimumPaneWidth}px, 100%)); min-width: 0; scroll-snap-align: start;";

    [Parameter]
    public string? Path { get; set; }

    private readonly List<SubjectPane> _panes = [];
    private readonly List<BreadcrumbItem> _breadcrumbs = [];

    private string? _lastNavigatedUrl;
    private bool _scrollToLastPane;
    private int _placeholderCount;
    private int _scrollVersion;
    private bool _disposed;

    private ElementReference _paneContainer;
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _paneFitting;
    private ISubjectRegistry? _subjectRegistry;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        // Only rebuild if this is the initial load (no panes yet)
        // or if Path changed externally (not from our own navigation)
        if (_panes.Count == 0)
        {
            RebuildFromPath();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HomeBlaze.Host/Components/Browser/SubjectBrowser.razor.js");
                var paneFitting = await module.InvokeAsync<IJSObjectReference>("fitPanes", _paneContainer, MinimumPaneWidth, PaneGap);

                // The page can be left while the script loads, which is after DisposeAsync has run.
                if (_disposed)
                {
                    await DisposeScriptAsync(module, paneFitting);
                    return;
                }

                _paneFitting = paneFitting;
                _jsModule = module;
            }

            // The panes are fitted before the first scroll, which a render during the import above leaves to this one.
            if (_scrollToLastPane && _jsModule != null && !_disposed)
            {
                _scrollToLastPane = false;
                var scrollVersion = _scrollVersion;
                try
                {
                    await _jsModule.InvokeVoidAsync("scrollToPane", _paneContainer, _panes.Count - 1, !firstRender);
                }
                finally
                {
                    // The row has scrolled back to the remaining panes, unless the panes changed again in the meantime.
                    if (scrollVersion == _scrollVersion && _placeholderCount > 0 && !_disposed)
                    {
                        _placeholderCount = 0;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected, nothing to scroll
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // Asks for a scroll to the last pane once the changed panes are rendered. The version changes with the panes
    // rather than with the scroll, so a scroll that ends after a later change leaves the placeholders to that change.
    private void ScrollToLastPaneAfterRender()
    {
        _scrollToLastPane = true;
        _scrollVersion++;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location);

        // Skip if this is our own programmatic navigation
        if (_lastNavigatedUrl != null && uri.AbsolutePath == _lastNavigatedUrl)
        {
            _lastNavigatedUrl = null;
            return;
        }

        var segments = uri.AbsolutePath.TrimStart('/').Split('/');
        if (segments.Length > 0 && segments[0] == "browser")
        {
            var decodedSegments = segments.Skip(1).Select(Uri.UnescapeDataString);
            Path = string.Join("/", decodedSegments);
           
            RebuildFromPath();
            
            InvokeAsync(StateHasChanged);
        }
    }

    private void RebuildFromPath()
    {
        var previousPaneCount = _panes.Count + _placeholderCount;
        BuildPanesFromPath();

        // A shorter path leaves placeholders behind like closed panes do, see RemovePanesFrom.
        _placeholderCount = Math.Max(0, previousPaneCount - _panes.Count);
        ScrollToLastPaneAfterRender();
    }

    private void BuildPanesFromPath()
    {
        _panes.Clear();
        _breadcrumbs.Clear();

        if (Root == null) return;

        // Get registry from root's context
        _subjectRegistry = RootContext?.GetService<ISubjectRegistry>();

        // Always show root as first pane
        _panes.Add(new SubjectPane
        {
            Subject = Root,
            DisplayName = "Root",
            Path = "/",
            PropertyName = null,
            Index = null
        });

        _breadcrumbs.Add(new BreadcrumbItem("Root", "/browser"));

        if (string.IsNullOrEmpty(Path))
            return;

        // Use RoutePathResolver to navigate the path and build panes
        var pathSegments = Path.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Select(Uri.UnescapeDataString)
            .ToArray();

        IInterceptorSubject currentSubject = Root;
        var currentPathParts = new List<string>();
        var currentPath = "/";
        var i = 0;

        while (i < pathSegments.Length)
        {
            var propertyName = pathSegments[i++];
            var registered = currentSubject.TryGetRegisteredSubject();
            var property = registered?.TryGetProperty(propertyName);

            if (property is not { CanContainSubjects: true })
            {
                // Try [InlinePaths] fallback
                var inlinePathsPropertyName = InlinePathsAttribute.GetInlinePathsPropertyName(currentSubject.GetType());
                if (inlinePathsPropertyName != null)
                {
                    property = registered?.TryGetProperty(inlinePathsPropertyName);
                    if (property is { CanContainSubjects: true })
                    {
                        // This segment is actually a child key, not a property name
                        var childKey = propertyName;
                        var child = SubjectPathResolverExtensions.FindChildByIndex(property, childKey);
                        if (child != null)
                        {
                            currentPathParts.Add(childKey);
                            currentPath = $"{currentPath}{childKey}/";
                            var breadcrumbPath = "/browser/" + string.Join("/", currentPathParts);
                            var childDisplayName = GetChildDisplayName(property, child, childKey);
                            _breadcrumbs.Add(new BreadcrumbItem(childDisplayName, breadcrumbPath));
                            _panes.Add(new SubjectPane { Subject = child, DisplayName = childDisplayName, Path = currentPath.TrimEnd('/'), PropertyName = inlinePathsPropertyName, Index = childKey });
                            currentSubject = child;
                            continue;
                        }
                    }
                }
                break;
            }

            currentPathParts.Add(propertyName);

            // Check for collections/dictionaries BEFORE subject references
            // because IDictionary<string, IInterceptorSubject> is an interface (IsSubjectReference would be true)
            // but it's actually a dictionary of subjects, not a single subject reference
            if (property.IsSubjectDictionary || property.IsSubjectCollection)
            {
                // Collection/Dictionary - next segment is the index/key
                if (i >= pathSegments.Length)
                    break;

                var indexStr = pathSegments[i++];
                var child = SubjectPathResolverExtensions.FindChildByIndex(property, indexStr);
                if (child == null)
                    break;

                currentPathParts.Add(indexStr);
                currentPath = $"{currentPath}{propertyName}/{indexStr}/";
                var breadcrumbPath = "/browser/" + string.Join("/", currentPathParts);
                var displayName = GetChildDisplayName(property, child, indexStr);
                _breadcrumbs.Add(new BreadcrumbItem(displayName, breadcrumbPath));
                _panes.Add(new SubjectPane { Subject = child, DisplayName = displayName, Path = currentPath.TrimEnd('/'), PropertyName = propertyName, Index = indexStr });
                currentSubject = child;
            }
            else if (property.IsSubjectReference)
            {
                // Direct subject property
                if (property.GetValue() is not IInterceptorSubject child)
                    break;

                currentPath = $"{currentPath}{propertyName}/";
                var breadcrumbPath = "/browser/" + string.Join("/", currentPathParts);
                var displayName = GetChildDisplayName(property, child, index: null);
                _breadcrumbs.Add(new BreadcrumbItem(displayName, breadcrumbPath));
                _panes.Add(new SubjectPane { Subject = child, DisplayName = displayName, Path = currentPath.TrimEnd('/'), PropertyName = propertyName, Index = null });
                currentSubject = child;
            }
            else
            {
                // Unknown property type with children - shouldn't happen
                break;
            }
        }
    }

    private void OnPropertyClick(SubjectPane clickedPane, string propertyName, object? index, IInterceptorSubject subject)
    {
        // Find the index of the clicked pane
        var paneIndex = _panes.IndexOf(clickedPane);
        if (paneIndex < 0) return;

        RemovePanesFrom(paneIndex + 1);

        // Build display name and path using slash notation
        var isInlinePathsProperty = InlinePathsAttribute.IsInlinePathsProperty(
            clickedPane.Subject.GetType(), propertyName);
        var property = clickedPane.Subject.TryGetRegisteredSubject()?.TryGetProperty(propertyName);
        var displayName = property is not null
            ? GetChildDisplayName(property, subject, index)
            : index?.ToString() ?? propertyName;
        var parentPath = clickedPane.Path.TrimEnd('/');
        var path = index != null
            ? (isInlinePathsProperty
                ? $"{parentPath}/{index}"
                : $"{parentPath}/{propertyName}/{index}")
            : $"{parentPath}/{propertyName}";

        // Add the new subject pane
        _panes.Add(new SubjectPane
        {
            Subject = subject,
            DisplayName = displayName,
            Path = path,
            PropertyName = propertyName,
            Index = index
        });

        // The new pane takes the place of the first pane it replaced.
        _placeholderCount = Math.Max(0, _placeholderCount - 1);
        ScrollToLastPaneAfterRender();
        UpdateUrl();
        StateHasChanged();
    }

    private void OnPaneClose(SubjectPane pane)
    {
        var paneIndex = _panes.IndexOf(pane);
        if (paneIndex <= 0) return; // Can't close the root pane

        RemovePanesFrom(paneIndex);
        UpdateUrl();
        StateHasChanged();
    }

    // Removes the pane at the index and all panes after it. Invisible placeholders keep their place until the row has
    // scrolled back to the remaining panes, see OnAfterRenderAsync: a row that gets shorter at once makes them jump.
    private void RemovePanesFrom(int index)
    {
        if (index >= _panes.Count)
        {
            return;
        }

        _placeholderCount += _panes.Count - index;
        _panes.RemoveRange(index, _panes.Count - index);
        ScrollToLastPaneAfterRender();
    }

    private async Task OnPaneDelete(SubjectPane pane)
    {
        // Get subject name for confirmation dialog
        string subjectName;
        IStorageContainer? storage = null;

        if (pane.Subject is IStorageFile storageFile)
        {
            subjectName = storageFile.Name;
            storage = storageFile.Storage;
        }
        else if (pane.Subject is IConfigurable configurableSubject)
        {
            subjectName = SubjectDisplayExtensions.GetIdentifyingDisplayName(pane.DisplayName, pane.Index);

            // Find the parent IStorageContainer by traversing up the pane hierarchy
            for (int i = _panes.IndexOf(pane) - 1; i >= 0; i--)
            {
                if (_panes[i].Subject is IStorageContainer container)
                {
                    storage = container;
                    break;
                }
            }

            if (storage == null)
                return;
        }
        else
        {
            return;
        }

        // Show confirmation dialog
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Subject",
            $"Are you sure you want to delete '{subjectName}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            // Delete the subject from storage
            await storage.DeleteSubjectAsync(pane.Subject, CancellationToken.None);

            // Close this pane and any after it
            var paneIndex = _panes.IndexOf(pane);
            if (paneIndex > 0)
            {
                RemovePanesFrom(paneIndex);
                UpdateUrl();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBoxAsync(
                "Delete Failed",
                $"Failed to delete: {ex.Message}",
                yesText: "OK");
        }
    }

    private void UpdateUrl()
    {
        var pathParts = new List<string>();

        // Skip the first pane (root) when building path
        foreach (var pane in _panes.Skip(1))
        {
            // For [InlinePaths] properties, only add the index (key), not the property name
            var parentPane = _panes[_panes.IndexOf(pane) - 1];
            var isInlinePathsProperty = pane.PropertyName != null &&
                InlinePathsAttribute.IsInlinePathsProperty(parentPane.Subject.GetType(), pane.PropertyName);

            if (isInlinePathsProperty && pane.Index != null)
            {
                // Only add the key for [InlinePaths] properties
                pathParts.Add(Uri.EscapeDataString(pane.Index.ToString()!));
            }
            else
            {
                // Add property name
                if (pane.PropertyName != null)
                {
                    pathParts.Add(Uri.EscapeDataString(pane.PropertyName));
                }

                // Add index/key if present (for collections/dictionaries)
                if (pane.Index != null)
                {
                    pathParts.Add(Uri.EscapeDataString(pane.Index.ToString()!));
                }
            }
        }

        var url = "/browser" + (pathParts.Any() ? "/" + string.Join("/", pathParts) : "");

        // Store the URL so OnLocationChanged knows to ignore this navigation
        _lastNavigatedUrl = url;
        NavigationManager.NavigateTo(url, replace: true);

        // Rebuild breadcrumbs
        _breadcrumbs.Clear();
        _breadcrumbs.Add(new BreadcrumbItem("Root", "/browser"));

        var breadcrumbParts = new List<string>();
        foreach (var pane in _panes.Skip(1))
        {
            // For [InlinePaths] properties, only add the index (key), not the property name
            var parentPane = _panes[_panes.IndexOf(pane) - 1];
            var isInlinePathsProp = pane.PropertyName != null &&
                InlinePathsAttribute.IsInlinePathsProperty(parentPane.Subject.GetType(), pane.PropertyName);

            if (isInlinePathsProp && pane.Index != null)
            {
                // Only add the key for [InlinePaths] properties
                breadcrumbParts.Add(Uri.EscapeDataString(pane.Index.ToString()!));
            }
            else
            {
                if (pane.PropertyName != null)
                {
                    breadcrumbParts.Add(Uri.EscapeDataString(pane.PropertyName));
                }
                if (pane.Index != null)
                {
                    breadcrumbParts.Add(Uri.EscapeDataString(pane.Index.ToString()!));
                }
            }

            var breadcrumbPath = "/browser/" + string.Join("/", breadcrumbParts);
            _breadcrumbs.Add(new BreadcrumbItem(pane.DisplayName, breadcrumbPath));
        }
    }

    // Breadcrumbs and pane titles use the same label as the child list of the parent pane.
    private static string GetChildDisplayName(RegisteredSubjectProperty property, IInterceptorSubject child, object? index)
        => property.GetChildDisplayName(new SubjectPropertyChild { Subject = child, Index = index });

    public void Dispose()
    {
        _disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await DisposeScriptAsync(_jsModule, _paneFitting);
    }

    private static async ValueTask DisposeScriptAsync(IJSObjectReference? module, IJSObjectReference? paneFitting)
    {
        try
        {
            if (paneFitting != null)
            {
                await paneFitting.InvokeVoidAsync("dispose");
                await paneFitting.DisposeAsync();
            }

            if (module != null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected, nothing to clean up
        }
    }

    private class SubjectPane
    {
        public required IInterceptorSubject Subject { get; init; }

        public string DisplayName { get; init; } = "";
        
        public string Path { get; init; } = "";
        
        public string? PropertyName { get; init; }
        
        public object? Index { get; init; }
    }
}
