@using HomeBlaze.Host.TimeZones
@using MudBlazor
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@using HomeBlaze.Components.Abstractions.TimeZones

@inject ITimeZoneDisplay TimeZone
@inject TimeZoneInterop Interop
@inject BrowserPreferences Preferences
@inject ILogger<TimeZoneSelector> Logger

@* A submenu: it must be placed inside a MudMenu, whose list then shows it as an entry with the active zone. *@
<MudMenu @ref="_menu" MaxHeight="500" data-testid="time-zone-menu">
    <ActivatorContent>
        <span class="time-zone-menu-activator">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mud-menu-item-icon" />
            <span class="time-zone-menu-text">
                <span>Time zone</span>
                <span class="mud-typography-caption mud-text-secondary" data-testid="time-zone-current">@CurrentLabel</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ArrowRight" />
        </span>
    </ActivatorContent>
    <ChildContent>
    @* The submenu has no menu items of its own, so MudMenu does not close it on Escape. The search field takes the
       focus from the list wrapper that MudMenu focuses on opening, so that a key reaches this handler at once. *@
    <div style="min-width: min(320px, calc(100vw - 32px));" @onkeydown="OnKeyDownAsync">
        <div style="position: sticky; top: 0; z-index: 1; background-color: var(--mud-palette-surface);">
            <MudTextField @bind-Value="_search" Placeholder="Search timezone" Immediate="true" AutoFocus="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="px-3 py-2" />
        </div>
        <MudList T="string" Dense="true">
            <MudListItem T="string" OnClick="@SelectAutomaticAsync">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <span><b>Automatic</b> (this browser)</span>
                    @if (TimeZone.Preference.IsAutomatic)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                    }
                </div>
            </MudListItem>
            @foreach (var option in FilteredZones())
            {
                <MudListItem T="string" OnClick="@(() => SelectZoneAsync(option.Id))">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span>@option.DisplayName</span>
                        @if (IsZoneSelected(option.Id))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
    </div>
    </ChildContent>
</MudMenu>

@code {
    private static readonly IReadOnlyList<TimeZoneOption> Zones = TimeZoneCatalog.GetZones();
    private MudMenu? _menu;
    private string _search = string.Empty;
    private bool _skipRender;

    private string CurrentLabel => GetCurrentLabel(TimeZone);

    private string SelectedZoneId => GetSelectedZoneId(TimeZone);

    /// <summary>The active zone as the menu shows it: "Automatic (zone)", the pinned zone, or "Timezone" while unresolved.</summary>
    public static string GetCurrentLabel(ITimeZoneDisplay timeZone) => timeZone.IsResolved
        ? (timeZone.Preference.IsAutomatic ? $"Automatic ({GetSelectedZoneId(timeZone)})" : GetSelectedZoneId(timeZone))
        : "Timezone";

    /// <summary>
    /// The IANA id of the active zone. Never <c>TimeZoneInfo.Id</c>, which is the platform id: on
    /// Windows, resolving "Europe/Berlin" yields "W. Europe Standard Time", so comparing that against
    /// the IANA-keyed catalog never matches. The result is no check mark on any entry and the resolved
    /// zone duplicated at the top of the list on every render.
    /// </summary>
    private static string GetSelectedZoneId(ITimeZoneDisplay timeZone) =>
        timeZone.Preference.ZoneId
        ?? (timeZone.Zone is { } zone ? TimeZoneCatalog.CreateOption(zone)?.Id ?? zone.Id : string.Empty);

    private bool IsZoneSelected(string id) =>
        !TimeZone.Preference.IsAutomatic && TimeZone.IsResolved &&
        string.Equals(SelectedZoneId, id, StringComparison.OrdinalIgnoreCase);

    private IEnumerable<TimeZoneOption> AllZones()
    {
        // The catalog is built from the OS's canonical zones, so a sibling zone the browser reports
        // (for example Europe/Zurich, which collapses into Europe/Berlin on Windows) may be missing.
        // Make the currently resolved zone selectable by adding it when the catalog lacks it.
        var selected = SelectedZoneId;
        if (TimeZone.Zone is { } zone
            && !string.IsNullOrEmpty(selected)
            && !Zones.Any(option => string.Equals(option.Id, selected, StringComparison.OrdinalIgnoreCase))
            && TimeZoneCatalog.CreateOption(zone) is { } current)
        {
            return Zones.Prepend(current);
        }

        return Zones;
    }

    private IEnumerable<TimeZoneOption> FilteredZones() =>
        string.IsNullOrWhiteSpace(_search)
            ? AllZones()
            : AllZones().Where(zone => zone.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private async Task SelectAutomaticAsync()
    {
        try
        {
            // Detection can come back empty, and resolving that pins UTC. Keeping the previous zone
            // matches what the initializer already does with the same input.
            var browserZone = await Interop.GetBrowserTimeZoneAsync();
            if (!string.IsNullOrWhiteSpace(browserZone))
            {
                TimeZone.SetResolved(TimeZonePreference.Automatic, TimeZoneResolver.Resolve(browserZone));
                await Preferences.SetAsync(BrowserPreferenceKeys.TimeZone, TimeZonePreference.Automatic.ToCookieValue());
            }

            await CloseMenuAsync();
        }
        catch (Exception exception) when (IsInteropFailure(exception))
        {
            LogInteropFailure(exception);
        }
    }

    private async Task SelectZoneAsync(string id)
    {
        try
        {
            var preference = TimeZonePreference.Specific(id);
            TimeZone.SetResolved(preference, TimeZoneResolver.Resolve(id));
            await Preferences.SetAsync(BrowserPreferenceKeys.TimeZone, preference.ToCookieValue());
            await CloseMenuAsync();
        }
        catch (Exception exception) when (IsInteropFailure(exception))
        {
            LogInteropFailure(exception);
        }
    }

    // An exception out of a click handler tears the circuit down and replaces the application with an error page,
    // which a failed detection or a menu closed on a lost circuit does not justify. OperationCanceledException is in the
    // set because that is how the interop call timeout surfaces; it derives from neither JSException nor JSDisconnectedException.
    private static bool IsInteropFailure(Exception exception) =>
        exception is JSDisconnectedException or OperationCanceledException or JSException;

    private void LogInteropFailure(Exception exception)
    {
        if (exception is JSException)
        {
            Logger.LogWarning(exception, "Could not detect the browser time zone.");
        }
    }

    // Every other key changes nothing here, and a render would rebuild the whole list of zones once more per key.
    // The input event of the search field renders on its own.
    protected override bool ShouldRender()
    {
        if (_skipRender)
        {
            _skipRender = false;
            return false;
        }

        return true;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _menu is null)
        {
            _skipRender = true;
            return;
        }

        _search = string.Empty;
        await _menu.CloseMenuAsync();
    }

    private async Task CloseMenuAsync()
    {
        _search = string.Empty;
        if (_menu is not null)
        {
            await _menu.CloseAllMenusAsync();
        }
    }
}
