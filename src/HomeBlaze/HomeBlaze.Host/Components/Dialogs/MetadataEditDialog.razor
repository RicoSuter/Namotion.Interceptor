@using HomeBlaze.Components.Abstractions.Pages
@using System.Text.Json
@using System.Text.Json.Nodes

@inject ISnackbar Snackbar

<MudDialog data-testid="metadata-edit-dialog">
    <DialogContent>
        @if (IsFolder)
        {
            <MudTextField @bind-Value="_title"
                          Label="Title"
                          Placeholder="@TitlePlaceholder"
                          Clearable="true"
                          data-testid="metadata-title" />
        }
        <MudTextField @bind-Value="_navigationTitle"
                      Label="Navigation title"
                      Placeholder="@NavigationTitlePlaceholder"
                      Clearable="true"
                      data-testid="metadata-navigation-title" />
        <MudTextField @bind-Value="_icon"
                      Label="Icon"
                      Placeholder="@IconPlaceholder"
                      Clearable="true"
                      DebounceInterval="300"
                      Adornment="Adornment.End"
                      AdornmentIcon="@SubjectIconExtensions.ResolveMudBlazorIcon(GetValue(_icon) ?? IconPlaceholder)"
                      HelperText="A MudBlazor icon name, such as Dashboard or Settings"
                      data-testid="metadata-icon" />
        @if (!IsFolder)
        {
            <MudSelect T="NavigationLocation?"
                       @bind-Value="_location"
                       Label="Location"
                       Placeholder="Sidebar"
                       Clearable="true"
                       data-testid="metadata-location">
                <MudSelectItem T="NavigationLocation?" Value="@((NavigationLocation?)NavigationLocation.NavBar)">Sidebar</MudSelectItem>
                <MudSelectItem T="NavigationLocation?" Value="@((NavigationLocation?)NavigationLocation.AppBar)">Top bar</MudSelectItem>
            </MudSelect>
            <MudSelect T="AppBarAlignment?"
                       @bind-Value="_alignment"
                       Label="Alignment"
                       Placeholder="Left"
                       Clearable="true"
                       Disabled="@(_location != NavigationLocation.AppBar)"
                       data-testid="metadata-alignment">
                <MudSelectItem T="AppBarAlignment?" Value="@((AppBarAlignment?)AppBarAlignment.Left)">Left</MudSelectItem>
                <MudSelectItem T="AppBarAlignment?" Value="@((AppBarAlignment?)AppBarAlignment.Right)">Right</MudSelectItem>
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveAsync" Disabled="@_isSaving" data-testid="metadata-save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>The folder or the subject whose metadata is edited. A storage is edited as the subject of its file.</summary>
    [Parameter, EditorRequired] public IInterceptorSubject Owner { get; set; } = default!;

    /// <summary>Whether the owner is a folder, an <see cref="IMetadataContainer"/> edited by its own metadata.</summary>
    [Parameter] public bool IsFolder { get; set; }

    [Parameter] public string? TitlePlaceholder { get; set; }

    [Parameter] public string? NavigationTitlePlaceholder { get; set; }

    [Parameter] public string IconPlaceholder { get; set; } = "Article";

    private string? _title;
    private string? _navigationTitle;
    private string? _icon;
    private NavigationLocation? _location;
    private AppBarAlignment? _alignment;
    private bool _isSaving;

    protected override void OnInitialized()
    {
        if (IsFolder)
        {
            var metadata = ((IMetadataContainer)Owner).Metadata;
            _title = metadata?.Title;
            _navigationTitle = metadata?.NavigationTitle;
            _icon = metadata?.Icon;
        }
        else if (Owner.TryGetSubjectMetadata() is { } metadata)
        {
            _navigationTitle = metadata.NavigationTitle;
            _icon = metadata.Icon;
            _location = metadata.Location;
            _alignment = metadata.Alignment;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task SaveAsync()
    {
        if (_isSaving)
            return;

        if (Owner.TryGetMetadataSubject() is not { } metadataSubject)
        {
            Snackbar.Add("Error saving metadata: the item is no longer in a storage.", Severity.Error);
            return;
        }

        _isSaving = true;
        try
        {
            // Every field the dialog shows, so that a field left empty removes its key and the other keys stay.
            var values = new JsonObject
            {
                [MetadataKeys.NavigationTitle] = GetValue(_navigationTitle),
                [MetadataKeys.Icon] = GetValue(_icon)
            };
            if (IsFolder)
            {
                values.Insert(0, MetadataKeys.Title, GetValue(_title));
            }
            else
            {
                values[MetadataKeys.Location] = _location?.ToString();
                values[MetadataKeys.Alignment] = _location == NavigationLocation.AppBar ? _alignment?.ToString() : null;
            }

            await metadataSubject.SetMetadataAsync(JsonElement.Parse(values.ToJsonString()), CancellationToken.None);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Error saving metadata: {exception.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string? GetValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>
    /// Shows the dialog for the metadata of a folder, or of a subject stored in one.
    /// </summary>
    public static Task<IDialogReference> ShowAsync(
        IDialogService dialogService,
        IInterceptorSubject owner,
        bool isFolder,
        string title,
        string? titlePlaceholder,
        string? navigationTitlePlaceholder,
        string iconPlaceholder)
    {
        var parameters = new DialogParameters<MetadataEditDialog>
        {
            { x => x.Owner, owner },
            { x => x.IsFolder, isFolder },
            { x => x.TitlePlaceholder, titlePlaceholder },
            { x => x.NavigationTitlePlaceholder, navigationTitlePlaceholder },
            { x => x.IconPlaceholder, iconPlaceholder }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        return dialogService.ShowAsync<MetadataEditDialog>(title, parameters, options);
    }
}
