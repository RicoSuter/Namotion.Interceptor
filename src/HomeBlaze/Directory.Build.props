<Project>
  <!-- MSBuild stops at the nearest Directory.Build.props, so without this import the HomeBlaze tree
       silently opts out of the repository defaults, including TreatWarningsAsErrors. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Disable NuGet package generation for all HomeBlaze projects -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
