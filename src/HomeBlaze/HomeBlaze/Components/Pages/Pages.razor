@page "/pages/{*Path}"

@using HomeBlaze.Abstractions
@using HomeBlaze.Components.Abstractions.Attributes
@using HomeBlaze.Components.Editors
@using HomeBlaze.Services.Components
@using Microsoft.AspNetCore.Components.Sections
@using Namotion.Interceptor.Blazor
@using Toolbelt.Blazor.HotKeys2

@inherits HomeBlazorComponentBase
@implements IAsyncDisposable

@inject SubjectComponentRegistry ComponentRegistry
@inject SubjectPathResolver PathResolver
@inject DeveloperModeService DeveloperMode
@inject HotKeys HotKeys

<PageTitle>@_title - HomeBlaze</PageTitle>

<TrackingScope Context="_subject?.Context" ShowDebugInfo="DeveloperMode.IsEnabled">
    @if (_subject == null)
    {
        <MudAlert Severity="Severity.Warning">Subject not found at path: @Path</MudAlert>
    }
    else
    {
        <CascadingValue Value="@IsEditing" Name="IsEditing">
        <CascadingValue Value="_widgetSelection" IsFixed="true">
            @if (_editMode == PageEditMode.Split && CanEdit())
            {
                <div data-testid="edit-splitter">
                    <MudSplitter @bind-Dimension="_splitDimension"
                                 Height="calc(100vh - 80px)"
                                 EnableSlide="true"
                                 OnDoubleClicked="ResetSplitDimension">
                        <StartContent>
                            <div style="width: 100%; height: 100%; overflow-y: auto;" @onclick="ClearSelectionCallback">
                                <SubjectComponent @key="_componentKey"
                                                  Subject="@_subject"
                                                  Type="SubjectComponentType.Page"/>
                            </div>
                        </StartContent>
                        <EndContent>
                            <div class="d-flex flex-column" style="height: 100%; width: 100%">
                                <div class="d-flex align-center justify-space-between gap-2 px-4 py-2" style="height: 56px; flex-shrink: 0; border-bottom: 1px solid var(--mud-palette-divider); width: 100%">
                                    <div class="d-flex gap-2">
                                        <SectionOutlet SectionName="EditActions" />
                                    </div>
                                    @RenderEditMenu()
                                </div>
                                <div style="flex-grow: 1; overflow: hidden; display: flex; flex-direction: column; width: 100%">
                                    <div style="flex-grow: 1; overflow: hidden; min-height: 0; width: 100%">
                                        <SubjectEditPanel @ref="_editPanel" Subject="@_subject" IsValidChanged="OnEditPanelIsValidChanged"/>
                                    </div>

                                    <div class="d-flex justify-end gap-2 pa-4" style="border-top: 1px solid var(--mud-palette-divider); flex-shrink: 0; width: 100%">
                                        <span data-testid="save-button">
                                            <MudButton Color="Color.Primary"
                                                       OnClick="OnSaveClicked"
                                                       Disabled="@(!_isEditPanelValid)">Save (Ctrl+S)</MudButton>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </EndContent>
                    </MudSplitter>
                </div>
            }
            else if (_editMode == PageEditMode.Source && CanEdit())
            {
                <div class="d-flex flex-column" style="height: calc(100vh - 80px); width: 100%">
                    <div class="d-flex align-center justify-space-between gap-2 px-4 py-2" style="height: 56px; flex-shrink: 0; border-bottom: 1px solid var(--mud-palette-divider); width: 100%">
                        <div class="d-flex gap-2">
                            <SectionOutlet SectionName="EditActions" />
                        </div>
                        @RenderEditMenu()
                    </div>
                    <div style="flex-grow: 1; overflow: hidden; display: flex; flex-direction: column; width: 100%">
                        <div style="flex-grow: 1; overflow: hidden; min-height: 0; width: 100%">
                            <SubjectEditPanel @ref="_editPanel" Subject="@_subject" IsValidChanged="OnEditPanelIsValidChanged"/>
                        </div>

                        <div class="d-flex justify-end gap-2 pa-4" style="border-top: 1px solid var(--mud-palette-divider); flex-shrink: 0; width: 100%">
                            <span data-testid="save-button">
                                <MudButton Color="Color.Primary"
                                           OnClick="OnSaveClicked"
                                           Disabled="@(!_isEditPanelValid)">Save (Ctrl+S)</MudButton>
                            </span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @if (CanEdit())
                {
                    <div style="position: absolute; top: 80px; right: 20px; z-index: 100;">
                        @RenderEditMenu()
                    </div>
                }

                @* View or Inline mode - show page component. A click that no widget took clears the selection. In edit mode the
                   area reaches down to the bottom of the window, so that a short page still has empty space to click; the 160px
                   cover the app bar and the paddings of the layout, so that the area alone does not make the page scroll. *@
                <div style="@(IsEditing ? "min-height: calc(100vh - 160px);" : null)" @onclick="ClearSelectionCallback">
                    <SubjectComponent @key="_componentKey"
                                      Subject="@_subject"
                                      Type="SubjectComponentType.Page"/>
                </div>
            }
        </CascadingValue>
        </CascadingValue>
    }
</TrackingScope>

@code {
    [Parameter] public string? Path { get; set; }

    private IInterceptorSubject? _subject;
    private string _title = "";
    private int _componentKey;
    private PageEditMode _editMode = PageEditMode.View;
    private double _splitDimension = 50;
    private SubjectEditPanel? _editPanel;

    // Stays false until the panel reports, which it does once its editor is ready and can be saved.
    private bool _isEditPanelValid;

    private HotKeysContext? _hotKeysContext;

    private readonly WidgetSelection _widgetSelection = new();

    // The selection is the receiver, so that a click on empty page space renders only the widget that it deselects.
    private EventCallback<MouseEventArgs> _clearSelectionCallback;

    // How long the page waits after a change of the paths before it renders. Attaches and detaches come in bursts,
    // such as the subjects of a device that connects, and every one of them inside this time ends in the same render.
    // Nobody waits for a device that appears, so the time is long enough to keep a graph that changes all the time
    // from rendering every open page more than a few times per second.
    private static readonly TimeSpan PathsChangedRenderDelay = TimeSpan.FromMilliseconds(250);

    private int _isPathsChangedRenderPending;
    private volatile bool _isDisposed;

    private enum PageEditMode
    {
        View, // Read-only rendered page
        Split, // Page on left, Monaco editor on right
        Source, // Full Monaco editor only
        Inline // View with inline editing on widgets
    }

    private bool IsEditing => _editMode != PageEditMode.View;
    private bool ShowEditor => _editMode is PageEditMode.Split or PageEditMode.Source;

    protected override void OnInitialized()
    {
        // The resolver caches an absolute path, so a widget or an expression reads no property on the way to its target
        // and the tracking scope does not see that an entry on the way appeared, was replaced or left.
        PathResolver.PathsChanged += OnPathsChanged;
        _clearSelectionCallback = EventCallback.Factory.Create<MouseEventArgs>(_widgetSelection, _widgetSelection.Clear);
    }

    // Runs on the thread that changes the graph, inside the lock of the lifecycle interceptor.
    private void OnPathsChanged()
    {
        if (Interlocked.Exchange(ref _isPathsChangedRenderPending, 1) == 0)
        {
            // Not Task.Run, which would carry the execution context of the writing thread into the render: that context
            // can hold the read recorder of the tracking scope of another page.
            ThreadPool.UnsafeQueueUserWorkItem(static page => _ = page.RenderAfterPathsChangedAsync(), this, preferLocal: false);
        }
    }

    private async Task RenderAfterPathsChangedAsync()
    {
        await Task.Delay(PathsChangedRenderDelay).ConfigureAwait(false);

        try
        {
            await InvokeAsync(() =>
            {
                // Cleared on the dispatcher, as the last thing before the render. A change that comes while this callback
                // still waits for the dispatcher is covered by the render below, so it queues nothing and at most one
                // callback of a page waits there. A change that comes during the render finds the flag clear and causes another one.
                Volatile.Write(ref _isPathsChangedRenderPending, 0);

                if (!_isDisposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch
        {
            // The dispatch can fail before the callback runs, for example when the circuit is gone. A flag that stayed set
            // would keep the page from ever rendering for a change of the paths again.
            Volatile.Write(ref _isPathsChangedRenderPending, 0);
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hotKeysContext = HotKeys.CreateContext()
                .Add(ModCode.Ctrl, Code.S, OnCtrlS, exclude: Exclude.None)
                // Escape in a dialog belongs to the dialog, and the widget that the dialog edits stays selected.
                .Add(Code.Escape, OnEscape, new HotKeyOptions { ExcludeSelector = ".mud-dialog-container, .mud-dialog-container *" });
        }

        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        LoadSubject();
        SetEditMode(PageEditMode.View);
    }

    private void LoadSubject()
    {
        _subject = null;
        _title = "";

        var path = Path;
        if (string.IsNullOrEmpty(path) || Root is null)
            return;

        var subject = PathResolver.ResolveSubject(path, PathStyle.Route);
        if (subject != null)
        {
            if (subject is ITitleProvider titleProvider)
            {
                _title = titleProvider.Title ?? subject.GetType().Name;
            }
            else
            {
                _title = subject.GetType().Name;
            }

            _subject = subject;
        }
    }

    private bool CanEdit()
    {
        if (_subject == null) return false;

        var hasEditComponent = ComponentRegistry.HasComponent(
            _subject.GetType(),
            SubjectComponentType.Edit);

        return hasEditComponent || _subject.HasConfigurationProperties();
    }

    private void SetEditMode(PageEditMode mode)
    {
        if (mode == _editMode)
        {
            return;
        }

        _editMode = mode;
        _widgetSelection.Clear();

        // Every mode with an editor has an edit panel of its own, which reports its validity once it is ready.
        _isEditPanelValid = false;
    }

    // Only an edited page has the handler, so that a click on a viewed page renders nothing.
    private EventCallback<MouseEventArgs> ClearSelectionCallback
        => IsEditing ? _clearSelectionCallback : default;

    private void OnEscape()
    {
        _widgetSelection.Clear();
    }

    private void OnEditPanelIsValidChanged(bool isValid)
    {
        _isEditPanelValid = isValid;
    }

    private async Task OnCtrlS()
    {
        if (!ShowEditor || _editPanel is not { } editPanel)
        {
            return;
        }

        // The shortcut does not depend on the button, so it reads the validity itself, which the button then follows.
        await editPanel.RefreshIsValidAsync();
        if (editPanel.IsValid)
        {
            await OnSaveClicked();
        }
    }

    private string GetModeIcon() => _editMode switch
    {
        PageEditMode.View => Icons.Material.Filled.Visibility,
        PageEditMode.Split => Icons.Material.Filled.VerticalSplit,
        PageEditMode.Source => Icons.Material.Filled.Code,
        PageEditMode.Inline => Icons.Material.Filled.Edit,
        _ => Icons.Material.Filled.Visibility
    };

    private async Task OnSaveClicked()
    {
        if (_editPanel is not { } editPanel)
        {
            return;
        }

        if (await editPanel.SaveAsync(CancellationToken.None))
        {
            _componentKey++;
        }
        else
        {
            // The button may have been enabled from a validity the form no longer has.
            await editPanel.RefreshIsValidAsync();
        }

        StateHasChanged();
    }

    private void ResetSplitDimension()
    {
        _splitDimension = 50;
    }

    private RenderFragment RenderEditMenu() => __builder =>
    {
        <MudMenu Icon="@GetModeIcon()"
                 data-testid="edit-mode-menu"
                 Color="@(IsEditing ? Color.Primary : Color.Default)"
                 Variant="Variant.Filled"
                 Size="Size.Small"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                         IconColor="@(_editMode == PageEditMode.View ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetEditMode(PageEditMode.View))">
                View
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.VerticalSplit"
                         IconColor="@(_editMode == PageEditMode.Split ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetEditMode(PageEditMode.Split))">
                Split
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Code"
                         IconColor="@(_editMode == PageEditMode.Source ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetEditMode(PageEditMode.Source))">
                Source
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                         IconColor="@(_editMode == PageEditMode.Inline ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetEditMode(PageEditMode.Inline))">
                Inline
            </MudMenuItem>
        </MudMenu>
    };

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        PathResolver.PathsChanged -= OnPathsChanged;

        if (_hotKeysContext != null)
        {
            await _hotKeysContext.DisposeAsync();
        }
    }
}
