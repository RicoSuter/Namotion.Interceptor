@page "/"

@using HomeBlaze.Components.Abstractions.Pages
@using Microsoft.Extensions.Logging

@inherits HomeBlazorComponentBase

@inject NavigationItemResolver NavigationResolver
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        RedirectToDefaultPage();
    }

    private void RedirectToDefaultPage()
    {
        if (Root == null)
            return;

        // Outside the try: during prerendering a navigation throws to redirect the response.
        Navigation.NavigateTo(GetDefaultPageUrl(Root));
    }

    private string GetDefaultPageUrl(IInterceptorSubject root)
    {
        try
        {
            // The first page of the top bar as it shows it: left aligned first, then right, each in navigation order.
            var appBarItems = NavigationResolver.GetAppBarItems(root);
            var appBarPage = appBarItems.FirstOrDefault(i => i.Alignment == AppBarAlignment.Left) ?? appBarItems.FirstOrDefault();
            if (appBarPage != null)
                return appBarPage.PageUrl;

            var navBarPage = NavigationResolver.GetChildItems(root)
                .FirstOrDefault(i => i is { IsPage: true, Location: NavigationLocation.NavBar });
            if (navBarPage != null)
                return navBarPage.PageUrl;
        }
        catch (Exception exception)
        {
            // The graph changes on other threads while this reads it, and the browser always opens.
            Logger.LogWarning(exception, "Error getting the default page");
        }

        return "/browser";
    }
}
