@page "/"

@using HomeBlaze.Components.Abstractions.Pages

@inherits HomeBlazorComponentBase

@inject NavigationItemResolver NavigationResolver
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        RedirectToDefaultPage();
    }

    private void RedirectToDefaultPage()
    {
        if (Root == null)
            return;

        var items = NavigationResolver.GetChildItems(Root).Where(i => i.IsPage).ToList();

        // Try first AppBar page (left aligned first, then right, then the menu)
        var appBarPage = items
            .Where(i => i.Location == NavigationLocation.AppBar)
            .OrderBy(i => i.Alignment switch { AppBarAlignment.Left => 0, AppBarAlignment.Right => 1, _ => 2 })
            .ThenBy(i => i.Order)
            .FirstOrDefault();

        if (appBarPage != null)
        {
            Navigation.NavigateTo(appBarPage.PageUrl, replace: true);
            return;
        }

        // Try first NavBar page
        var navBarPage = items
            .Where(i => i.Location == NavigationLocation.NavBar)
            .OrderBy(i => i.Order)
            .FirstOrDefault();

        if (navBarPage != null)
        {
            Navigation.NavigateTo(navBarPage.PageUrl, replace: true);
            return;
        }

        // Fallback to browser
        Navigation.NavigateTo("/browser", replace: true);
    }
}
