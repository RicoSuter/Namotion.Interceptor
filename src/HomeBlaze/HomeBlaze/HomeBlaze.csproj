    <ItemGroup>
        <Watch Remove="Data/**/*" />
        <Watch Remove="Seed/**/*" />
        <ProjectReference Include="..\Namotion.Devices.Gpio.HomeBlaze\Namotion.Devices.Gpio.HomeBlaze.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Gpio\Namotion.Devices.Gpio.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Luxtronik\Namotion.Devices.Luxtronik.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Luxtronik.HomeBlaze\Namotion.Devices.Luxtronik.HomeBlaze.csproj" />
        <ProjectReference Include="..\Namotion.Devices.MyStrom\Namotion.Devices.MyStrom.csproj" />
        <ProjectReference Include="..\Namotion.Devices.MyStrom.HomeBlaze\Namotion.Devices.MyStrom.HomeBlaze.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Shelly\Namotion.Devices.Shelly.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Shelly.HomeBlaze\Namotion.Devices.Shelly.HomeBlaze.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Wallbox\Namotion.Devices.Wallbox.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Wallbox.HomeBlaze\Namotion.Devices.Wallbox.HomeBlaze.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Ecowitt\Namotion.Devices.Ecowitt.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Ecowitt.HomeBlaze\Namotion.Devices.Ecowitt.HomeBlaze.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Philips.Hue\Namotion.Devices.Philips.Hue.csproj" />
        <ProjectReference Include="..\Namotion.Devices.Philips.Hue.HomeBlaze\Namotion.Devices.Philips.Hue.HomeBlaze.csproj" />
        <ProjectReference Include="..\HomeBlaze.AI\HomeBlaze.AI.csproj" />
        <ProjectReference Include="..\HomeBlaze.History.Mcp\HomeBlaze.History.Mcp.csproj" />
        <ProjectReference Include="..\HomeBlaze.Host\HomeBlaze.Host.csproj" />
        <ProjectReference Include="..\HomeBlaze.Samples\HomeBlaze.Samples.csproj" />
        <ProjectReference Include="..\HomeBlaze.OpcUa\HomeBlaze.OpcUa.csproj" />
        <ProjectReference Include="..\HomeBlaze.OpcUa.Blazor\HomeBlaze.OpcUa.Blazor.csproj" />
        <ProjectReference Include="..\HomeBlaze.History.InMemory\HomeBlaze.History.InMemory.csproj" />
        <ProjectReference Include="..\HomeBlaze.History.InMemory.Blazor\HomeBlaze.History.InMemory.Blazor.csproj" />
        <ProjectReference Include="..\HomeBlaze.History.Sqlite\HomeBlaze.History.Sqlite.csproj" />
        <ProjectReference Include="..\HomeBlaze.History.Sqlite.Blazor\HomeBlaze.History.Sqlite.Blazor.csproj" />
        <ProjectReference Include="..\HomeBlaze.Plugins\HomeBlaze.Plugins.csproj" />
        <ProjectReference Include="..\HomeBlaze.ServiceDefaults\HomeBlaze.ServiceDefaults.csproj" />
        <ProjectReference Include="..\MyCompany.SamplePlugin1.HomeBlaze\MyCompany.SamplePlugin1.HomeBlaze.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\MyCompany.SamplePlugin2.HomeBlaze\MyCompany.SamplePlugin2.HomeBlaze.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\..\Namotion.Interceptor.Generator\Namotion.Interceptor.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <PackageReference Include="BlazorMonaco" />
        <PackageReference Include="CodeBeam.MudBlazor.Extensions" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <!-- Development data is read from the project folder, never from the output. -->
        <Content Update="Data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
        <None Remove="Data\History\**;Data\OpcUa\**" />
        <!-- Starting set for new installations, copied into an empty data folder on first start.
             The docs are linked from the development data so they exist only once in the repository. -->
        <Content Update="Seed\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="Seed\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <!-- Plugins\*.nupkg are generated by sample plugin builds (GeneratePackageOnBuild).
             A Content Include glob would be evaluated before those targets run on clean builds.
             Copied via CopyPluginNupkgs target below instead. -->
    </ItemGroup>

    <PropertyGroup>
        <ContainerRepository>homeblaze</ContainerRepository>
        <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
        <!-- SDK-built images own every file as root, so the app user could not write /data.
             Root also gives access to GPIO devices. -->
        <ContainerUser>root</ContainerUser>
    </PropertyGroup>

    <ItemGroup>
        <ContainerPort Include="8080" Type="tcp" />
        <ContainerPort Include="4840" Type="tcp" />
        <ContainerEnvironmentVariable Include="HomeBlaze__RootConfigFile" Value="/data/Root.json" />
        <ContainerEnvironmentVariable Include="HomeBlaze__SeedDirectory" Value="/app/Seed" />
    </ItemGroup>

    <!-- An Update on the SDK's default None items would keep their RecursiveDir relative to the project folder,
         and unqualified metadata in a target batches over every None item, hence the qualified intermediate item. -->
    <Target Name="LinkSeedDocs" BeforeTargets="AssignTargetPaths">
        <ItemGroup>
            <_SeedDocs Include="Data\Files\Docs\**\*" />
            <None Include="@(_SeedDocs)" Link="Seed\Files\Docs\%(_SeedDocs.RecursiveDir)%(_SeedDocs.Filename)%(_SeedDocs.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <Target Name="CopyPluginNupkgs" AfterTargets="Build">
        <ItemGroup>
            <_PluginNupkgs Include="Plugins\*.nupkg" />
        </ItemGroup>
        <Copy SourceFiles="@(_PluginNupkgs)" DestinationFolder="$(OutputPath)Plugins" SkipUnchangedFiles="true" />
    </Target>

</Project>
