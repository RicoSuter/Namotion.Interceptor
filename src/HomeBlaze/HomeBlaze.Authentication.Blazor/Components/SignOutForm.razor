@* A plain form, posted by the browser and not by the circuit, as only a request can remove the session cookie. *@

<form method="post" action="@AccountEndpoints.LogoutPath.TrimStart('/')" data-testid="@TestId">
    <AntiforgeryToken />
    @if (IsMenuItem)
    {
        @* The markup of a MudMenuItem, which cannot submit a form, so that the entry lines up with the other entries. *@
        <button type="submit" role="menuitem" class="sign-out-menu-item mud-menu-item mud-ripple mud-list-item-clickable">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mud-menu-item-icon"/>
            <MudText Class="mud-menu-item-text">Sign out</MudText>
        </button>
    }
    else
    {
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Logout">
            Sign out
        </MudButton>
    }
</form>

@code {
    /// <summary>The <c>data-testid</c> of the form.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Whether the button is shown as an entry of a menu.</summary>
    [Parameter]
    public bool IsMenuItem { get; set; }
}
