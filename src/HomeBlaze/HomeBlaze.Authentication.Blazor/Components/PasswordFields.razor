@* The form that sets or changes the password of the signed-in person, posted to the password endpoint. *@

<AccountForm Action="@AccountEndpoints.PasswordPath.TrimStart('/')" SubmitText="@SubmitText" TestId="@TestId">
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    @* For password managers, which store the new password under this name. *@
    <input type="hidden" name="username" value="@UserName" autocomplete="username" />
    @if (HasPassword)
    {
        <label for="@($"{IdPrefix}-current")">Current password</label>
        <input id="@($"{IdPrefix}-current")" name="currentPassword" type="password" autocomplete="current-password" required />
    }
    <label for="@($"{IdPrefix}-new")">New password</label>
    <input id="@($"{IdPrefix}-new")" name="newPassword" type="password" autocomplete="new-password" required />
    <label for="@($"{IdPrefix}-confirm")">Repeat the new password</label>
    <input id="@($"{IdPrefix}-confirm")" name="confirmPassword" type="password" autocomplete="new-password" required />
</AccountForm>

@code {
    /// <summary>The name of the person, for password managers.</summary>
    [Parameter]
    public string? UserName { get; set; }

    /// <summary>Whether the person has a password, which they then enter to change it.</summary>
    [Parameter]
    public bool HasPassword { get; set; }

    /// <summary>The page to load once the password is set, including the path base.</summary>
    [Parameter]
    public string? ReturnUrl { get; set; }

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = string.Empty;

    /// <summary>The start of the ids of the inputs, unique on the page.</summary>
    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = string.Empty;

    /// <summary>The <c>data-testid</c> of the form.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
