@* Sets the password of a person who must change it before they use the app: it cannot be closed, only left by signing out. *@

@inject CurrentUser CurrentUser
@inject AccountPasswords Passwords

<MudDialog>
    <DialogContent>
        <div data-testid="set-password-dialog">
            <UnencryptedHttpWarning />
            <MudText Typo="Typo.body2" Class="mb-3">
                Choose a password for <strong>@_userName</strong> with at least 10 characters.
            </MudText>
            @if (_hasPassword is { } hasPassword)
            {
                <PasswordFields UserName="@_userName" HasPassword="@hasPassword" ReturnUrl="@ReturnUrl" SubmitText="Set password"
                                IdPrefix="set-password" TestId="set-password-form" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <SignOutForm TestId="set-password-sign-out" />
    </DialogActions>
</MudDialog>

@code {
    private string? _userName;
    private bool? _hasPassword;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The page to load once the password is set, including the path base.</summary>
    [Parameter]
    public string? ReturnUrl { get; set; }

    /// <summary>Shows the dialog, which cannot be closed, and returns once it is shown.</summary>
    public static Task<IDialogReference> ShowAsync(IDialogService dialogService, string? returnUrl)
    {
        ArgumentNullException.ThrowIfNull(dialogService);

        var parameters = new DialogParameters<SetPasswordDialog> { { dialog => dialog.ReturnUrl, returnUrl } };
        return dialogService.ShowAsync<SetPasswordDialog>("Set your password", parameters, AccountDialogOptions.Create(isClosable: false));
    }

    protected override async Task OnInitializedAsync()
    {
        _userName = AuthenticationState is null ? null : (await AuthenticationState).User.Identity?.Name;
        _hasPassword = await Passwords.HasPasswordAsync(CurrentUser.UserId);
    }
}
