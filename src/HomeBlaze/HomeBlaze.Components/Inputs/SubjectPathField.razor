@using Namotion.Interceptor.Registry.Abstractions

@inject IDialogService DialogService

<MudTextField T="string"
              Value="@Value"
              ValueChanged="SetValueAsync"
              Label="@Label"
              Placeholder="@Placeholder"
              Variant="@Variant"
              Required="@Required"
              Immediate="true"
              Adornment="Adornment.End"
              AdornmentIcon="@Icons.Material.Filled.Search"
              AdornmentAriaLabel="@($"Browse {Label}")"
              OnAdornmentClick="OpenPickerDialogAsync"
              Class="@Class"
              data-testid="subject-path-field" />

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Path";

    [Parameter]
    public string Placeholder { get; set; } = "Enter path or click to browse";

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    /// <summary>
    /// Whether a surrounding form reports the field as invalid while it is empty.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public IDictionary<string, IInterceptorSubject>? LocalSubjects { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public Func<RegisteredSubjectProperty, bool>? IsPropertyVisible { get; set; }

    [Parameter]
    public Func<RegisteredSubjectProperty, bool>? CanSelectProperty { get; set; }

    /// <summary>
    /// Decides whether the picker lets the user select a subject, every subject when null.
    /// </summary>
    [Parameter]
    public Func<IInterceptorSubject, bool>? CanSelectSubject { get; set; }

    private async Task OpenPickerDialogAsync()
    {
        var parameters = new DialogParameters<SubjectPathPickerDialog>
        {
            { x => x.SelectedPath, Value },
            { x => x.LocalSubjects, LocalSubjects },
            { x => x.Label, Label },
            { x => x.Placeholder, Placeholder },
            { x => x.IsPropertyVisible, IsPropertyVisible },
            { x => x.CanSelectProperty, CanSelectProperty },
            { x => x.CanSelectSubject, CanSelectSubject }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SubjectPathPickerDialog>("Select Path", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string selectedPath })
        {
            await SetValueAsync(selectedPath);
        }
    }

    // Binding the text field to Value would set the parameter here without raising ValueChanged to the parent.
    private async Task SetValueAsync(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
