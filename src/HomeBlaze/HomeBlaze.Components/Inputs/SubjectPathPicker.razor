@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.Components.Operations
@using Namotion.Interceptor.Registry.Attributes

@inject RootManager RootManager
@inject SubjectPathResolver PathResolver

<div class="subject-path-picker" data-testid="subject-path-picker">
    <MudTextField T="string"
                  Value="@Value"
                  ValueChanged="OnPathTypedAsync"
                  Label="@Label"
                  Placeholder="@Placeholder"
                  Variant="Variant.Outlined"
                  Immediate="true" />

    @if (_previewValue != null || _isValidPath)
    {
        <MudText Typo="Typo.caption" Class="mt-1 mb-2">
            Preview: @(_previewValue is MethodMetadata method ? method.Title : _previewValue?.ToString() ?? "(subject)")
        </MudText>
    }

    <MudDivider Class="my-2" />

    @* An item that cannot be selected is ReadOnly: rejecting it in OnSelectedValueChangedAsync is too late, as the
       tree has selected it by then and keeps it selected. *@
    <MudTreeView T="PathTreeItem"
                 Items="@_treeItems"
                 SelectionMode="SelectionMode.SingleSelection"
                 @bind-SelectedValue="_selectedItem"
                 @bind-SelectedValue:after="OnSelectedValueChangedAsync"
                 Hover="true"
                 Dense="true"
                 Height="300px">
        <ItemTemplate>
            <MudTreeViewItem T="PathTreeItem"
                             Value="@context.Value"
                             Items="@GetChildItems(context)"
                             Text="@context.Value?.DisplayName"
                             Icon="@context.Value?.Icon"
                             Expanded="@context.Expanded"
                             ExpandedChanged="@(expanded => OnExpandedChanged((TreeItemData<PathTreeItem>)context, expanded))"
                             ReadOnly="@(context.Value?.CanSelect == false)"
                             OnClick="@(() => OnItemClicked((TreeItemData<PathTreeItem>)context))"
                             Class="@GetItemClass(context.Value)" />
        </ItemTemplate>
    </MudTreeView>
</div>

@* MudBlazor puts the class of an item on the element that also contains its children, so the rules select the row
   of the item: on the element, the opacity would dim everything below it, once more per level. *@
<style>
    .subject-path-picker .subject-path-picker-disabled > .mud-treeview-item-content {
        opacity: 0.5;
    }

    .subject-path-picker .subject-path-picker-not-selectable > .mud-treeview-item-content {
        opacity: 0.6;
    }

    .subject-path-picker .subject-path-picker-expands-on-click > .mud-treeview-item-content {
        cursor: pointer;
    }
</style>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Path";

    [Parameter]
    public string Placeholder { get; set; } = "Enter path (e.g., motor/Temperature)";

    [Parameter]
    public IDictionary<string, IInterceptorSubject>? LocalSubjects { get; set; }

    [Parameter]
    public Func<RegisteredSubjectProperty, bool>? IsPropertyVisible { get; set; }

    /// <summary>
    /// Decides whether a property can be selected, every listed property when null. An operation and an attribute are
    /// listed only when this accepts them, an attribute below its property.
    /// </summary>
    [Parameter]
    public Func<RegisteredSubjectProperty, bool>? CanSelectProperty { get; set; }

    /// <summary>
    /// Decides whether a subject can be selected, every subject when null. One that cannot still expands.
    /// </summary>
    [Parameter]
    public Func<IInterceptorSubject, bool>? CanSelectSubject { get; set; }

    private readonly List<TreeItemData<PathTreeItem>> _treeItems = [];

    private PathTreeItem? _selectedItem;
    private object? _previewValue;
    private bool _isValidPath;

    protected override void OnInitialized()
    {
        BuildTreeItems();
    }

    protected override void OnParametersSet()
    {
        UpdatePreview();
        ExpandToSelectedPath();
    }

    private void BuildTreeItems()
    {
        _treeItems.Clear();

        // Add local subjects
        if (LocalSubjects is { Count: > 0 })
        {
            foreach (var kvp in LocalSubjects)
            {
                _treeItems.Add(CreateSubjectTreeItem(kvp.Value, kvp.Key, kvp.Key));
            }
        }

        // Add Root
        if (RootManager.Root != null)
        {
            var rootItem = CreateSubjectTreeItem(RootManager.Root, "Root", "/");
            rootItem.Value!.Icon = Icons.Material.Filled.Home;
            _treeItems.Add(rootItem);
        }
    }

    private TreeItemData<PathTreeItem> CreateSubjectTreeItem(IInterceptorSubject subject, string displayName, string path)
    {
        var isExpandable = HasExpandableProperties(subject);

        var pathItem = new PathTreeItem
        {
            DisplayName = displayName,
            Path = path,
            Icon = Icons.Material.Filled.AccountTree,
            Subject = subject,
            IsExpandable = isExpandable,
            CanSelect = CanSelectSubject == null || CanSelectSubject(subject)
        };

        var treeItem = new TreeItemData<PathTreeItem>
        {
            Value = pathItem,
            Expanded = false,
            Expandable = isExpandable,
            // Add placeholder child so MudBlazor shows expand arrow
            Children = isExpandable ? CreatePlaceholderChildren() : null
        };

        return treeItem;
    }

    private List<TreeItemData<PathTreeItem>> CreatePlaceholderChildren()
    {
        return
        [
            new TreeItemData<PathTreeItem>
            {
                Value = new PathTreeItem
                {
                    DisplayName = "Loading...",
                    Path = "",
                    Icon = Icons.Material.Filled.HourglassEmpty,
                    IsPlaceholder = true
                }
            }
        ];
    }

    private bool HasPlaceholderChild(TreeItemData<PathTreeItem> treeItem)
    {
        return treeItem.Children?.Count == 1 &&
               treeItem.Children.First() is TreeItemData<PathTreeItem> { Value.IsPlaceholder: true };
    }

    private void OnExpandedChanged(TreeItemData<PathTreeItem> treeItem, bool expanded)
    {
        treeItem.Expanded = expanded;

        if (expanded && treeItem.Value != null && HasPlaceholderChild(treeItem))
        {
            // Load children lazily, replacing placeholder
            var children = LoadChildren(treeItem.Value);
            treeItem.Children = children;
        }

        StateHasChanged();
    }

    private void OnItemClicked(TreeItemData<PathTreeItem> treeItem)
    {
        if (treeItem.Value is { CanSelect: false, IsExpandable: true })
        {
            OnExpandedChanged(treeItem, !treeItem.Expanded);
        }
    }

    private List<TreeItemData<PathTreeItem>> LoadChildren(PathTreeItem parent)
    {
        var children = new List<TreeItemData<PathTreeItem>>();

        if (parent.Property is { Children.Length: > 0 })
        {
            // Check collection/dictionary first (before reference)
            if (parent.Property.IsSubjectDictionary || parent.Property.IsSubjectCollection)
            {
                var isInlinePathsProperty = parent.Subject != null &&
                    InlinePathsAttribute.IsInlinePathsProperty(parent.Subject.GetType(), parent.Property.Name);

                // For collection/dictionary, show child subjects by index
                foreach (var child in parent.Property.Children)
                {
                    string childPath;
                    if (isInlinePathsProperty)
                    {
                        // InlinePaths: strip property name, use key directly
                        var lastSlash = parent.Path.LastIndexOf('/');
                        var basePath = lastSlash >= 0 ? parent.Path[..lastSlash] : "";
                        childPath = basePath.Length > 0 ? $"{basePath}/{child.Index}" : child.Index?.ToString() ?? "";
                    }
                    else
                    {
                        childPath = $"{parent.Path}[{child.Index}]";
                    }
                    var childDisplayName = $"[{child.Index}]";

                    children.Add(CreateSubjectTreeItem(child.Subject, childDisplayName, childPath));
                }
            }
            else if (parent.Property.IsSubjectReference)
            {
                // For a reference, directly show the child subject's properties
                var child = parent.Property.Children[0];
                return LoadPropertiesFromSubject(child.Subject, parent.Path);
            }
        }
        else if (parent.Subject != null)
        {
            return LoadPropertiesFromSubject(parent.Subject, parent.Path);
        }
        else if (parent.Property is { CanContainSubjects: false } && CanSelectProperty is not null)
        {
            return LoadAttributes(parent.Property, parent.Path);
        }

        return children;
    }

    private List<TreeItemData<PathTreeItem>> LoadPropertiesFromSubject(IInterceptorSubject subject, string basePath)
    {
        var children = new List<TreeItemData<PathTreeItem>>();

        var registry = subject.Context.TryGetService<ISubjectRegistry>();
        var registered = registry?.TryGetRegisteredSubject(subject);
        if (registered != null)
        {
            foreach (var property in registered.Properties.OrderBy(p => p.GetDisplayPosition()))
            {
                // Skip internal properties
                if (property.Name.StartsWith("_"))
                    continue;

                // Apply visibility filter
                if (IsPropertyVisible != null && !IsPropertyVisible(property))
                    continue;

                // [InlinePaths] properties: show children directly instead of the property node
                if (InlinePathsAttribute.IsInlinePathsProperty(subject.GetType(), property.Name))
                {
                    foreach (var child in property.Children)
                    {
                        var childKey = child.Index?.ToString() ?? "";
                        var childPath = $"{basePath.TrimEnd('/')}/{childKey}";
                        children.Add(CreateSubjectTreeItem(child.Subject, childKey, childPath));
                    }
                    continue;
                }

                // Determine if property has state attribute
                var hasState = property.GetStateMetadata() != null;

                // Determine if this property is expandable
                var isExpandable = false;
                if (property.IsSubjectDictionary || property.IsSubjectCollection)
                {
                    isExpandable = property.Children.Length > 0;
                }
                else if (property is { IsSubjectReference: true, Children.Length: > 0 })
                {
                    isExpandable = HasExpandableProperties(property.Children[0].Subject);
                }
                else if (property is { IsAttribute: false, CanContainSubjects: false })
                {
                    isExpandable = HasListedAttributes(property);
                }

                // Only methods can be listed, and only when a predicate is set to accept them; skip the metadata
                // lookup otherwise, as it evaluates getters for interface- and object-typed properties.
                var method = CanSelectProperty is not null ? property.TryGetMethodMetadata() : null;
                var isListedMethod = IsListedMethod(property, method);

                // Include if: has State attribute OR is expandable, also by its attributes, OR is an operation that can be selected
                if (!hasState && !isExpandable && !isListedMethod)
                    continue;

                var propertyPath = $"{basePath.TrimEnd('/')}/{property.Name}";

                // Check IsEnabled for visual styling
                var isEnabledAttribute = property.TryGetAttribute(KnownAttributes.IsEnabled);
                var isEnabled = isEnabledAttribute?.GetValue() as bool? ?? true;

                // Check if property can be selected; for a method reuse IsListedMethod's result instead of calling the
                // predicate a second time for the same property.
                var canSelect = method is not null ? isListedMethod : CanSelectProperty == null || CanSelectProperty(property);

                var pathItem = new PathTreeItem
                {
                    DisplayName = property.Name,
                    Path = propertyPath,
                    Icon = method is not null ? GetMethodIcon(method) : GetPropertyIcon(property),
                    Property = property,
                    IsExpandable = isExpandable,
                    IsEnabled = isEnabled,
                    CanSelect = canSelect
                };

                children.Add(new TreeItemData<PathTreeItem>
                {
                    Value = pathItem,
                    Expanded = false,
                    Expandable = isExpandable,
                    Children = isExpandable ? CreatePlaceholderChildren() : null
                });
            }
        }

        return children;
    }

    // An attribute is a property of the subject, so its path is a sibling of the path of its property: "/Motor/Speed"
    // has the attribute "/Motor/Speed_Minimum".
    private List<TreeItemData<PathTreeItem>> LoadAttributes(RegisteredSubjectProperty property, string propertyPath)
    {
        var subjectPath = propertyPath[..(propertyPath.LastIndexOf('/') + 1)];
        var children = new List<TreeItemData<PathTreeItem>>();
        foreach (var attribute in SubjectPathSelection.GetListedAttributes(property, CanSelectProperty!))
        {
            var isExpandable = HasListedAttributes(attribute);
            children.Add(new TreeItemData<PathTreeItem>
            {
                Value = new PathTreeItem
                {
                    DisplayName = attribute.BrowseName,
                    Path = subjectPath + attribute.Name,
                    Icon = Icons.Material.Filled.LocalOffer,
                    Property = attribute,
                    IsExpandable = isExpandable,
                    CanSelect = CanSelectProperty!(attribute)
                },
                Expanded = false,
                Expandable = isExpandable,
                Children = isExpandable ? CreatePlaceholderChildren() : null
            });
        }

        return children;
    }

    // Only a predicate that accepts an attribute lists one, like an operation.
    private bool HasListedAttributes(RegisteredSubjectProperty property)
    {
        return CanSelectProperty is not null && SubjectPathSelection.GetListedAttributes(property, CanSelectProperty).Any();
    }

    private static bool IsUnderAttributeItem(PathTreeItem item, string targetPath)
    {
        if (item.Property is not { CanContainSubjects: false } property)
        {
            return false;
        }

        var subjectPathLength = item.Path.LastIndexOf('/') + 1;
        if (targetPath.Length <= subjectPathLength ||
            string.Compare(targetPath, 0, item.Path, 0, subjectPathLength, StringComparison.OrdinalIgnoreCase) != 0 ||
            targetPath.IndexOf('/', subjectPathLength) >= 0)
        {
            return false;
        }

        return SubjectPathSelection.IsAttributeOf(property.Parent.TryGetProperty(targetPath[subjectPathLength..]), property);
    }

    private void ExpandToSelectedPath()
    {
        if (string.IsNullOrEmpty(Value))
            return;

        // Try to expand tree nodes along the selected path
        ExpandPath(_treeItems, Value);
        StateHasChanged();
    }

    private bool ExpandPath(IReadOnlyCollection<ITreeItemData<PathTreeItem>>? items, string targetPath)
    {
        if (items == null)
            return false;

        foreach (var item in items.OfType<TreeItemData<PathTreeItem>>())
        {
            if (item.Value == null)
                continue;

            var itemPath = item.Value.Path;

            // Check if target path matches this item's path
            if (targetPath.Equals(itemPath, StringComparison.OrdinalIgnoreCase))
            {
                // ReadOnly only stops a click: the tree highlights any item that it is given as selected.
                _selectedItem = item.Value.CanSelect ? item.Value : null;
                return true;
            }

            // Check if target path is under this item
            var isUnderItem = itemPath == "/"
                ? targetPath.StartsWith("/", StringComparison.OrdinalIgnoreCase)
                : targetPath.StartsWith(itemPath + "/", StringComparison.OrdinalIgnoreCase) ||
                  targetPath.StartsWith(itemPath + "[", StringComparison.OrdinalIgnoreCase) ||
                  IsUnderAttributeItem(item.Value, targetPath);
            if (isUnderItem)
            {
                // Expand this node
                item.Expanded = true;

                // Load children if not already loaded (replace placeholder)
                if (item.Children == null || HasPlaceholderChild(item))
                {
                    item.Children = LoadChildren(item.Value);
                }

                // Recursively expand children
                if (ExpandPath(item.Children, targetPath))
                    return true;
            }
        }

        return false;
    }

    private async Task OnSelectedValueChangedAsync()
    {
        if (_selectedItem != null)
        {
            // Use shortest canonical path when a subject is selected
            if (_selectedItem.Subject != null)
            {
                Value = PathResolver.GetPath(_selectedItem.Subject, PathStyle.Canonical) ?? _selectedItem.Path;
            }
            else
            {
                Value = _selectedItem.Path;
            }

            await ValueChanged.InvokeAsync(Value);
            UpdatePreview();
        }
    }

    private bool HasExpandableProperties(IInterceptorSubject subject)
    {
        var registry = subject.Context.TryGetService<ISubjectRegistry>();
        var registered = registry?.TryGetRegisteredSubject(subject);

        if (registered == null)
            return false;

        return registered.Properties.Any(p =>
        {
            if (p.Name.StartsWith("_"))
                return false;

            // Has state attribute - will be shown
            if (p.GetStateMetadata() != null)
                return true;

            // Operation that can be selected - will be shown; skip the metadata lookup when no predicate is
            // set, as it evaluates getters for interface- and object-typed properties.
            var method = CanSelectProperty is not null ? p.TryGetMethodMetadata() : null;
            if (IsListedMethod(p, method))
                return true;

            // Collection/Dictionary with children - will be shown
            if ((p.IsSubjectDictionary || p.IsSubjectCollection) && p.Children.Length > 0)
                return true;

            // Reference with expandable subject - will be shown
            if (p is { IsSubjectReference: true, Children.Length: > 0 })
                return HasExpandableProperties(p.Children[0].Subject);

            // Property with attributes that can be selected - will be shown
            return !p.IsAttribute && !p.CanContainSubjects && HasListedAttributes(p);
        });
    }

    private string GetPropertyIcon(RegisteredSubjectProperty property)
    {
        if (property.IsSubjectDictionary)
            return Icons.Material.Filled.Dataset;
        if (property.IsSubjectCollection)
            return Icons.Material.Filled.List;
        if (property.IsSubjectReference)
            return Icons.Material.Filled.Link;
        return Icons.Material.Filled.Label;
    }

    // Only a predicate that accepts an operation lists one, so the expression picker (no predicate) and the pickers
    // for subjects never offer an operation.
    private bool IsListedMethod(RegisteredSubjectProperty property, MethodMetadata? method)
    {
        return method is not null && CanSelectProperty is not null && CanSelectProperty(property);
    }

    private static string GetMethodIcon(MethodMetadata method)
    {
        return MudBlazorIconResolver.Resolve(OperationInvoker.GetIconName(method));
    }

    private static string? GetItemClass(PathTreeItem? item)
    {
        if (item == null)
            return null;

        return (item.IsEnabled, item.CanSelect, item.IsExpandable) switch
        {
            (false, false, true) => "subject-path-picker-disabled subject-path-picker-not-selectable subject-path-picker-expands-on-click",
            (false, false, false) => "subject-path-picker-disabled subject-path-picker-not-selectable",
            (true, false, true) => "subject-path-picker-not-selectable subject-path-picker-expands-on-click",
            (true, false, false) => "subject-path-picker-not-selectable",
            (false, true, _) => "subject-path-picker-disabled",
            _ => null
        };
    }

    // Binding the text field to Value would set the parameter here without raising ValueChanged to the parent.
    private async Task OnPathTypedAsync(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        UpdatePreview();
        ExpandToSelectedPath();
    }

    private void UpdatePreview()
    {
        _previewValue = null;
        _isValidPath = false;

        if (string.IsNullOrWhiteSpace(Value))
            return;

        try
        {
            object? value = null;

            // Try local subject resolution first (e.g., "mymotor/Temperature")
            if (LocalSubjects != null)
            {
                var slashIndex = Value.IndexOf('/');
                if (slashIndex > 0)
                {
                    var key = Value[..slashIndex];
                    if (LocalSubjects.TryGetValue(key, out var local))
                    {
                        value = PathResolver.ResolveValue(Value[(slashIndex + 1)..], PathStyle.Canonical, relativeTo: local);
                    }
                }
            }

            // Then try absolute/root resolution (e.g., "/Demo/Conveyor/Temperature")
            value ??= PathResolver.ResolveValue(Value, PathStyle.Canonical);

            if (value != null)
            {
                _previewValue = value;
                _isValidPath = true;
            }
            else
            {
                // Try resolving as a subject (not a property value)
                IInterceptorSubject? subject = null;

                if (LocalSubjects != null)
                {
                    var slashIndex = Value.IndexOf('/');
                    if (slashIndex > 0)
                    {
                        var key = Value[..slashIndex];
                        if (LocalSubjects.TryGetValue(key, out var local))
                        {
                            subject = PathResolver.ResolveSubject(Value[(slashIndex + 1)..], PathStyle.Canonical, relativeTo: local);
                        }
                    }
                    else if (LocalSubjects.TryGetValue(Value, out var directLocal))
                    {
                        subject = directLocal;
                    }
                }

                subject ??= PathResolver.ResolveSubject(Value, PathStyle.Canonical);

                if (subject != null)
                {
                    _isValidPath = true;
                }
            }
        }
        catch
        {
            // Invalid path - ignore
        }
    }

    private static List<TreeItemData<PathTreeItem>>? GetChildItems(ITreeItemData<PathTreeItem> context)
    {
        return context.Children?.OfType<TreeItemData<PathTreeItem>>().ToList();
    }

    private class PathTreeItem
    {
        public string DisplayName { get; set; } = "";
        public string Path { get; set; } = "";
        public string Icon { get; set; } = Icons.Material.Filled.Label;
        public bool IsExpandable { get; set; }
        public bool IsEnabled { get; set; } = true;
        public bool IsPlaceholder { get; set; }
        public bool CanSelect { get; set; } = true;

        // For lazy loading
        public IInterceptorSubject? Subject { get; set; }
        public RegisteredSubjectProperty? Property { get; set; }
    }
}
