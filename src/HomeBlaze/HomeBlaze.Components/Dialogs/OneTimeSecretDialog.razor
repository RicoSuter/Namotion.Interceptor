@* Shows a secret that exists only now, such as a setup code or a key, with a button that copies it. The secret is kept
   only by this dialog and gone once it closes. *@
@implements IAsyncDisposable

@using HomeBlaze.Abstractions
@using Microsoft.JSInterop

@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        <div @ref="_element" data-testid="one-time-secret">
            <MudText Typo="Typo.body2" Class="mb-3">@Message</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudPaper Outlined="true" Class="pa-2 flex-grow-1 one-time-secret-value">
                    <code data-testid="one-time-secret-value">@Secret</code>
                </MudPaper>
                @* Copied by the script within the click, as browsers refuse to copy once the click is over. *@
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" title="Copy" aria-label="Copy" data-copy-value="@Secret"
                               data-testid="one-time-secret-copy" />
            </MudStack>
            @if (Link is { } link)
            {
                var address = Navigation.ToAbsoluteUri(link).ToString();
                <MudLink Href="@address" Target="_blank" Class="d-inline-block mt-3" data-testid="one-time-secret-link">@address</MudLink>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close" data-testid="one-time-secret-close">Done</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .one-time-secret-value {
        font-family: monospace;
        user-select: all;
        word-break: break-all;
    }
</style>

@code {
    private const string ModulePath = "./_content/HomeBlaze.Components/Dialogs/OneTimeSecretDialog.razor.js";

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<OneTimeSecretDialog>? _dotNetReference;
    private bool _isDisposed;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>What the secret is for and who gets it.</summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Secret { get; set; } = string.Empty;

    /// <summary>The page the secret is used on, relative to the base address of the application or absolute, shown as a link, or null.</summary>
    [Parameter]
    public string? Link { get; set; }

    /// <summary>Shows the secret an operation returned; returns once the dialog is shown, not once it is closed.</summary>
    public static Task ShowAsync(IDialogService dialogService, OneTimeSecret secret)
    {
        var parameters = new DialogParameters<OneTimeSecretDialog>
        {
            { dialog => dialog.Message, secret.Message },
            { dialog => dialog.Secret, secret.Secret },
            { dialog => dialog.Link, secret.LinkPath }
        };

        // Closed only on purpose, as the secret cannot be shown again.
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
        return dialogService.ShowAsync<OneTimeSecretDialog>(secret.Title, parameters, options);
    }

    /// <summary>Called by the script with whether the secret was copied.</summary>
    [JSInvokable]
    public void OnCopied(bool isCopied)
    {
        if (isCopied)
        {
            Snackbar.Add("Copied", Severity.Normal, options => options.VisibleStateDuration = 1500);
        }
        else
        {
            Snackbar.Add("It could not be copied; select it and copy it instead.", Severity.Warning);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference?>("import", ModulePath);
            if (_module is null)
            {
                return;
            }

            if (_isDisposed)
            {
                await _module.DisposeAsync();
                return;
            }

            _dotNetReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("register", _element, _dotNetReference);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException or JSException)
        {
            // Without the script the copy button does nothing; the secret can still be selected and copied.
        }
    }

    private void Close() => MudDialog?.Close();

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _dotNetReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the module with it.
            }
        }
    }
}
