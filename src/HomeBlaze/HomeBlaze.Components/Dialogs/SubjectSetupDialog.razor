@using HomeBlaze.Components.Editors
@using Microsoft.JSInterop

@inject SubjectTypeCatalog TypeCatalog
@inject SubjectFactory SubjectFactory
@inject RootManager RootManager
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

@implements IDisposable

<MudDialog data-testid="create-subject-dialog"
           Class="subject-setup-dialog"
           ContentClass="@(_selectedType is null ? "subject-setup-picker-content" : null)">
    <TitleContent>
        <MudText Typo="Typo.h6" data-testid="create-dialog-title">@GetTitle()</MudText>
    </TitleContent>
    <DialogContent>
        @* The picker stays in the tree while the configure page is shown, so its search and group survive "Back". *@
        <div class="subject-setup-picker-page" hidden="@(_selectedType is not null)">
            <SubjectTypePicker @ref="_typePicker" Types="_types" OnTypeSelected="SelectType" />
        </div>
        @if (_selectedType is not null && _createdSubject is not null)
        {
            <MudStack Spacing="3">
                @if (Options.NameField is { } nameOptions)
                {
                    @* The field validates itself after every change and overwrites Error and ErrorText with its own
                       result, so the check must also be its Validation. Error and ErrorText still show the error of
                       a name that was kept from the previous type, which the new field has not validated yet. *@
                    <MudTextField T="string"
                                  Value="_subjectName"
                                  ValueChanged="OnNameChanged"
                                  Label="@nameOptions.Label"
                                  Required="true"
                                  Immediate="true"
                                  AutoFocus="_hasFinePointer"
                                  Adornment="@(nameOptions.Suffix.Length > 0 ? Adornment.End : Adornment.None)"
                                  AdornmentText="@nameOptions.Suffix"
                                  Validation="@((Func<string?, string?>)ValidateName)"
                                  Error="@(_nameError is not null)"
                                  ErrorText="@_nameError"
                                  HelperText="Part of the subject's path, which is its ID. Avoid renaming it later."
                                  data-testid="create-name-input" />
                }
                @* A hosted form may change its validity without raising IsValidChanged, so the dialog reads it again
                   after interaction. Blazor does not bubble change, so a control that only changes on change is picked
                   up by the next focus change or by the pointer entering "Create". *@
                <div @oninput="_refreshEditPanelIsValid"
                     @onclick="_refreshEditPanelIsValid"
                     @onkeyup="_refreshEditPanelIsValid"
                     @onfocusin="_refreshEditPanelIsValid"
                     @onfocusout="_refreshEditPanelIsValid">
                    <SubjectEditPanel @key="_createdSubject"
                                      @ref="_editPanel"
                                      Subject="_createdSubject"
                                      IsCreating="true"
                                      IsValidChanged="OnEditPanelIsValidChanged" />
                </div>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (_selectedType is not null)
        {
            <MudButton OnClick="GoBack"
                       Disabled="_isCreating"
                       data-testid="back-button">Back</MudButton>
            <MudSpacer />
        }
        <MudButton OnClick="Cancel"
                   Disabled="_isCreating"
                   data-testid="cancel-button">Cancel</MudButton>
        @if (_selectedType is not null)
        {
            @* A validity that changed without any event in the form, such as a delayed validation, is read
               again before the pointer can reach the button. *@
            <span @onpointerenter="_refreshEditPanelIsValid" style="display: inline-block;">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@(!CanCreate)"
                           OnClick="Create"
                           data-testid="create-button">Create</MudButton>
            </span>
        }
    </DialogActions>
</MudDialog>

<style>
    /* MudBlazor caps a dialog at the viewport height less the app bar, which leaves a phone in landscape too little. */
    .mud-dialog.subject-setup-dialog {
        height: max(calc(100dvh - 200px), 480px);
        max-height: calc(100dvh - 16px);
    }

    @@media (max-height: 500px) {
        .mud-dialog.subject-setup-dialog .mud-dialog-title {
            padding-top: 8px;
            padding-bottom: 8px;
        }

        .mud-dialog.subject-setup-dialog .mud-dialog-content {
            padding-top: 4px;
            padding-bottom: 4px;
        }
    }

    .mud-dialog .mud-dialog-content.subject-setup-picker-content,
    .subject-setup-picker-content > .subject-setup-picker-page {
        display: flex;
        flex-direction: column;
    }

    .subject-setup-picker-content > .subject-setup-picker-page {
        flex: 1 1 auto;
        min-height: 0;
    }
</style>

@code {
    private const string ModulePath = "./_content/HomeBlaze.Components/Dialogs/SubjectSetupDialog.razor.js";

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public SubjectSetupOptions Options { get; set; } = new();

    private IReadOnlyList<SubjectTypeDescriptor> _types = [];
    private SubjectTypePicker? _typePicker;
    private bool _isSearchFocusPending;
    private bool _hasFinePointer;
    private SubjectTypeDescriptor? _selectedType;
    private IInterceptorSubject? _createdSubject;
    private bool _isCreatedSubjectHandedOver;
    private SubjectEditPanel? _editPanel;
    private bool _isEditPanelValid;
    private string _subjectName = "";
    private string? _nameError;
    private bool _isNameEdited;
    private bool _isCreating;
    private bool _isDisposed;
    private Func<Task> _refreshEditPanelIsValid = () => Task.CompletedTask;

    private bool CanCreate => _createdSubject is not null && _nameError is null && _isEditPanelValid && !_isCreating;

    protected override void OnInitialized()
    {
        IEnumerable<IInterceptorSubject> existingSubjects =
            RootManager.Root?.Context.TryGetService<ISubjectRegistry>()?.KnownSubjects.Keys
            ?? Enumerable.Empty<IInterceptorSubject>();

        _types = TypeCatalog.GetCreatableTypes(existingSubjects);

        // These events fire for every keystroke in the hosted form, and handling them as the dialog would render
        // it, and with it that form, each time.
        _refreshEditPanelIsValid = new NonRenderingEventReceiver(RefreshEditPanelIsValidAsync).HandleAsync;
    }

    private string GetTitle()
    {
        return _selectedType is null ? "Create subject" : $"Create {_selectedType.DisplayName}";
    }

    private void SelectType(SubjectTypeDescriptor descriptor)
    {
        DiscardCreatedSubject();

        try
        {
            _createdSubject = SubjectFactory.CreateSubject(descriptor.Type);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to create subject: {exception.Message}", Severity.Error);
            return;
        }

        _selectedType = descriptor;
        _isEditPanelValid = false;

        if (Options.NameField is { } nameOptions && !_isNameEdited)
        {
            _subjectName = nameOptions.SuggestName(descriptor.Type);
        }

        _nameError = ValidateName(_subjectName);
        RefreshDialog();
    }

    private void GoBack()
    {
        DiscardCreatedSubject();
        _selectedType = null;
        _editPanel = null;
        _isEditPanelValid = false;
        _isSearchFocusPending = _hasFinePointer;
        RefreshDialog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focusing a field opens the on-screen keyboard of a touch device, over the list or the form.
            _hasFinePointer = await HasFinePointerAsync();
            _isSearchFocusPending = _hasFinePointer && _selectedType is null;
        }

        // The picker is hidden until the render that follows "Back", and a hidden field cannot take the focus.
        if (_isSearchFocusPending && _typePicker is { } typePicker)
        {
            _isSearchFocusPending = false;
            await typePicker.FocusSearchAsync();
        }
    }

    private async Task<bool> HasFinePointerAsync()
    {
        try
        {
            await using var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
            return await module.InvokeAsync<bool>("hasFinePointer");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            return false;
        }
    }

    private void OnNameChanged(string? name)
    {
        _subjectName = name ?? "";

        // A cleared name is not a choice to keep, so the next type gets its suggestion again.
        _isNameEdited = !string.IsNullOrWhiteSpace(_subjectName);
        _nameError = ValidateName(_subjectName);
    }

    private void OnEditPanelIsValidChanged(bool isValid)
    {
        _isEditPanelValid = isValid;
    }

    private Task RefreshEditPanelIsValidAsync()
    {
        return _editPanel?.RefreshIsValidAsync() ?? Task.CompletedTask;
    }

    private string? ValidateName(string? name)
    {
        return Options.NameField?.Validate(name);
    }

    private void RefreshDialog()
    {
        // The title is rendered by the dialog container, which only follows an explicit refresh.
        MudDialog?.StateHasChanged();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task Create()
    {
        // Read once, before the first await: whatever changes these fields while the create is in flight
        // must not swap the subject that is attached and returned.
        var createdSubject = _createdSubject;
        var editPanel = _editPanel;
        if (createdSubject is null || editPanel is null || !CanCreate)
        {
            return;
        }

        var name = Options.NameField is null ? null : _subjectName.Trim();

        // A second click while the awaits below are pending would run BeforeSave again and attach the subject twice.
        _isCreating = true;

        try
        {
            // Attaching can start a hosted subject right away, and it reads its configuration once it
            // starts, so the edits must be applied before BeforeSave attaches it.
            if (!await editPanel.ApplyChangesAsync(CancellationToken.None))
            {
                // The button was enabled from a validity the form no longer has.
                Snackbar.Add("Complete the required fields first", Severity.Warning);
                await editPanel.RefreshIsValidAsync();
                return;
            }

            // Persisting finds its writer through the parents BeforeSave establishes.
            if (Options.BeforeSave is { } beforeSave)
            {
                try
                {
                    beforeSave(createdSubject);
                }
                finally
                {
                    // A BeforeSave that fails halfway may have attached the subject already, and discarding
                    // it then would take it out of the graph again.
                    _isCreatedSubjectHandedOver = createdSubject.GetParents().Length > 0;
                }
            }

            await editPanel.PersistAsync(CancellationToken.None);

            if (Options.BeforeSave is null)
            {
                // The caller attaches the subject, which it takes from the result.
                _isCreatedSubjectHandedOver = true;
            }

            MudDialog?.Close(DialogResult.Ok(new CreateSubjectResult(createdSubject, name)));
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to create subject: {exception.Message}", Severity.Error);
        }
        finally
        {
            _isCreating = false;

            if (_isDisposed)
            {
                DiscardCreatedSubject();
            }
        }
    }

    private void DiscardCreatedSubject()
    {
        // A running create may be about to hand the subject over. When the dialog is disposed by the time
        // it ends, it calls this again.
        if (_isCreating)
        {
            return;
        }

        // The factory attaches the subject that backs the form to the root context, where a hosted subject
        // already runs. Discarding one that was handed over would take it out of the graph again.
        if (_createdSubject is { } createdSubject && !_isCreatedSubjectHandedOver)
        {
            SubjectFactory.DiscardSubject(createdSubject);
        }

        _createdSubject = null;
        _isCreatedSubjectHandedOver = false;
    }

    public void Dispose()
    {
        _isDisposed = true;
        DiscardCreatedSubject();
    }

    /// <summary>
    /// Shows the create subject dialog and returns the result.
    /// </summary>
    /// <param name="dialogService">The dialog service.</param>
    /// <param name="options">The options, or null for a dialog that asks for no name.</param>
    /// <returns>The created subject and its name, or null if cancelled.</returns>
    public static async Task<CreateSubjectResult?> ShowAsync(
        IDialogService dialogService,
        SubjectSetupOptions? options = null)
    {
        var dialogOptions = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var parameters = new DialogParameters<SubjectSetupDialog>
        {
            { setupDialog => setupDialog.Options, options ?? new SubjectSetupOptions() }
        };

        var dialog = await dialogService.ShowAsync<SubjectSetupDialog>("Create subject", parameters, dialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled != false)
            return null;

        return result.Data as CreateSubjectResult;
    }

    /// <summary>
    /// Handles an event in place of the dialog, which is then not rendered afterwards.
    /// </summary>
    private sealed class NonRenderingEventReceiver(Func<Task> handler) : IHandleEvent
    {
        public Task HandleAsync() => handler();

        Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);
    }
}
