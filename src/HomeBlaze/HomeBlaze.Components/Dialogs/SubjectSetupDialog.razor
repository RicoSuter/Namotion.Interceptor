@using HomeBlaze.Components.Editors
@using Microsoft.JSInterop
@using HomeBlaze.Abstractions.Discovery
@using HomeBlaze.Services.Discovery

@inject SubjectTypeCatalog TypeCatalog
@inject SubjectFactory SubjectFactory
@inject RootManager RootManager
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject SubjectDiscoveryService DiscoveryService

@implements IDisposable

<MudDialog data-testid="create-subject-dialog"
           Class="subject-setup-dialog"
           ContentClass="@(_selectedType is null ? "subject-setup-picker-content" : null)">
    <TitleContent>
        <MudText Typo="Typo.h6" data-testid="create-dialog-title">@GetTitle()</MudText>
    </TitleContent>
    <DialogContent>
        @* The picker stays in the tree while the configure page is shown, so its search and group survive "Back".
           The Discover page stays as well, so its results survive "Back". *@
        <div class="subject-setup-picker-page" hidden="@(_selectedType is not null)">
            @if (_isDiscoverAvailable)
            {
                <MudToggleGroup T="PickerMode"
                                Value="_pickerMode"
                                ValueChanged="OnPickerModeChanged"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small"
                                Class="mb-2 subject-setup-picker-mode-toggle"
                                data-testid="picker-mode-toggle">
                    <MudToggleItem Value="PickerMode.Types" Text="All types" data-testid="picker-mode-types" />
                    <MudToggleItem Value="PickerMode.Discover" Text="Discover" data-testid="picker-mode-discover" />
                </MudToggleGroup>
            }
            <div class="subject-setup-picker-mode" hidden="@(_pickerMode != PickerMode.Types)">
                <SubjectTypePicker @ref="_typePicker" Types="_types" OnTypeSelected="SelectType" />
            </div>
            @if (_isDiscoverAvailable)
            {
                <div class="subject-setup-picker-mode" hidden="@(_pickerMode != PickerMode.Discover)">
                    <SubjectDiscoveryPage @ref="_discoveryPage"
                                          Types="_types"
                                          ExistingSubjects="_existingSubjects"
                                          IsActive="@(_selectedType is null && _pickerMode == PickerMode.Discover)"
                                          OnSelected="SelectDiscovered"
                                          OnNavigating="Cancel" />
                </div>
            }
        </div>
        @if (_selectedType is not null && _createdSubject is not null)
        {
            <MudStack Spacing="3">
                @if (_nameOptions is { } nameOptions)
                {
                    @* The field validates itself after every change and overwrites Error and ErrorText with its own
                       result, so the check must also be its Validation. Error and ErrorText still show the error of
                       a name that was kept from the previous type, which the new field has not validated yet. *@
                    <MudTextField T="string"
                                  @ref="_nameField"
                                  Value="_subjectName"
                                  ValueChanged="OnNameChanged"
                                  Label="@nameOptions.Label"
                                  Required="true"
                                  Immediate="true"
                                  Adornment="@(nameOptions.Suffix.Length > 0 ? Adornment.End : Adornment.None)"
                                  AdornmentText="@nameOptions.Suffix"
                                  Validation="@((Func<string?, string?>)ValidateName)"
                                  Error="@(_nameError is not null)"
                                  ErrorText="@_nameError"
                                  HelperText="Part of the subject's path, which is its ID. Avoid renaming it later."
                                  data-testid="create-name-input" />
                }
                <SubjectEditPanel @key="_createdSubject"
                                  @ref="_editPanel"
                                  Subject="_createdSubject"
                                  IsCreating="true"
                                  DiscoveryResult="_discoveredSubject?.Result"
                                  IsValidChanged="OnEditPanelIsValidChanged" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (_selectedType is not null && Options.Type is null)
        {
            <MudButton OnClick="GoBack"
                       Disabled="_isCreating"
                       data-testid="back-button">Back</MudButton>
            <MudSpacer />
        }
        <MudButton OnClick="Cancel"
                   Disabled="_isCreating"
                   data-testid="cancel-button">@(_hasCreated && _selectedType is null ? "Done" : "Cancel")</MudButton>
        @if (_selectedType is not null)
        {
            @* A validity that changed without any event in the form, such as a delayed validation, is read
               again before the pointer can reach the button. *@
            <span @onpointerenter="_refreshEditPanelIsValid" style="display: inline-block;">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@(!CanCreate)"
                           OnClick="Create"
                           data-testid="create-button">Create</MudButton>
            </span>
        }
    </DialogActions>
</MudDialog>

<style>
    /* MudBlazor caps a dialog at the viewport height less the app bar, which leaves a phone in landscape too little. */
    .mud-dialog.subject-setup-dialog {
        height: max(calc(100dvh - 200px), 480px);
        max-height: calc(100dvh - 16px);
    }

    @@media (max-height: 500px) {
        .mud-dialog.subject-setup-dialog .mud-dialog-title {
            padding-top: 8px;
            padding-bottom: 8px;
        }

        .mud-dialog.subject-setup-dialog .mud-dialog-content {
            padding-top: 4px;
            padding-bottom: 4px;
        }
    }

    .mud-dialog .mud-dialog-content.subject-setup-picker-content,
    .subject-setup-picker-content > .subject-setup-picker-page {
        display: flex;
        flex-direction: column;
    }

    .subject-setup-picker-content > .subject-setup-picker-page {
        flex: 1 1 auto;
        min-height: 0;
    }

    /* The toggle group clips its overflow, so as a flex item it would shrink to nothing on a short screen. */
    .subject-setup-picker-page > .subject-setup-picker-mode-toggle {
        flex: none;
    }

    /* :not([hidden]) keeps display: flex from overriding the hidden attribute. */
    .subject-setup-picker-page > .subject-setup-picker-mode:not([hidden]) {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }
</style>

@code {
    private const string ModulePath = "./_content/HomeBlaze.Components/Dialogs/SubjectSetupDialog.razor.js";

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public SubjectSetupOptions Options { get; set; } = new();

    private IReadOnlyList<SubjectTypeDescriptor> _types = [];
    private IReadOnlyCollection<IInterceptorSubject> _existingSubjects = [];
    private bool _isDiscoverAvailable;
    private PickerMode _pickerMode = PickerMode.Types;
    private DiscoveredSubject? _discoveredSubject;
    private SubjectDiscoveryPage? _discoveryPage;
    private SubjectNameOptions? _nameOptions;
    private bool _hasCreated;
    private SubjectTypePicker? _typePicker;
    private bool _isSearchFocusPending;
    private MudTextField<string>? _nameField;
    private bool _isNameFocusPending;
    private bool _hasFinePointer;
    private SubjectTypeDescriptor? _selectedType;
    private IInterceptorSubject? _createdSubject;
    private bool _isCreatedSubjectHandedOver;
    private SubjectEditPanel? _editPanel;
    private bool _isEditPanelValid;
    private string _subjectName = "";
    private string? _nameError;
    private bool _isNameEdited;
    private bool _isCreating;
    private bool _isDisposed;
    private Func<Task> _refreshEditPanelIsValid = () => Task.CompletedTask;

    private bool CanCreate => _createdSubject is not null && _nameError is null && _isEditPanelValid && !_isCreating;

    protected override void OnInitialized()
    {
        // A field of its own, because the names grow with each subject created while the dialog is open, and a
        // parameter written by the component itself is overwritten when its parent renders.
        _nameOptions = Options.NameField;

        LoadTypes();
        _isDiscoverAvailable = Options.Type is null && DiscoveryService.HasSubjectDiscoveries(_types.Select(descriptor => descriptor.Type).ToArray());

        // A normal handler would re-render the dialog, and with it the form, each time the pointer enters the button.
        _refreshEditPanelIsValid = new NonRenderingEventReceiver(RefreshEditPanelIsValidAsync).HandleAsync;

        if (Options.Type is { } type)
        {
            SelectType(SubjectTypeCatalog.Describe(type));
        }
    }

    private void LoadTypes()
    {
        _existingSubjects =
            RootManager.Root?.Context.TryGetService<ISubjectRegistry>()?.KnownSubjects.Keys.ToArray()
            ?? [];

        _types = TypeCatalog.GetCreatableTypes(_existingSubjects);
    }

    private string GetTitle()
    {
        return _selectedType is null ? "Create subject" : $"Create {_selectedType.DisplayName}";
    }

    private void SelectType(SubjectTypeDescriptor descriptor)
    {
        ShowConfigurePage(descriptor, null);
    }

    private void SelectDiscovered(DiscoveredSubject discoveredSubject)
    {
        if (_types.FirstOrDefault(descriptor => descriptor.Type == discoveredSubject.SubjectType) is { } descriptor)
        {
            ShowConfigurePage(descriptor, discoveredSubject);
        }
    }

    private void ShowConfigurePage(SubjectTypeDescriptor descriptor, DiscoveredSubject? discoveredSubject)
    {
        DiscardCreatedSubject();

        try
        {
            _createdSubject = SubjectFactory.CreateSubject(descriptor.Type);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to create subject: {exception.Message}", Severity.Error);
            return;
        }

        _selectedType = descriptor;
        _discoveredSubject = discoveredSubject;
        _isEditPanelValid = false;

        if (_nameOptions is { } nameOptions && !_isNameEdited)
        {
            _subjectName = discoveredSubject is null
                ? nameOptions.SuggestName(descriptor.Type)
                : nameOptions.SuggestName(discoveredSubject.Result.DisplayName, descriptor.Type);
        }

        _nameError = ValidateName(_subjectName);
        _isNameFocusPending = _nameOptions is not null;
        RefreshDialog();
    }

    private void GoBack()
    {
        DiscardCreatedSubject();
        ShowPicker();
    }

    private void ShowPicker()
    {
        _selectedType = null;
        _discoveredSubject = null;
        _editPanel = null;
        _isEditPanelValid = false;
        _isNameFocusPending = false;

        // Back returns to the page the type was picked on; only the type list has a search to focus.
        _isSearchFocusPending = _hasFinePointer && _pickerMode == PickerMode.Types;
        RefreshDialog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focusing a field opens the on-screen keyboard of a touch device, over the list or the form.
            _hasFinePointer = await HasFinePointerAsync();
            _isSearchFocusPending = _hasFinePointer && _selectedType is null && _pickerMode == PickerMode.Types;
        }

        // The picker is hidden until the render that follows "Back", and a hidden field cannot take the focus.
        if (_isSearchFocusPending && _typePicker is { } typePicker)
        {
            _isSearchFocusPending = false;
            await typePicker.FocusSearchAsync();
        }

        // A type picked while the pointer is still being queried renders the field before the pointer is known,
        // so the focus waits for the pointer instead of the field's first render.
        if (_isNameFocusPending && _hasFinePointer && _nameField is { } nameField)
        {
            _isNameFocusPending = false;
            await nameField.FocusAsync();
        }
    }

    private async Task<bool> HasFinePointerAsync()
    {
        try
        {
            await using var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
            return await module.InvokeAsync<bool>("hasFinePointer");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            return false;
        }
    }

    private void OnNameChanged(string? name)
    {
        _subjectName = name ?? "";

        // A cleared name is not a choice to keep, so the next type gets its suggestion again.
        _isNameEdited = !string.IsNullOrWhiteSpace(_subjectName);
        _nameError = ValidateName(_subjectName);
    }

    private void OnEditPanelIsValidChanged(bool isValid)
    {
        _isEditPanelValid = isValid;
    }

    private Task RefreshEditPanelIsValidAsync()
    {
        return _editPanel?.RefreshIsValidAsync() ?? Task.CompletedTask;
    }

    private string? ValidateName(string? name)
    {
        return _nameOptions?.Validate(name);
    }

    private void RefreshDialog()
    {
        // The title is rendered by the dialog container, which only follows an explicit refresh.
        MudDialog?.StateHasChanged();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task Create()
    {
        // Read once, before the first await: whatever changes these fields while the create is in flight
        // must not swap the subject that is attached and returned.
        var createdSubject = _createdSubject;
        var editPanel = _editPanel;
        var discoveredSubject = _discoveredSubject;
        if (createdSubject is null || editPanel is null || !CanCreate)
        {
            return;
        }

        var name = _nameOptions is null ? null : _subjectName.Trim();

        // A second click while the awaits below are pending would run BeforeSave again and attach the subject twice.
        _isCreating = true;

        try
        {
            // Attaching can start a hosted subject right away, and it reads its configuration once it
            // starts, so the edits must be applied before BeforeSave attaches it.
            if (!await editPanel.ApplyChangesAsync(CancellationToken.None))
            {
                // The button was enabled from a validity the form no longer has.
                Snackbar.Add("Complete the required fields first", Severity.Warning);
                await editPanel.RefreshIsValidAsync();
                return;
            }

            // Persisting finds its writer through the parents BeforeSave establishes.
            if (Options.BeforeSave is { } beforeSave)
            {
                try
                {
                    beforeSave(createdSubject);
                }
                finally
                {
                    // A BeforeSave that fails halfway may have attached the subject already, and discarding
                    // it then would take it out of the graph again.
                    _isCreatedSubjectHandedOver = createdSubject.GetParents().Length > 0;
                }

                await editPanel.PersistAsync(CancellationToken.None);
            }
            else
            {
                // Nothing stores the subject yet, so there is nothing to persist, but a hosted subject already
                // runs and has to pick up the edits.
                if (createdSubject is IConfigurable configurable)
                {
                    try
                    {
                        await configurable.ApplyConfigurationAsync(CancellationToken.None);
                    }
                    catch (Exception exception)
                    {
                        // As when persisting, the subject is created all the same.
                        Snackbar.Add($"Error applying configuration: {exception.Message}", Severity.Error);
                    }
                }

                if (Options.OnCreatedAsync is { } onCreatedAsync)
                {
                    try
                    {
                        await onCreatedAsync(new CreateSubjectResult(createdSubject, name));
                    }
                    catch
                    {
                        // As for BeforeSave: a callback that fails halfway may have attached the subject already.
                        _isCreatedSubjectHandedOver = createdSubject.GetParents().Length > 0;
                        throw;
                    }
                }

                // The caller attaches and stores the subject, which it gets from the result or through OnCreatedAsync.
                _isCreatedSubjectHandedOver = true;

                // A closed dialog has nothing to return to. ShowAsync requires a name field with OnCreatedAsync.
                if (Options.OnCreatedAsync is not null && discoveredSubject is not null && !_isDisposed)
                {
                    ReturnToDiscoverPage(createdSubject, discoveredSubject, name!);
                    return;
                }
            }

            MudDialog?.Close(DialogResult.Ok(new CreateSubjectResult(createdSubject, name)));
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to create subject: {exception.Message}", Severity.Error);
        }
        finally
        {
            _isCreating = false;

            if (_isDisposed)
            {
                DiscardCreatedSubject();
            }
        }
    }

    /// <summary>
    /// Returns to the Discover page after the subject of a found device was stored, so that the next device can be
    /// created without a new scan.
    /// </summary>
    private void ReturnToDiscoverPage(IInterceptorSubject createdSubject, DiscoveredSubject discoveredSubject, string name)
    {
        _hasCreated = true;
        Snackbar.Add($"Created \"{name}\"", Severity.Success);

        // The existing names are a copy, which does not see the subject that was just stored.
        if (_nameOptions is { } nameOptions)
        {
            _nameOptions = nameOptions with { ExistingNames = [.. nameOptions.ExistingNames, name] };
        }

        // So that Scan again recognizes the new subject and a single instance type is no longer offered.
        LoadTypes();
        _discoveryPage?.MarkAdded(discoveredSubject, createdSubject);

        // The subject was handed over, so unlike Back this must not discard it.
        _createdSubject = null;
        _isCreatedSubjectHandedOver = false;
        _isNameEdited = false;
        ShowPicker();
    }

    private void DiscardCreatedSubject()
    {
        // A running create may be about to hand the subject over. When the dialog is disposed by the time
        // it ends, it calls this again.
        if (_isCreating)
        {
            return;
        }

        // The factory attaches the subject that backs the form to the root context, where a hosted subject
        // already runs. Discarding one that was handed over would take it out of the graph again.
        if (_createdSubject is { } createdSubject && !_isCreatedSubjectHandedOver)
        {
            SubjectFactory.DiscardSubject(createdSubject);
        }

        _createdSubject = null;
        _isCreatedSubjectHandedOver = false;
    }

    private void OnPickerModeChanged(PickerMode pickerMode)
    {
        _pickerMode = pickerMode;
        _isSearchFocusPending = _hasFinePointer && pickerMode == PickerMode.Types;
    }

    private enum PickerMode
    {
        Types,
        Discover
    }

    public void Dispose()
    {
        _isDisposed = true;
        DiscardCreatedSubject();
    }

    /// <summary>
    /// Shows the create subject dialog and returns the result.
    /// </summary>
    /// <param name="dialogService">The dialog service.</param>
    /// <param name="options">The options, or null for a dialog that asks for no name.</param>
    /// <returns>
    /// The created subject and its name, or null if canceled. Always null when <see cref="SubjectSetupOptions.OnCreatedAsync"/>
    /// is set, which receives each created subject instead.
    /// </returns>
    /// <exception cref="ArgumentException">
    /// <see cref="SubjectSetupOptions.OnCreatedAsync"/> is set together with <see cref="SubjectSetupOptions.BeforeSave"/>
    /// or without <see cref="SubjectSetupOptions.NameField"/>.
    /// </exception>
    public static async Task<CreateSubjectResult?> ShowAsync(
        IDialogService dialogService,
        SubjectSetupOptions? options = null)
    {
        options ??= new SubjectSetupOptions();
        if (options.OnCreatedAsync is not null)
        {
            if (options.BeforeSave is not null)
            {
                throw new ArgumentException(
                    $"{nameof(SubjectSetupOptions.BeforeSave)} and {nameof(SubjectSetupOptions.OnCreatedAsync)} cannot be set together.",
                    nameof(options));
            }

            if (options.NameField is null)
            {
                throw new ArgumentException(
                    $"{nameof(SubjectSetupOptions.OnCreatedAsync)} requires {nameof(SubjectSetupOptions.NameField)}.",
                    nameof(options));
            }
        }

        var dialogOptions = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var parameters = new DialogParameters<SubjectSetupDialog>
        {
            { setupDialog => setupDialog.Options, options }
        };

        var dialog = await dialogService.ShowAsync<SubjectSetupDialog>("Create subject", parameters, dialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled != false || options.OnCreatedAsync is not null)
            return null;

        return result.Data as CreateSubjectResult;
    }
}
