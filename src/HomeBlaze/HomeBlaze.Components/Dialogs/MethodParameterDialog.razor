@using HomeBlaze.Abstractions.Attributes
@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.Services.Display

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrEmpty(Method?.Description))
        {
            <MudText Typo="Typo.body2" Class="mb-4">@Method.Description</MudText>
        }

        @if (Method != null)
        {
            <MudStack Spacing="3">
                @foreach (var parameter in Method.Parameters.Where(p => p.RequiresInput))
                {
                    @switch (GetInputKind(parameter))
                    {
                        case InputKind.Simple:
                            <div>@RenderField(CreateParameterField(parameter))</div>
                            break;

                        case InputKind.Members:
                            <MudPaper Outlined="true" Class="pa-3">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@GetLabel(parameter.Name, !parameter.IsNullable)</MudText>
                                <MudStack Spacing="2">
                                    @foreach (var field in CreateMemberFields(parameter))
                                    {
                                        <div>@RenderField(field)</div>
                                    }
                                </MudStack>
                                @if (HasError(parameter.Name))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@GetError(parameter.Name)</MudText>
                                }
                            </MudPaper>
                            break;

                        case InputKind.Json:
                            <MudTextField T="string"
                                          Label="@($"{GetLabel(parameter.Name, !parameter.IsNullable)} (JSON)")"
                                          Value="@GetStringValue(parameter.Name)"
                                          ValueChanged="@(v => SetValue(parameter.Name, v))"
                                          Lines="6"
                                          Error="@HasError(parameter.Name)"
                                          ErrorText="@GetError(parameter.Name)"
                                          Immediate="true" />
                            break;

                        default:
                            <MudAlert Severity="Severity.Error">
                                Parameter '@parameter.Name' (type @parameter.Type.Name) cannot be provided via UI
                            </MudAlert>
                            break;
                    }
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Execute"
                   Disabled="@(!IsValid)">Execute</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public MethodMetadata? Method { get; set; }

    private readonly Dictionary<string, string?> _inputValues = new();
    private readonly Dictionary<string, string?> _errors = new();

    private enum InputKind
    {
        Unsupported,
        Simple,
        Members,
        Json
    }

    // One entered value: a simple parameter is keyed by its name, a member of an object parameter by
    // "parameter.Member", so the two never collide.
    private sealed record InputField(string Key, string Label, Type Type, StateUnit? Unit, bool IsRequired);

    private IEnumerable<MethodParameter> InputParameters =>
        Method?.Parameters.Where(p => p.RequiresInput) ?? [];

    protected override void OnParametersSet()
    {
        if (Method == null)
        {
            return;
        }

        foreach (var parameter in InputParameters)
        {
            switch (GetInputKind(parameter))
            {
                case InputKind.Simple when !_inputValues.ContainsKey(parameter.Name):
                    _inputValues[parameter.Name] = parameter.Type == typeof(bool) ? "false" : null;
                    break;

                case InputKind.Members:
                    foreach (var field in CreateMemberFields(parameter))
                    {
                        if (field.Type == typeof(bool) && !_inputValues.ContainsKey(field.Key))
                        {
                            _inputValues[field.Key] = "false";
                        }
                    }
                    break;
            }
        }

        ValidateAll();
    }

    private static InputKind GetInputKind(MethodParameter parameter) =>
        ParameterConverter.IsSupported(parameter.Type) ? InputKind.Simple
        : ParameterConverter.IsSupportedObject(parameter.Type) ? InputKind.Members
        : ParameterConverter.IsJsonObject(parameter.Type) ? InputKind.Json
        : InputKind.Unsupported;

    private static InputField CreateParameterField(MethodParameter parameter) =>
        new(parameter.Name, GetLabel(parameter.Name, !parameter.IsNullable), parameter.Type, parameter.Unit, !parameter.IsNullable);

    private static IEnumerable<InputField> CreateMemberFields(MethodParameter parameter) =>
        ParameterConverter.GetObjectMembers(parameter.Type).Select(member => CreateMemberField(parameter, member));

    // An optional object parameter can be left out entirely, so none of its members are individually required
    // even when the member itself is required once the object is provided; that check happens in TryCreateObject.
    private static InputField CreateMemberField(MethodParameter parameter, ObjectParameterMember member)
    {
        var isRequired = member.IsRequired && !parameter.IsNullable;
        return new InputField(GetMemberKey(parameter, member), GetLabel(member.Name, isRequired), member.Type, null, isRequired);
    }

    private static string GetMemberKey(MethodParameter parameter, ObjectParameterMember member) =>
        $"{parameter.Name}.{member.Name}";

    private static string GetLabel(string name, bool isRequired)
    {
        var label = char.ToUpperInvariant(name[0]) + name.Substring(1);
        return isRequired ? $"{label} *" : label;
    }

    private RenderFragment RenderField(InputField field) => __builder =>
    {
        var valueType = Nullable.GetUnderlyingType(field.Type) ?? field.Type;
        if (valueType == typeof(bool))
        {
            <MudCheckBox T="bool"
                         Label="@field.Label"
                         Value="@GetBoolValue(field.Key)"
                         ValueChanged="@(v => SetValue(field.Key, v))" />
        }
        else if (valueType.IsEnum)
        {
            // A plain enum member that is not required still has a default value once omitted, so its empty
            // option reads "(Default)"; only a Nullable<T> enum actually becomes null, which reads "(None)".
            var isNullableType = Nullable.GetUnderlyingType(field.Type) != null;
            <MudSelect T="string"
                       Label="@field.Label"
                       Value="@GetStringValue(field.Key)"
                       ValueChanged="@(v => SetValue(field.Key, v))"
                       Error="@HasError(field.Key)"
                       ErrorText="@GetError(field.Key)"
                       Required="@field.IsRequired">
                @if (!field.IsRequired)
                {
                    <MudSelectItem Value="@((string?)null)">@(isNullableType ? "(None)" : "(Default)")</MudSelectItem>
                }
                @foreach (var enumValue in Enum.GetNames(valueType))
                {
                    <MudSelectItem Value="@enumValue">@enumValue</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            var unitSuffix = field.Unit.HasValue ? StateUnitExtensions.GetUnitSuffix(field.Unit.Value) : null;
            <MudTextField T="string"
                          Label="@field.Label"
                          Value="@GetStringValue(field.Key)"
                          ValueChanged="@(v => SetValue(field.Key, v))"
                          Error="@HasError(field.Key)"
                          ErrorText="@GetError(field.Key)"
                          Required="@field.IsRequired"
                          Immediate="true"
                          Adornment="@(unitSuffix != null ? Adornment.End : Adornment.None)"
                          AdornmentText="@unitSuffix" />
        }
    };

    private bool GetBoolValue(string key) =>
        _inputValues.TryGetValue(key, out var value) && (value?.Equals("true", StringComparison.OrdinalIgnoreCase) ?? false);

    private string? GetStringValue(string key) => _inputValues.GetValueOrDefault(key);

    private void SetValue(string key, object? value)
    {
        _inputValues[key] = value?.ToString();
        ValidateAll();
    }

    private void ValidateAll()
    {
        _errors.Clear();
        foreach (var parameter in InputParameters)
        {
            switch (GetInputKind(parameter))
            {
                case InputKind.Simple:
                    ValidateField(CreateParameterField(parameter));
                    break;

                case InputKind.Members:
                    var fields = CreateMemberFields(parameter).ToArray();
                    foreach (var field in fields)
                    {
                        ValidateField(field);
                    }

                    if (fields.All(field => !_errors.ContainsKey(field.Key)) && !TryCreateMembersValue(parameter, out _, out var membersError))
                    {
                        _errors[parameter.Name] = membersError;
                    }
                    break;

                case InputKind.Json:
                    if (!ParameterConverter.TryParseJson(GetStringValue(parameter.Name), parameter.Type, parameter.IsNullable, out _, out var jsonError))
                    {
                        _errors[parameter.Name] = jsonError;
                    }
                    break;
            }
        }
    }

    private void ValidateField(InputField field)
    {
        var input = _inputValues.GetValueOrDefault(field.Key);
        if (string.IsNullOrEmpty(input))
        {
            if (field.IsRequired)
            {
                _errors[field.Key] = "This field is required";
            }
            return;
        }

        if (!ParameterConverter.TryConvert(input, field.Type, field.Unit, out _))
        {
            _errors[field.Key] = $"Invalid value for {(Nullable.GetUnderlyingType(field.Type) ?? field.Type).Name}";
        }
    }

    private bool TryCreateMembersValue(MethodParameter parameter, out object? value, out string? error)
    {
        var members = ParameterConverter.GetObjectMembers(parameter.Type);
        var inputs = members.ToDictionary(member => member.Name, member => GetStringValue(GetMemberKey(parameter, member)));
        if (parameter.IsNullable && inputs.Values.All(string.IsNullOrEmpty))
        {
            value = null;
            error = null;
            return true;
        }

        return ParameterConverter.TryCreateObject(parameter.Type, inputs, out value, out error);
    }

    private bool HasError(string key) => _errors.ContainsKey(key);

    private string? GetError(string key) => _errors.GetValueOrDefault(key);

    private bool IsValid =>
        Method != null &&
        InputParameters.All(parameter => GetInputKind(parameter) != InputKind.Unsupported) &&
        _errors.Count == 0;

    private void Cancel() => MudDialog?.Cancel();

    private void Execute()
    {
        if (Method == null || !IsValid)
        {
            return;
        }

        var inputParameters = InputParameters.ToArray();
        var parameters = new object?[inputParameters.Length];
        for (var i = 0; i < inputParameters.Length; i++)
        {
            var parameter = inputParameters[i];
            switch (GetInputKind(parameter))
            {
                case InputKind.Simple:
                    // A percent is entered from 0 to 100 next to the % adornment, but the operation takes a fraction.
                    if (ParameterConverter.TryConvert(GetStringValue(parameter.Name), parameter.Type, parameter.Unit, out var simpleValue))
                    {
                        parameters[i] = simpleValue;
                    }
                    break;

                case InputKind.Members:
                    if (TryCreateMembersValue(parameter, out var membersValue, out _))
                    {
                        parameters[i] = membersValue;
                    }
                    break;

                case InputKind.Json:
                    if (ParameterConverter.TryParseJson(GetStringValue(parameter.Name), parameter.Type, parameter.IsNullable, out var jsonValue, out _))
                    {
                        parameters[i] = jsonValue;
                    }
                    break;
            }
        }

        MudDialog?.Close(DialogResult.Ok(parameters));
    }

    public static Task<IDialogReference> ShowAsync(
        IDialogService dialogService,
        MethodMetadata method)
    {
        var parameters = new DialogParameters<MethodParameterDialog>
        {
            { x => x.Method, method }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        return dialogService.ShowAsync<MethodParameterDialog>(method.Title, parameters, options);
    }
}
