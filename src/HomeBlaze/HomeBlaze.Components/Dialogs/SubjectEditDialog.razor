@using HomeBlaze.Components.Editors
@using HomeBlaze.Services
@using HomeBlaze.Components.Abstractions
@using Namotion.Interceptor

<MudDialog AriaLabelledBy="@_titleId">
    <TitleContent>
        <MudText Typo="Typo.h6" id="@_titleId">@MudDialog?.Title</MudText>
        @if (Subject is not null)
        {
            var typeName = SubjectNames.GetTypeName(Subject.GetType());
            <MudText Typo="Typo.caption"
                     Class="mud-text-secondary"
                     Style="display: block; font-family: monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                     title="@typeName"
                     data-testid="subject-edit-dialog-type">@typeName</MudText>
        }
    </TitleContent>
    <DialogContent>
        <SubjectEditPanel @ref="_editPanel" Subject="@Subject" IsValidChanged="OnEditPanelIsValidChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="OnSaveClicked"
                   Disabled="@(!_isEditPanelValid)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public IInterceptorSubject? Subject { get; set; }

    private SubjectEditPanel? _editPanel;

    private readonly string _titleId = $"subject-edit-dialog-title-{Guid.NewGuid():N}";

    // Stays false until the panel reports, which it does once its editor is ready and can be saved.
    private bool _isEditPanelValid;

    public MaxWidth GetPreferredDialogSize()
    {
        return MaxWidth.Small;
    }

    private void Cancel() => MudDialog?.Cancel();

    private void OnEditPanelIsValidChanged(bool isValid)
    {
        _isEditPanelValid = isValid;
    }

    private async Task OnSaveClicked()
    {
        if (_editPanel is not { } editPanel)
        {
            return;
        }

        if (await editPanel.SaveAsync(CancellationToken.None))
        {
            MudDialog?.Close(DialogResult.Ok(true));
        }
        else
        {
            // The button may have been enabled from a validity the form no longer has.
            await editPanel.RefreshIsValidAsync();
        }
    }

    public static Task<IDialogReference> ShowAsync(
        IDialogService dialogService,
        SubjectComponentRegistry componentRegistry,
        IInterceptorSubject subject,
        string? title = null)
    {
        var parameters = new DialogParameters<SubjectEditDialog>
        {
            { x => x.Subject, subject }
        };

        var editRegistration = componentRegistry.GetComponent(
            subject.GetType(),
            SubjectComponentType.Edit);
        
        var options = new DialogOptions
        {
            MaxWidth = editRegistration != null ? MaxWidth.Large : MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        return dialogService.ShowAsync<SubjectEditDialog>(title ?? "Edit Subject", parameters, options);
    }
}
