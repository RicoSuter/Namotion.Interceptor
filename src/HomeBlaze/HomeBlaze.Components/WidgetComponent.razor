@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(Widget))]
@implements ISubjectComponent

@{
    // Resolved once per render and never kept: the read is what the tracking scope records.
    var widget = Subject as Widget;
    var resolvedSubject = widget?.ResolvedSubject;
}

@if (widget is null || resolvedSubject is null)
{
    <MudAlert Severity="Severity.Error" Dense="true">
        Cannot resolve path: @widget?.Path
    </MudAlert>
}
else if (widget.IsSelfOrAncestor(resolvedSubject) || IsShownByOuterReference(widget))
{
    <MudAlert Severity="Severity.Warning" Dense="true" data-testid="widget-cycle">
        Cannot show path: @widget.Path (it contains this widget)
    </MudAlert>
}
else
{
    <CascadingValue Value="this" IsFixed="true">
        <SubjectComponent Subject="@resolvedSubject" Type="SubjectComponentType.Widget" />
    </CascadingValue>
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    /// <summary>
    /// The nearest reference that this one is shown inside of, through any number of other components.
    /// </summary>
    [CascadingParameter]
    private WidgetComponent? OuterReference { get; set; }

    // Two references that show each other's container are not ancestors of each other in the object graph,
    // so that cycle only shows in the components: the same widget is then already being shown further out.
    private bool IsShownByOuterReference(Widget widget)
    {
        for (var outer = OuterReference; outer is not null; outer = outer.OuterReference)
        {
            if (ReferenceEquals(outer.Subject, widget))
            {
                return true;
            }
        }

        return false;
    }
}
