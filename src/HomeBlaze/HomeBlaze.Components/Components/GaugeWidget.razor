@using System.Globalization
@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(Gauge))]
@implements ISubjectComponent
@inject SubjectPathResolver PathResolver
@inject ITimeZoneDisplay TimeZone

@{
    var gauge = Subject as Gauge;
}

@if (gauge is not null)
{
    // Read once per render and never kept: the read is what the tracking scope records.
    var reading = ValueReader.Read(PathResolver, gauge, gauge.Path, gauge.Map, TimeZone);
    var state = GaugeDisplay.GetState(reading, gauge.Minimum, gauge.Maximum);
    var size = gauge.Size;

    if (reading.MapError is not null)
    {
        @* The value text is the one place that shows the error of a map. *@
        <ValueText Reading="@reading" />
    }
    else if (state.Error is not null)
    {
        <WidgetArgumentError Message="@state.Error" />
    }
    else
    {
        var label = ValueReader.GetLabel(reading, gauge.Label);

        <div class="d-inline-flex flex-column align-center gap-1"
             role="meter"
             aria-label="@label"
             aria-valuenow="@GaugeDisplay.FormatNumber(state.Value)"
             aria-valuemin="@GaugeDisplay.FormatNumber(state.Range?.Minimum)"
             aria-valuemax="@GaugeDisplay.FormatNumber(state.Range?.Maximum)"
             aria-valuetext="@reading.Text"
             data-testid="gauge"
             data-percent="@(state.Percent?.ToString("0.##", CultureInfo.InvariantCulture))">
            <div class="gauge-ring" style="@GaugeDisplay.GetRingStyle(size)">
                @* The full ring in a faint colour is the track, so that an empty ring is still seen. The inline size overrides the fixed sizes of MudBlazor. *@
                <MudProgressCircular Value="100" Min="0" Max="100" StrokeWidth="4" Class="gauge-track" Style="width: 100%; height: 100%;" aria-hidden="true" />
                <MudProgressCircular Value="@(state.Percent ?? 0)" Min="0" Max="100" StrokeWidth="4" Rounded="true" Color="@GaugeDisplay.GetColor(reading)" Class="gauge-value" Style="width: 100%; height: 100%;" aria-hidden="true" />
                <div class="gauge-text">
                    <ValueText Reading="@reading" Path="@gauge.Path" Typo="@GaugeDisplay.GetValueTypo(size)" />
                </div>
            </div>
            <MudText Typo="Typo.caption" Class="ma-0" data-testid="value-label">@label</MudText>
        </div>
    }
}

<style>
    .gauge-ring {
        position: relative;
    }

    .gauge-ring .mud-progress-circular {
        position: absolute;
        inset: 0;
    }

    .gauge-ring svg {
        width: 100%;
        height: 100%;
    }

    .gauge-ring .gauge-track {
        opacity: 0.2;
    }

    .gauge-ring .gauge-text {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
