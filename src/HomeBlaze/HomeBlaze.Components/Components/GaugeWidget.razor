@using System.Globalization
@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(Gauge))]
@implements ISubjectComponent
@inject SubjectPathResolver PathResolver
@inject ITimeZoneDisplay TimeZone

@{
    var gauge = Subject as Gauge;
}

@if (gauge is not null)
{
    // Read once per render and never kept: its render records the reads, so that it renders again when one changes.
    var path = gauge.Path;
    var reading = ValueReader.Read(PathResolver, gauge, path, gauge.Map, TimeZone);
    var state = ValueRangeResolver.GetState(reading.Property, reading.Value, gauge.Minimum, gauge.Maximum);
    var size = gauge.Size;

    if ((reading.MapError ?? state.Error) is { } error)
    {
        <WidgetArgumentError Message="@error" />
    }
    else
    {
        var label = ValueReader.GetLabel(reading.Property, gauge.Label, path);
        // A meter must have a value, so without one the ring is a named group; Blazor leaves out the null attributes.
        var isMeter = state.AriaValue is not null;

        @* The ring is the meter, and the label is next to it rather than inside, because a meter hides what is inside it
           from screen readers and the label can be a button. *@
        <div class="gauge-widget place-centered" style="@GaugeDisplay.GetSizeStyle(size)" data-testid="gauge">
            <div class="gauge-ring"
                 role="@(isMeter ? "meter" : "group")"
                 aria-label="@label"
                 aria-valuenow="@GaugeDisplay.FormatNumber(state.AriaValue)"
                 aria-valuemin="@GaugeDisplay.FormatNumber(isMeter ? state.Range?.Minimum : null)"
                 aria-valuemax="@GaugeDisplay.FormatNumber(isMeter ? state.Range?.Maximum : null)"
                 aria-valuetext="@(isMeter ? reading.Text : null)"
                 data-testid="gauge-meter"
                 data-percent="@(state.Percent?.ToString("0.##", CultureInfo.InvariantCulture))">
                @* The full ring in a faint color is the track, so that an empty ring is still seen. The inline size overrides the fixed sizes of MudBlazor. *@
                <MudProgressCircular Value="100" Min="0" Max="100" StrokeWidth="4" Class="gauge-track" Style="width: 100%; height: 100%;" aria-hidden="true" />
                <MudProgressCircular Value="@(state.Percent ?? 0)" Min="0" Max="100" StrokeWidth="4" Rounded="true" Color="@GaugeDisplay.GetColor(reading)" Class="gauge-value" Style="width: 100%; height: 100%;" aria-hidden="true" />
                <div class="gauge-text">
                    <ValueText Reading="@reading" Path="@path" />
                </div>
            </div>
            <HistoryLabel Property="@reading.Property" Text="@label" Class="ma-0 gauge-label" IsNamedElsewhere="true" />
        </div>
    }
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
