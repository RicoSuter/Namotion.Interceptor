@* The value of a value widget: its text in the colour of its case, a dash when it is missing, or the error of its map. *@
@* A widget reads all its values in one render, so an equal reading does not render the text again. *@
@inherits Namotion.Interceptor.Blazor.TrackedComponentBase

@if (Reading.MapError is not null)
{
    <WidgetArgumentError Message="@Reading.MapError" />
}
else if (Reading.IsMissing)
{
    <MudTooltip Text="@Path">
        <MudText Typo="@Typo" Class="mud-text-secondary ma-0" data-testid="value-missing">@Reading.Text</MudText>
    </MudTooltip>
}
else
{
    <MudText Typo="@Typo" Color="@Reading.Color" Class="ma-0" data-testid="value-text">@Reading.Text</MudText>
}

@code {
    [Parameter, EditorRequired]
    public ValueReading Reading { get; set; } = default!;

    /// <summary>
    /// The path of the value, shown as tooltip when the value is missing.
    /// </summary>
    [Parameter]
    public string? Path { get; set; }

    [Parameter]
    public Typo Typo { get; set; } = Typo.body2;
}
