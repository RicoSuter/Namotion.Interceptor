@using HomeBlaze.Components.Dialogs

@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(GridLayout))]
@implements ISubjectComponent

@inject IDialogService DialogService
@inject SubjectFactory SubjectFactory
@inject SubjectComponentRegistry ComponentRegistry
@inject RootManager RootManager
@inject ISnackbar Snackbar

<div class="grid-layout-container"
     style="display: grid;
            grid-template-rows: repeat(@(Grid?.Rows ?? 1), 1fr);
            grid-template-columns: repeat(@(Grid?.Columns ?? 1), 1fr);
            gap: 8px;
            width: 100%;
            min-height: 400px;
            position: relative;">

    @* Render cells *@
    @foreach (var cell in Cells)
    {
        <div class="grid-cell @(IsEditing ? "editing" : "")" style="@GetCellStyle(cell)">
            @if (IsEditing)
            {
                <LayoutItemActions EditTitle="Edit Cell"
                                   OnEdit="() => EditCell(cell)"
                                   OnDelete="() => DeleteCell(cell)" />
            }
            <div class="grid-cell-content">
                <SubjectComponent Subject="@cell.Child"
                                  Type="SubjectComponentType.Widget" />
            </div>
        </div>
    }

    @* Render empty cells for adding in edit mode *@
    @if (IsEditing)
    {
        @foreach (var (row, col) in GetEmptyCellPositions())
        {
            <div class="grid-cell empty edit-mode-selected-interactive"
                 style="grid-row: @(row + 1); grid-column: @(col + 1);"
                 @onclick="() => AddCellAt(row, col)">
                <MudIcon Icon="@Icons.Material.Filled.Add"
                         Color="Color.Default"
                         Class="add-icon" />
            </div>
        }
    }
</div>

<style>
    .grid-cell {
        background: var(--mud-palette-surface);
        border: 1px solid rgba(128,128,128,0.2);
        border-radius: 4px;
        min-height: 100px;
        overflow: hidden;
        position: relative;
    }

    /* In edit mode: disable widget interaction */
    .grid-cell.editing {
        border: 2px dashed var(--mud-palette-primary);
    }

    .grid-cell.editing .grid-cell-content {
        pointer-events: none;  /* Disable all widget interaction */
    }

    .grid-cell-content {
        width: 100%;
        height: 100%;
    }

    .grid-cell.empty {
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-style: dashed;
    }

    .grid-cell.empty:hover {
        background: rgba(var(--mud-palette-primary-rgb), 0.1);
    }

    .add-icon {
        opacity: 0.5;
    }
</style>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    private GridLayout? Grid => Subject as GridLayout;

    private GridCell[] Cells => Grid?.Cells ?? [];

    private string GetCellStyle(GridCell cell)
    {
        var row = cell.Row.HasValue ? $"grid-row: {cell.Row.Value + 1} / span {cell.RowSpan}" : null;
        var col = cell.Column.HasValue ? $"grid-column: {cell.Column.Value + 1} / span {cell.ColumnSpan}" : null;

        return (row, col) switch
        {
            (not null, not null) => $"{row}; {col}",
            (not null, null) => row,
            (null, not null) => col,
            _ => ""
        };
    }

    private IEnumerable<(int row, int col)> GetEmptyCellPositions()
    {
        if (Grid == null) yield break;

        var occupied = new HashSet<(int, int)>();

        // Mark all occupied cells (accounting for spans)
        foreach (var cell in Cells)
        {
            if (!cell.Row.HasValue || !cell.Column.HasValue) continue;

            for (int r = 0; r < cell.RowSpan; r++)
            {
                for (int c = 0; c < cell.ColumnSpan; c++)
                {
                    occupied.Add((cell.Row.Value + r, cell.Column.Value + c));
                }
            }
        }

        // Return unoccupied positions
        for (int r = 0; r < Grid.Rows; r++)
        {
            for (int c = 0; c < Grid.Columns; c++)
            {
                if (!occupied.Contains((r, c)))
                    yield return (r, c);
            }
        }
    }

    private async Task AddCellAt(int row, int column)
    {
        await SubjectSetupDialog.ShowAsync(DialogService, new SubjectSetupOptions
        {
            BeforeSave = subject =>
            {
                if (Grid == null) return;

                var cell = SubjectFactory.CreateSubject<GridCell>();
                cell.Row = row;
                cell.Column = column;
                cell.Child = subject;

                Grid.Cells = [.. Cells, cell];
            }
        });
    }

    private async Task EditCell(GridCell cell)
    {
        var title = cell.Child is { } child ? SubjectNames.TryGetTitle(child) : null;
        await SubjectEditDialog.ShowAsync(DialogService, ComponentRegistry, cell, title is null ? "Edit Cell" : $"Edit Cell: {title}");
    }

    private async Task DeleteCell(GridCell cell)
    {
        if (Grid == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Cell",
            "Are you sure you want to delete this cell?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            Grid.Cells = Cells.Where(existing => existing != cell).ToArray();

            await RootManager.WriteConfigurationOrWarnAsync(Grid, Snackbar, CancellationToken.None);
        }
    }
}
