@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.Components.Operations
@implements IDisposable
@inject IDialogService DialogService
@inject IServiceProvider ServiceProvider

@{
    // Read once per render and never kept: the reads are what the tracking scope records.
    var property = Property;
    var method = property?.GetValue() as MethodMetadata;
    var isEnabled = method is not null && property!.IsMethodEnabled();
    var text = !string.IsNullOrEmpty(Label) ? Label : method?.Title ?? Path ?? string.Empty;
    var icon = MudBlazorIconResolver.ResolveOrNull(!string.IsNullOrEmpty(Icon) ? Icon : method is null ? null : OperationInvoker.GetIconName(method));
    var tooltip = method is null ? Path : method.Description;
    var isDisabled = IsEditing || _isRunning || !isEnabled;
}

@if (Kind == OperationButtonKind.Tile)
{
    <TileView TestId="operation-button-tile"
              AccessibleName="@(string.IsNullOrEmpty(Label) ? text : null)"
              Tooltip="@tooltip"
              Label="@Label"
              Subtitle="@Subtitle"
              Icon="@icon"
              Color="@Color"
              Variant="@Variant"
              Disabled="@isDisabled"
              IsBusy="@_isRunning"
              Badge="@Badge"
              OnClick="_runCallback" />
}
else
{
    <MudButton Variant="@Variant"
               Color="@Color"
               StartIcon="@(_isRunning ? null : icon)"
               Disabled="@isDisabled"
               OnClick="_runCallback"
               title="@tooltip"
               aria-busy="@(_isRunning ? "true" : null)"
               data-testid="operation-button">
        @* The spinner takes the start icon's place instead of adding one, so the button keeps its width while busy. *@
        @if (_isRunning)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width: 20px; height: 20px;" />
        }
        @text
    </MudButton>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private bool _isRunning;
    private EventCallback<MouseEventArgs> _runCallback;

    /// <summary>
    /// The method property of the operation or query, or null when the path leads nowhere.
    /// </summary>
    [Parameter]
    public RegisteredSubjectProperty? Property { get; set; }

    /// <summary>
    /// The path as written, the text when the path leads nowhere and no label is given.
    /// </summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>
    /// The text of the button, the title of the method when it is not set.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// The name of the icon at the start of the button. Defaults to the icon of the method, else "PlayArrow"
    /// for an operation and "Search" for a query.
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public Color Color { get; set; } = OperationButton.DefaultColor;

    [Parameter]
    public Variant Variant { get; set; } = OperationButton.DefaultVariant;

    /// <summary>
    /// Whether the operation is drawn as a button or as a tile that fills its place.
    /// </summary>
    [Parameter]
    public OperationButtonKind Kind { get; set; }

    /// <summary>
    /// A second, smaller line below the label of a tile.
    /// </summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>
    /// Content drawn over the top right corner of a tile, such as an indicator.
    /// </summary>
    [Parameter]
    public IInterceptorSubject? Badge { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    protected override void OnInitialized()
    {
        // Created once: binding the method group directly in the markup would allocate a new delegate on every render.
        _runCallback = EventCallback.Factory.Create<MouseEventArgs>(this, RunAsync);
    }

    private async Task RunAsync()
    {
        if (_isRunning || Property?.GetValue() is not MethodMetadata method)
        {
            return;
        }

        _isRunning = true;
        try
        {
            await OperationInvoker.InvokeAsync(DialogService, ServiceProvider, method, _lifetime.Token);
        }
        finally
        {
            _isRunning = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
