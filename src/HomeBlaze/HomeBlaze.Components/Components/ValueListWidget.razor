@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(ValueList))]
@implements ISubjectComponent
@inherits SelectionContainingWidgetBase
@inject SubjectPathResolver PathResolver
@inject ITimeZoneDisplay TimeZone

@{
    // Read once per render and never kept in a field: its render records the read, so that it renders again when it changes.
    // The readings come first because a row without an icon needs to know whether another row has one.
    // Every option of a row is read once, because each read is intercepted and recorded.
    var rows = (Subject as ValueList)?.Values ?? [];
    var items = new (string? Path, ValueReading? Reading, string? Icon)[rows.Length];
    var anyIcon = false;
    for (var index = 0; index < rows.Length; index++)
    {
        var row = rows[index];
        var path = row.Path;
        var reading = string.IsNullOrEmpty(path) ? null : ValueReader.Read(PathResolver, row, path, row.Map, TimeZone);
        var icon = MudBlazorIconResolver.ResolveOrNull(reading?.Icon ?? row.Icon);
        items[index] = (path, reading, icon);
        anyIcon |= icon is not null;
    }
}

<MudList T="string" Dense="true" ReadOnly="true" Padding="false" Class="value-list" data-testid="value-list">
    @for (var index = 0; index < rows.Length; index++)
    {
        var row = rows[index];
        var (path, reading, icon) = items[index];
        if (IsEditing && Selection is not null)
        {
            @* A row is selectable only while the list or one of its rows is selected, so that the first click on the list
               selects the list. It stays mounted when that changes, so that a selected widget in its content stays selected. *@
            <SubjectComponent @key="row"
                              Subject="@row"
                              Type="SubjectComponentType.Widget"
                              IsSelectionEnabled="@ContainsSelection"
                              AdditionalParameters="@(new Dictionary<string, object?> { ["Path"] = path, ["Reading"] = reading, ["Icon"] = icon, ["AnyIcon"] = anyIcon })" />
        }
        else
        {
            <ValueListRow @key="row" Row="@row" Path="@path" Reading="@reading" Icon="@icon" AnyIcon="@anyIcon" />
        }
    }
</MudList>
@if (ContainsSelection && StructureEditor is { } editor && Subject is ValueList list && PageListSlot.Find(editor.GetListSlots(list), "Value") is { } slot)
{
    @* Shown while the list or one of its rows is selected, and it takes the pointer in both cases. *@
    <MudButton Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               Class="edit-mode-interactive"
               OnClick="@(() => editor.AddListItemAsync(list, slot))"
               data-testid="add-value-button">Add value</MudButton>
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [CascadingParameter]
    public PageStructureEditor? StructureEditor { get; set; }
}
