@using System.Runtime.CompilerServices
@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(ExpansionPanels))]
@implements ISubjectComponent
@inherits PermissionsComponentBase

@{
    // Read once per render and never kept: a reload assigns a new array.
    var layout = Subject as ExpansionPanels;
    var panels = GetShownPanels(layout);
}

<MudExpansionPanels MultiExpansion="@(layout?.Single != true)" data-testid="expansion-panels">
    @foreach (var panel in panels)
    {
        <MudExpansionPanel @key="panel"
                           Expanded="@IsExpanded(panel)"
                           ExpandedChanged="@(expanded => SetExpanded(panel, expanded))"
                           HeaderClass="edit-mode-interactive"
                           data-testid="expansion-panel">
            <TitleContent>
                <div class="d-flex align-center gap-2">
                    @if (!string.IsNullOrEmpty(panel.Icon))
                    {
                        <MudIcon Icon="@MudBlazorIconResolver.Resolve(panel.Icon)" />
                    }

                    <MudText Class="ma-0">@panel.Title</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="layout-cell" data-testid="expansion-panel-content">
                    <SubjectComponent Subject="@panel.Content" Type="SubjectComponentType.Widget" />
                </div>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    // What the viewer opened and closed, by panel instance, so that a reload which keeps a panel keeps its
    // state. Weak, because a reload can replace a panel and nothing tells this component.
    private readonly ConditionalWeakTable<ExpansionPanel, StrongBox<bool>> _expanded = new();

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    // A panel the roles hide is neither named nor rendered. The array of the layout is returned when every panel is shown.
    private ExpansionPanel[] GetShownPanels(ExpansionPanels? layout)
    {
        var panels = layout?.Panels ?? [];
        foreach (var panel in panels)
        {
            if (!Permissions.CanShow(panel))
            {
                return panels.Where(shown => Permissions.CanShow(shown)).ToArray();
            }
        }

        return panels;
    }

    private bool IsExpanded(ExpansionPanel panel) =>
        _expanded.TryGetValue(panel, out var expanded) ? expanded.Value : panel.Expanded;

    private void SetExpanded(ExpansionPanel panel, bool expanded) =>
        _expanded.AddOrUpdate(panel, new StrongBox<bool>(expanded));
}
