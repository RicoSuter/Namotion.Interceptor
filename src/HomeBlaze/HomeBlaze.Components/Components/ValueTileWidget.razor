@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(ValueTile))]
@implements ISubjectComponent
@inject SubjectPathResolver PathResolver
@inject ITimeZoneDisplay TimeZone

@{
    var tile = Subject as ValueTile;
}

@if (tile is not null)
{
    // Read once per render and never kept: its render records the reads, so that it renders again when one changes.
    var path = tile.Path;
    var reading = ValueReader.Read(PathResolver, tile, path, tile.Map, TimeZone);
    if (reading.MapError is not null)
    {
        <WidgetArgumentError Message="@reading.MapError" />
    }
    else
    {
        var icon = MudBlazorIconResolver.ResolveOrNull(reading.Icon ?? tile.Icon);

        <MudPaper Class="pa-3" Elevation="1" data-testid="value-tile">
            <div class="d-flex align-center gap-1">
                @if (icon is not null)
                {
                    <MudIcon Icon="@icon" Size="Size.Small" />
                }

                <MudText Typo="Typo.caption" data-testid="value-label">@ValueReader.GetLabel(reading.Property, tile.Label, path)</MudText>
            </div>
            <ValueText Reading="@reading" Path="@path" Typo="Typo.h5" />
        </MudPaper>
    }
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
