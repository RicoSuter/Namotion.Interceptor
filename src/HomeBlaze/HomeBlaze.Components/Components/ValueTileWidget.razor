@using HomeBlaze.Components.Abstractions.TimeZones
@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(ValueTile))]
@implements ISubjectComponent
@inject SubjectPathResolver PathResolver
@inject ITimeZoneDisplay TimeZone

@{
    var tile = Subject as ValueTile;
}

@if (tile is not null)
{
    // Read once per render and never kept: the read is what the tracking scope records.
    var reading = ValueReader.Read(PathResolver, tile, tile.Path, tile.Map, TimeZone);
    var icon = reading.Icon ?? tile.Icon;

    <MudPaper Class="pa-3" Elevation="1" data-testid="value-tile">
        <div class="d-flex align-center gap-1">
            @if (!string.IsNullOrEmpty(icon))
            {
                <MudIcon Icon="@MudBlazorIconResolver.Resolve(icon)" Size="Size.Small" />
            }

            <MudText Typo="Typo.caption" data-testid="value-label">@ValueReader.GetLabel(reading, tile.Label)</MudText>
        </div>
        <ValueText Reading="@reading" Path="@tile.Path" Typo="Typo.h5" />
    </MudPaper>
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
