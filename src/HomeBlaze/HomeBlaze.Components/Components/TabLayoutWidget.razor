@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(TabLayout))]
@using MudBlazor.Services
@implements ISubjectComponent
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject IBrowserViewportService BrowserViewportService

@{
    // Read once per render and never kept: a reload assigns a new array.
    var tabs = Layout?.Tabs ?? [];
    var position = GetPosition();
}

<div class="tab-layout" data-testid="tab-layout">
    <MudTabs @ref="_tabs"
             Elevation="1"
             Rounded="true"
             TabHeaderClass="edit-mode-interactive"
             @attributes="GetChangedPosition(position)"
             ActivePanelIndex="@GetActivePanelIndex(tabs)"
             ActivePanelIndexChanged="@OnActivePanelIndexChanged">
        @* Not keyed: MudTabs lists its panels in the order they were created, so a panel that moved with
           its tab would keep its old place in the tab bar. Each panel shows the tab at its position. *@
        @foreach (var tab in tabs)
        {
            <MudTabPanel Tag="@tab"
                         Text="@tab.Title"
                         Icon="@MudBlazorIconResolver.ResolveOrNull(tab.Icon)">
                <div class="tab-layout-panel layout-cell @GetPanelSpacing(position)" data-testid="tab-panel">
                    <SubjectComponent @key="tab" Subject="@tab.Content" Type="SubjectComponentType.Widget" />
                </div>
            </MudTabPanel>
        }
    </MudTabs>
</div>

<style>
    /* Beside the tab bar the panels are the items of a row. A panel takes the room that the tab bar leaves,
       also when its content is narrower. Content that cannot get as narrow as that room, like a wide table,
       scrolls inside the panel: left to overflow, it would cover a tab bar at the right. */
    .tab-layout-panel-beside {
        flex: 1 1 0;
        min-width: 0;
        overflow-x: auto;
    }

    /* Without this, such content widens the row of the panels and with it the page. The child selectors keep
       the rules of this block away from a vertical tab bar that a widget inside a tab has of its own. */
    .tab-layout > .mud-tabs > .mud-tabs-panels.mud-tabs-vertical {
        min-width: 0;
    }

    /* Tabs below each other start at the same place, so that their icons stand in one line. */
    .tab-layout > .mud-tabs > .mud-tabs-tabbar.mud-tabs-vertical .mud-tab {
        justify-content: flex-start;
    }
</style>

@code {
    private MudTabs? _tabs;

    // Only ever compared with the tabs of the current render, never used on its own.
    private Tab? _selectedTab;

    // The position that MudTabs has, which starts as its default.
    private MudBlazor.Position _shownPosition = MudBlazor.Position.Top;

    // Below this width of the window, in pixels, a tab bar at a side moves to the top.
    private const int NarrowWindowWidth = 600;

    private bool _isNarrow;
    private bool _isSubscribed;
    private bool _isDisposed;

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    private TabLayout? Layout => Subject as TabLayout;

    Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

    ResizeOptions? IBrowserViewportObserver.ResizeOptions => null;

    // A tab bar at a side leaves too little room for the content of a narrow window, so it is at the top there.
    private MudBlazor.Position GetPosition() => Layout?.Position switch
    {
        TabPosition.Left when !_isNarrow => MudBlazor.Position.Left,
        TabPosition.Right when !_isNarrow => MudBlazor.Position.Right,
        TabPosition.Bottom => MudBlazor.Position.Bottom,
        _ => MudBlazor.Position.Top
    };

    // MudTabs measures its tabs in the browser and renders a second time whenever it is handed a position, also
    // an unchanged one. It keeps the last position it was handed, so it gets one only when the position changes.
    private Dictionary<string, object>? GetChangedPosition(MudBlazor.Position position)
    {
        if (position == _shownPosition)
        {
            return null;
        }

        _shownPosition = position;
        return new Dictionary<string, object> { [nameof(MudTabs.Position)] = position };
    }

    // The space between the tab bar and the content. A panel beside the tab bar clips what leaves it, so it
    // also keeps a little room for the shadow of a card at its other edges.
    private static string GetPanelSpacing(MudBlazor.Position position) => position switch
    {
        MudBlazor.Position.Left => "tab-layout-panel-beside pl-4 pr-1 pb-1",
        MudBlazor.Position.Right => "tab-layout-panel-beside pr-4 pl-1 pb-1",
        MudBlazor.Position.Bottom => "pb-4",
        _ => "pt-4"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only a layout with its tabs at a side has to know the width of the window. It keeps listening once it
        // did, because a reload of the page can move the tabs away from the side and back.
        if (_isSubscribed || Layout?.Position is not (TabPosition.Left or TabPosition.Right))
        {
            return;
        }

        _isSubscribed = true;
        await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);

        // The service adds the observer when the browser has answered, which can be after the page was left.
        if (_isDisposed)
        {
            await BrowserViewportService.UnsubscribeAsync(this);
        }
    }

    Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs browserViewportEventArgs)
    {
        // The width and not the breakpoint: the first notification has the width of this moment, but a
        // breakpoint that the service worked out from the width it saw last.
        var isNarrow = browserViewportEventArgs.BrowserWindowSize?.Width < NarrowWindowWidth;
        if (isNarrow == _isNarrow)
        {
            return Task.CompletedTask;
        }

        _isNarrow = isNarrow;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        if (_isSubscribed)
        {
            await BrowserViewportService.UnsubscribeAsync(this);
        }
    }

    private int GetActivePanelIndex(Tab[] tabs)
    {
        for (var index = 0; index < tabs.Length; index++)
        {
            if (ReferenceEquals(tabs[index], _selectedTab))
            {
                return index;
            }
        }

        // Nothing was selected yet, or a reload removed or replaced the selected tab.
        _selectedTab = null;
        return 0;
    }

    private void OnActivePanelIndexChanged(int index)
    {
        // Taken from the panel and not from the slot: the index belongs to the panels as they were last
        // rendered, and the slot can hold a newer array by now.
        var panels = _tabs?.Panels;
        _selectedTab = panels is not null && index >= 0 && index < panels.Count
            ? panels[index].Tag as Tab
            : null;
    }
}
