@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(Card))]
@implements ISubjectComponent

@{
    var card = Subject as Card;
}

@if (card is not null)
{
    var hasTitle = !string.IsNullOrEmpty(card.Title);
    var hasSubtitle = !string.IsNullOrEmpty(card.Subtitle);
    var hasIcon = !string.IsNullOrEmpty(card.Icon);
    var headerRight = card.HeaderRight;
    var hasHeader = hasTitle || hasSubtitle || hasIcon || headerRight is not null;

    // The title and the body sit close together, as the lines of a paragraph. A picture between them, or a missing body or header, leaves the full padding.
    var hasPicture = !string.IsNullOrEmpty(card.Image);
    var isTight = hasHeader && card.Content is not null && !hasPicture;

    // MudCardHeader gives its actions area a margin of -8 pixels at the top and at the end, because it is made for icon buttons with a padding of their own. me-2 and mt-3 cancel that, so that the content ends where the content of the card ends.
    // The 4 pixels that mt-3 adds beyond the 8 centre one line of content, 24 pixels high, on the 32 pixel title line. A button in the slot has a padding of its own and needs no me-2 and no mt-3.
    // A part of the header that is not set is passed as null, because the header keeps room for a part that is an empty fragment.
    RenderFragment? avatar = hasIcon
        ? @<MudIcon Icon="@MudBlazorIconResolver.Resolve(card.Icon!)" Color="@card.IconColor" data-testid="card-icon" />
        : null;
    RenderFragment? actions = headerRight is not null
        ? @<div class="mt-3 me-2" data-testid="card-header-right"><SubjectComponent Subject="@headerRight" Type="SubjectComponentType.Widget" /></div>
        : null;

    <MudCard Class="card-widget" Elevation="@(card.Outlined ? 0 : card.Elevation)" Outlined="@card.Outlined" data-testid="card">
        @if (hasHeader)
        {
            <MudCardHeader Class="@(isTight ? "pb-2" : null)" CardHeaderAvatar="@avatar" CardHeaderActions="@actions">
                <CardHeaderContent>
                    @if (hasTitle && !string.IsNullOrEmpty(card.Href))
                    {
                        <MudLink Href="@card.ResolveScopedLink(card.Href)" Typo="Typo.h6" Color="Color.Inherit" data-testid="card-title">@card.Title</MudLink>
                    }
                    else if (hasTitle)
                    {
                        <MudText Typo="Typo.h6" data-testid="card-title">@card.Title</MudText>
                    }

                    @if (hasSubtitle)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary ma-0" data-testid="card-subtitle">@card.Subtitle</MudText>
                    }
                </CardHeaderContent>
            </MudCardHeader>
        }

        @if (hasPicture)
        {
            <MudCardMedia Image="@card.ResolveScopedLink(card.Image)" Height="200" />
        }

        @if (card.Content is not null)
        {
            <MudCardContent Class="@(isTight ? "pt-0" : null)">
                <SubjectComponent Subject="@card.Content" Type="SubjectComponentType.Widget" />
            </MudCardContent>
        }

        @if (card.Footer is not null)
        {
            <MudDivider />
            <MudCardActions Class="pa-4" data-testid="card-footer">
                <SubjectComponent Subject="@card.Footer" Type="SubjectComponentType.Widget" />
            </MudCardActions>
        }
    </MudCard>
}

<style>
    /* The distance between two paragraphs of a page, so that cards below each other do not touch. */
    .card-widget {
        margin-bottom: 0.75rem;
    }

    /* A layout cell spaces its content itself, so the card that ends the cell adds nothing below.
       The two wrappers are those of SubjectComponent, for the content of the cell and for the card. */
    .layout-cell > .subject-component-wrapper > .subject-component-wrapper:last-of-type > .card-widget {
        margin-bottom: 0;
    }
</style>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
