@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(Card))]
@implements ISubjectComponent

@{
    var card = Subject as Card;
}

@if (card is not null)
{
    var sizeStyle = _styleCache.GetStyle(card.Height, card.AspectRatio, out var sizeError);
    if (sizeError is not null)
    {
        <WidgetArgumentError Message="@sizeError" />
    }
    else
    {
        var hasTitle = !string.IsNullOrEmpty(card.Title);
        var hasSubtitle = !string.IsNullOrEmpty(card.Subtitle);
        var hasIcon = !string.IsNullOrEmpty(card.Icon);
        var headerRight = card.HeaderRight;
        var hasHeader = hasTitle || hasSubtitle || hasIcon || headerRight is not null;

        // The paddings, and the closer distance between a header and a body that follows it directly, are in card-widget.css.
        // MudCardHeader gives its actions area a margin of -8 pixels at the top and at the end, because it is made for icon buttons with a padding of their own. me-1 and mt-2 cancel 4 of them and the 4 pixels that an indicator has around itself the rest, so that its visible edge ends where the content of the card ends, as the header and the body have the same padding. mb-n1 takes back the bottom margin of the indicator, which would make the header 4 pixels taller than the title.
        // The 4 pixels of top margin of the indicator are also what centres one line of content, 24 pixels high, on the 32 pixel title line. Text that stands here has no margin and ends 4 pixels further out than the content of the card. A button in the slot has a padding of its own and needs no me-1 and no mt-2.
        // The header aligns its parts at the top, so that the icon stands on the title line like the content of HeaderRight, also when the subtitle takes several lines. mt-1 centres the icon, 24 pixels high, on the 32 pixel title line. d-block keeps the icon out of a line box, which would add the room below a baseline to the height of the header.
        // A part of the header that is not set is passed as null, because the header keeps room for a part that is an empty fragment.
        RenderFragment? avatar = hasIcon
            ? @<MudIcon Icon="@MudBlazorIconResolver.Resolve(card.Icon!)" Color="@card.IconColor" Class="d-block mt-1" data-testid="card-icon" />
            : null;
        RenderFragment? actions = headerRight is not null
            ? @<div class="mt-2 me-1 mb-n1" data-testid="card-header-right"><SubjectComponent Subject="@headerRight" Type="SubjectComponentType.Widget" /></div>
            : null;

        <MudCard Class="@(sizeStyle is null ? "card-widget" : "card-widget card-widget-sized")" Style="@sizeStyle" Elevation="@(card.Outlined ? 0 : card.Elevation)" Outlined="@card.Outlined" data-testid="card">
            @if (hasHeader)
            {
                <MudCardHeader Class="align-start" CardHeaderAvatar="@avatar" CardHeaderActions="@actions">
                    <CardHeaderContent>
                        @if (hasTitle && !string.IsNullOrEmpty(card.Href))
                        {
                            @* While the page is edited the link would leave it, also by keyboard, so it leads nowhere and takes no focus. *@
                            <MudLink Href="@(IsEditing ? null : card.ResolveScopedLink(card.Href))" Typo="Typo.h6" Color="Color.Inherit" tabindex="@(IsEditing ? "-1" : null)" data-testid="card-title">@card.Title</MudLink>
                        }
                        else if (hasTitle)
                        {
                            <MudText Typo="Typo.h6" data-testid="card-title">@card.Title</MudText>
                        }

                        @if (hasSubtitle)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary ma-0" data-testid="card-subtitle">@card.Subtitle</MudText>
                        }
                    </CardHeaderContent>
                </MudCardHeader>
            }

            @if (!string.IsNullOrEmpty(card.Image))
            {
                <MudCardMedia Image="@card.ResolveScopedLink(card.Image)" Height="200" />
            }

            @if (card.Content is not null)
            {
                <MudCardContent data-testid="card-content">
                    <SubjectComponent Subject="@card.Content" Type="SubjectComponentType.Widget" />
                </MudCardContent>
            }

            @if (card.Footer is not null)
            {
                <MudDivider />
                <MudCardActions data-testid="card-footer">
                    <SubjectComponent Subject="@card.Footer" Type="SubjectComponentType.Widget" />
                </MudCardActions>
            }
        </MudCard>
    }
}

@code {
    private readonly CardStyleCache _styleCache = new();

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }
}
