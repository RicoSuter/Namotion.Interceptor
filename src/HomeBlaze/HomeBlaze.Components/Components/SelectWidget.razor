@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(Select))]
@implements ISubjectComponent
@inject SubjectPathResolver PathResolver

@{
    var select = Subject as Select;
}

@if (select is not null)
{
    // Read once per render and never kept: its render records the reads, so that it renders again when one changes.
    var path = select.Path;
    var map = ValueReader.ResolveMap(PathResolver, select, select.Map, out var mapError);
    if (mapError is not null)
    {
        <WidgetArgumentError Message="@mapError" />
    }
    else
    {
        <SelectView Property="@ValueReader.ResolveProperty(PathResolver, select, path)"
                    Path="@path"
                    Label="@select.Label"
                    Map="@map" />
    }
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
