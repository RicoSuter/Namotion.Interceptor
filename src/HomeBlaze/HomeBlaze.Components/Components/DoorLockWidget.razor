@using HomeBlaze.Abstractions.Devices.Locks
@using HomeBlaze.Abstractions.Metadata
@using HomeBlaze.Abstractions.Sensors
@using HomeBlaze.Components.Controls
@using HomeBlaze.Components.Operations
@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(DoorLock))]
@implements ISubjectComponent
@implements IDisposable
@inject SubjectPathResolver PathResolver
@inject IDialogService DialogService
@inject IServiceProvider ServiceProvider

@{
    var widget = Subject as DoorLock;
}

@if (widget is not null)
{
    // Read once per render and never kept: its render records the reads, so that it renders again when one changes.
    var path = widget.Path;
    var (target, appearance, operation) = Resolve(widget);
    var label = !string.IsNullOrEmpty(widget.Label)
        ? widget.Label
        : (target is null ? null : SubjectNames.TryGetTitle(target, labelProperty: null)) ?? path ?? string.Empty;
    var subtitle = !string.IsNullOrEmpty(widget.Subtitle) ? widget.Subtitle : target is null ? null : appearance.Subtitle;

    <TileView TestId="door-lock-tile"
              AccessibleName="@label"
              Label="@label"
              Subtitle="@subtitle"
              Icon="@appearance.DoorIcon"
              Color="@appearance.Fill"
              Disabled="@(IsEditing || _isRunning || operation is null)"
              IsBusy="@_isRunning"
              BadgeIcon="@appearance.BadgeIcon"
              OnClick="_clickCallback" />
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private bool _isRunning;
    private EventCallback<MouseEventArgs> _clickCallback;

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    protected override void OnInitialized()
    {
        _clickCallback = EventCallback.Factory.Create<MouseEventArgs>(this, RunAsync);
    }

    // The lock at the path of the widget (null when there is none), what the tile shows for it, and the operation a click
    // invokes (null when there is none or it is not enabled).
    private (IInterceptorSubject? Target, DoorLockAppearance Appearance, MethodMetadata? Operation) Resolve(DoorLock widget)
    {
        var path = widget.Path;
        var target = string.IsNullOrEmpty(path)
            ? null
            : ValueReader.ResolveSubject(PathResolver, widget, path) as IDoorLockState as IInterceptorSubject;
        var appearance = DoorLockDisplay.Get((target as IDoorLockState)?.LockState, (target as IDoorSensor)?.DoorState);
        var property = target is not null && appearance.Operation is { } name ? target.TryGetRegisteredProperty(name) : null;
        var operation = property?.TryGetMethodMetadata() is { } method && property.IsMethodEnabled() ? method : null;
        return (target, appearance, operation);
    }

    private async Task RunAsync()
    {
        if (_isRunning || Subject is not DoorLock widget || Resolve(widget).Operation is not { } operation)
        {
            return;
        }

        _isRunning = true;
        try
        {
            await OperationInvoker.InvokeAsync(DialogService, ServiceProvider, operation, _lifetime.Token);
        }
        finally
        {
            _isRunning = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
