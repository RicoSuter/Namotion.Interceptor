@using HomeBlaze.Components.Controls
@inject PropertyWriter Writer

@{
    // Read once per render and never kept: the reads are what the tracking scope records.
    var property = Property;
    var enumType = property is null ? null : EnumChoices.GetEnumType(property.Type);
}

@if (enumType is not null && EnumChoices.IsFlags(enumType))
{
    <WidgetArgumentError Message="@EnumChoices.GetFlagsError(enumType)" />
}
else
{
    var value = property?.GetValue();
    var names = GetNames(enumType);
    var isNullable = enumType is not null && Nullable.GetUnderlyingType(property!.Type) is not null;
    var canWrite = enumType is not null && PropertyWriter.IsWritable(property!, value);
    var map = Map;

    <div data-testid="select">
        <MudSelect T="string"
                   @key="_resetKey"
                   Label="@ValueReader.GetControlLabel(property, Label, Path)"
                   Value="@(value is Enum ? value.ToString() : null)"
                   ValueChanged="_chooseCallback"
                   ToStringFunc="_textFunc"
                   Disabled="@(IsEditing || !canWrite)"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true">
            @if (isNullable)
            {
                <MudSelectItem T="string" Value="@((string?)null)">@ValueReader.MissingText</MudSelectItem>
            }
            @foreach (var name in names)
            {
                var mapCase = map?.FindCase(name);
                var icon = MudBlazorIconResolver.ResolveOrNull(mapCase?.Icon);
                <MudSelectItem T="string" Value="@name">
                    <div class="d-flex align-center gap-2">
                        @if (icon is not null)
                        {
                            <MudIcon Icon="@icon" Color="@mapCase!.Color" Size="Size.Small" />
                        }
                        <span>@GetText(name, mapCase)</span>
                    </div>
                </MudSelectItem>
            }
        </MudSelect>
    </div>
}

@code {
    // An object, not a counter: a boxed int as @key would allocate on every render.
    private object _resetKey = new();
    private EventCallback<string?> _chooseCallback;
    private Func<string?, string?> _textFunc = null!;
    // Enum.GetNames copies the names on every call, so they are kept per enum type.
    private Type? _namesType;
    private string[] _names = [];

    /// <summary>
    /// The enum property that the select shows, or null when the path leads nowhere.
    /// </summary>
    [Parameter]
    public RegisteredSubjectProperty? Property { get; set; }

    /// <summary>
    /// The path as written, the label when the path leads nowhere and no label is given.
    /// </summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>
    /// The label of the select, the title that the property declares when it is not set.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// The map that gives each value its text and icon, or null for the names of the enum.
    /// </summary>
    [Parameter]
    public ValueMap? Map { get; set; }

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    protected override void OnInitialized()
    {
        // Created once: binding method groups or lambdas in the markup would allocate new delegates on every render.
        _chooseCallback = EventCallback.Factory.Create<string?>(this, Choose);
        _textFunc = GetText;
    }

    private string[] GetNames(Type? enumType)
    {
        if (enumType is null)
        {
            return [];
        }

        if (enumType != _namesType)
        {
            _names = Enum.GetNames(enumType);
            _namesType = enumType;
        }

        return _names;
    }

    private string? GetText(string? name) => GetText(name, name is null ? null : Map?.FindCase(name));

    private static string GetText(string? name, ValueMapCase? mapCase)
    {
        if (name is null)
        {
            return ValueReader.MissingText;
        }

        var text = mapCase?.Text;
        return string.IsNullOrEmpty(text) ? name : text;
    }

    private void Choose(string? name)
    {
        var property = Property;
        var enumType = property is null ? null : EnumChoices.GetEnumType(property.Type);
        if (property is null || enumType is null)
        {
            return;
        }

        var value = name is null ? null : Enum.Parse(enumType, name);
        Writer.TryWrite(property, value);

        // The select keeps the choice the user made, and only a new key makes it show the property again.
        if (!Equals(property.GetValue(), value))
        {
            _resetKey = new object();
        }
    }
}
