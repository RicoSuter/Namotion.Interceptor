@using System.Runtime.CompilerServices
@using HomeBlaze.Components.Dialogs

@inject SubjectComponentRegistry ComponentRegistry
@inject IDialogService DialogService

@* The widget below tracks its own reads, so a parent that renders again with the same parameters, as a page does for a change of an expression, renders neither this wrapper nor the widget. *@
@inherits Namotion.Interceptor.Blazor.TrackedComponentBase
@implements IDisposable
@implements IHandleEvent

@if (Subject != null)
{
    var registration = ComponentRegistry.GetComponent(Subject.GetType(), Type);
    if (registration?.ComponentType != null)
    {
        var isSelectable = IsSelectable;
        var isSelected = isSelectable && ReferenceEquals(Selection?.Selected, this);
        var isRevealable = !isSelectable && Revealer is not null && Type == SubjectComponentType.Widget;
        @* A page fills a container of definite height, such as the split editor's pane, and keeps its natural
           height elsewhere. *@
        <div class="@GetWrapperClass(isSelectable, isSelected, isRevealable, _isTextBlock)"
             style="position: relative;@(Type == SubjectComponentType.Page ? " height: 100%;" : null)"
             tabindex="@(isSelectable ? "0" : null)"
             role="@(isSelectable ? "group" : null)"
             aria-roledescription="@(isSelectable ? "widget" : null)"
             aria-current="@(isSelected ? "true" : null)"
             aria-label="@(isSelectable ? GetAccessibleName() : null)"
             @onpointerdown="@(isSelectable ? _pointerDownCallback : default)"
             @onclick="@(isSelectable ? _clickCallback : isRevealable ? _revealCallback : default)"
             @onclick:stopPropagation="@(isSelectable || isRevealable)"
             @onkeydown="@(isSelectable ? _keyDownCallback : default)"
             @onkeydown:stopPropagation="@isSelectable">
            @{
                var selectableParent = isSelected ? SelectableAncestor : null;
                var structureEditor = isSelected ? StructureEditor : null;
                var actions = structureEditor?.GetActions(Subject) ?? default;
                var hasEditAction = isSelected && (actions.CanEditText || HasEditComponent);
                var listSlots = structureEditor?.GetListSlots(Subject) ?? [];
            }
            @if (isSelected && (selectableParent != null || hasEditAction || actions.CanDelete || listSlots.Count > 0))
            {
                @* The anchor of the bar, see SubjectComponent.razor.css. *@
                <div class="subject-action-bar-anchor">
                    <MudPopover Open="true"
                                AnchorOrigin="Origin.TopRight"
                                TransformOrigin="Origin.BottomRight"
                                OverflowBehavior="OverflowBehavior.FlipAlways"
                                Elevation="4"
                                Class="@(_isTextBlock ? "subject-action-bar text-block-bar" : "subject-action-bar")"
                                role="toolbar"
                                aria-label="Widget actions"
                                data-testid="widget-action-bar">
                        @* Written here, so that it keeps the scope of this component in the provider of the popover. *@
                        <div class="subject-action-bar-content">
                            @if (selectableParent != null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                               Size="Size.Small"
                                               Class="select-parent-button"
                                               title="Select parent"
                                               aria-label="Select parent"
                                               OnClick="_selectParentCallback"
                                               data-testid="select-parent-button" />
                            }

                            @if (actions.CanMoveUp)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                               Size="Size.Small"
                                               Color="@(_isTextBlock ? Color.Success : Color.Default)"
                                               title="Move up"
                                               aria-label="Move up"
                                               OnClick="_moveUpCallback"
                                               data-testid="move-up-button" />
                            }

                            @if (actions.CanMoveDown)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                               Size="Size.Small"
                                               Color="@(_isTextBlock ? Color.Success : Color.Default)"
                                               title="Move down"
                                               aria-label="Move down"
                                               OnClick="_moveDownCallback"
                                               data-testid="move-down-button" />
                            }

                            @foreach (var slot in listSlots)
                            {
                                @* Only the selected widget renders its bar, so the lambda allocates for one widget. *@
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Size="Size.Small"
                                               title="@($"Add {slot.Name}")"
                                               aria-label="@($"Add {slot.Name}")"
                                               OnClick="@(() => structureEditor!.AddListItemAsync(Subject!, slot))"
                                               data-testid="@($"add-slot-item-button-{slot.Name}")" />
                            }

                            @if (hasEditAction)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="@(_isTextBlock ? Color.Success : Color.Primary)"
                                               title="Edit"
                                               aria-label="Edit"
                                               OnClick="_editCallback"
                                               data-testid="edit-subject-button" />
                            }

                            @if (actions.CanDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               title="Delete"
                                               aria-label="Delete"
                                               OnClick="_deleteCallback"
                                               data-testid="delete-block-button" />
                            }
                        </div>
                    </MudPopover>
                </div>
            }
            <CascadingValue Value="this" Name="ParentSubjectComponent" IsFixed="true">
                <DynamicComponent Type="registration.ComponentType"
                                  @ref="_dynamicComponent"
                                  Parameters="@GetComponentParameters()" />
            </CascadingValue>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            No @Type component for @Subject.GetType().Name
        </MudAlert>
    }
}

@code {
    private DynamicComponent? _dynamicComponent;
    private object? _reportedInstance;
    private Dictionary<string, object?>? _cachedParameters;
    private IInterceptorSubject? _previousSubject;
    private Dictionary<string, object?>? _previousAdditionalParameters;

    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public SubjectComponentType Type { get; set; }

    /// <summary>
    /// Additional parameters to pass to the rendered component (e.g., IsCreating).
    /// </summary>
    [Parameter]
    public Dictionary<string, object?>? AdditionalParameters { get; set; }

    /// <summary>
    /// Whether the widget can be selected while the page is edited. A widget that cannot keeps rendering the same way,
    /// and the widgets inside it stay selectable.
    /// </summary>
    [Parameter]
    public bool IsSelectionEnabled { get; set; } = true;

    [CascadingParameter(Name = "IsEditing")]
    public bool IsEditing { get; set; }

    /// <summary>
    /// The selection of the page. Without one, no widget can be selected and no edit action is shown.
    /// </summary>
    [CascadingParameter]
    public WidgetSelection? Selection { get; set; }

    /// <summary>
    /// The editor of the structure of the page, cascaded while the page is edited inline. Without it no structure action
    /// is shown.
    /// </summary>
    [CascadingParameter]
    public PageStructureEditor? StructureEditor { get; set; }

    /// <summary>Cascaded to the preview next to an editor, where a click reveals the widget in the editor.</summary>
    [CascadingParameter]
    public ISubjectRevealTarget? Revealer { get; set; }

    /// <summary>Gets whether the selected widget is this one or a widget inside it.</summary>
    public bool ContainsSelection
    {
        get
        {
            for (var component = Selection?.Selected; component is not null; component = component.ParentComponent)
            {
                if (ReferenceEquals(component, this))
                {
                    return true;
                }
            }

            return false;
        }
    }

    /// <summary>Gets this widget when it can be selected, otherwise the nearest widget around it that can, or null.</summary>
    public SubjectComponent? GetSelectableSelfOrAncestor() => IsSelectable ? this : SelectableAncestor;

    [CascadingParameter(Name = "ParentSubjectComponent")]
    private SubjectComponent? ParentComponent { get; set; }

    // A pointer that moved further than this between press and click dragged something, such as a node of a canvas.
    private const double MaximumClickDistance = 5;

    private double _pointerDownX;
    private double _pointerDownY;

    // The widgets directly inside this one, in the order they were created. Allocated by the first of them.
    private List<SubjectComponent>? _childComponents;

    // Created once: a method group in the markup would allocate a delegate on every render, and every widget renders here.
    // Only a selectable or revealable widget gets the handlers of the wrapper, so that an event on a viewed page stays in
    // the browser.
    private EventCallback<PointerEventArgs> _pointerDownCallback;
    private EventCallback<MouseEventArgs> _clickCallback;
    private EventCallback<KeyboardEventArgs> _keyDownCallback;
    private EventCallback<MouseEventArgs> _revealCallback;
    private EventCallback _selectParentCallback;
    private EventCallback _editCallback;
    private EventCallback _moveUpCallback;
    private EventCallback _moveDownCallback;
    private EventCallback _deleteCallback;

    /// <summary>
    /// Two-way binding for accessing the rendered component instance.
    /// Useful for edit panels that need to access ISubjectEditComponent methods.
    /// </summary>
    [Parameter]
    public ISubjectComponent? ComponentInstance { get; set; }

    /// <summary>
    /// Raised once after each registered component has rendered for the first time, with null when
    /// that component does not implement <see cref="ISubjectComponent"/>.
    /// </summary>
    [Parameter]
    public EventCallback<ISubjectComponent?> ComponentInstanceChanged { get; set; }

    // Without an edit component, the edit dialog falls back to the generated properties editor.
    private bool HasEditComponent =>
        Subject != null &&
        (ComponentRegistry.HasComponent(Subject.GetType(), SubjectComponentType.Edit) || Subject.HasConfigurationProperties());

    // Every block of a page is configurable, also one without configuration properties of its own, and a block of text is
    // selectable as well. The content of a slot, such as the body of a card, and an expression in the text are not.
    internal bool IsSelectable =>
        IsEditing &&
        IsSelectionEnabled &&
        Type == SubjectComponentType.Widget &&
        Selection != null &&
        (Subject is IConfigurable || _isTextBlock || HasEditComponent);

    // Constant strings, so that rendering a wrapper allocates no class names. Text blocks are grouped only in Inline mode,
    // so a viewed page never has the class text-block.
    internal static string GetWrapperClass(bool isSelectable, bool isSelected, bool isRevealable, bool isTextBlock) =>
        isSelected ? (isTextBlock ? "subject-component-wrapper selectable selected text-block" : "subject-component-wrapper selectable selected")
        : isSelectable ? (isTextBlock ? "subject-component-wrapper selectable text-block" : "subject-component-wrapper selectable")
        : isRevealable ? "subject-component-wrapper revealable"
        : isTextBlock ? "subject-component-wrapper text-block"
        : "subject-component-wrapper";

    // Keyed weakly, because the type of a widget can come from a plugin that is unloaded again.
    private static readonly ConditionalWeakTable<Type, string> TypeDisplayNames = new();

    // The properties that name a selectable widget without a title, looked up once per subject.
    private RegisteredSubjectProperty? _labelProperty;
    private RegisteredSubjectProperty? _pathProperty;

    // Whether the widget of the subject is a block of text of its page, which can be selected without a configuration.
    private bool _isTextBlock;

    /// <summary>Gets the name that assistive technology reads for the widget: its title, its path or the name of its type.</summary>
    public string GetAccessibleName()
    {
        if (SubjectNames.TryGetTitle(Subject!, _labelProperty) is { } title)
        {
            return title;
        }

        if (_pathProperty?.GetValue() is string { Length: > 0 } path)
        {
            return path;
        }

        return TypeDisplayNames.GetValue(Subject!.GetType(), static type => SubjectTypeCatalog.Describe(type).DisplayName);
    }

    private static RegisteredSubjectProperty? TryGetTextProperty(RegisteredSubject? subject, string propertyName) =>
        subject?.TryGetProperty(propertyName) is { } property && property.Type == typeof(string) ? property : null;

    /// <summary>Gets the nearest widget around this one that can be selected, or null.</summary>
    public SubjectComponent? SelectableAncestor
    {
        get
        {
            var parent = ParentComponent;
            while (parent != null && !parent.IsSelectable)
            {
                parent = parent.ParentComponent;
            }

            return parent;
        }
    }

    protected override void OnInitialized()
    {
        _pointerDownCallback = EventCallback.Factory.Create<PointerEventArgs>(this, OnPointerDown);
        _clickCallback = EventCallback.Factory.Create<MouseEventArgs>(this, OnClick);
        _keyDownCallback = EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDown);
        _selectParentCallback = EventCallback.Factory.Create(this, SelectParent);
        _editCallback = EventCallback.Factory.Create(this, OpenEditDialog);
        if (ParentComponent != null)
        {
            (ParentComponent._childComponents ??= []).Add(this);
        }
    }

    /// <summary>
    /// Gets this widget when it can be selected, otherwise the first widget inside it that can, such as the widget in
    /// the page content of a canvas node.
    /// </summary>
    internal SubjectComponent? FindSelectable()
    {
        if (IsSelectable)
        {
            return this;
        }

        if (_childComponents != null)
        {
            foreach (var child in _childComponents)
            {
                if (child.FindSelectable() is { } selectable)
                {
                    return selectable;
                }
            }
        }

        return null;
    }

    /// <summary>Gets the selectable widget of the subject among this widget and the widgets inside it, or null.</summary>
    internal SubjectComponent? FindSelectable(IInterceptorSubject subject)
    {
        if (ReferenceEquals(Subject, subject) && IsSelectable)
        {
            return this;
        }

        if (_childComponents != null)
        {
            foreach (var child in _childComponents)
            {
                if (child.FindSelectable(subject) is { } selectable)
                {
                    return selectable;
                }
            }
        }

        return null;
    }

    // An event of the wrapper or the bar does not render the widget: a press, a key or a click that selects nothing changes
    // nothing, and a change of the selection renders the two widgets it concerns through OnSelectionChanged.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);

    internal void OnSelectionChanged()
    {
        StateHasChanged();
    }

    private void SelectParent()
    {
        Selection?.Select(SelectableAncestor);
    }

    private void OnPointerDown(PointerEventArgs args)
    {
        _pointerDownX = args.ClientX;
        _pointerDownY = args.ClientY;
    }

    private void OnClick(MouseEventArgs args)
    {
        if (Math.Abs(args.ClientX - _pointerDownX) > MaximumClickDistance ||
            Math.Abs(args.ClientY - _pointerDownY) > MaximumClickDistance)
        {
            return;
        }

        Selection?.Select(this);
    }

    // The innermost widget takes the click. A widget that has no block of its own, such as a subject that a Widget
    // block shows, reveals the nearest widget around it that has one.
    private async Task RevealAsync(MouseEventArgs args)
    {
        for (var component = this; component is not null; component = component.ParentComponent)
        {
            if (component.Subject is { } subject && await Revealer!.RevealAsync(subject))
            {
                return;
            }
        }
    }

    // A Space on the focused widget itself arrives here as Enter, see widget-selection.js, so that a Space in an input
    // inside the widget stays with the input.
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Enter" || Selection == null)
        {
            return;
        }

        if (!ReferenceEquals(Selection.Selected, this))
        {
            Selection.Select(this);
        }
        else if (HasEditComponent || StructureEditor?.GetActions(Subject!).CanEditText == true)
        {
            await OpenEditDialog();
        }
    }

    protected override void OnParametersSet()
    {
        // Created once, and only on a page that has a use for them, so that a viewed page allocates none per widget.
        if (Revealer is not null && !_revealCallback.HasDelegate)
        {
            _revealCallback = EventCallback.Factory.Create<MouseEventArgs>(this, RevealAsync);
        }

        if (StructureEditor is not null && !_deleteCallback.HasDelegate)
        {
            _moveUpCallback = EventCallback.Factory.Create(this, () => StructureEditor!.MoveAsync(Subject!, -1));
            _moveDownCallback = EventCallback.Factory.Create(this, () => StructureEditor!.MoveAsync(Subject!, 1));
            _deleteCallback = EventCallback.Factory.Create(this, () => StructureEditor!.DeleteAsync(Subject!));
        }

        if (Subject != _previousSubject || AdditionalParameters != _previousAdditionalParameters)
        {
            if (Subject != _previousSubject)
            {
                var registeredSubject = Subject?.TryGetRegisteredSubject();
                _labelProperty = TryGetTextProperty(registeredSubject, SubjectNames.LabelPropertyName);
                _pathProperty = SubjectNames.TryGetPathProperty(registeredSubject);
                _isTextBlock = Subject is not null &&
                               ComponentRegistry.GetComponent(Subject.GetType(), Type)?.ComponentType is { } componentType &&
                               typeof(ITextBlockWidget).IsAssignableFrom(componentType);
            }

            _previousSubject = Subject;
            _previousAdditionalParameters = AdditionalParameters;
            _cachedParameters = BuildComponentParameters();
        }
    }

    private Dictionary<string, object?> GetComponentParameters()
        => _cachedParameters ??= BuildComponentParameters();

    private Dictionary<string, object?> BuildComponentParameters()
    {
        var parameters = new Dictionary<string, object?> { ["Subject"] = Subject };

        if (AdditionalParameters != null)
        {
            foreach (var kvp in AdditionalParameters)
            {
                parameters[kvp.Key] = kvp.Value;
            }
        }

        return parameters;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A reload creates the widget of an inserted block after the edit returned, see WidgetSelection.SelectSubject.
        Selection?.OnRendered(this);

        // Compared as the rendered object rather than as ISubjectComponent: the registry accepts any
        // component type, and a host that waits for this callback must also hear from one that is not
        // an ISubjectComponent.
        var renderedInstance = _dynamicComponent?.Instance;
        if (!ReferenceEquals(renderedInstance, _reportedInstance))
        {
            _reportedInstance = renderedInstance;
            ComponentInstance = renderedInstance as ISubjectComponent;
            await ComponentInstanceChanged.InvokeAsync(ComponentInstance);
        }
    }

    private async Task OpenEditDialog()
    {
        if (Subject == null)
            return;

        if (StructureEditor is { } editor && editor.GetActions(Subject).CanEditText)
        {
            await editor.EditTextAsync(Subject);
            return;
        }

        var title = SubjectNames.TryGetTitle(Subject, _labelProperty);
        await SubjectEditDialog.ShowAsync(DialogService, ComponentRegistry, Subject, SubjectEditDialog.GetTitle(null, title));
    }

    public void Dispose()
    {
        Selection?.Remove(this);
        ParentComponent?._childComponents?.Remove(this);
    }
}
