@implements IDisposable
@using HomeBlaze.Abstractions.Metadata

@if (!_configurationProperties.Any())
{
    <MudText>No configuration properties found.</MudText>
}
else
{
    @if (_externalChangeDetected)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Configuration was changed externally. Your unsaved changes may be overwritten.
        </MudAlert>
    }

    @if (_errors.Any())
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    @* Evaluated without the default delay, so that a click that follows an edit already meets its result. *@
    <MudForm @ref="_form" ValidationDelay="0" ErrorsChanged="OnFormErrorsChanged">
        @foreach (var prop in _configurationProperties)
        {
            var isSecret = prop.GetConfigurationMetadata()?.IsSecret == true;
            <PropertyEditor Property="@prop"
                            Value="@_editValues[prop.Name]"
                            IsSecret="@isSecret"
                            ValueChanged="@(v => OnPropertyValueChanged(prop.Name, v, isSecret))" />
        }
    </MudForm>
}

@code {
    private MudForm? _form;
    private bool? _reportedIsValid;
    private bool _isSaving;
    private bool _externalChangeDetected;
    private List<string> _errors = [];

    private List<RegisteredSubjectProperty> _configurationProperties = [];
    private Dictionary<string, object?> _editValues = new();
    private HashSet<string> _modifiedSecrets = new();
    private IDisposable? _changeSubscription;

    [Parameter, EditorRequired]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public EventCallback<bool> IsValidChanged { get; set; }

    /// <summary>
    /// Gets whether no field shows an error and every property that cannot hold null has a value.
    /// </summary>
    public bool IsValid
    {
        get
        {
            // The MudForm only counts once it was evaluated, which the first edit causes. Until then it reports
            // every form with a required field as invalid, although all of them are prefilled from the subject.
            if (_form is { IsTouched: true, IsValid: false })
            {
                return false;
            }

            foreach (var property in _configurationProperties)
            {
                if (_editValues[property.Name] is null && EditedPropertyValues.IsRequired(property.Type))
                {
                    return false;
                }
            }

            return true;
        }
    }

    // Raised after every evaluation of the form, also when it changed its validity and not its errors, as
    // for text that is no number.
    private Task OnFormErrorsChanged(string[] errors) => ReportIsValidAsync();

    private async Task ReportIsValidAsync()
    {
        var isValid = IsValid;
        if (_reportedIsValid != isValid)
        {
            _reportedIsValid = isValid;
            await IsValidChanged.InvokeAsync(isValid);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReportIsValidAsync();
        }
    }

    /// <summary>
    /// Gets whether the last <see cref="ApplyChanges"/> failed and therefore applied nothing.
    /// </summary>
    public bool HasErrors => _errors.Any();

    protected override void OnInitialized()
    {
        _changeSubscription?.Dispose();
        _changeSubscription = null;

        if (Subject != null)
        {
            _configurationProperties = Subject.GetConfigurationProperties()
                .Where(p => p.HasSetter)
                .OrderBy(p => p.GetDisplayPosition())
                .ToList();

            _editValues = _configurationProperties.ToDictionary(
                p => p.Name,
                p => p.GetConfigurationMetadata()?.IsSecret == true ? (object?)"" : p.GetValue());

            SubscribeToPropertyChanges();
        }
        else
        {
            _configurationProperties = [];
            _editValues = new();
        }
    }

    private void SubscribeToPropertyChanges()
    {
        if (Subject == null) return;

        try
        {
            var observable = Subject.Context.GetPropertyChangeObservable();
            _changeSubscription = observable
                .Subscribe(
                    onNext: change =>
                    {
                        if (change.Property.Subject == Subject &&
                            !_isSaving &&
                            change.Property.TryGetRegisteredProperty()?.IsConfigurationProperty() == true)
                        {
                            _externalChangeDetected = true;
                            InvokeAsync(StateHasChanged);
                        }
                    },
                    onError: _ => { });
        }
        catch
        {
            // Property change subscriptions may not be registered
        }
    }

    private async Task OnPropertyValueChanged(string propertyName, object? value, bool isSecret)
    {
        _editValues[propertyName] = value;
        if (isSecret)
        {
            _modifiedSecrets.Add(propertyName);
        }

        await ReportIsValidAsync();
    }

    /// <summary>
    /// Applies the edited values to the subject, all or none: when one of them cannot be converted or set, the
    /// subject keeps its values and <see cref="HasErrors"/> is true.
    /// </summary>
    public void ApplyChanges()
    {
        if (Subject == null) return;

        _isSaving = true;
        try
        {
            // A secret is shown empty, so only one that the user entered is an edit.
            _errors = EditedPropertyValues.Apply(_configurationProperties
                .Where(property => property.GetConfigurationMetadata()?.IsSecret != true || _modifiedSecrets.Contains(property.Name))
                .Select(property => KeyValuePair.Create(property, _editValues[property.Name])));
        }
        finally
        {
            _isSaving = false;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _changeSubscription?.Dispose();
    }
}
