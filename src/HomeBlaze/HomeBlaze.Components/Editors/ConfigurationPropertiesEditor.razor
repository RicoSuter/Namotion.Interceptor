@implements IDisposable
@inject IUserPermissions Permissions
@using System.Reactive.Concurrency
@using System.Reactive.Linq
@using HomeBlaze.Abstractions.Attributes
@using HomeBlaze.Abstractions.Metadata

@if (!_configurationProperties.Any())
{
    <MudText>No configuration properties found.</MudText>
}
else
{
    @if (_externalChangeDetected)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Configuration was changed externally. Your unsaved changes may be overwritten.
        </MudAlert>
    }

    @if (_errors.Any())
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    @* Evaluated without the default delay, so that a click that follows an edit already meets its result. *@
    <MudForm @ref="_form" ValidationDelay="0" ErrorsChanged="OnFormErrorsChanged">
        @foreach (var prop in _configurationProperties)
        {
            var isSecret = prop.GetConfigurationMetadata()?.IsSecret == true;
            <PropertyEditor Property="@prop"
                            Value="@_editValues[prop.Name]"
                            IsSecret="@isSecret"
                            ValueChanged="@(v => OnPropertyValueChanged(prop.Name, v, isSecret))" />
        }
    </MudForm>
}

@code {
    private MudForm? _form;
    private bool? _reportedIsValid;
    private volatile bool _isSaving;
    private bool _externalChangeDetected;
    private List<string> _errors = [];

    private List<RegisteredSubjectProperty> _configurationProperties = [];
    private Dictionary<string, object?> _editValues = new();
    private HashSet<string> _modifiedSecrets = new();
    private IDisposable? _changeSubscription;

    [Parameter, EditorRequired]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public EventCallback<bool> IsValidChanged { get; set; }

    /// <summary>Gets or sets whether the subject is being created, see <see cref="IsChecked"/>.</summary>
    [Parameter]
    public bool IsCreating { get; set; }

    /// <summary>
    /// Gets whether the members an edit of the subject changes are checked: always, except while the subject is created
    /// and not part of the graph yet, where whoever attaches it checks that the viewer may create it.
    /// </summary>
    internal static bool IsChecked(IInterceptorSubject subject, bool isCreating) => !isCreating || subject.GetParents().Length > 0;

    /// <summary>
    /// Gets whether no field shows an error and every property that cannot hold null has a value.
    /// </summary>
    public bool IsValid
    {
        get
        {
            // The MudForm sets itself invalid when a required field registers and evaluates itself only after its
            // first render, which can come after this editor first reports. Until a field is touched, the loop
            // below decides alone; all required fields are prefilled from the subject.
            if (_form is { IsTouched: true, IsValid: false })
            {
                return false;
            }

            foreach (var property in _configurationProperties)
            {
                if (_editValues[property.Name] is null && EditedPropertyValues.IsRequired(property.Type))
                {
                    return false;
                }
            }

            return true;
        }
    }

    // Raised after every evaluation of the form, also when it changed its validity and not its errors, as
    // for text that is no number.
    private Task OnFormErrorsChanged(string[] errors) => ReportIsValidAsync();

    private async Task ReportIsValidAsync()
    {
        var isValid = IsValid;
        if (_reportedIsValid != isValid)
        {
            _reportedIsValid = isValid;
            await IsValidChanged.InvokeAsync(isValid);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReportIsValidAsync();
        }
    }

    /// <summary>
    /// Gets whether the last <see cref="ApplyChanges"/> failed.
    /// </summary>
    public bool HasErrors => _errors.Any();

    /// <summary>
    /// Gets whether the editor has a field for at least one property of the subject: a [Configuration] property with a
    /// setter that is no slot and cannot hold subjects. False when the subject is not registered.
    /// </summary>
    public static bool HasEditableProperties(IInterceptorSubject subject)
    {
        var registeredSubject = subject.TryGetRegisteredSubject();
        if (registeredSubject is null)
        {
            return false;
        }

        foreach (var property in registeredSubject.Properties)
        {
            if (IsEditableProperty(property))
            {
                return true;
            }
        }

        return false;
    }

    // A slot or a property that can hold subjects is edited through the subjects it holds, which this editor has no
    // field for.
    private static bool IsEditableProperty(RegisteredSubjectProperty property)
    {
        if (!property.HasSetter || property.CanContainSubjects || !property.IsConfigurationProperty())
        {
            return false;
        }

        foreach (var attribute in property.ReflectionAttributes)
        {
            if (attribute is SlotAttribute)
            {
                return false;
            }
        }

        return true;
    }

    protected override void OnInitialized()
    {
        _changeSubscription?.Dispose();
        _changeSubscription = null;

        if (Subject != null)
        {
            _configurationProperties = Subject.TryGetRegisteredSubject()?.Properties
                .Where(IsEditableProperty)
                .OrderBy(p => p.GetDisplayPosition())
                .ToList() ?? [];

            _editValues = _configurationProperties.ToDictionary(
                p => p.Name,
                p => p.GetConfigurationMetadata()?.IsSecret == true ? (object?)"" : p.GetValue());

            SubscribeToPropertyChanges();
        }
        else
        {
            _configurationProperties = [];
            _editValues = new();
        }
    }

    private void SubscribeToPropertyChanges()
    {
        if (Subject == null) return;

        try
        {
            // The filter runs inside the write, where it still meets _isSaving for what the editor sets and sets
            // back itself. What passes is handled off the write, which every other writer of the context waits for.
            _changeSubscription = Subject.Context
                .GetPropertyChangeObservable(ImmediateScheduler.Instance)
                .Where(change => change.Property.Subject == Subject && !_isSaving)
                .ObserveOn(Scheduler.Default)
                .Subscribe(
                    onNext: change =>
                    {
                        if (change.Property.TryGetRegisteredProperty() is { } property && IsEditableProperty(property))
                        {
                            _externalChangeDetected = true;
                            InvokeAsync(StateHasChanged);
                        }
                    },
                    onError: _ => { });
        }
        catch
        {
            // Property change subscriptions may not be registered
        }
    }

    private async Task OnPropertyValueChanged(string propertyName, object? value, bool isSecret)
    {
        _editValues[propertyName] = value;
        if (isSecret)
        {
            _modifiedSecrets.Add(propertyName);
        }

        await ReportIsValidAsync();
    }

    /// <summary>
    /// Applies the edited values to the subject as <see cref="EditedPropertyValues.Apply"/> does: nothing is set
    /// when one of them cannot be converted, and the values already set are set back when a setter rejects its
    /// value. Nothing is set either when the viewer may not administer one of the members whose value changes, see
    /// <see cref="IsChecked"/>. <see cref="HasErrors"/> is true in these cases.
    /// </summary>
    /// <remarks>
    /// A value that cannot be set back stays changed on the subject, which is shown as an error of its own.
    /// </remarks>
    public void ApplyChanges()
    {
        if (Subject == null) return;

        // A secret is shown empty, so only one that the user entered is an edit.
        var editedValues = _configurationProperties
            .Where(property => property.GetConfigurationMetadata()?.IsSecret != true || _modifiedSecrets.Contains(property.Name))
            .Select(property => KeyValuePair.Create(property, _editValues[property.Name]))
            .ToList();

        if (IsChecked(Subject, IsCreating) &&
            !editedValues.Where(edit => !Equals(edit.Value, edit.Key.GetValue())).All(edit => Permissions.CanAdminister(edit.Key)))
        {
            _errors = [AccessDeniedTexts.Administer];
            StateHasChanged();
            return;
        }

        _isSaving = true;
        try
        {
            _errors = EditedPropertyValues.Apply(editedValues);
        }
        finally
        {
            _isSaving = false;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _changeSubscription?.Dispose();
    }
}
