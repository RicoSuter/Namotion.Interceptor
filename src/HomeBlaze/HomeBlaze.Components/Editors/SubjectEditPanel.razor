@using HomeBlaze.Abstractions
@using HomeBlaze.Services

@implements IAsyncDisposable

@inject RootManager RootManager
@inject SubjectComponentRegistry ComponentRegistry
@inject ISnackbar Snackbar
@inject DeveloperModeService DeveloperMode

<TrackingScope Context="Subject?.Context" ShowDebugInfo="DeveloperMode.IsEnabled">
    @if (Subject != null)
    {
        @if (IsCreating && ComponentRegistry.HasComponent(Subject.GetType(), SubjectComponentType.Setup))
        {
            <SubjectComponent Subject="@Subject"
                              Type="SubjectComponentType.Setup"
                              AdditionalParameters="@(new Dictionary<string, object?> { ["IsCreating"] = IsCreating })"
                              @bind-ComponentInstance="_subjectComponent" />
        }
        else if (ComponentRegistry.HasComponent(Subject.GetType(), SubjectComponentType.Edit))
        {
            <SubjectComponent Subject="@Subject"
                              Type="SubjectComponentType.Edit"
                              AdditionalParameters="@(new Dictionary<string, object?> { ["IsCreating"] = IsCreating })"
                              @bind-ComponentInstance="_subjectComponent" />
        }
        else
        {
            <ConfigurationPropertiesEditor @ref="_propertiesEditor" Subject="@Subject" IsValidChanged="OnIsValidChanged" />
        }
    }
</TrackingScope>

@code {
    [Parameter] public IInterceptorSubject? Subject { get; set; }

    [Parameter] public bool IsCreating { get; set; }

    /// <summary>
    /// Invoked when the validity of the edit component or the generic editor changes, so the host can re-render
    /// its save button.
    /// </summary>
    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }

    private ISubjectComponent? _subjectComponent;
    private ISubjectEditComponent? _editComponent;
    private ConfigurationPropertiesEditor? _propertiesEditor;
    private IInterceptorSubject? _previousSubject;
    private ISubjectEditComponent? _reportedEditComponent;
    private bool? _lastReportedIsValid;

    public bool IsValid => _editComponent?.IsValid ?? _propertiesEditor?.IsValid ?? true;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Subject != _previousSubject)
        {
            _previousSubject = Subject;
            _lastReportedIsValid = null;
        }

        // TODO: Extract event subscription/unsubscription to helper method - logic duplicated in OnParametersSet, OnAfterRender, and DisposeAsync
        // Unsubscribe from previous edit component
        if (_editComponent != null)
        {
            _editComponent.IsValidChanged -= OnIsValidChanged;
            _editComponent.IsDirtyChanged -= OnIsDirtyChanged;
            _editComponent = null;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        // Subscribe to new edit component if available
        if (_subjectComponent is ISubjectEditComponent editComponent && _editComponent != editComponent)
        {
            if (_editComponent != null)
            {
                _editComponent.IsValidChanged -= OnIsValidChanged;
                _editComponent.IsDirtyChanged -= OnIsDirtyChanged;
            }

            _editComponent = editComponent;
            _editComponent.IsValidChanged += OnIsValidChanged;
            _editComponent.IsDirtyChanged += OnIsDirtyChanged;
            StateHasChanged();

            // The same instance is subscribed again after every parameter update, so only a new instance resets
            // the reported value; reporting an unchanged value is then dropped, which keeps the host's re-render
            // from looping back here.
            if (!ReferenceEquals(_reportedEditComponent, editComponent))
            {
                _reportedEditComponent = editComponent;
                _lastReportedIsValid = null;
            }

            OnIsValidChanged(editComponent.IsValid);
        }
    }

    private void OnIsValidChanged(bool isValid) => InvokeAsync(() =>
    {
        StateHasChanged();

        // Edit components may raise this on every keystroke; the host only needs the transitions.
        if (_lastReportedIsValid == isValid)
        {
            return Task.CompletedTask;
        }

        _lastReportedIsValid = isValid;
        return IsValidChanged.InvokeAsync(isValid);
    });

    private void OnIsDirtyChanged(bool isDirty) => InvokeAsync(StateHasChanged);

    public async Task SaveAsync(CancellationToken cancellationToken)
    {
        bool isApplied;
        try
        {
            isApplied = await ApplyChangesAsync(cancellationToken);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
            return;
        }

        if (isApplied)
        {
            await PersistAsync(cancellationToken);
        }
    }

    /// <summary>
    /// Applies the buffered edits to the subject without persisting them.
    /// </summary>
    /// <returns>False when there is no subject or the edits are invalid, in which case nothing was applied.</returns>
    public async Task<bool> ApplyChangesAsync(CancellationToken cancellationToken)
    {
        if (Subject == null) return false;

        if (_editComponent != null)
        {
            if (!_editComponent.IsValid)
            {
                return false;
            }

            await _editComponent.SaveAsync(cancellationToken);
        }
        else
        {
            if (_propertiesEditor?.HasErrors == true)
            {
                return false;
            }

            _propertiesEditor?.ApplyChanges();
        }

        return true;
    }

    /// <summary>
    /// Writes the configuration that contains the subject through the nearest IConfigurationWriter among its
    /// parents, else the root manager, and applies it. Nothing is written for a subject that is part of no
    /// configuration, such as a file, which its edit component has saved.
    /// </summary>
    public async Task PersistAsync(CancellationToken cancellationToken)
    {
        var subject = Subject;
        if (subject == null) return;

        try
        {
            // The first configurable parent would be wrong here: for a file that is its storage, whose
            // configuration does not contain the file.
            var configurationOwner = subject.TryGetConfigurationOwner();
            if (configurationOwner is IConfigurable configurable)
            {
                var configurationWriter = RootManager.GetConfigurationWriter(configurationOwner);
                await configurationWriter.WriteConfigurationAsync(configurationOwner, CancellationToken.None);
                await configurable.ApplyConfigurationAsync(cancellationToken);
            }

            Snackbar.Add("Configuration saved.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
        }
    }

    public ValueTask DisposeAsync()
    {
        if (_editComponent != null)
        {
            _editComponent.IsValidChanged -= OnIsValidChanged;
            _editComponent.IsDirtyChanged -= OnIsDirtyChanged;
        }

        return ValueTask.CompletedTask;
    }

}
