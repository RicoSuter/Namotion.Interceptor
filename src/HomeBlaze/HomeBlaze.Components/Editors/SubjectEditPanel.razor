@using HomeBlaze.Abstractions
@using HomeBlaze.Services

@implements IAsyncDisposable

@inject RootManager RootManager
@inject SubjectComponentRegistry ComponentRegistry
@inject ISnackbar Snackbar
@inject DeveloperModeService DeveloperMode

<TrackingScope Context="Subject?.Context" ShowDebugInfo="DeveloperMode.IsEnabled">
    @if (Subject != null)
    {
        @if (HostedComponentType is { } hostedComponentType)
        {
            <SubjectComponent @key="Subject"
                              Subject="@Subject"
                              Type="hostedComponentType"
                              AdditionalParameters="@(IsCreating ? CreatingParameters : EditingParameters)"
                              ComponentInstance="_subjectComponent"
                              ComponentInstanceChanged="OnSubjectComponentRendered" />
        }
        else
        {
            <ConfigurationPropertiesEditor @key="Subject"
                                           @ref="_propertiesEditor"
                                           Subject="@Subject"
                                           IsValidChanged="OnPropertiesEditorIsValidChanged" />
        }
    }
</TrackingScope>

@code {
    // SubjectComponent builds the parameters of the hosted component again whenever it is given another instance.
    private static readonly Dictionary<string, object?> CreatingParameters = new() { ["IsCreating"] = true };
    private static readonly Dictionary<string, object?> EditingParameters = new() { ["IsCreating"] = false };

    [Parameter] public IInterceptorSubject? Subject { get; set; }

    [Parameter] public bool IsCreating { get; set; }

    /// <summary>
    /// Raised with the current validity once the hosted editor is ready, and again whenever the validity changes.
    /// </summary>
    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }

    private IInterceptorSubject? _editedSubject;
    private ISubjectComponent? _subjectComponent;
    private bool _isSubjectComponentRendered;
    private ISubjectEditComponent? _subscribedEditComponent;
    private ConfigurationPropertiesEditor? _propertiesEditor;
    private bool? _reportedIsValid;

    private SubjectComponentType? HostedComponentType
    {
        get
        {
            if (Subject is null)
            {
                return null;
            }

            var subjectType = Subject.GetType();
            if (IsCreating && ComponentRegistry.HasComponent(subjectType, SubjectComponentType.Setup))
            {
                return SubjectComponentType.Setup;
            }

            return ComponentRegistry.HasComponent(subjectType, SubjectComponentType.Edit) ? SubjectComponentType.Edit : null;
        }
    }

    // A null instance cannot stand for "not reported yet": a registered component that is not an
    // ISubjectComponent is reported as null and has nothing to apply.
    private bool IsSubjectComponentPending => !_isSubjectComponentRendered && HostedComponentType is not null;

    /// <summary>
    /// Gets whether the hosted editor is valid. Also true while a registered component has not rendered yet,
    /// during which <see cref="ApplyChangesAsync"/> still returns false.
    /// </summary>
    public bool IsValid => (_subjectComponent as ISubjectEditComponent)?.IsValid ?? _propertiesEditor?.IsValid ?? true;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Subject, _editedSubject))
        {
            _editedSubject = Subject;

            // The editor of the previous subject is replaced with the next render, and must not answer for the new one until then.
            SubscribeTo(null);
            _subjectComponent = null;
            _isSubjectComponentRendered = false;
            _propertiesEditor = null;
            _reportedIsValid = null;
        }
    }

    private void OnSubjectComponentRendered(ISubjectComponent? subjectComponent)
    {
        _subjectComponent = subjectComponent;
        _isSubjectComponentRendered = true;
        SubscribeTo(subjectComponent as ISubjectEditComponent);
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => ReportIsValidAsync();

    private void SubscribeTo(ISubjectEditComponent? editComponent)
    {
        if (ReferenceEquals(_subscribedEditComponent, editComponent))
        {
            return;
        }

        if (_subscribedEditComponent is not null)
        {
            _subscribedEditComponent.IsValidChanged -= OnIsValidChanged;
            _subscribedEditComponent.IsDirtyChanged -= OnIsDirtyChanged;
        }

        _subscribedEditComponent = editComponent;

        if (editComponent is not null)
        {
            editComponent.IsValidChanged += OnIsValidChanged;
            editComponent.IsDirtyChanged += OnIsDirtyChanged;
        }
    }

    private void OnIsValidChanged(bool isValid) => InvokeAsync(async () =>
    {
        StateHasChanged();
        await ReportIsValidAsync();
    });

    private Task OnPropertiesEditorIsValidChanged(bool isValid) => ReportIsValidAsync();

    /// <summary>
    /// Reads the validity of the hosted editor again and raises <see cref="IsValidChanged"/> when it differs
    /// from the last value that was raised.
    /// </summary>
    public Task RefreshIsValidAsync() => ReportIsValidAsync();

    private async Task ReportIsValidAsync()
    {
        // While the hosted component is pending, IsValid falls back to true. Reporting that would briefly
        // enable the parent's confirm button for an invalid form.
        if (!IsValidChanged.HasDelegate || IsSubjectComponentPending)
        {
            return;
        }

        var isValid = IsValid;
        if (_reportedIsValid != isValid)
        {
            _reportedIsValid = isValid;
            await IsValidChanged.InvokeAsync(isValid);
        }
    }

    private void OnIsDirtyChanged(bool isDirty) => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Applies the buffered edits to the subject and persists them.
    /// </summary>
    /// <returns>
    /// True when the edits were applied and <see cref="PersistAsync"/> ran, which reports a failure of its own to
    /// the user. False when the edits were not applied, which is reported to the user, and nothing was persisted:
    /// either <see cref="ApplyChangesAsync"/> returned false and the subject is unchanged, or the edit component
    /// failed while saving.
    /// </returns>
    public async Task<bool> SaveAsync(CancellationToken cancellationToken)
    {
        bool isApplied;
        try
        {
            isApplied = await ApplyChangesAsync(cancellationToken);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
            return false;
        }

        if (!isApplied)
        {
            Snackbar.Add("The values could not be applied", Severity.Error);
            return false;
        }

        await PersistAsync(cancellationToken);
        return true;
    }

    /// <summary>
    /// Applies the buffered edits to the subject without persisting them.
    /// </summary>
    /// <returns>
    /// False when there is no subject, the editor is not ready yet or not valid, or the generated properties
    /// editor could not convert or set one of its values. Nothing was applied to the subject then.
    /// </returns>
    public async Task<bool> ApplyChangesAsync(CancellationToken cancellationToken)
    {
        if (Subject == null || IsSubjectComponentPending || !IsValid) return false;

        if (_subjectComponent is ISubjectEditComponent editComponent)
        {
            await editComponent.SaveAsync(cancellationToken);
        }
        else if (_propertiesEditor is { } propertiesEditor)
        {
            propertiesEditor.ApplyChanges();
            return !propertiesEditor.HasErrors;
        }

        return true;
    }

    /// <summary>
    /// Writes the configuration that contains the subject through the nearest IConfigurationWriter among its
    /// parents, else the root manager, and applies it. Nothing is written for a subject that is part of no
    /// configuration, such as a file, which its edit component has saved.
    /// </summary>
    public async Task PersistAsync(CancellationToken cancellationToken)
    {
        var subject = Subject;
        if (subject == null) return;

        try
        {
            // The first configurable parent would be wrong here: for a file that is its storage, whose
            // configuration does not contain the file.
            var configurationOwner = subject.TryGetConfigurationOwner();
            if (configurationOwner is IConfigurable configurable)
            {
                var configurationWriter = RootManager.GetConfigurationWriter(configurationOwner);
                await configurationWriter.WriteConfigurationAsync(configurationOwner, CancellationToken.None);
                await configurable.ApplyConfigurationAsync(cancellationToken);
            }

            Snackbar.Add("Configuration saved.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
        }
    }

    public ValueTask DisposeAsync()
    {
        SubscribeTo(null);
        return ValueTask.CompletedTask;
    }

}
