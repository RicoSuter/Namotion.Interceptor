@inject IDialogService DialogService

<MudButton Size="Size.Small" Variant="Variant.Outlined" Class="game-action" StartIcon="@Icons.Material.Filled.Tune"
           Disabled="@(Disabled || _isOpen || View is null)" data-testid="game-graphics" OnClick="OpenAsync">Graphics</MudButton>

@code {
    private bool _isOpen;

    // Cascaded, because a parameter must be public and the connection is internal.
    [CascadingParameter] private GameViewConnection? View { get; set; }

    /// <summary>
    /// Whether the button is disabled, as before the view started.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    private async Task OpenAsync()
    {
        if (_isOpen || View is not { } view)
        {
            return;
        }

        _isOpen = true;
        try
        {
            await GameGraphicsDialog.ShowAsync(DialogService, view);
        }
        finally
        {
            _isOpen = false;
        }
    }
}
