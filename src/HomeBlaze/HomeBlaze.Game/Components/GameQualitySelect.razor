@* The values are the preset names of game-render.js. *@
<MudSelect @ref="_select" T="string" Value="Value" ValueChanged="ValueChanged" OpenChanged="OnOpenChangedAsync"
           ToStringFunc="@GetLabel" Label="Quality" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
           Disabled="Disabled" data-testid="game-quality">
    <MudSelectItem T="string" Value="@Auto" />
    <MudSelectItem T="string" Value="@("low")" />
    <MudSelectItem T="string" Value="@("medium")" />
    <MudSelectItem T="string" Value="@("high")" />
</MudSelect>

@code {
    /// <summary>
    /// The choice that applies when the browser stored none.
    /// </summary>
    public const string Auto = "auto";

    private MudSelect<string>? _select;

    /// <summary>
    /// The quality choice, a preset name or <see cref="Auto"/>.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = Auto;

    /// <summary>
    /// Raised when the player picks a choice.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Whether the choice cannot be changed.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    private static string GetLabel(string? choice) => choice switch
    {
        "low" => "Low",
        "medium" => "Medium",
        "high" => "High",
        _ => "Auto"
    };

    // The game ignores keys while an input has the focus, so a closed menu gives the arrow keys back to walking. MudSelect
    // focuses itself again after a pick, which a blur on the value change would precede.
    private async Task OnOpenChangedAsync(bool isOpen)
    {
        if (!isOpen && _select is { } select)
        {
            await select.BlurAsync();
        }
    }
}
