@inject ITimeZoneDisplay TimeZone

@* Tiles at least 150 px wide fill each row, so the three to five tiles wrap evenly on any width. *@
<div class="mb-3" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 8px;"
     data-testid="agent-stats">
    @StatTile("Background runs", Agent.RunCount.ToString())
    @StatTile("Last background run", Agent.LastRunTime is { } lastRun ? TimeZone.Format(lastRun) : "never")
    @StatTile("Last activity", Agent.LastActivityTime is { } lastActivity ? TimeZone.Format(lastActivity) : "never")
    @if (Agent.FiveHourUsage is { } fiveHour)
    {
        @StatTile("Subscription usage, 5 hours", fiveHour.ToString("P0"))
        @StatTile("Subscription usage, 7 days", Agent.SevenDayUsage?.ToString("P0") ?? "?")
    }
</div>

@* Below the small breakpoint each run stacks into labeled lines instead of a wide table. *@
<MudTable T="AgentTimelineEntry" Items="GetRuns()" Dense="true" Hover="true" Elevation="0" Outlined="true"
          Breakpoint="Breakpoint.Xs" RowsPerPage="RunsPerPage" data-testid="agent-runs">
    <HeaderContent>
        <MudTh>Time</MudTh>
        <MudTh>Trigger</MudTh>
        <MudTh>Duration</MudTh>
        <MudTh>Tokens (in/out)</MudTh>
        <MudTh>Tools</MudTh>
        <MudTh>Result</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Time">@TimeZone.Format(context.Timestamp)</MudTd>
        <MudTd DataLabel="Trigger">@AgentTriggerLabels.Format(context.Trigger)</MudTd>
        <MudTd DataLabel="Duration">@(context.Duration is { } duration ? $"{duration.TotalSeconds:0.0} s" : "")</MudTd>
        <MudTd DataLabel="Tokens (in/out)">@(context.Usage is { } usage ? $"{usage.InputTokens + usage.CacheReadInputTokens + usage.CacheCreationInputTokens}/{usage.OutputTokens}" : "")</MudTd>
        <MudTd DataLabel="Tools">@context.ToolCalls.Count</MudTd>
        <MudTd DataLabel="Result">
            <MudText Typo="Typo.body2" title="@context.Text"
                     Color="@(context.Kind == AgentTimelineEntryKind.Error ? Color.Error : Color.Inherit)"
                     Style="max-width: 40ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;">@context.Text</MudText>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        @if (GetRuns().Count > RunsPerPage)
        {
            <MudTablePager HideRowsPerPage="true" data-testid="agent-runs-pager" />
        }
    </PagerContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No background runs yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private const int RunsPerPage = 25;

    private IReadOnlyList<AgentTimelineEntry>? _runsSource;
    private List<AgentTimelineEntry> _runs = [];

    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    // Newest first. The timeline is an immutable snapshot that is replaced on every change, so the list is rebuilt
    // only when the snapshot changes.
    private List<AgentTimelineEntry> GetRuns()
    {
        var entries = Agent.Timeline.Entries;
        if (!ReferenceEquals(_runsSource, entries))
        {
            _runsSource = entries;
            var runs = new List<AgentTimelineEntry>();
            for (var index = entries.Count - 1; index >= 0; index--)
            {
                if (AgentTimeline.IsBackgroundRun(entries[index]))
                {
                    runs.Add(entries[index]);
                }
            }

            _runs = runs;
        }

        return _runs;
    }

    private static RenderFragment StatTile(string label, string value) =>
        @<MudPaper Outlined="true" Class="pa-3 mud-height-full">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
            <MudText Typo="Typo.h6">@value</MudText>
        </MudPaper>;
}
