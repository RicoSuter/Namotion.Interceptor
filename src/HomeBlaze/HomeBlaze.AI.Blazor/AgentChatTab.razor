@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div class="d-flex flex-column mud-height-full">
    @* column-reverse keeps the scroll position anchored at the newest entry without script. *@
    <div class="d-flex flex-column-reverse flex-grow-1 overflow-y-auto" data-testid="agent-timeline">
        <div>
            <AgentTimelineList Agent="Agent" TimeZoneVersion="TimeZoneVersion" />
        </div>
    </div>

    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Class="flex-shrink-0 pt-2">
        <div class="flex-grow-1" data-testid="agent-chat-input" @ref="_inputContainer">
            <MudTextField T="string" @bind-Value="_message" Immediate="true" Lines="1" Sizing="InputSizing.Auto" MaxLines="6"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ask the agent"
                          HelperText="@(_sendsOnEnter ? "Enter sends, Shift+Enter adds a line" : null)" FullWidth="true" />
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Send" Variant="Variant.Filled" Color="Color.Primary" aria-label="Send" Class="mt-1"
                       OnClick="SendAsync" Disabled="@(_isSending || string.IsNullOrWhiteSpace(_message))" data-testid="agent-chat-send" />
    </MudStack>
</div>

@code {
    private string _message = string.Empty;
    private bool _isSending;
    private ElementReference _inputContainer;
    private DotNetObjectReference<AgentChatTab>? _dotNetReference;
    private IJSObjectReference? _module;
    private IJSObjectReference? _enterListener;
    private bool _sendsOnEnter;
    private bool _isDisposed;

    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    [Parameter]
    public int TimeZoneVersion { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // DisposeAsync can run while an interop call is pending, so each result is checked against _isDisposed and
        // released here when it arrives after disposal.
        try
        {
            var module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/HomeBlaze.AI.Blazor/AgentChatTab.razor.js");
            if (_isDisposed)
            {
                await module.DisposeAsync();
                return;
            }

            _module = module;
            _dotNetReference = DotNetObjectReference.Create(this);
            var listener = await module.InvokeAsync<IJSObjectReference?>("attachEnterToSend", _inputContainer, _dotNetReference);
            if (_isDisposed)
            {
                await DisposeListenerAsync(listener);
                return;
            }

            _enterListener = listener;
            if (listener is not null && await listener.InvokeAsync<bool>("sendsOnEnter") && !_isDisposed)
            {
                _sendsOnEnter = true;
                StateHasChanged();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or OperationCanceledException)
        {
            // The circuit is gone or the script failed to load; the Send button still works.
        }
    }

    /// <summary>Shows or hides the keyboard hint when the device's primary pointer changes.</summary>
    [JSInvokable]
    public void SetSendsOnEnter(bool sendsOnEnter)
    {
        if (!_isDisposed && _sendsOnEnter != sendsOnEnter)
        {
            _sendsOnEnter = sendsOnEnter;
            StateHasChanged();
        }
    }

    /// <summary>Sends the message typed into the chat input when Enter is pressed.</summary>
    [JSInvokable]
    public async Task SendFromKeyboardAsync(string text)
    {
        if (_isSending)
        {
            return;
        }

        // The keydown can overtake the input binding's last update, so the text comes from the textarea itself.
        _message = text;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _message.Trim();
        if (_isSending || text.Length == 0)
        {
            return;
        }

        _message = string.Empty;
        _isSending = true;
        StateHasChanged();
        try
        {
            // Failures and the not-running case are recorded in the timeline; only caller cancellation throws.
            await Agent.SendMessageAsync(text, CancellationToken.None);
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        var listener = _enterListener;
        var module = _module;
        _enterListener = null;
        _module = null;
        try
        {
            try
            {
                await DisposeListenerAsync(listener);
            }
            finally
            {
                if (module is not null)
                {
                    await module.DisposeAsync();
                }
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or OperationCanceledException)
        {
            // The circuit is gone, and the browser dropped the listener with the page.
        }

        _dotNetReference?.Dispose();
    }

    private static async Task DisposeListenerAsync(IJSObjectReference? listener)
    {
        if (listener is null)
        {
            return;
        }

        try
        {
            await listener.InvokeVoidAsync("dispose");
        }
        finally
        {
            await listener.DisposeAsync();
        }
    }
}
