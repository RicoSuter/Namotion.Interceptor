@if (Calls.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
        @foreach (var call in Calls)
        {
            <MudTooltip Text="@($"{call.Arguments}\n{call.ResultPreview}")">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(call.IsError ? Color.Error : Color.Default)" Icon="@Icons.Material.Filled.Build">
                    @call.Name
                </MudChip>
            </MudTooltip>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<AgentToolCall> Calls { get; set; } = [];
}
