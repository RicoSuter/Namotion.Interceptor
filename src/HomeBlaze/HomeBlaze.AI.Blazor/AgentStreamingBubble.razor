@implements IDisposable

@{
    UpdateHtml();
}
@* Laid out like the final reply, with the progress overlaid on the bottom padding, so the reply replaces it
   without a jump. *@
<div class="py-2 my-2 relative" style="max-width: min(100%, 56rem);" data-testid="agent-streaming">
    <AgentMarkdown>
        @foreach (var segment in _stableSegments)
        {
            @segment.Html
        }
        @_tailHtml
    </AgentMarkdown>
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="Size.Small" Style="position: absolute; left: 0; right: 0; bottom: 0;" />
</div>

@code {
    private LlmAgentBase? _subscribed;
    private int _isRenderPending;
    private readonly List<(string Text, MarkupString Html)> _stableSegments = [];
    private int _stableLength;
    private MarkupString _tailHtml;

    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Agent))
        {
            if (_subscribed is not null)
            {
                _subscribed.TimelineChanged -= OnTimelineChanged;
            }

            _subscribed = Agent;
            _subscribed.TimelineChanged += OnTimelineChanged;
        }
    }

    private void OnTimelineChanged()
    {
        // Text deltas arrive faster than the browser can render; coalesce them into one pending render.
        if (Interlocked.Exchange(ref _isRenderPending, 1) == 0)
        {
            _ = InvokeAsync(() =>
            {
                Volatile.Write(ref _isRenderPending, 0);
                StateHasChanged();
            });
        }
    }

    // Completed blocks are converted once, as one segment per boundary move, so a render sends only the newest
    // segment and the block being written; unchanged segments keep their markup and are not sent again.
    private void UpdateHtml()
    {
        var text = Agent.StreamingText;
        if (!StartsWithStableSegments(text))
        {
            // A new turn started streaming while this bubble stayed on the page.
            _stableSegments.Clear();
            _stableLength = 0;
        }

        var stableLength = AgentStreamingMarkdown.FindStableLength(text);
        if (stableLength > _stableLength)
        {
            var segment = text[_stableLength..stableLength];
            _stableSegments.Add((segment, new MarkupString(AgentMarkdownRenderer.ToHtml(segment))));
            _stableLength = stableLength;
        }

        _tailHtml = _stableLength < text.Length ? new MarkupString(AgentMarkdownRenderer.ToHtml(text[_stableLength..])) : default;
    }

    private bool StartsWithStableSegments(string text)
    {
        if (text.Length < _stableLength)
        {
            return false;
        }

        var position = 0;
        foreach (var (segment, _) in _stableSegments)
        {
            if (!text.AsSpan(position, segment.Length).SequenceEqual(segment))
            {
                return false;
            }

            position += segment.Length;
        }

        return true;
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.TimelineChanged -= OnTimelineChanged;
            _subscribed = null;
        }
    }
}
