@implements IDisposable

<MudPaper Class="pa-3 my-2" Elevation="0" Outlined="true" Style="max-width: min(100%, 56rem);" data-testid="agent-streaming">
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Class="mb-2" />
    <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere;">@Agent.StreamingText</MudText>
</MudPaper>

@code {
    private LlmAgentBase? _subscribed;
    private int _isRenderPending;

    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Agent))
        {
            if (_subscribed is not null)
            {
                _subscribed.TimelineChanged -= OnTimelineChanged;
            }

            _subscribed = Agent;
            _subscribed.TimelineChanged += OnTimelineChanged;
        }
    }

    private void OnTimelineChanged()
    {
        // Text deltas arrive faster than the browser can render; coalesce them into one pending render.
        if (Interlocked.Exchange(ref _isRenderPending, 1) == 0)
        {
            _ = InvokeAsync(() =>
            {
                Volatile.Write(ref _isRenderPending, 0);
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.TimelineChanged -= OnTimelineChanged;
            _subscribed = null;
        }
    }
}
