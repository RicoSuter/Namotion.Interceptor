@inject ITimeZoneDisplay TimeZone
@inject IDialogService DialogService

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-1">Settings</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Outlined="true">
            <tbody>
                @SettingRow("Model", Agent.Model ?? "default")
                @SettingRow("Effort", Agent.Effort?.ToString() ?? "default")
                @SettingRow("Background model", Agent.BackgroundModel ?? "same as model")
                @SettingRow("Background effort", Agent.BackgroundEffort?.ToString() ?? "same as effort")
                @SettingRow("Watch paths", @<text>
                    @if (Agent.WatchPaths.Length == 0)
                    {
                        <text>none</text>
                    }
                    @foreach (var path in Agent.WatchPaths)
                    {
                        <div>@path</div>
                    }
                </text>)
                @SettingRow("Poll interval", Agent.PollInterval is { } pollInterval && pollInterval > TimeSpan.Zero ? AgentTimeSpanInput.Format(pollInterval) : "none")
                @SettingRow("Minimum run interval", AgentTimeSpanInput.Format(Agent.GetEffectiveMinRunInterval()))
                @SettingRow("Allowed tools", @<text>
                    @if (Agent.AllowedTools.Length > 0)
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="py-1">
                            @foreach (var tool in Agent.AllowedTools)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">@tool</MudChip>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <text>none (memory only)</text>
                    }
                </text>)
                @SettingRow("Turn timeout", Agent.GetEffectiveTurnTimeout() is { } turnTimeout ? AgentTimeSpanInput.Format(turnTimeout) : "none")
                @SettingRow("Tool calls per turn", Agent.MaxToolCallsPerTurn.ToString())
                @if (Agent is ClaudeCliAgent cliAgent)
                {
                    @SettingRow("CLI path", cliAgent.CliPath)
                    @SettingRow("Fallback model", cliAgent.FallbackModel ?? "none")
                }
                @if (Agent is AnthropicAgent anthropicAgent)
                {
                    @SettingRow("API key", string.IsNullOrWhiteSpace(anthropicAgent.ApiKey) ? "not set" : "set")
                    @SettingRow("Max output tokens", anthropicAgent.MaxTokens.ToString())
                    @SettingRow("History token budget", anthropicAgent.HistoryTokenBudget > 0 ? anthropicAgent.HistoryTokenBudget.ToString() : "never summarize")
                }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="d-block mt-1 mud-text-secondary">Change settings with the subject's Edit action.</MudText>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-1">Instructions</MudText>
        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; overflow-wrap: anywhere;">@(string.IsNullOrWhiteSpace(Agent.Instructions) ? "none" : Agent.Instructions)</MudText>
    </MudItem>
    <MudItem xs="12">
        @{ var memory = MemoryEditor.Snapshot; }
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
            <MudText Typo="Typo.h6">Memory</MudText>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="MemoryEditor.StartAdd" Disabled="@(!MemoryEditor.IsAvailable || MemoryEditor.IsEditing || MemoryEditor.IsSaving)" data-testid="agent-memory-add">Add entry</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
            The agent's own notes, shown to it with their update time on every run. Keys are slash paths such as alerts/freezer.
        </MudText>
        @if (!MemoryEditor.IsAvailable)
        {
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary" data-testid="agent-memory-not-loaded">@AgentMemoryEditor.NotLoadedText</MudText>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="my-2" data-testid="agent-memory-size">
            <MudProgressLinear Value="@GetUsage(memory)" Color="@(GetUsage(memory) >= 90 ? Color.Warning : Color.Primary)"
                               Rounded="true" Size="Size.Small" Class="flex-grow-1" Style="max-width: 240px;" aria-label="Memory usage" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @memory.Size.ToString("N0") of @AgentMemory.MaxSize.ToString("N0") bytes, @memory.Entries.Length of @AgentMemory.MaxEntries entries
            </MudText>
        </MudStack>
        @if (MemoryEditor.IsEditing)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2" data-testid="agent-memory-form">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@(MemoryEditor.OriginalKey is null ? "New entry" : "Edit entry")</MudText>
                <MudStack Spacing="2">
                    <div data-testid="agent-memory-key">
                        <MudTextField T="string" @bind-Value="MemoryEditor.Key" Label="Key" Placeholder="alerts/freezer-temperature" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" Disabled="MemoryEditor.IsSaving" MaxLength="@AgentMemory.MaxKeyLength" />
                    </div>
                    <div data-testid="agent-memory-value">
                        <MudTextField T="string" @bind-Value="MemoryEditor.Value" Label="Value" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" MaxLines="12"
                                      Immediate="true" Disabled="MemoryEditor.IsSaving" Counter="@AgentMemory.MaxValueLength"
                                      Error="@(MemoryEditor.ValueError is not null)" ErrorText="@MemoryEditor.ValueError" />
                    </div>
                </MudStack>
                @if (MemoryEditor.IsStale)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        The agent changed this entry while you were editing. Saving replaces its change.
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="MemoryEditor.Reload">Reload</MudButton>
                    </MudAlert>
                }
                else if (MemoryEditor.ReplacesExisting)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">An entry with this key exists. Saving replaces it.</MudAlert>
                }
                @if (MemoryEditor.Error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" data-testid="agent-memory-error">@MemoryEditor.Error</MudAlert>
                }
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Text" OnClick="MemoryEditor.Cancel" Disabled="MemoryEditor.IsSaving" data-testid="agent-memory-cancel">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MemoryEditor.SaveAsync"
                               Disabled="@(MemoryEditor.IsSaving || string.IsNullOrWhiteSpace(MemoryEditor.Key) || string.IsNullOrWhiteSpace(MemoryEditor.Value) || MemoryEditor.ValueError is not null)"
                               data-testid="agent-memory-save">Save</MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (MemoryEditor.Error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" data-testid="agent-memory-error">@MemoryEditor.Error</MudAlert>
        }
        @* Below the small breakpoint each entry stacks into labeled lines instead of a wide table. *@
        <MudTable T="AgentMemoryEntry" Items="memory.Entries" Dense="true" Hover="true" Elevation="0" Outlined="true"
                  Breakpoint="Breakpoint.Xs" data-testid="agent-memory">
            <HeaderContent>
                <MudTh>Key</MudTh>
                <MudTh>Value</MudTh>
                <MudTh Style="white-space: nowrap;">Updated</MudTh>
                <MudTh aria-label="Actions"></MudTh>
            </HeaderContent>
            <RowTemplate>
                @* The wrapping styles sit on inner elements: on phones the cell also renders its data label, which must not wrap. *@
                <MudTd DataLabel="Key"><span style="overflow-wrap: anywhere;" data-testid="agent-memory-entry-key">@context.Key</span></MudTd>
                <MudTd DataLabel="Value"><div style="white-space: pre-wrap; overflow-wrap: anywhere;" data-testid="agent-memory-entry-value">@context.Value</div></MudTd>
                <MudTd DataLabel="Updated" Style="white-space: nowrap;">@TimeZone.Format(context.Updated)</MudTd>
                <MudTd>
                    <div class="d-flex justify-end flex-nowrap">
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@($"Edit {context.Key}")"
                                           OnClick="@(() => MemoryEditor.StartEdit(context))" Disabled="@(MemoryEditor.IsSaving || MemoryEditor.IsEditing)" data-testid="agent-memory-edit" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Delete {context.Key}")"
                                           OnClick="@(() => DeleteAsync(context))" Disabled="MemoryEditor.IsSaving" data-testid="agent-memory-delete" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">The memory is empty.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    [Parameter, EditorRequired]
    public AgentMemoryEditor MemoryEditor { get; set; } = null!;

    private static double GetUsage(AgentMemorySnapshot memory) =>
        Math.Min(100, 100.0 * Math.Max((double)memory.Size / AgentMemory.MaxSize, (double)memory.Entries.Length / AgentMemory.MaxEntries));

    private async Task DeleteAsync(AgentMemoryEntry entry)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete memory entry",
            $"Delete the entry {entry.Key}?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            await MemoryEditor.DeleteAsync(entry);
        }
    }

    private static RenderFragment SettingRow(string label, string value) => SettingRow(label, @<text>@value</text>);

    // Values such as paths break anywhere so that narrow screens wrap them instead of widening the table.
    private static RenderFragment SettingRow(string label, RenderFragment value) =>
        @<tr>
            <td class="mud-text-secondary">@label</td>
            <td style="overflow-wrap: anywhere;">@value</td>
        </tr>;
}
