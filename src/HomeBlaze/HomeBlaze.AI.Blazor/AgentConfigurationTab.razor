@inject ITimeZoneDisplay TimeZone

<MudGrid>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6">Settings</MudText>
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td>Model</td><td>@(Agent.Model ?? "default")</td></tr>
                <tr><td>Effort</td><td>@(Agent.Effort?.ToString() ?? "default")</td></tr>
                <tr><td>Background model</td><td>@(Agent.BackgroundModel ?? "same as model")</td></tr>
                <tr><td>Background effort</td><td>@(Agent.BackgroundEffort?.ToString() ?? "same as effort")</td></tr>
                <tr><td>Watch paths</td><td>@string.Join(", ", Agent.WatchPaths)</td></tr>
                <tr><td>Poll interval</td><td>@(Agent.PollInterval?.ToString() ?? "none")</td></tr>
                <tr><td>Minimum run interval</td><td>@Agent.MinRunInterval</td></tr>
                <tr><td>Allowed tools</td><td>@(Agent.AllowedTools.Length > 0 ? string.Join(", ", Agent.AllowedTools) : "all")</td></tr>
                <tr><td>Turn timeout</td><td>@Agent.TurnTimeout</td></tr>
                <tr><td>Tool calls per turn</td><td>@Agent.MaxToolCallsPerTurn</td></tr>
                @if (Agent is ClaudeCliAgent cliAgent)
                {
                    <tr><td>CLI path</td><td>@cliAgent.CliPath</td></tr>
                    <tr><td>Fallback model</td><td>@(cliAgent.FallbackModel ?? "none")</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption">Change settings with the subject's Edit action.</MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-3">Instructions</MudText>
        <MudText Style="white-space: pre-wrap;">@Agent.Instructions</MudText>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6">Memory</MudText>
        <MudText Typo="Typo.caption">
            The agent's own notes, shown to it on every run. Last updated: @(_baseline.LastUpdated is { } lastUpdated ? TimeZone.Format(lastUpdated) : "never")
        </MudText>
        <div data-testid="agent-memory">
            <MudTextField T="string" @bind-Value="_memory" Lines="16" Variant="Variant.Outlined" Immediate="true" />
        </div>
        @if (_isStale)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                The agent changed its memory while you were editing. Saving replaces its change.
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ReloadMemory">Reload</MudButton>
            </MudAlert>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">@_error</MudAlert>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SaveMemoryAsync"
                   Disabled="@(_isSaving || _memory == _baseline.Content)" data-testid="agent-memory-save">Save memory</MudButton>
    </MudItem>
</MudGrid>

@code {
    private LlmAgentBase? _agent;
    private AgentMemorySnapshot _baseline = new(string.Empty, null);
    private string _memory = string.Empty;
    private bool _isStale;
    private bool _isSaving;
    private string? _error;

    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    protected override void OnParametersSet()
    {
        // The parent re-renders on every timeline change, which includes the agent's own memory updates.
        // Untouched editor content follows the agent; edited content is kept and flagged instead.
        var snapshot = Agent.Memory.GetSnapshot();
        if (!ReferenceEquals(_agent, Agent) || _memory == _baseline.Content)
        {
            _agent = Agent;
            _baseline = snapshot;
            _memory = snapshot.Content;
            _isStale = false;
        }
        else
        {
            _isStale = snapshot.Content != _baseline.Content;
        }
    }

    private void ReloadMemory()
    {
        _baseline = Agent.Memory.GetSnapshot();
        _memory = _baseline.Content;
        _isStale = false;
        _error = null;
    }

    private async Task SaveMemoryAsync()
    {
        _isSaving = true;
        try
        {
            if (await Agent.Memory.TryWriteAsync(_memory, CancellationToken.None))
            {
                ReloadMemory();
            }
            else
            {
                _error = $"The memory is limited to {AgentMemory.MaxBytes} bytes.";
            }
        }
        catch (Exception exception)
        {
            _error = $"The memory could not be saved: {exception.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
