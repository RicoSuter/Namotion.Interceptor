@inject ITimeZoneDisplay TimeZone

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-1">Settings</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Outlined="true">
            <tbody>
                @SettingRow("Model", Agent.Model ?? "default")
                @SettingRow("Effort", Agent.Effort?.ToString() ?? "default")
                @SettingRow("Background model", Agent.BackgroundModel ?? "same as model")
                @SettingRow("Background effort", Agent.BackgroundEffort?.ToString() ?? "same as effort")
                @SettingRow("Watch paths", @<text>
                    @if (Agent.WatchPaths.Length == 0)
                    {
                        <text>none</text>
                    }
                    @foreach (var path in Agent.WatchPaths)
                    {
                        <div>@path</div>
                    }
                </text>)
                @SettingRow("Poll interval", Agent.PollInterval is { } pollInterval && pollInterval > TimeSpan.Zero ? AgentTimeSpanInput.Format(pollInterval) : "none")
                @SettingRow("Minimum run interval", AgentTimeSpanInput.Format(Agent.MinRunInterval))
                @SettingRow("Allowed tools", @<text>
                    @if (Agent.AllowedTools.Length > 0)
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="py-1">
                            @foreach (var tool in Agent.AllowedTools)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">@tool</MudChip>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <text>none (memory only)</text>
                    }
                </text>)
                @SettingRow("Turn timeout", FormatTurnTimeout(Agent.TurnTimeout))
                @SettingRow("Tool calls per turn", Agent.MaxToolCallsPerTurn.ToString())
                @if (Agent is ClaudeCliAgent cliAgent)
                {
                    @SettingRow("CLI path", cliAgent.CliPath)
                    @SettingRow("Fallback model", cliAgent.FallbackModel ?? "none")
                }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="d-block mt-1 mud-text-secondary">Change settings with the subject's Edit action.</MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-4">Instructions</MudText>
        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; overflow-wrap: anywhere;">@Agent.Instructions</MudText>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-1">Memory</MudText>
        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
            The agent's own notes, shown to it on every run. Last updated: @(Draft.LastUpdated is { } lastUpdated ? TimeZone.Format(lastUpdated) : "never")
        </MudText>
        <div data-testid="agent-memory">
            <MudTextField T="string" @bind-Value="Draft.Text" Lines="12" Variant="Variant.Outlined" Immediate="true" Disabled="Draft.IsSaving" />
        </div>
        @if (Draft.IsStale)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                The agent changed its memory while you were editing. Saving replaces its change.
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="Draft.Reload">Reload</MudButton>
            </MudAlert>
        }
        @if (Draft.Error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Draft.Error</MudAlert>
        }
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Draft.SaveAsync"
                       Disabled="@(Draft.IsSaving || !Draft.IsModified)" data-testid="agent-memory-save">Save memory</MudButton>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public LlmAgentBase Agent { get; set; } = null!;

    [Parameter, EditorRequired]
    public AgentMemoryDraft Draft { get; set; } = null!;

    // The page re-renders when the agent writes its memory, so the draft follows or flags that write here.
    protected override void OnParametersSet() => Draft.Refresh();

    // The runtime treats zero, negative and over int.MaxValue milliseconds as no limit.
    private static string FormatTurnTimeout(TimeSpan turnTimeout) =>
        turnTimeout > TimeSpan.Zero && turnTimeout.TotalMilliseconds <= int.MaxValue ? AgentTimeSpanInput.Format(turnTimeout) : "none";

    private static RenderFragment SettingRow(string label, string value) => SettingRow(label, @<text>@value</text>);

    // Values such as paths break anywhere so that narrow screens wrap them instead of widening the table.
    private static RenderFragment SettingRow(string label, RenderFragment value) =>
        @<tr>
            <td class="mud-text-secondary">@label</td>
            <td style="overflow-wrap: anywhere;">@value</td>
        </tr>;
}
