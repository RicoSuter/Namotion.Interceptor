@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(NukiOpener))]
@implements ISubjectComponent
@inject ITimeZoneDisplay TimeZone

@if (Subject is NukiOpener opener)
{
    var isRinging = opener.IsRinging == true;
    <MudPaper Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudIcon Icon="@(isRinging ? Icons.Material.Filled.NotificationsActive : Icons.Material.Filled.Notifications)"
                         Color="@(Enum.TryParse<Color>(opener.IconColor, out var iconColor) ? iconColor : Color.Default)" Class="mr-2" />
                <MudText Typo="Typo.h6">@opener.Title</MudText>
                <MudSpacer />
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">@(opener.OpenerState?.ToString() ?? "Unknown")</MudChip>
            </MudStack>

            <MudDivider />

            <MudStack Row="true" Spacing="2">
                @if (opener.OpenerState == NukiOpenerState.RingToOpenActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Ring to open</MudChip>
                }
                @if (opener.IsContinuousModeActive == true)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Continuous mode</MudChip>
                }
            </MudStack>

            @if (opener.LastRingTime is { } lastRingTime)
            {
                <MudText Typo="Typo.body2" Color="@(isRinging ? Color.Warning : Color.Default)">
                    @(isRinging ? "Ringing, since " : "Last ring: ")@TimeZone.Format(lastRingTime)
                </MudText>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }
}
