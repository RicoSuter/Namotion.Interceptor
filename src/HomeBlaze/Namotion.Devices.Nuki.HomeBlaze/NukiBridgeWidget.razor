@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(NukiBridge))]
@inherits PermissionsComponentBase
@implements ISubjectComponent

@if (Subject is NukiBridge bridge)
{
    <MudPaper Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudIcon Icon="@(bridge.IsConnected ? Icons.Material.Filled.Hub : Icons.Material.Outlined.Hub)"
                         Color="@NukiWidgetColors.FromIconColor(bridge.IconColor)" Class="mr-2" />
                <MudText Typo="Typo.h6">@bridge.Title</MudText>
                <MudSpacer />
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(bridge.IsConnected ? Color.Success : Color.Error)">
                    @(bridge.IsConnected ? "Connected" : "Disconnected")
                </MudChip>
            </MudStack>

            <MudDivider />

            <MudStack Row="true" Spacing="4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption">Locks</MudText>
                    <MudText Typo="Typo.h5">@CountShown(bridge.Locks.Values)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption">Openers</MudText>
                    <MudText Typo="Typo.h5">@CountShown(bridge.Openers.Values)</MudText>
                </MudStack>
                @if (bridge.SoftwareVersion is { } softwareVersion)
                {
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption">Firmware</MudText>
                        <MudText Typo="Typo.h5">@softwareVersion</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    // A lock or opener the roles hide is not counted.
    private int CountShown(IEnumerable<IInterceptorSubject> devices) =>
        devices.Count(device => Permissions.CanShow(device));
}
