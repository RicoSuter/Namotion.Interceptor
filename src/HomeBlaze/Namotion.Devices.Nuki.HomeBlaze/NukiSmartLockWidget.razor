@using global::HomeBlaze.Abstractions.Sensors
@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(NukiSmartLock))]
@implements ISubjectComponent

@if (Subject is NukiSmartLock smartLock)
{
    var lockState = smartLock.LockState;
    var iconColor = GetColor(smartLock.IconColor);
    <MudPaper Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudIcon Icon="@GetIcon(lockState)" Color="@iconColor" Class="mr-2" />
                <MudText Typo="Typo.h6">@smartLock.Title</MudText>
                <MudSpacer />
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@iconColor">
                    @(lockState?.ToString() ?? "Unknown")
                </MudChip>
            </MudStack>

            <MudDivider />

            <MudStack Row="true" Spacing="4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption">Door</MudText>
                    <MudText Typo="Typo.h6">@GetDoorText(smartLock.DoorState)</MudText>
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption">Battery</MudText>
                    <MudText Typo="Typo.h6" Color="@(smartLock.IsBatteryCritical == true ? Color.Error : Color.Default)">
                        @(smartLock.BatteryLevel is { } level ? level.ToString("P0", System.Globalization.CultureInfo.CurrentCulture) : "–")
                    </MudText>
                </MudStack>
            </MudStack>

            @if (smartLock.IsBatteryCritical == true)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">The batteries of the lock are at a critical level.</MudAlert>
            }

            @if (smartLock.IsKeypadBatteryCritical == true)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">The batteries of the keypad are at a critical level.</MudAlert>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    // The same icons as the IconName of the lock.
    private static string GetIcon(DoorLockState? lockState) => lockState switch
    {
        DoorLockState.Locked => Icons.Material.Filled.Lock,
        DoorLockState.Jammed => Icons.Material.Filled.LockReset,
        _ => Icons.Material.Filled.LockOpen
    };

    private static string GetDoorText(DoorState? doorState) => doorState switch
    {
        DoorState.Open => "Open",
        DoorState.Opening => "Opening",
        DoorState.PartiallyOpen => "Partially open",
        DoorState.Closing => "Closing",
        DoorState.Closed => "Closed",
        _ => "–"
    };

    private static Color GetColor(string? iconColor) =>
        Enum.TryParse<Color>(iconColor, out var color) ? color : Color.Default;
}
