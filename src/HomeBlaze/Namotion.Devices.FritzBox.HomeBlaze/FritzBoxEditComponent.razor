@attribute [SubjectComponent(SubjectComponentType.Edit, typeof(FritzBox))]
@implements ISubjectEditComponent

<MudForm>
    <MudTextField @bind-Value="_name"
                  @bind-Value:after="OnFieldChanged"
                  Label="Name"
                  Immediate="true" />

    <MudTextField @bind-Value="_hostAddress"
                  @bind-Value:after="OnFieldChanged"
                  Label="Host Address (IP or hostname)"
                  Required="true"
                  RequiredError="Host address is required"
                  Immediate="true"
                  Class="mt-4" />

    <MudTextField @bind-Value="_username"
                  @bind-Value:after="OnFieldChanged"
                  Label="Username"
                  Immediate="true"
                  Class="mt-4" />

    <MudTextField @bind-Value="_password"
                  @bind-Value:after="OnFieldChanged"
                  Label="Password (leave empty to keep the current one)"
                  InputType="InputType.Password"
                  Immediate="true"
                  Class="mt-4" />

    <MudNumericField @bind-Value="_pollingIntervalSeconds" @bind-Value:after="OnFieldChanged"
                     Label="Polling Interval (seconds)"
                     Min="FritzBox.MinimumIntervalSeconds"
                     Max="FritzBox.MaximumIntervalSeconds"
                     Class="mt-4" />

    <MudNumericField @bind-Value="_retryIntervalSeconds" @bind-Value:after="OnFieldChanged"
                     Label="Retry Interval (seconds)"
                     Min="FritzBox.MinimumIntervalSeconds"
                     Max="FritzBox.MaximumIntervalSeconds"
                     Class="mt-4" />

    <MudText Typo="Typo.subtitle2" Class="mt-4">Trusted certificate key</MudText>
    <MudText Typo="Typo.caption" Style="font-family: monospace; word-break: break-all;">
        @(_certificatePin ?? "None yet: the next connection trusts the key the router presents.")
    </MudText>

    @if (RouterSubject?.PresentedCertificatePin is { } presentedPin && presentedPin != _certificatePin)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2">
            The router presents a different certificate key: @presentedPin. Accept it only if you know why the router's certificate changed.
        </MudAlert>
        @if (RouterSubject?.PresentedCertificateFingerprint is { } presentedFingerprint)
        {
            <MudText Typo="Typo.caption" Style="font-family: monospace; word-break: break-all;" Class="mt-1">
                Fingerprint (compare it with the one your browser shows for this router's web UI): @presentedFingerprint
            </MudText>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="() => AcceptPresentedCertificate(presentedPin)" Class="mt-2">
            Accept New Certificate
        </MudButton>
    }

    @if (!IsCreating)
    {
        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Current State</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudText>Connection:</MudText>
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(RouterSubject?.IsConnected == true ? Color.Success : Color.Error)"
                     Variant="Variant.Filled">
                @(RouterSubject?.IsConnected == true ? "Connected" : "Disconnected")
            </MudChip>
        </MudStack>
        @if (RouterSubject?.StatusMessage != null)
        {
            <MudText Class="mt-1">@RouterSubject.StatusMessage</MudText>
        }
        @if (RouterSubject?.Model != null)
        {
            <MudText Class="mt-1">Model: @RouterSubject.Model</MudText>
        }
        @if (RouterSubject?.SoftwareVersion != null)
        {
            <MudText>FRITZ!OS: @RouterSubject.SoftwareVersion</MudText>
        }
        @if (RouterSubject?.AvailableSoftwareUpdate != null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">Update available: @RouterSubject.AvailableSoftwareUpdate</MudAlert>
        }
        @if (RouterSubject != null)
        {
            <MudText>Clients: @RouterSubject.PresentClientCount present of @RouterSubject.ClientCount</MudText>
        }
    }
</MudForm>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public bool IsCreating { get; set; }

    private FritzBox? RouterSubject => Subject as FritzBox;

    private string _name = string.Empty;
    private string? _hostAddress;
    private string? _username;
    private string? _password;
    private string? _certificatePin;
    private int _pollingIntervalSeconds = FritzBox.DefaultPollingIntervalSeconds;
    private int _retryIntervalSeconds = FritzBox.DefaultRetryIntervalSeconds;

    private string _originalName = string.Empty;
    private string? _originalHostAddress;
    private string? _originalUsername;
    private string? _originalCertificatePin;
    private int _originalPollingIntervalSeconds = FritzBox.DefaultPollingIntervalSeconds;
    private int _originalRetryIntervalSeconds = FritzBox.DefaultRetryIntervalSeconds;

    public bool IsValid => !string.IsNullOrWhiteSpace(_hostAddress) &&
                           _pollingIntervalSeconds is >= FritzBox.MinimumIntervalSeconds and <= FritzBox.MaximumIntervalSeconds &&
                           _retryIntervalSeconds is >= FritzBox.MinimumIntervalSeconds and <= FritzBox.MaximumIntervalSeconds;

    public bool IsDirty => _name != _originalName ||
                           Normalize(_hostAddress) != Normalize(_originalHostAddress) ||
                           Normalize(_username) != Normalize(_originalUsername) ||
                           !string.IsNullOrEmpty(_password) ||
                           _certificatePin != _originalCertificatePin ||
                           _pollingIntervalSeconds != _originalPollingIntervalSeconds ||
                           _retryIntervalSeconds != _originalRetryIntervalSeconds;

    public event Action<bool>? IsValidChanged;
    public event Action<bool>? IsDirtyChanged;

    protected override void OnInitialized()
    {
        if (RouterSubject != null)
        {
            _name = RouterSubject.Name;
            _hostAddress = RouterSubject.HostAddress;
            _username = RouterSubject.Username;
            _certificatePin = RouterSubject.CertificatePin;

            // Maps zero or below to the library's own default (FritzBox.GetEffectiveInterval does the same for the
            // polling loop) and then clamps, so a value a previous, looser version of the library (or a hand-edited
            // configuration file) could have stored outside the current range does not leave the dialog stuck on
            // IsValid's range check with no field that explains why.
            _pollingIntervalSeconds = LoadInterval((int)RouterSubject.PollingInterval.TotalSeconds, FritzBox.DefaultPollingIntervalSeconds);
            _retryIntervalSeconds = LoadInterval((int)RouterSubject.RetryInterval.TotalSeconds, FritzBox.DefaultRetryIntervalSeconds);
        }

        RememberOriginals();
    }

    private static int LoadInterval(int storedSeconds, int defaultSeconds) =>
        ClampInterval(storedSeconds <= 0 ? defaultSeconds : storedSeconds);

    private static int ClampInterval(int seconds) =>
        Math.Clamp(seconds, FritzBox.MinimumIntervalSeconds, FritzBox.MaximumIntervalSeconds);

    /// <summary>
    /// Collapses blank to null so a user clearing a field back to what it loaded as (null) is not seen as a
    /// change, and so saving does not turn a stored null into a stored "".
    /// </summary>
    private static string? Normalize(string? value)
    {
        var trimmed = value?.Trim();
        return string.IsNullOrEmpty(trimmed) ? null : trimmed;
    }

    private void RememberOriginals()
    {
        _originalName = _name;
        _originalHostAddress = _hostAddress;
        _originalUsername = _username;
        _originalCertificatePin = _certificatePin;
        _originalPollingIntervalSeconds = _pollingIntervalSeconds;
        _originalRetryIntervalSeconds = _retryIntervalSeconds;
    }

    private void AcceptPresentedCertificate(string presentedPin)
    {
        _certificatePin = presentedPin;
        OnFieldChanged();
    }

    private void OnFieldChanged()
    {
        IsValidChanged?.Invoke(IsValid);
        IsDirtyChanged?.Invoke(IsDirty);
    }

    public Task SaveAsync(CancellationToken cancellationToken)
    {
        if (RouterSubject != null && IsValid)
        {
            // Writes only what actually changed here: the router itself can update CertificatePin (and other
            // properties) between this dialog loading its values and the user saving, and writing every field
            // unconditionally would overwrite that with the stale value this dialog loaded.
            if (_name != _originalName)
            {
                RouterSubject.Name = _name;
            }

            if (Normalize(_hostAddress) != Normalize(_originalHostAddress))
            {
                RouterSubject.HostAddress = Normalize(_hostAddress);
            }

            if (Normalize(_username) != Normalize(_originalUsername))
            {
                RouterSubject.Username = Normalize(_username);
            }

            if (!string.IsNullOrEmpty(_password))
            {
                RouterSubject.Password = _password;
            }

            if (_certificatePin != _originalCertificatePin)
            {
                RouterSubject.CertificatePin = _certificatePin;
            }

            if (_pollingIntervalSeconds != _originalPollingIntervalSeconds)
            {
                RouterSubject.PollingInterval = TimeSpan.FromSeconds(_pollingIntervalSeconds);
            }

            if (_retryIntervalSeconds != _originalRetryIntervalSeconds)
            {
                RouterSubject.RetryInterval = TimeSpan.FromSeconds(_retryIntervalSeconds);
            }

            _password = null;
            RememberOriginals();
            IsDirtyChanged?.Invoke(false);
        }

        return Task.CompletedTask;
    }
}
