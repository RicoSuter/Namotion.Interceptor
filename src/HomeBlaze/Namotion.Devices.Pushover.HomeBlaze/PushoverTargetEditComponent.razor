@attribute [SubjectComponent(SubjectComponentType.Edit, typeof(PushoverTarget))]
@implements ISubjectEditComponent

<MudForm>
    <MudTextField @bind-Value="_name"
                  Label="Name"
                  Required="true"
                  RequiredError="Name is required"
                  Immediate="true"
                  OnKeyUp="OnFieldChanged" />

    <MudTextField @bind-Value="_userKey"
                  Label="User or Group Key"
                  InputType="InputType.Password"
                  HelperText="@(_hasStoredUserKey ? "Leave empty to keep the current key" : null)"
                  Immediate="true"
                  OnKeyUp="OnFieldChanged"
                  Class="mt-4" />

    <MudNumericField T="int"
                     Value="_emergencyRetrySeconds"
                     ValueChanged="@(value => { _emergencyRetrySeconds = value; OnFieldChanged(); })"
                     Label="Emergency Retry (seconds)"
                     Min="30"
                     Max="10800"
                     Class="mt-4" />

    <MudNumericField T="int"
                     Value="_emergencyExpireMinutes"
                     ValueChanged="@(value => { _emergencyExpireMinutes = value; OnFieldChanged(); })"
                     Label="Emergency Expire (minutes)"
                     Min="1"
                     Max="180"
                     Class="mt-4" />

    @if (!IsCreating && Target != null)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Current State</MudText>
        <MudText>Status: @Target.Status</MudText>
        @if (!string.IsNullOrEmpty(Target.StatusMessage))
        {
            <MudText>@Target.StatusMessage</MudText>
        }
        @if (Target.Devices.Length > 0)
        {
            <MudText>Devices: @string.Join(", ", Target.Devices)</MudText>
        }
    }
</MudForm>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public bool IsCreating { get; set; }

    private PushoverTarget? Target => Subject as PushoverTarget;

    private string _name = string.Empty;
    private string? _userKey;
    private bool _hasStoredUserKey;
    private int _emergencyRetrySeconds = 60;
    private int _emergencyExpireMinutes = 60;

    private string _originalName = string.Empty;
    private int _originalEmergencyRetrySeconds = 60;
    private int _originalEmergencyExpireMinutes = 60;

    public bool IsValid => !string.IsNullOrWhiteSpace(_name) && (_hasStoredUserKey || !string.IsNullOrWhiteSpace(_userKey));

    public bool IsDirty => _name != _originalName ||
                           !string.IsNullOrEmpty(_userKey) ||
                           _emergencyRetrySeconds != _originalEmergencyRetrySeconds ||
                           _emergencyExpireMinutes != _originalEmergencyExpireMinutes;

    public event Action<bool>? IsValidChanged;
    public event Action<bool>? IsDirtyChanged;

    protected override void OnInitialized()
    {
        if (Target == null)
        {
            return;
        }

        _name = Target.Name;
        _hasStoredUserKey = !string.IsNullOrEmpty(Target.UserKey);
        _emergencyRetrySeconds = (int)Target.EmergencyRetry.TotalSeconds;
        _emergencyExpireMinutes = (int)Target.EmergencyExpire.TotalMinutes;

        _originalName = _name;
        _originalEmergencyRetrySeconds = _emergencyRetrySeconds;
        _originalEmergencyExpireMinutes = _emergencyExpireMinutes;
    }

    private void OnFieldChanged()
    {
        IsValidChanged?.Invoke(IsValid);
        IsDirtyChanged?.Invoke(IsDirty);
    }

    public Task SaveAsync(CancellationToken cancellationToken)
    {
        if (Target == null || !IsValid)
        {
            return Task.CompletedTask;
        }

        Target.Name = _name;
        if (!string.IsNullOrWhiteSpace(_userKey))
        {
            Target.UserKey = _userKey;
        }

        Target.EmergencyRetry = TimeSpan.FromSeconds(_emergencyRetrySeconds);
        Target.EmergencyExpire = TimeSpan.FromMinutes(_emergencyExpireMinutes);

        _hasStoredUserKey = !string.IsNullOrEmpty(Target.UserKey);
        _userKey = null;
        _originalName = _name;
        _originalEmergencyRetrySeconds = _emergencyRetrySeconds;
        _originalEmergencyExpireMinutes = _emergencyExpireMinutes;
        IsDirtyChanged?.Invoke(false);
        return Task.CompletedTask;
    }
}
