@attribute [SubjectComponent(SubjectComponentType.Edit, typeof(PushoverService))]
@implements ISubjectEditComponent

<MudForm>
    <MudTextField @bind-Value="_name"
                  Label="Name"
                  Immediate="true"
                  OnKeyUp="OnFieldChanged" />

    <MudTextField @bind-Value="_applicationToken"
                  Label="Application Token"
                  InputType="InputType.Password"
                  HelperText="@(_hasApplicationToken ? "Leave empty to keep the current token" : null)"
                  Immediate="true"
                  OnKeyUp="OnFieldChanged"
                  Class="mt-4" />

    @foreach (var target in _targets)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-4">
            <MudTextField @bind-Value="target.Name"
                          Label="Target Name"
                          Required="true"
                          RequiredError="Name is required"
                          Immediate="true"
                          OnKeyUp="OnFieldChanged" />

            <MudTextField @bind-Value="target.UserKey"
                          Label="User or Group Key"
                          InputType="InputType.Password"
                          HelperText="@(HasStoredUserKey(target) ? "Leave empty to keep the current key" : null)"
                          Required="@(!HasStoredUserKey(target))"
                          RequiredError="Key is required"
                          Immediate="true"
                          OnKeyUp="OnFieldChanged"
                          Class="mt-2" />

            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudNumericField T="int"
                                 Value="target.EmergencyRetrySeconds"
                                 ValueChanged="@(value => { target.EmergencyRetrySeconds = value; OnFieldChanged(); })"
                                 Label="Emergency Retry (seconds)"
                                 Min="@MinimumEmergencyRetrySeconds"
                                 Max="@MaximumEmergencyExpireSeconds" />
                <MudNumericField T="int"
                                 Value="target.EmergencyExpireMinutes"
                                 ValueChanged="@(value => { target.EmergencyExpireMinutes = value; OnFieldChanged(); })"
                                 Label="Emergency Expire (minutes)"
                                 Min="@MinimumEmergencyRetryMinutes"
                                 Max="@MaximumEmergencyExpireMinutes" />
                <MudNumericField T="int"
                                 Value="target.MaximumActiveEmergencies"
                                 ValueChanged="@(value => { target.MaximumActiveEmergencies = value; OnFieldChanged(); })"
                                 Label="Maximum Active Emergencies"
                                 Min="1" />
            </MudStack>

            <MudButton OnClick="@(() => RemoveTarget(target))"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Color="Color.Error"
                       Class="mt-2">Remove</MudButton>
        </MudPaper>
    }

    <MudButton OnClick="AddTarget" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Add Target</MudButton>
</MudForm>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public bool IsCreating { get; set; }

    private PushoverService? Service => Subject as PushoverService;

    private static readonly PushoverTarget DefaultTarget = new();

    private static readonly int MinimumEmergencyRetrySeconds = (int)PushoverTarget.MinimumEmergencyRetry.TotalSeconds;
    private static readonly int MaximumEmergencyExpireSeconds = (int)PushoverTarget.MaximumEmergencyExpire.TotalSeconds;

    // MinimumEmergencyRetry is 30 seconds, less than one minute; the Expire field is entered in whole minutes, so
    // its floor is 1, not the 0 that truncating 0.5 minutes down would give.
    private static readonly int MinimumEmergencyRetryMinutes = Math.Max(1, (int)PushoverTarget.MinimumEmergencyRetry.TotalMinutes);
    private static readonly int MaximumEmergencyExpireMinutes = (int)PushoverTarget.MaximumEmergencyExpire.TotalMinutes;

    private string _name = string.Empty;
    private string? _applicationToken;
    private bool _hasApplicationToken;
    private readonly List<TargetInput> _targets = [];

    public bool IsValid =>
        (_hasApplicationToken || !string.IsNullOrWhiteSpace(_applicationToken)) &&
        _targets.Count > 0 &&
        _targets.All(target => !string.IsNullOrWhiteSpace(target.Name) && (HasStoredUserKey(target) || !string.IsNullOrWhiteSpace(target.UserKey)));

    public bool IsDirty { get; private set; }

    public event Action<bool>? IsValidChanged;
    public event Action<bool>? IsDirtyChanged;

    protected override void OnInitialized()
    {
        if (Service == null)
        {
            return;
        }

        _name = Service.Name;
        _hasApplicationToken = !string.IsNullOrEmpty(Service.ApplicationToken);
        foreach (var (key, target) in Service.Targets)
        {
            var emergencyRetrySeconds = (int)target.EmergencyRetry.TotalSeconds;
            var emergencyExpireMinutes = (int)target.EmergencyExpire.TotalMinutes;
            _targets.Add(new TargetInput
            {
                Key = key,
                Name = target.Name,
                EmergencyRetrySeconds = emergencyRetrySeconds,
                LoadedEmergencyRetrySeconds = emergencyRetrySeconds,
                EmergencyExpireMinutes = emergencyExpireMinutes,
                LoadedEmergencyExpireMinutes = emergencyExpireMinutes,
                MaximumActiveEmergencies = target.MaximumActiveEmergencies
            });
        }
    }

    private void OnFieldChanged()
    {
        IsDirty = true;
        IsValidChanged?.Invoke(IsValid);
        IsDirtyChanged?.Invoke(IsDirty);
    }

    private void AddTarget()
    {
        _targets.Add(new TargetInput());
        OnFieldChanged();
    }

    private void RemoveTarget(TargetInput target)
    {
        _targets.Remove(target);
        OnFieldChanged();
    }

    public Task SaveAsync(CancellationToken cancellationToken)
    {
        if (Service == null || !IsValid)
        {
            return Task.CompletedTask;
        }

        Service.Name = _name;
        if (!string.IsNullOrWhiteSpace(_applicationToken))
        {
            Service.ApplicationToken = _applicationToken;
        }

        // Existing targets are kept as instances, so their state and subscriptions survive; the dictionary is
        // replaced as a whole.
        var targets = new Dictionary<string, PushoverTarget>();
        foreach (var input in _targets)
        {
            var key = input.Key ?? PushoverService.CreateTargetKey(input.Name, targets.Keys.Concat(Service.Targets.Keys).ToArray());
            var isExisting = TryGetExistingTarget(input, out var existing);
            var target = existing ?? new PushoverTarget();

            target.Name = input.Name;
            if (!string.IsNullOrWhiteSpace(input.UserKey))
            {
                target.UserKey = input.UserKey;
            }

            // Written only when the user changed the number, so an untouched field never rounds the existing
            // TimeSpan to the seconds or minutes the field shows. A new target takes every value.
            if (!isExisting || input.EmergencyRetrySeconds != input.LoadedEmergencyRetrySeconds)
            {
                target.EmergencyRetry = TimeSpan.FromSeconds(input.EmergencyRetrySeconds);
            }

            if (!isExisting || input.EmergencyExpireMinutes != input.LoadedEmergencyExpireMinutes)
            {
                target.EmergencyExpire = TimeSpan.FromMinutes(input.EmergencyExpireMinutes);
            }

            target.MaximumActiveEmergencies = input.MaximumActiveEmergencies;

            input.Key = key;
            input.UserKey = null;
            input.LoadedEmergencyRetrySeconds = input.EmergencyRetrySeconds;
            input.LoadedEmergencyExpireMinutes = input.EmergencyExpireMinutes;
            targets[key] = target;
        }

        Service.Targets = targets;

        _hasApplicationToken = !string.IsNullOrEmpty(Service.ApplicationToken);
        _applicationToken = null;
        IsDirty = false;
        IsDirtyChanged?.Invoke(false);
        return Task.CompletedTask;
    }

    // An input whose key is no longer in Service.Targets, for example after an external edit of the configuration,
    // is a new target and needs its user key again.
    private bool TryGetExistingTarget(TargetInput input, [System.Diagnostics.CodeAnalysis.NotNullWhen(true)] out PushoverTarget? target)
    {
        target = null;
        return input.Key is { } key && Service?.Targets.TryGetValue(key, out target) == true;
    }

    private bool HasStoredUserKey(TargetInput input) =>
        TryGetExistingTarget(input, out var target) && !string.IsNullOrEmpty(target.UserKey);

    private sealed class TargetInput
    {
        public string? Key { get; set; }

        public string Name { get; set; } = string.Empty;

        public string? UserKey { get; set; }

        public int EmergencyRetrySeconds { get; set; } = (int)DefaultTarget.EmergencyRetry.TotalSeconds;

        public int LoadedEmergencyRetrySeconds { get; set; } = (int)DefaultTarget.EmergencyRetry.TotalSeconds;

        public int EmergencyExpireMinutes { get; set; } = (int)DefaultTarget.EmergencyExpire.TotalMinutes;

        public int LoadedEmergencyExpireMinutes { get; set; } = (int)DefaultTarget.EmergencyExpire.TotalMinutes;

        public int MaximumActiveEmergencies { get; set; } = DefaultTarget.MaximumActiveEmergencies;
    }
}
