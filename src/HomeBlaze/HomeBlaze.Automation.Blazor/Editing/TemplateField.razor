@inject IDialogService DialogService

<div data-testid="automation-template-field">
    <MudTextField T="string" Label="@Label" Value="@_text" ValueChanged="SetValueAsync" Immediate="true"
                  HelperText="Text, with {{ path }} for a value" Error="@(_error is not null)" ErrorText="@_error" />
    <div class="d-flex flex-wrap align-center gap-2">
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.DataObject" OnClick="InsertValueAsync">Insert value</MudButton>
        @if (_rendered is { Length: > 0 } rendered)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="overflow-wrap: anywhere;">Now: @rendered</MudText>
        }
    </div>
</div>

@code {
    private string? _text;
    private string? _written;
    private string? _error;
    private string? _rendered;
    private bool _isInitialized;
    private string? _evaluatedText;
    private RuleExpressions? _evaluatedExpressions;

    private static readonly Func<IInterceptorSubject, bool> NoSubject = _ => false;

    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>Whether an empty text is an error.</summary>
    [Parameter] public bool IsRequired { get; set; }

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter, EditorRequired] public RuleExpressions Expressions { get; set; } = null!;

    // The field renders again after each keystroke, before its parent passes the new value down, so the text is reloaded
    // only when the parent holds something other than what this field last wrote.
    protected override void OnParametersSet()
    {
        if (!_isInitialized || Value != _written)
        {
            _isInitialized = true;
            _text = Value;
            _written = Value;
        }

        Refresh();
    }

    // Evaluated when the text or the expressions change, not on every render of the editor.
    private void Refresh()
    {
        var text = _text ?? string.Empty;
        if (text == _evaluatedText && ReferenceEquals(Expressions, _evaluatedExpressions))
        {
            return;
        }

        _evaluatedText = text;
        _evaluatedExpressions = Expressions;
        _error = ArgumentFields.Validate(text, typeof(string), IsRequired, Expressions);
        _rendered = _error is null && text.Contains("{{", StringComparison.Ordinal) ? Expressions.RenderTemplate(text) : null;
    }

    private Task SetValueAsync(string? value)
    {
        _text = value;
        _written = value;
        Refresh();
        return ValueChanged.InvokeAsync(value);
    }

    private async Task InsertValueAsync()
    {
        var parameters = new DialogParameters<SubjectPathPickerDialog>
        {
            { dialog => dialog.SelectedPath, null },
            { dialog => dialog.Label, "Value" },
            { dialog => dialog.CanSelectSubject, NoSubject }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialogReference = await DialogService.ShowAsync<SubjectPathPickerDialog>("Insert value", parameters, options);
        if (await dialogReference.Result is { Canceled: false, Data: string path })
        {
            await SetValueAsync($"{_text}{{{{ {path} }}}}");
        }
    }
}
