@inject ITimeZoneDisplay TimeZone
@inject TimeProvider TimeProvider

<MudPaper Outlined="true" Class="pa-3" data-testid="automation-guard">
    <ConditionField Label="Checked when a trigger fires" Lead="Check" Value="@_condition"
                    ValueChanged="@(value => SetGuardAsync(value, _cooldown))"
                    Validate="@Expressions.Validate" Preview="@Expressions.Preview" TestId="automation-guard-condition" />
    <div class="d-flex flex-wrap align-center gap-3 mt-2">
        <DurationField Label="At most once every" Value="@_cooldown" ValueChanged="@(value => SetGuardAsync(_condition, value))"
                       Draft="Draft" MustBePositive="true" RuleKey="@Rule.Key" HelperText="Empty: no limit" Style="max-width: 240px;" />
        @if (LastTriggeredAt is { } lastTriggeredAt)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Last triggered @AutomationTime.Format(TimeZone, lastTriggeredAt, TimeProvider.GetUtcNow())</MudText>
        }
    </div>
</MudPaper>

@code {
    private string? _condition;
    private TimeSpan? _cooldown;
    private string? _writtenGuard;
    private bool _isInitialized;

    [Parameter, EditorRequired] public RuleDraft Rule { get; set; } = null!;

    [Parameter, EditorRequired] public AutomationDraft Draft { get; set; } = null!;

    [Parameter, EditorRequired] public RuleExpressions Expressions { get; set; } = null!;

    /// <summary>When the saved rule last triggered, or null.</summary>
    [Parameter] public DateTimeOffset? LastTriggeredAt { get; set; }

    [Parameter] public EventCallback Changed { get; set; }

    // The two inputs keep what the user typed: a half-typed condition such as "(" does not split back out of the guard,
    // so they are read from the guard only when it was changed by someone else.
    protected override void OnParametersSet()
    {
        if (_isInitialized && Rule.Guard == _writtenGuard)
        {
            return;
        }

        _isInitialized = true;
        _writtenGuard = Rule.Guard;
        (_condition, _cooldown) = GuardCooldown.Split(Rule.Guard);
    }

    // The guard is written only here, after an edit, so that opening a rule never rewrites the text it holds.
    private Task SetGuardAsync(string? condition, TimeSpan? cooldown)
    {
        _condition = condition;
        _cooldown = cooldown;
        Rule.Guard = GuardCooldown.Combine(condition, cooldown);
        _writtenGuard = Rule.Guard;
        return Changed.InvokeAsync();
    }
}
