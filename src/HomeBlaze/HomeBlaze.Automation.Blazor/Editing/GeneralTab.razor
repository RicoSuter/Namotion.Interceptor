<MudStack Spacing="3" Class="automation-tab">
    <MudTextField T="string" Label="Name" Value="@Draft.Name" ValueChanged="@((string? name) => EditAsync(() => Draft.Name = name))" Immediate="true"
                  HelperText="The title of the automation." data-testid="automation-name" />
    <MudSwitch T="bool" Value="@Draft.Enabled" ValueChanged="@((bool isEnabled) => EditAsync(() => Draft.Enabled = isEnabled))" Color="Color.Primary" data-testid="automation-enabled"
               Label="Enabled: the rules observe their triggers. A disabled automation keeps its state." />
</MudStack>

@code {
    [Parameter, EditorRequired] public AutomationDraft Draft { get; set; } = null!;

    [Parameter] public EventCallback Changed { get; set; }

    private Task EditAsync(Action edit)
    {
        edit();
        return Changed.InvokeAsync();
    }
}
