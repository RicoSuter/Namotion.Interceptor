@implements IDisposable

<MudTextField T="string" Label="@Label" Value="@_text" ValueChanged="SetTextAsync" Immediate="true" OnBlur="OnBlurAsync" HelperText="@HelperText"
              Error="@(_error is not null)" ErrorText="@_error" Style="@Style" />

@code {
    private const string FormatError = "Use a duration such as 20s, 10m or 1h30m";
    private const string PositiveError = "Use a duration above 0";

    private readonly string _inputId = Guid.NewGuid().ToString("N");
    private string? _text;
    private string? _error;
    private TimeSpan? _shownValue;

    [CascadingParameter] private PendingRows? PendingRows { get; set; }

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public TimeSpan? Value { get; set; }

    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }

    /// <summary>
    /// Raised when the error of the field may have changed without a change of <see cref="Value"/>: it rejects a text, or a
    /// text gives <see cref="Value"/> again after an error.
    /// </summary>
    [Parameter] public EventCallback ErrorChanged { get; set; }

    [Parameter, EditorRequired] public AutomationDraft Draft { get; set; } = null!;

    /// <summary>The rule an error of the field belongs to.</summary>
    [Parameter] public string? RuleKey { get; set; }

    [Parameter] public string? HelperText { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>Whether zero is no duration, as for a cooldown, where it means none.</summary>
    [Parameter] public bool MustBePositive { get; set; }

    // The text stays as typed while it does not parse, and is replaced only when the value changes elsewhere.
    protected override void OnParametersSet()
    {
        if (Value == _shownValue)
        {
            return;
        }

        _shownValue = Value;
        _text = Value is { } value ? AutomationDuration.Format(value) : null;
    }

    private Task SetTextAsync(string? text)
    {
        _text = text;
        if (string.IsNullOrWhiteSpace(text))
        {
            return AcceptAsync(null);
        }

        if (!DurationInput.TryParse(text, out var duration))
        {
            // A number or a literal that still lacks its unit is being typed; the error shows when the field is left.
            return IsInProgress(text) ? Task.CompletedTask : RejectAsync(FormatError);
        }

        return MustBePositive && duration <= TimeSpan.Zero ? RejectAsync(PositiveError) : AcceptAsync(duration);
    }

    private Task OnBlurAsync() =>
        string.IsNullOrWhiteSpace(_text) || DurationInput.TryParse(_text, out _) || _error is not null ? Task.CompletedTask : RejectAsync(FormatError);

    private static bool IsInProgress(string text) => DurationInput.IsMissingUnit(text);

    private Task RejectAsync(string error)
    {
        _error = error;
        Draft.SetInputError(_inputId, new AutomationValidationError(RuleKey, $"{Label}: {error}"));
        return ErrorChanged.InvokeAsync();
    }

    // A text that gives the value the field already has, such as the one typed again after an error, is no edit.
    private Task AcceptAsync(TimeSpan? value)
    {
        var hadError = _error is not null;
        _error = null;
        _shownValue = value;
        Draft.SetInputError(_inputId, null);
        if (value != Value)
        {
            return ValueChanged.InvokeAsync(value);
        }

        return hadError ? ErrorChanged.InvokeAsync() : Task.CompletedTask;
    }

    public void Dispose()
    {
        if (_error is not null)
        {
            PendingRows?.Discard($"An invalid duration in '{Label}'");
        }

        Draft.SetInputError(_inputId, null);
    }
}
