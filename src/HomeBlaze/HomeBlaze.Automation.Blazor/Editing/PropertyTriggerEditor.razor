<MudPaper Outlined="true" Class="pa-3" data-testid="automation-property-trigger">
    <div class="d-flex align-center">
        <MudText Typo="Typo.overline">Property condition</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Remove trigger" OnClick="@(() => Removed.InvokeAsync())" />
    </div>
    <ConditionField Label="Fires when" Lead="" Value="@_trigger.Expression" ValueChanged="SetExpressionAsync"
                    Validate="@RuleExpressions.ValidateCondition" Preview="@Expressions.PreviewCondition" Hints="@RuleExpressions.GetConditionHints"
                    TestId="automation-trigger-condition" />
    <div class="d-flex flex-wrap gap-3 mt-2">
        <div style="flex: 1 1 160px;">
            <DurationField Label="For at least" Value="@_trigger.For" ValueChanged="SetHoldAsync" ErrorChanged="InputChanged" Draft="Draft" RuleKey="@RuleKey"
                           HelperText="Empty: fires at once" />
        </div>
        <div style="flex: 1 1 200px;">
            <MudSelect T="TriggerActivation" Label="When the rule starts" Value="@_trigger.OnActivation" ValueChanged="SetActivationAsync"
                       ToStringFunc="@FormatActivation">
                <MudSelectItem Value="TriggerActivation.EvaluateImmediately">@FormatActivation(TriggerActivation.EvaluateImmediately)</MudSelectItem>
                <MudSelectItem Value="TriggerActivation.WaitForFalseToTrue">@FormatActivation(TriggerActivation.WaitForFalseToTrue)</MudSelectItem>
            </MudSelect>
        </div>
    </div>
    @if (_trigger.Rearm is null)
    {
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRearmAsync" Class="mt-2"
                   data-testid="automation-add-rearm">Fires again only after</MudButton>
    }
    else
    {
        <div class="d-flex align-start gap-1 mt-3">
            <div class="flex-grow-1" style="min-width: 0;">
                <ConditionField Label="Fires again only after" Lead="" Value="@_trigger.Rearm" ValueChanged="SetRearmAsync"
                                Validate="@RuleExpressions.ValidateCondition" Preview="@Expressions.PreviewCondition" Hints="@RuleExpressions.GetConditionHints"
                                TestId="automation-trigger-rearm" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Default: once the condition above is false again</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Remove the rearm condition" OnClick="RemoveRearmAsync" />
        </div>
    }
</MudPaper>

@code {
    private PropertyTrigger _trigger = null!;

    [Parameter, EditorRequired] public PropertyTrigger Trigger { get; set; } = null!;

    [Parameter, EditorRequired] public RuleExpressions Expressions { get; set; } = null!;

    [Parameter, EditorRequired] public AutomationDraft Draft { get; set; } = null!;

    [Parameter, EditorRequired] public string RuleKey { get; set; } = string.Empty;

    [Parameter] public EventCallback<AutomationTrigger> TriggerChanged { get; set; }

    [Parameter] public EventCallback Removed { get; set; }

    /// <summary>Raised when the errors may have changed without an edit, such as when the hold input rejects its text.</summary>
    [Parameter] public EventCallback InputChanged { get; set; }

    // The component renders again after each edit, before its parent passes the new trigger down. A stale value in that
    // render would make the expression field reload its text and lose a row that is not finished.
    protected override void OnParametersSet() => _trigger = Trigger;

    private Task UpdateAsync(PropertyTrigger trigger)
    {
        _trigger = trigger;
        return TriggerChanged.InvokeAsync(trigger);
    }

    private Task SetExpressionAsync(string? expression) => UpdateAsync(_trigger with { Expression = expression ?? string.Empty });

    private Task SetHoldAsync(TimeSpan? hold) => UpdateAsync(_trigger with { For = hold });

    private Task SetActivationAsync(TriggerActivation activation) => UpdateAsync(_trigger with { OnActivation = activation });

    private Task AddRearmAsync() => UpdateAsync(_trigger with { Rearm = string.Empty });

    private Task SetRearmAsync(string? rearm) => UpdateAsync(_trigger with { Rearm = rearm ?? string.Empty });

    private Task RemoveRearmAsync() => UpdateAsync(_trigger with { Rearm = null });

    private static string FormatActivation(TriggerActivation activation) =>
        activation == TriggerActivation.WaitForFalseToTrue ? "Wait for a change" : "Run if already true";
}
