@attribute [SubjectComponent(SubjectComponentType.Page, typeof(Automation))]
@implements ISubjectComponent
@implements IDisposable
@using global::HomeBlaze.Components.Dialogs
@using global::HomeBlaze.History.Abstractions
@using global::HomeBlaze.Services.Components
@using Namotion.Interceptor.Registry.Abstractions
@inject ITimeZoneDisplay TimeZone
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject SubjectComponentRegistry ComponentRegistry
@inject SubjectPathResolver PathResolver
@inject TimeProvider TimeProvider

@if (Subject is Automation automation)
{
    var path = PathResolver.GetPath(automation, PathStyle.Canonical);
    @* Read in the render of the page itself, not in the content of a child component, so that a run renders the page and its runs are read again. *@
    _renderedRunsKey = GetRunsKey(automation);
    <div class="d-flex flex-column gap-4 pt-2 pt-sm-4 pb-4" data-testid="automation-page">
        @* The right padding keeps the buttons clear of the page's edit mode menu, which floats over the top right corner. *@
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="pr-12">
            <MudIcon Icon="@Icons.Material.Filled.AutoMode" />
            <MudStack Spacing="0" Style="min-width: 0;">
                <MudText Typo="Typo.h5" Style="overflow-wrap: anywhere;">@automation.Title</MudText>
                @if (path is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@path</MudText>
                }
            </MudStack>
            <MudChip T="string" Size="Size.Small" Color="@AutomationColors.GetStatusColor(automation.Status)" Class="ma-0" data-testid="automation-status">@automation.Status</MudChip>
            @if (automation.StatusMessage is { Length: > 0 } statusMessage)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="overflow-wrap: anywhere;">@statusMessage</MudText>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="@(() => ResetAsync(automation))"
                       data-testid="automation-reset">Reset state</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => EditAsync(automation))"
                       data-testid="automation-edit">Edit</MudButton>
        </MudStack>

        @if (automation.States.Length > 0)
        {
            <section>
                <MudText Typo="Typo.h6">State</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Read only. Edit the states in the States tab of the editor.</MudText>
                <div class="mt-2" style="overflow-x: auto;">
                    <StateDiagram Layout="@GetLayout(automation)" CurrentState="@automation.CurrentState" CurrentDetail="@GetCurrentDetail(automation)" />
                </div>
            </section>
        }

        <section>
            <MudText Typo="Typo.h6">Rules</MudText>
            @if (automation.Rules.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No rules yet. Add one with Edit.</MudText>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                        <thead>
                            <tr>
                                <th>Rule</th>
                                <th>Mode</th>
                                <th>Status</th>
                                <th>Last triggered</th>
                                <th>Runs</th>
                                <th aria-label="Actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (key, rule) in automation.GetRulesInOrder())
                            {
                                <tr data-testid="automation-rule-row">
                                    <td>
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@(rule.Name ?? key)</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@DescribeScope(automation, rule)</MudText>
                                    </td>
                                    <td>@AutomationSummary.FormatMode(rule.Mode)</td>
                                    <td style="overflow-wrap: anywhere;">@AutomationSummary.GetStatusText(rule.Status)</td>
                                    <td>@FormatInstant(rule.LastTriggeredAt, "Never")</td>
                                    <td>@(rule.RunCount ?? 0)</td>
                                    <td>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Science"
                                                   OnClick="@(() => TestAsync(key, rule))" data-testid="automation-test-now">Test now</MudButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
        </section>

        <section>
            <MudText Typo="Typo.h6">Recent runs</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(_hasHistory ? "From history: the runs of the last seven days." : "Without a history store: the last run of each rule.")
            </MudText>
            @if (_runsError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_runsError</MudAlert>
            }
            else if (_runs.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2" data-testid="automation-no-runs">No runs yet.</MudText>
            }
            else
            {
                <MudStack Spacing="1" Class="mt-2">
                    @foreach (var run in _runs)
                    {
                        <div class="d-flex flex-wrap align-center gap-2" data-testid="automation-run">
                            <MudText Typo="Typo.caption" Style="min-width: 160px;">@FormatInstant(run.At, "Last run")</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@run.RuleName</MudText>
                            @if (run.Outcome is { } outcome)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@AutomationColors.GetOutcomeColor(outcome)" Class="ma-0">@AutomationSummary.FormatOutcome(outcome)</MudChip>
                            }
                            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="overflow-wrap: anywhere;">@run.Message</MudText>
                        </div>
                    }
                </MudStack>
            }
        </section>
    </div>
}

@code {
    private const int MaxRuns = 20;
    private static readonly TimeSpan RunWindow = TimeSpan.FromDays(7);
    private static readonly TimeSpan ReloadInterval = TimeSpan.FromSeconds(5);

    private readonly StateDiagramLayoutCache _layouts = new();
    private readonly RunReloadSchedule _reloads = new(ReloadInterval);
    private readonly CancellationTokenSource _disposal = new();
    private StateDiagramLayout? _layout;
    private (string[]? States, string? InitialState, Dictionary<string, AutomationRule>? Rules, string[]? RuleOrder) _layoutConfiguration;
    private IReadOnlyList<RunEntry> _runs = [];
    private bool _hasHistory;
    private string? _runsError;
    private int? _renderedRunsKey;
    private int? _loadedRunsKey;
    private int _loadVersion;

    [Parameter] public IInterceptorSubject? Subject { get; set; }

    // The page reads the run counts in its render, so a run or a saved configuration renders it again. The runs are read
    // at most once per interval, and once more after it while the history lags behind the counts.
    protected override void OnAfterRender(bool firstRender)
    {
        if (Subject is Automation && _renderedRunsKey != _loadedRunsKey)
        {
            _loadedRunsKey = _renderedRunsKey;
            RequestLoad();
        }
    }

    private void RequestLoad()
    {
        if (_reloads.Request(TimeProvider.GetUtcNow()) is { } delay)
        {
            _ = LoadAfterAsync(delay);
        }
    }

    private async Task LoadAfterAsync(TimeSpan delay)
    {
        var cancellationToken = _disposal.Token;
        try
        {
            if (delay > TimeSpan.Zero)
            {
                await Task.Delay(delay, TimeProvider, cancellationToken);
            }

            _reloads.Start(TimeProvider.GetUtcNow());
            if (Subject is not Automation automation || cancellationToken.IsCancellationRequested)
            {
                return;
            }

            var version = ++_loadVersion;
            var isBehind = await LoadRunsAsync(automation, version, cancellationToken);
            if (!IsStale(version, cancellationToken))
            {
                StateHasChanged();
            }

            if (isBehind && !cancellationToken.IsCancellationRequested)
            {
                RequestLoad();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The page was closed.
        }
    }

    private bool IsStale(int version, CancellationToken cancellationToken) =>
        version != _loadVersion || cancellationToken.IsCancellationRequested;

    // A load that a newer one superseded leaves the runs alone, so a slow older query cannot replace newer runs. Returns
    // whether the history lags behind the live run counts.
    private async Task<bool> LoadRunsAsync(Automation automation, int version, CancellationToken cancellationToken)
    {
        IHistoryStore[] stores = ((IInterceptorSubject)automation).Context.TryGetService<ISubjectRegistry>()?.KnownSubjects.Keys.OfType<IHistoryStore>().ToArray() ?? [];
        if (stores.Length == 0)
        {
            _hasHistory = false;
            _runsError = null;
            _runs = GetLastRuns(automation);
            return false;
        }

        try
        {
            var now = TimeProvider.GetUtcNow();
            var result = await RunHistory.LoadAsync(stores, GetRunSources(automation), now - RunWindow, now, MaxRuns, cancellationToken);
            if (!IsStale(version, cancellationToken))
            {
                _hasHistory = true;
                _runs = result.Runs;
                _runsError = null;
            }

            return result.IsBehind;
        }
        catch (Exception exception) when (exception is not OutOfMemoryException)
        {
            // A load that a newer one superseded or that the closed page canceled shows nothing.
            if (!IsStale(version, cancellationToken))
            {
                _hasHistory = true;
                _runsError = $"The runs could not be read from history: {exception.Message}";
            }

            return false;
        }
    }

    private IReadOnlyList<RunSource> GetRunSources(Automation automation) =>
    [
        .. automation.GetRulesInOrder()
            .Select(pair => (pair.Key, pair.Value, Path: PathResolver.GetPath(pair.Value, PathStyle.Canonical)))
            .Where(rule => rule.Path is not null)
            .Select(rule => new RunSource(rule.Value.Name ?? rule.Key, rule.Path!, rule.Value.RunCount))
    ];

    private async Task TestAsync(string key, AutomationRule rule)
    {
        AutomationRuleTestResult result;
        try
        {
            result = rule.TestNow();
        }
        catch (InvalidOperationException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
            return;
        }

        var parameters = new DialogParameters<RuleTestDialog>
        {
            { dialog => dialog.Result, result },
            { dialog => dialog.Rule, rule },
            { dialog => dialog.EvaluatedAt, AutomationTime.Format(TimeZone, TimeProvider.GetUtcNow(), TimeProvider.GetUtcNow()) }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<RuleTestDialog>($"Test now: {rule.Name ?? key}", parameters, options);
    }

    private Task EditAsync(Automation automation) =>
        SubjectEditDialog.ShowAsync(DialogService, ComponentRegistry, automation, $"Edit {automation.Title}");

    private async Task ResetAsync(Automation automation)
    {
        var isConfirmed = await DialogService.ShowMessageBoxAsync(
            "Reset state",
            "Enter the initial state, clear the last trigger times and start every rule over?",
            yesText: "Reset",
            cancelText: "Cancel");
        if (isConfirmed != true)
        {
            return;
        }

        try
        {
            automation.ResetState();
        }
        catch (InvalidOperationException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private string FormatInstant(DateTimeOffset? instant, string fallback) =>
        instant is { } value ? AutomationTime.Format(TimeZone, value, TimeProvider.GetUtcNow()) : fallback;

    private string GetCurrentDetail(Automation automation) =>
        automation.StateEnteredAt is { } since ? $"Current, since {AutomationTime.Format(TimeZone, since, TimeProvider.GetUtcNow())}" : "Current";

    // The page renders on every change of a status or a run, so the layout is computed again only after a configuration was
    // applied, which replaces these values.
    private StateDiagramLayout GetLayout(Automation automation)
    {
        var configuration = (automation.States, automation.InitialState, automation.Rules, automation.RuleOrder);
        if (_layout is null || !ReferenceEquals(_layoutConfiguration.States, configuration.States) || _layoutConfiguration.InitialState != configuration.InitialState ||
            !ReferenceEquals(_layoutConfiguration.Rules, configuration.Rules) || !ReferenceEquals(_layoutConfiguration.RuleOrder, configuration.RuleOrder))
        {
            _layoutConfiguration = configuration;
            _layout = _layouts.Get(automation.States, automation.InitialState, [.. automation.GetRulesInOrder().Select(pair => StateDiagramRule.From(pair.Key, pair.Value))]);
        }

        return _layout;
    }

    private static string? DescribeScope(Automation automation, AutomationRule rule)
    {
        if (rule.InState is { } state)
        {
            return $"Active in state {state}";
        }

        return automation.States.Length > 0 ? "Any state" : null;
    }

    // A hash instead of a text, because the page renders on every change of a status.
    private static int GetRunsKey(Automation automation)
    {
        var hash = new HashCode();
        foreach (var (key, rule) in automation.Rules)
        {
            hash.Add(key);
            hash.Add(rule.Name);
            hash.Add(rule.RunCount);
        }

        return hash.ToHashCode();
    }

    private static IReadOnlyList<RunEntry> GetLastRuns(Automation automation) =>
        RunHistory.GetLastRuns(automation.GetRulesInOrder().Select(pair => (pair.Value.Name ?? pair.Key, pair.Value.LastRunOutcome, pair.Value.LastRunMessage)));

    public void Dispose()
    {
        _disposal.Cancel();
        _disposal.Dispose();
    }
}
