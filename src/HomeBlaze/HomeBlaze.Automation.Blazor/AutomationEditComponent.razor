@attribute [SubjectComponent(SubjectComponentType.Edit, typeof(Automation))]
@implements ISubjectEditComponent
@implements IDisposable

@if (Automation is not null && _draft is { } draft)
{
    <div class="automation-editor">
    <MudStack Spacing="2" Class="automation-stack" data-testid="automation-editor" data-dirty="@(_isDirty ? "true" : "false")">
        @if (_pendingRows.Any)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" data-testid="automation-pending">
                A condition is not finished. Complete or remove it before saving.
            </MudAlert>
        }
        @if (GetCurrentStateNotice(draft) is { } notice)
        {
            <MudAlert Severity="Severity.Info" Dense="true" data-testid="automation-notices">@notice</MudAlert>
        }
        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="automation-errors" data-testid="automation-errors">
                <MudText Typo="Typo.body2">Fix these before saving:</MudText>
                <ul class="pl-4">
                    @foreach (var error in _errors)
                    {
                        <li><MudText Typo="Typo.body2">@Describe(draft, error)</MudText></li>
                    }
                </ul>
            </MudAlert>
        }
        <CascadingValue Value="_pendingRows">
            <MudTabs Elevation="0" Border="true" Class="automation-tabs" ActivePanelIndex="_tabIndex" ActivePanelIndexChanged="OnTabChanged" TabPanelsClass="automation-tab-panels pt-3">
                <MudTabPanel Text="General">
                    <GeneralTab Draft="draft" Changed="OnChanged" />
                </MudTabPanel>
                <MudTabPanel Text="Rules">
                    <RulesTab Automation="Automation" Draft="draft" Errors="_errors" SelectedRuleKey="@_selectedRuleKey" SelectedRuleKeyChanged="OnRuleSelected" Changed="OnChanged" />
                </MudTabPanel>
                <MudTabPanel Text="States">
                    <StatesTab Automation="Automation" Draft="draft" Changed="OnChanged" RuleOpened="OpenRule" />
                </MudTabPanel>
            </MudTabs>
        </CascadingValue>
    </MudStack>
    </div>
}

@code {
    private readonly PendingRows _pendingRows = new();
    private AutomationDraft? _draft;
    private IReadOnlyList<AutomationValidationError> _errors = [];
    private int _tabIndex;
    private string? _selectedRuleKey;
    private bool _isDirty;
    private bool _needsRevalidation;
    private bool _wasValid = true;
    private bool _isDisposed;

    [Parameter] public IInterceptorSubject? Subject { get; set; }

    [Parameter] public bool IsCreating { get; set; }

    public event Action<bool>? IsValidChanged;

    public event Action<bool>? IsDirtyChanged;

    public string PreferredDialogSize => "Large";

    public bool IsDirty => _isDirty;

    // Validated on every read, because an input that is removed while it shows an error clears the error only when it is
    // disposed, after the change that removed it.
    public bool IsValid => _draft is not null && !_pendingRows.Any && _draft.Validate().Count == 0;

    private Automation? Automation => Subject as Automation;

    protected override void OnInitialized()
    {
        if (Automation is { } automation)
        {
            _draft = AutomationDraft.From(automation);
            _errors = _draft.Validate();
            _selectedRuleKey = _draft.Rules.Count > 0 ? _draft.Rules[0].Key : null;
        }

        _wasValid = IsValid;
        _pendingRows.Changed += OnPendingRowsChanged;
    }

    public Task SaveAsync(CancellationToken cancellationToken)
    {
        if (Automation is { } automation && _draft is { } draft && IsValid)
        {
            draft.ApplyTo(automation);
            SetDirty(false);
        }

        return Task.CompletedTask;
    }

    // A field that goes away reports from its disposal, which runs during a render of this component, so the update is
    // queued instead of rendering in the middle of it.
    private void OnPendingRowsChanged() => _ = InvokeAsync(() =>
    {
        if (!_isDisposed)
        {
            ReportValidity();
            StateHasChanged();
        }
    });

    private void OnTabChanged(int index)
    {
        _tabIndex = index;
        _needsRevalidation = true;
    }

    private const int RulesTabIndex = 1;

    private void OpenRule(string ruleKey)
    {
        _selectedRuleKey = ruleKey;
        _tabIndex = RulesTabIndex;
        _needsRevalidation = true;
    }

    private void OnRuleSelected(string? key)
    {
        _selectedRuleKey = key;
        _needsRevalidation = true;
    }

    // An input that shows an error clears it when it is disposed, which happens in the render after a selection or an edit
    // that removed it, so the errors are read again after that render. This is no edit, so the dialog does not become dirty.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!_needsRevalidation || _draft is null)
        {
            return;
        }

        _needsRevalidation = false;
        var errors = _draft.Validate();
        ReportValidity();
        if (!errors.SequenceEqual(_errors))
        {
            _errors = errors;
            StateHasChanged();
        }
    }

    /// <summary>Every tab raises this after each edit of the draft, so that the errors and the validity follow it.</summary>
    private void OnChanged()
    {
        _errors = _draft?.Validate() ?? [];
        _needsRevalidation = true;
        SetDirty(true);
        ReportValidity();
    }

    // Raised on transitions only, because the host renders its save button again on each event.
    private void ReportValidity()
    {
        var isValid = IsValid;
        if (isValid != _wasValid)
        {
            _wasValid = isValid;
            IsValidChanged?.Invoke(isValid);
        }
    }

    // Not an error, because the automation is still saved; it then stops until its state is reset.
    private string? GetCurrentStateNotice(AutomationDraft draft) =>
        Automation?.CurrentState is { } current && !draft.States.Contains(current)
            ? $"The current state '{current}' is renamed or removed. After saving, the automation stops with an error until its state is reset."
            : null;

    private static string Describe(AutomationDraft draft, AutomationValidationError error) =>
        draft.FindRule(error.RuleKey) is { } rule ? $"Rule '{rule.DisplayName}': {error.Message}" : error.Message;

    public void Dispose()
    {
        _isDisposed = true;
        _pendingRows.Changed -= OnPendingRowsChanged;
    }

    private void SetDirty(bool isDirty)
    {
        if (_isDirty != isDirty)
        {
            _isDirty = isDirty;
            IsDirtyChanged?.Invoke(isDirty);
        }
    }
}
