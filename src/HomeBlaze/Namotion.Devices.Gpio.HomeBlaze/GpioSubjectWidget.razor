@using Namotion.Interceptor

@attribute [SubjectComponent(SubjectComponentType.Widget, typeof(GpioSubject))]
@inherits PermissionsComponentBase
@implements ISubjectComponent

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Memory" Class="mr-2" />
            GPIO
        </MudText>

        <MudDivider />

        <MudStack Row="true" Spacing="4">
            <MudStack>
                <MudText Typo="Typo.caption">Digital Pins</MudText>
                <MudText Typo="Typo.h5">@ShownPins.Count()</MudText>
            </MudStack>

            <MudStack>
                <MudText Typo="Typo.caption">Inputs</MudText>
                <MudText Typo="Typo.h5">@InputCount</MudText>
            </MudStack>

            <MudStack>
                <MudText Typo="Typo.caption">Outputs</MudText>
                <MudText Typo="Typo.h5">@OutputCount</MudText>
            </MudStack>
        </MudStack>

        @if (GpioSubject?.AnalogChannels.Values.Count(channel => Permissions.CanShow(channel)) is > 0 and var analogChannelCount)
        {
            <MudDivider />
            <MudStack Row="true" Spacing="4">
                <MudStack>
                    <MudText Typo="Typo.caption">Analog Channels</MudText>
                    <MudText Typo="Typo.h5">@analogChannelCount</MudText>
                </MudStack>
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    private GpioSubject? GpioSubject => Subject as GpioSubject;

    // A pin the roles hide is not counted.
    private IEnumerable<GpioPin> ShownPins =>
        GpioSubject?.Pins.Values.Where(pin => Permissions.CanShow(pin)) ?? [];

    private int InputCount => ShownPins
        .Count(p => p.Mode is GpioPinMode.Input or GpioPinMode.InputPullUp or GpioPinMode.InputPullDown);

    private int OutputCount => ShownPins
        .Count(p => p.Mode == GpioPinMode.Output);
}
