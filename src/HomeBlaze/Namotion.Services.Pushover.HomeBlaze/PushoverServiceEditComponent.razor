@attribute [SubjectComponent(SubjectComponentType.Edit, typeof(PushoverService))]
@implements ISubjectEditComponent
@inject IUserPermissions Permissions

<MudForm>
    <MudTextField @bind-Value="_name"
                  Label="Name"
                  Immediate="true"
                  OnKeyUp="OnFieldChanged" />

    <MudTextField @bind-Value="_applicationToken"
                  Label="Application Token"
                  InputType="InputType.Password"
                  HelperText="@(HasStoredApplicationToken ? "Leave empty to keep the current token" : null)"
                  Immediate="true"
                  OnKeyUp="OnFieldChanged"
                  Class="mt-4" />

    @foreach (var target in _targets)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-4">
            <MudTextField @bind-Value="target.Name"
                          Label="Target Name"
                          Required="true"
                          RequiredError="Name is required"
                          Immediate="true"
                          OnKeyUp="OnFieldChanged" />

            <MudTextField @bind-Value="target.UserKey"
                          Label="User or Group Key"
                          InputType="InputType.Password"
                          HelperText="@(HasStoredUserKey(target) ? "Leave empty to keep the current key" : null)"
                          Required="@(!HasStoredUserKey(target))"
                          RequiredError="Key is required"
                          Immediate="true"
                          OnKeyUp="OnFieldChanged"
                          Class="mt-2" />

            <MudButton OnClick="@(() => RemoveTarget(target))"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Color="Color.Error"
                       Class="mt-2">Remove</MudButton>
        </MudPaper>
    }

    <MudButton OnClick="AddTarget" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Add Target</MudButton>
</MudForm>

@code {
    [Parameter]
    public IInterceptorSubject? Subject { get; set; }

    [Parameter]
    public bool IsCreating { get; set; }

    private PushoverService? Service => Subject as PushoverService;

    private string _name = string.Empty;
    private string? _applicationToken;
    private readonly List<TargetInput> _targets = [];

    // The keys of the targets the form lists or listed, whose inputs decide them at a save; every other target, such as
    // one the roles hid when the form opened, is kept as it is.
    private readonly HashSet<string> _listedKeys = new(StringComparer.Ordinal);

    private bool HasStoredApplicationToken => !string.IsNullOrEmpty(Service?.ApplicationToken);

    public bool IsValid =>
        (HasStoredApplicationToken || !string.IsNullOrWhiteSpace(_applicationToken)) &&
        (_targets.Count > 0 || GetUnlistedTargets().Any()) &&
        _targets.All(target => !string.IsNullOrWhiteSpace(target.Name) && (HasStoredUserKey(target) || !string.IsNullOrWhiteSpace(target.UserKey)));

    public bool IsDirty { get; private set; }

    public event Action<bool>? IsValidChanged;
    public event Action<bool>? IsDirtyChanged;

    protected override void OnInitialized()
    {
        if (Service == null)
        {
            return;
        }

        _name = Service.Name;

        // A target the roles hide is not listed, and a save keeps it as it is.
        foreach (var (key, target) in Service.Targets.Where(pair => Permissions.CanShow(pair.Value)))
        {
            _targets.Add(new TargetInput { Key = key, Name = target.Name });
            _listedKeys.Add(key);
        }
    }

    private void OnFieldChanged()
    {
        IsDirty = true;
        IsValidChanged?.Invoke(IsValid);
        IsDirtyChanged?.Invoke(IsDirty);
    }

    private void AddTarget()
    {
        _targets.Add(new TargetInput());
        OnFieldChanged();
    }

    private void RemoveTarget(TargetInput target)
    {
        _targets.Remove(target);
        OnFieldChanged();
    }

    /// <summary>Saves the edits; refused, changing nothing, when the roles hid a listed target since the form opened.</summary>
    /// <exception cref="InvalidOperationException">A listed target is hidden now.</exception>
    public Task SaveAsync(CancellationToken cancellationToken)
    {
        if (Service == null || !IsValid)
        {
            return Task.CompletedTask;
        }

        // Neither the edits nor the removal of a target the viewer may no longer see are applied, and keeping it instead
        // would silently undo a removal.
        var currentTargets = Service.Targets;
        foreach (var key in _listedKeys)
        {
            if (currentTargets.TryGetValue(key, out var listed) && !Permissions.CanShow(listed))
            {
                throw new InvalidOperationException("A target was hidden since the form was opened. Close the form and open it again.");
            }
        }

        Service.Name = _name;
        if (!string.IsNullOrWhiteSpace(_applicationToken))
        {
            Service.ApplicationToken = _applicationToken;
        }

        // In the order of the current targets, existing targets kept as instances, so their state survives; new ones last.
        var targets = new Dictionary<string, PushoverTarget>();
        foreach (var (key, target) in currentTargets)
        {
            if (!_listedKeys.Contains(key))
            {
                targets[key] = target;
            }
            else if (_targets.Find(input => input.Key == key) is { } input)
            {
                targets[key] = Apply(input, target);
            }
        }

        // An input whose target was removed elsewhere keeps its key, so a key created for a new target avoids those as well.
        var usedKeys = new HashSet<string>(currentTargets.Keys, StringComparer.Ordinal);
        usedKeys.UnionWith(_targets.Select(input => input.Key).OfType<string>());
        foreach (var input in _targets.Where(input => input.Key is null || !currentTargets.ContainsKey(input.Key)))
        {
            if (input.Key is null)
            {
                input.Key = PushoverService.CreateTargetKey(input.Name, usedKeys);
                usedKeys.Add(input.Key);
            }

            targets[input.Key] = Apply(input, new PushoverTarget());
        }

        Service.Targets = targets;
        _listedKeys.Clear();
        _listedKeys.UnionWith(_targets.Select(input => input.Key).OfType<string>());

        _applicationToken = null;
        IsDirty = false;
        IsDirtyChanged?.Invoke(false);
        return Task.CompletedTask;
    }

    private static PushoverTarget Apply(TargetInput input, PushoverTarget target)
    {
        target.Name = input.Name;
        if (!string.IsNullOrWhiteSpace(input.UserKey))
        {
            target.UserKey = input.UserKey;
        }

        input.UserKey = null;
        return target;
    }

    private IEnumerable<KeyValuePair<string, PushoverTarget>> GetUnlistedTargets() =>
        Service?.Targets.Where(pair => !_listedKeys.Contains(pair.Key)) ?? [];

    // An input whose key is no longer in Service.Targets, for example after an external edit of the configuration,
    // is a new target and needs its user key again.
    private bool TryGetExistingTarget(TargetInput input, [System.Diagnostics.CodeAnalysis.NotNullWhen(true)] out PushoverTarget? target)
    {
        target = null;
        return input.Key is { } key && Service?.Targets.TryGetValue(key, out target) == true;
    }

    private bool HasStoredUserKey(TargetInput input) =>
        TryGetExistingTarget(input, out var target) && !string.IsNullOrEmpty(target.UserKey);

    private sealed class TargetInput
    {
        public string? Key { get; set; }

        public string Name { get; set; } = string.Empty;

        public string? UserKey { get; set; }
    }
}
